<jboss-web>
#if($systemproperties.get("contextroot"))
#set ($contextroot = $systemproperties.get("contextroot"))
   <context-root>$contextroot</context-root>
#end
#set ($securitydomain = $systemproperties.get("securitydomain"))
   <security-domain>$securitydomain</security-domain>
#if($systemproperties.get("loginconfig").indexOf("<auth-method>FORM</auth-method>") >= 0)
   <valve>
      <class-name>org.apache.catalina.authenticator.FormAuthenticator</class-name>
      <param>
         <param-name>landingPage</param-name>  
         <param-value></param-value>
      </param>
      <param>
         <param-name>disableProxyCaching</param-name>  
         <param-value>false</param-value>  
      </param>
      <param>
         <param-name>characterEncoding</param-name>  
         <param-value>UTF-8</param-value>  
      </param>
   </valve>
#elseif($systemproperties.get("loginconfig").indexOf("<auth-method>SPNEGO</auth-method>") >= 0)
   <valve>
      <class-name>org.jboss.security.negotiation.NegotiationAuthenticator</class-name>
      <param>
         <param-name>disableProxyCaching</param-name>  
         <param-value>false</param-value>  
      </param>
      <param>
         <param-name>characterEncoding</param-name>  
         <param-value>UTF-8</param-value>  
      </param>
   </valve>
#end
