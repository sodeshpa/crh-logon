#if (!$mergedir)
#set($mergedir = $systemproperties.get("mergedir"))
#end
#parse("macros.hvm")
<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts-config PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 1.2//EN" "http://jakarta.apache.org/struts/dtds/struts-config_1_2.dtd">
<!--
 Copyright (c)     : AdNovum Informatik AG
 Version Number    : $Revision$
 Date of last edit : $Date$

 ${msg_warning_generated}

 generated by: $gdi.version
 generated at: $gdi.generatedAt
 generated from:
    $cartridge.templatePath/$currentTemplate
#if ($properties.get("strict") == "true" || $systemproperties.get("strict") == "true" )
 strict mode: true
#else
 strict mode: false
#end
-->

#macro (isAction)
#if ($properties.get("strict") == "true" || $systemproperties.get("strict") == "true" )
#if ( ($currentClass.isA("org.apache.struts.action.Action")))
true#else
false
#end
#else
#if ( ($currentClass.name.endsWith("Action")))
true#else
false
#end
#end
#end
#macro (isForm)
#if ($properties.get("strict") == "true" || $systemproperties.get("strict") == "true" )
#if ( ($currentClass.isA("org.apache.struts.action.ActionForm")))
true#else
false
#end
#else
#if ( ($currentClass.name.endsWith("Form")))
true#else
false
#end
#end
#end

<struts-config>

  <!-- ========== Data Sources Definitions =================================== -->
#includefile("struts-data-sources.xml")
  
  <!-- ========== Form Bean Definitions =================================== -->
  <form-beans>

#foreach ($currentClass in $javap.getJavaDocBuilder().getClasses())
#if ( "#isForm()" == "true" )
#set ($form_tag = false)
#set ($form_tag = $currentClass.getTagByName("struts.form"))
#if (!$form_tag)
#set ($form_tag = $currentClass.getTagByName("struts:form"))
#end
#if ($form_tag)
    <form-bean
      name="$form_tag.getNamedParameter("name")"
      type="$currentClass.getFullyQualifiedName()"
    />
#end
#end
#end

#includefile("struts-forms.xml")

  </form-beans>

  <!-- ========== Global Exceptions Definitions =================================== -->
#includefile("global-exceptions.xml")
  
  <!-- ========== Global Forward Definitions =================================== -->
#includefile("global-forwards.xml")
  
  <!-- ========== Action Mapping Definitions =================================== -->
  <action-mappings>

#foreach ($currentClass in $javap.getJavaDocBuilder().getClasses())
#if ( "#isAction()" == "true" )
#set ($action_tag = false)
#set ($action_tag = $currentClass.getTagByName("struts.action"))
#if (!$action_tag)
#set ($action_tag = $currentClass.getTagByName("struts:action"))
#end
#if ($action_tag)
#set ($name_value = false)
#set ($name_value = $action_tag.getNamedParameter("name"))
    <action
      path="$st.nvl($action_tag.getNamedParameter("path"))"
      type="$currentClass.getFullyQualifiedName()"
#if ($name_value)
      name="$name_value"
#end
#if ($name_value)
      scope="$st.nvl($action_tag.getNamedParameter("scope"), "request")"
#end
#if ($name_value && $action_tag.getNamedParameter("input"))
      input="$action_tag.getNamedParameter("input")"
#end
      unknown="$st.nvl($action_tag.getNamedParameter("unknown"), "false")"
      validate="$st.nvl($action_tag.getNamedParameter("validate"), "true")"
    >
#set ($action_fwd_tags = false)
#set ($action_fwd_tags = $currentClass.getTagsByName("struts.action-forward"))
#if (!$action_fwd_tags)
#set ($action_fwd_tags = $currentClass.getTagsByName("struts:action-forward"))
#end
#foreach ($forwardTag in $action_fwd_tags)
#if ($forwardTag.getNamedParameter("name"))
      <forward
        name="$forwardTag.getNamedParameter("name")"
        path="$st.nvl($forwardTag.getNamedParameter("path"))"
        redirect="$st.nvl($forwardTag.getNamedParameter("redirect"), "false")"
      />
#end
#end
    </action>
#end
#end
#end

#includefile("struts-actions.xml")
  </action-mappings>
  
#includefile("struts-controller.xml")

#includefile("struts-message-resources.xml")

#includefile("struts-plugins.xml")

</struts-config>
