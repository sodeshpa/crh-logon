#set ($pwd = "${systemproperties.pwd}")
#set ($securitydomain = $systemproperties.get("securitydomain"))
<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2">
    <deployment>
        <dependencies>
#if ($securitydomain.endsWith("SPNEGO"))
            <module name="org.jboss.security.negotiation" export="true"/>
#end
            <module name="org.hibernate"/>
#if ($pwd.endsWith("_terminal"))
            <module name="org.javassist"/>
#else
            <module name="org.antlr"/>
            <module name="deployment.jalopy"/>
            <module name="org.apache.commons.collections"/>
            <system export="true">
                <paths>
                    <path name="com/sun/org/apache/xerces/internal/impl/dv/util"/>
                </paths>
            </system>
#end
        </dependencies>
    </deployment>
#if (!$pwd.endsWith("_terminal"))
    <module name="deployment.jalopy">
        <resources>
            <resource-root path="lib/jalopy-1.5rc3.jar">
                <filter>
                    <exclude path="antlr/**"/>
                </filter>
            </resource-root>
        </resources>
    </module>
#end
</jboss-deployment-structure>
