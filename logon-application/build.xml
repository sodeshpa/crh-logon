	<!-- ================================================================= -->
	<!-- === generator                                                 === -->
	<!-- ================================================================= -->
	<target name="generateEarDesc" depends="prepareIntEar, prepareExtEar, prepareTerminalEar, generateIntDesc, generateExtDesc, generateTerminalDesc"/>

	<target name="generateIntDesc" if="${build-logon-int}">
		<gditask classpathref="gdi.classpath"
				 cartridgePath="${etc.dir}/gdi/ear"
				 inputPath="${build.dir}/stage_int"
				 outputPath="${generated.dir}/gdi/intear">
			<systemproperty name="allfiles" value="true"/>
			<systemproperty name="pwd" value="${build.dir}/stage_int"/>
			<systemproperty name="securitydomain" value="${login.domain.int}"/>
			<systemproperty name="host" value="${host}"/>
			<systemproperty name="port" value="${http.port}"/>
			<properties>
				<fileset file ="${etc.dir}/application.properties"/>
			</properties>
		</gditask>
	</target>

	<target name="generateExtDesc" if="${build-logon-ext}">
		<gditask classpathref="gdi.classpath"
				 cartridgePath="${etc.dir}/gdi/ear"
				 inputPath="${build.dir}/stage_ext"
				 outputPath="${generated.dir}/gdi/extear">
			<systemproperty name="allfiles" value="true"/>
			<systemproperty name="pwd" value="${build.dir}/stage_ext"/>
			<systemproperty name="securitydomain" value="${login.domain.ext}"/>
			<systemproperty name="host" value="${host}"/>
			<systemproperty name="port" value="${http.port}"/>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
			<properties>
				<fileset file ="${etc.dir}/application.properties"/>
			</properties>
		</gditask>
	</target>

