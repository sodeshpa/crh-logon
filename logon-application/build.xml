<project name="project-app" default="dist" basedir=".">
	<description>${ant.project.name} project build file</description>


	<!-- ================================================================= -->
	<!-- === externally defined                                        === -->
	<!-- ================================================================= -->
	<import file="properties.xml"/>
	<import file="../common.xml"/>

	<!-- ============================================================== -->
	<!--  properties                                                    -->
	<!-- ============================================================== -->
	<property name="app.name"                   value="${ant.project.name}"/>
	<property name="ear.name"                   value="${app.name}.ear"/>

	<!-- Default conatiner host and http port -->
	<property name="container.host"             value="localhost"/>
	<property name="container.http.port"        value="15080"/>
	<property name="host"                       value="${container.host}"/>
	<property name="http.port"                  value="${container.http.port}"/>

	<!-- ================================================================ -->
	<!--  parametrize local project structure                            -->
	<!-- ================================================================ -->
	<property name="ear.dir"                    location="${build.dir}/apps"/>
	<property name="ear.staging.dir"            location="${ear.dir}/logon-appEAR"/>
	<property name="ear.etc.dir"                location="${etc.dir}/ear"/>

	<!-- ================================================================ -->
	<!--  wrappers to avoid multiple execution when called by subant      -->
	<!-- ================================================================ -->
	<target name="initWrapper" unless="batchCall">
		<antcall target="init" inheritall="true"/>
	</target>
	<target name="buildWrapper" unless="batchCall">
		<antcall target="build" inheritall="true"/>
	</target>

	<!-- ================================================================ -->
	<!--  initialization, cleanup and default targets                     -->
	<!-- ================================================================ -->
	<target name="all" depends="ears"
			description="build and test everything"/>

	<target name="build" depends="ears"
			description="build and test everything"/>

	<target name="init" depends=""
			description="initialization project structure and environment">
		<tstamp/>

		<echo message="--------- ${ant.project.name}-${build.version} building on ${os.name} ---------"/>
		<echo message=" "/>
		<echo message="building file ${ant.file} with ${ant.version}"/>
		<echo message=""/>
		<mkdir dir="${build.dir}"/>
		<mkdir dir="${build.etc.dir}"/>
		<mkdir dir="${ear.dir}"/>
		<mkdir dir="${ear.staging.dir}"/>
		<mkdir dir="${dist.lib.dir}"/>

		<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>
		<if>
			<equals arg1="${environment}" arg2="dev" />
			<then>
				<property name="build.date" value="January 1 1970"/>
				<property name="build.stamp" value="197001010000"/>
				<property name="build.implementation_version" value="${version}-${environment}"/>
			</then>
			<else>
				<property name="build.date" value="${TODAY}"/>
				<property name="build.stamp" value="${DSTAMP}${TSTAMP}"/>
				<property name="build.implementation_version" value="${build.version}"/>
			</else>
		</if>
	</target>

	<target name="clean" depends="clean-test"
			description="cleans all generated files and directories" >
		<delete dir="${build.dir}"/>
	</target>

	<!-- ================================================================ -->
	<!--  EAR targets                                                 -->
	<!-- ================================================================ -->
	<target name="ears" depends="init, generateEarDesc, ear"/>
	<target name="ear" depends="earint, earext, earterminal"/>

	<target name="earint" if="${build-logon-int}">
		<!-- build int ear -->
		<copy todir="${build.dir}/earmodules_int" verbose="true" flatten="true" includeEmptyDirs="false" failonerror="false">
			<fileset dir="${build.dir}/stage_int/ejbs" />
			<fileset dir="${build.dir}/stage_int/wars" />
		</copy>
		<copy todir="${build.dir}/earmodules_int/lib" verbose="true" flatten="true" includeEmptyDirs="false" failonerror="false">
			<fileset dir="${build.dir}/stage_int/lib">
				<exclude name="**/logon-business-client.jar"/>
			</fileset>
		</copy>
		<copy todir="${build.dir}/earmodules_int/lib" verbose="true" flatten="true" includeEmptyDirs="false" failonerror="false">
			<fileset dir="${build.dir}/stage_int/lib-axis2"/>
		</copy>
		<ear destfile="${project-int.ear}"
			 appxml="${generated.dir}/gdi/intear/application.xml">
			<manifest>
				<attribute name="Manifest-Version" value="1.0"/>
				<attribute name="Implementation-Title" value="${project-int.ear.name}"/>
				<attribute name="Implementation-Vendor" value="${vendor}"/>
				<attribute name="Implementation-Version" value="${build.implementation_version}"/>
				<attribute name="Build-Date" value="${build.date}"/>
				<attribute name="Build-Stamp" value="${build.stamp}"/>
				<attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
				<attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
			</manifest>
			<metainf file="${generated.dir}/gdi/intear/jboss-deployment-structure.xml"/>
			<fileset dir="${build.dir}/earmodules_int"/>
		</ear>
	</target>

	<target name="earext" if="${build-logon-ext}">
		<!-- build ext ear -->
		<copy todir="${build.dir}/earmodules_ext" verbose="true" flatten="true" includeEmptyDirs="false" failonerror="false">
