		</gditask>
	</target>

	<target name="generateEarDescTD" depends="prepareIntEar">
		<java classname="ch.nevis.gdi.main.TemplateDesigner"
			  fork="true" failonerror="true" newenvironment="true">
			<jvmarg value="-Dallfiles=true"/>
			<jvmarg value="-Dpwd=${build.dir}/stage_int"/>
			<jvmarg value="-Dhost=${host}"/>
			<jvmarg value="-Dport=${http.port}"/>
			<classpath refid="gdi.classpath"/>
			<arg line="${etc.dir}/gdi/ear ${build.dir}/stage_int ${generated.dir}/gdi/intear etc/application.properties"/>
		</java>
	</target>

	<!-- ================================================================= -->
	<!-- === distribution targets                                      === -->
	<!-- ================================================================= -->
	<target name="dist" description="build the distribution" unless="omit.subcomponent.application">
		<antcall target="realdist" inheritall="true"/>
	</target>
	<target name="realdist" depends="build, realdistint, realdistext, realdistterminal"/>

	<target name="realdistint" if="${build-logon-int}">
		<symlink link="${dist.lib.dir}" resource="${project-int.ear}" failonerror="false"/>
		<copy tofile="${dist.dir}/int_info.txt" file="${generated.dir}/gdi/intear/info.txt"/>
	</target>

	<target name="realdistext" if="${build-logon-ext}">
		<symlink link="${dist.lib.dir}" resource="${project-ext.ear}" failonerror="false"/>
		<copy tofile="${dist.dir}/ext_info.txt" file="${generated.dir}/gdi/extear/info.txt"/>
	</target>

	<target name="realdistterminal" if="${build-logon-terminal}">
		<symlink link="${dist.lib.dir}" resource="${project-terminal.ear}" failonerror="false"/>
		<copy tofile="${dist.dir}/terminal_info.txt" file="${generated.dir}/gdi/terminalear/info.txt"/>
	</target>

	<!-- NOTE: what we build here is only used for development (enables faster dev-cycles) -->
	<target name="deploy" description="deploy this sub-project only">
		<echo>nothing to deploy here!</echo>
	</target>

	<!-- ================================================================ -->
	<!-- source code tracing instrumentation targets                      -->
	<!-- ================================================================ -->
	<target name="adntrace2-instrument">
		<taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
		<adntrace2 operation="instrument"/>
	</target>

	<target name="adntrace2-refresh">
		<taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
		<adntrace2 operation="refresh"/>
	</target>

	<!-- ================================================================ -->
	<!--  generate documentation                                          -->
	<!-- ================================================================ -->
	<target name="docs" depends="buildWrapper"
			description="generate all documentation">
	</target>


	<!-- ================================================================ -->
	<!--  externally defined tasks/targets                                -->
	<!-- ================================================================ -->
	<import file="./build-test.xml"/>

</project>