
<security-constraint>
  <web-resource-collection>
    <web-resource-name>protectedresources</web-resource-name>
    <url-pattern>/chart/*</url-pattern>
    <url-pattern>/blob/*</url-pattern>
    <url-pattern>/image/*</url-pattern>
    <url-pattern>/imagename/*</url-pattern>
    <url-pattern>/pdf/*</url-pattern>
    <url-pattern>/download/pdf/*</url-pattern>
  </web-resource-collection>
#if ($systemproperties.redirectToHttps == "true")
    <user-data-constraint>
      <transport-guarantee>CONFIDENTIAL</transport-guarantee>
    </user-data-constraint>
#end
  <auth-constraint>
    <role-name>Users</role-name>
  </auth-constraint>
</security-constraint>

<security-constraint>
  <web-resource-collection>
    <web-resource-name>protectedactions</web-resource-name>
