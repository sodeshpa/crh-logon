		<filter-class>com.crh.logon.web.filters.ForcePasswordChangeFilter</filter-class>
	</filter>
#end
	<filter>
    	<filter-name>RequestEncodingFilter</filter-name>
		<filter-class>com.crh.logon.web.filters.RequestEncodingFilter</filter-class>
		<init-param>
#set ($encoding = "")
#if ($systemproperties.get("encoding"))
#set ($encoding = $systemproperties.get("encoding"))
#end		    
                <param-name>encoding</param-name>
                <param-value>$encoding</param-value>
        </init-param>
	</filter>
	
