    <!-- HTTP Caching Filter -->
    <filter>
        <filter-name>NoCacheHeaderFilter</filter-name>
        <filter-class>ch.nevis.espace.util.cache.CacheHeaderFilter</filter-class>
    </filter>

    <filter>
        <filter-name>FarFutureExpiresCacheHeaderFilter</filter-name>
        <filter-class>ch.nevis.espace.util.cache.CacheHeaderFilter</filter-class>
        <init-param>
        	<param-name>Except.ServletPath.StartsWith</param-name>
        	<param-value>/dwr</param-value>
        </init-param>
        <init-param>
        	<param-name>CacheControl</param-name>
        	<param-value>private</param-value>
        </init-param>
        <init-param>
        	<param-name>ExpiresDefault</param-name>
        	<param-value>access plus 10 years</param-value>        
        </init-param>
    </filter>
    
    <filter>
        <filter-name>NearFutureExpiresCacheHeaderFilter</filter-name>
        <filter-class>ch.nevis.espace.util.cache.CacheHeaderFilter</filter-class>
        <init-param>
        	<param-name>CacheControl</param-name>
        	<param-value>private</param-value>
        </init-param>
        <init-param>
        	<param-name>ExpiresDefault</param-name>
        	<param-value>access plus 1 weeks</param-value>        
        </init-param>
    </filter>
    <!-- Session Lock Filter -->
    <filter>
        <filter-name>SerializeSessionAccessFilter</filter-name>
        <filter-class>ch.nevis.espace.filters.SerializeSessionAccessFilter</filter-class>
    </filter>

	<filter>
    	<filter-name>RequestInfoFilter</filter-name>
      	<description>This filter logs the elapsed time and other request/response characteristic information</description>
		<filter-class>ch.nevis.espace.filters.RequestInfoFilter</filter-class>
	</filter>

    <filter>
        <filter-name>OpTraceFilter</filter-name>
        <filter-class>ch.nevis.jcan.optrace.web.RequestContextFilter</filter-class>
        <init-param>
                <param-name>transferIdName</param-name>
                <param-value>transferIdName</param-value>
        </init-param>
        <init-param>
                <param-name>userNameFallbackName</param-name>
                <param-value>userNameFallbackName</param-value>
        </init-param>
        <init-param>
                <param-name>ClientIP</param-name>
                <param-value>ClientIP</param-value>
        </init-param>
    </filter>

	<filter>
    	<filter-name>TimeIndicatorFilter</filter-name>
		<filter-class>com.crh.logon.web.filters.TimeIndicatorFilter</filter-class>
	</filter>

    <filter>
        <filter-name>DwrRequestInfoFilter</filter-name>
        <filter-class>com.crh.logon.web.filters.DwrRequestInfoFilter</filter-class>
    </filter>

	<filter>
    	<filter-name>UserFilter</filter-name>
		<filter-class>com.crh.logon.web.filters.UserFilter</filter-class>
	</filter>
	
	<filter>
    	<filter-name>ConfigBeanFilter</filter-name>
		<filter-class>com.crh.logon.web.filters.ConfigBeanFilter</filter-class>
        <init-param>
                <param-name>context</param-name>
                <param-value>admin</param-value>
        </init-param>
	</filter>
#if(!$systemproperties.get("securitydomain").endsWith("SPNEGO"))
	<filter>
