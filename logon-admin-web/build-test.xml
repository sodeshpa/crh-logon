			<include name="junit/junit/4.12/junit-4.12.jar"/>
			<include name="org/apache/velocity/velocity-engine-core/2.1/velocity-engine-core-2.1.jar"/>
			<include name="org/slf4j/slf4j-api/1.7.26/slf4j-api-1.7.26.jar"/>
