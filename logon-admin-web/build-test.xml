    <path id="test.compile.classpath">
        <path refid="compile.classpath"/>
    	<pathelement location="${subcomponent.common-web}/${build.dir.name}/test/classes"/>
        <pathelement location="${classes.dir}"/>
        <pathelement location="${junit.jar}"/>
        <pathelement location="${hamcrest.jar}"/>
		<path refid="jcan-test.path"/>
		<!--pathelement location="${js.jar}"/-->

    	<path refid="selenium.classpath"/>
    	<path refid="compile.classpath"/>
    </path>

    <path id="test.unit.classpath">
        <pathelement location="${commons-logging.jar}"/>
        <pathelement location="${dom4j.jar}"/>
        <pathelement location="${jdom.jar}"/>
        <pathelement location="${test.build.etc.dir}"/>
        <pathelement location="${test.classes.dir}"/>
        <path refid="test.compile.classpath"/>
    </path>

    <path id="test.integration.classpath">
    	<!-- <pathelement location="${js.jar}"/>
        <pathelement location="${tidy.jar}"/>
    	<pathelement location="${xercesImpl.jar}"/>
    	<pathelement location="${xmlutil.jar}"/>
    	<pathelement location="${xtype.jar}"/> -->
