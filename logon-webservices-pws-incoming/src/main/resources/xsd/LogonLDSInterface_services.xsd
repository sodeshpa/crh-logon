    <xsd:element name="regularizationRequest">
        <xsd:annotation>
            <xsd:documentation>Sent only once, covering all individual loads.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="losc:request">
                    <xsd:sequence>
                        <xsd:element name="vehicle" type="losc:vehicleData"/>
                        <xsd:element name="driver" type="losc:driverData" minOccurs="0" />
                        <xsd:element name="attorney" type="losc:attorneyData" minOccurs="0" />
                        <xsd:element name="dispatcher" type="losc:dispatcherData" minOccurs="0" />
                        <xsd:element maxOccurs="unbounded" name="endLoadingPart"
                                     type="losc:endLoadingPartData"/>
                        <xsd:element maxOccurs="unbounded" minOccurs="0" name="returnPallets">
                            <xsd:complexType>
                                <xsd:sequence>
                                    <xsd:element name="logonOrderNo">
                                        <xsd:annotation>
                                            <xsd:documentation>LOGON order number (or delivery number in CRH terminology).</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="12"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element minOccurs="1" name="materialNo">
                                        <xsd:annotation>
                                            <xsd:documentation>SAP material number of the pallet. Pallet (material) must be present in the order this return is referring to.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="18"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element minOccurs="1" name="quantity">
                                        <xsd:annotation>
                                            <xsd:documentation>Quantity of pallets returned in the unit of measure defined by 'quantityUom'.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:decimal">
                                                <xsd:totalDigits value="12"/>
                                                <xsd:fractionDigits value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="quantityUom">
                                        <xsd:annotation>
                                            <xsd:documentation>The unit of measure 'quantity' is measured in. Must be SAP base UoM, sales UoM or any UoM which is defined in alternative UoM of the material.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="3"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                </xsd:sequence>
                            </xsd:complexType>
                        </xsd:element>
                        <xsd:element name="firstWeighing" type="losc:firstWeighingData" minOccurs="0"/>
                        <xsd:element name="secondWeighing" type="losc:secondWeighingData" minOccurs="0"/>
                        <xsd:element name="tareDeviationDriverACK" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Tare deviation (measured != master data) warning shown and confirmed by driver.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:boolean"/>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="maxGrossExceededDriverACK" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>The measured gross weight exceeds the maximum allowed for the vehicle. Warning shown and confirmed by driver.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:boolean"/>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="ldsCustomerOrderNo" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Customer order number / external order number.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="20"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="ldsDeliveryNoteNo" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Delivery note number from the LDS for this order.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="12"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="ldsEnterShippingpointTime" minOccurs="0"
                                     type="xsd:dateTime">
                            <xsd:annotation>
                                <xsd:documentation>The time the truck entered the shippoingpoint/plant area.
                                    This value is considered if there are no PDAs involved.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ldsLeaveShippingpointTime" minOccurs="0"
                                     type="xsd:dateTime">
                            <xsd:annotation>
                                <xsd:documentation>Time the truck leaves the shippoingpoint/plant area.
                                    This value is considered if there are no PDAs involved.
                                    In WeWaS, this corresponds to the print delivery note event
                                    or similar event. Later that can be identified and related to
                                    this specific truck and order.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="deliveryNotePrintingPoint" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Point where delivery note should be printed.
                                    Actaully this is the loading point in LOGON. Check logic impact on Shipping Point Master Data!
                                    (maybe just an additional loading point in LOGON).</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="12"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="suppressDeliveryNotePrinting">
                            <xsd:annotation>
                                <xsd:documentation>Override of all other settings. No delivery note will be printed at all. Also suppresses printing of collective delivery note, but only if this is the last endLoadingRequest of that customer order (no 'memory' of this option).</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:boolean"> </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="noteDelivery" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Remark relevant for delivery note (and later invoice).</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="256"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="noteLDS" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Remark for operator of LDS and/or truck driver. To be displayed somewhere on the LDS screen.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="256"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="carrierLetter" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Driver to put the 15 Alphanumeric code in SCHENCK and to be print on DN.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="15"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="seals" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Seal Numbers added by Operating during exiting phase. Maximum of four seals are possible per truck, regardless of whether BULK or BAG products.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="256"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="regularizationResponse">
        <xsd:complexType>
            <xsd:complexContent>
