                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="suppressDeliveryNotePrinting">
                            <xsd:annotation>
                                <xsd:documentation>Override of all other settings. No delivery note will be printed at all. Also suppresses printing of collective delivery note, but only if this is the last endLoadingRequest of that customer order (no 'memory' of this option).</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:boolean"> </xsd:restriction>
