<?xml version="1.0" encoding="ISO-8859-1" ?>

<taglib version="2.0" xmlns="http://java.sun.com/xml/j2ee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd">
	<tlib-version>1.0</tlib-version>
	<jsp-version>2.0</jsp-version>
	<short-name>pdf-rendering</short-name>
	<uri>http://com.crh.logon/tags/pdf-rendering.tld</uri>
	<tag>
    	<name>cut</name>
    	<tag-class>com.crh.logon.order.taglib.PdfRenderingCutoff</tag-class>
    	<body-content>JSP</body-content>
    	<attribute>
			<name>width</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<description>
				Width of the element in pixels.
			</description>
		</attribute>
		<attribute>
			<name>classes</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<description>
				Element classes.
			</description>
		</attribute>
 	</tag>
</taglib>