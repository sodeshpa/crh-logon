<!-- Set project name to project's cvs module name, as project name will
     be used for toolbox scope checks -->

<project name="logon-init" default="dist" basedir=".">
    <description>${ant.project.name} project build file</description>

    <!-- ================================================================= -->
    <!-- === externally defined                                        === -->
    <!-- ================================================================= -->
    <import file="properties.xml"/>
    <import file="../common.xml"/>

    <!-- ================================================================= -->
    <!-- === maven like dependencies                                   === -->
    <!-- ================================================================= -->
    <import file="${AAL_HOME}/aal/aal-maven.xml"/>
    <import file="./build-deps.xml"/>    
    <path id="eclipse.lib.classpath">
        <path refid="logon-mavendeps.compile.classpath"/> <!-- maven libs -->
    </path>

    <!-- ============================================================== -->
    <!--  properties                                                    -->
    <!-- ============================================================== -->
    <property name="webapp.name"                value="${ant.project.name}"/>

    <!-- ================================================================ -->
    <!--  parametrize local project structure                             -->
    <!-- ================================================================ -->
    <property name="javadoc.dir"                location="${build.dir}/api"/>
    <property name="webapps.dir"                location="${build.dir}/webapps"/>

    <property name="webapps.staging.dir"        location="${webapps.dir}/${webapp.name}.war_staging"/>
    <property name="webapps.unwar.dir"          location="${webapps.dir}/${webapp.name}UNWAR"/>
	<property name="webmerge.dir"               location="${etc.dir}/gdi/webconfig/merge"/>

    <property name="test-integration.jar"       location="${build.dir}/test/lib/test-integration.jar"/>

    <!-- ================================================================ -->
    <!--  define target specific classpaths (build, runtime, test)        -->
    <!-- ================================================================ -->
    <path id="compile.classpath">
        <pathelement location="${servlet.jar}"/>
    	<pathelement location="${jcan-log.jar}"/>
    	<pathelement location="${log4j.jar}"/>
    	<pathelement location="${spring.jar}"/>
    	<pathelement location="${jcan-optrace.jar}"/>
    	<pathelement location="${commons-lang.jar}"/>
		<pathelement location="${project-common.jar.loc}"/>
        <pathelement location="${project-common-web.classes.dir}"/>
        <pathelement location="${project-business-client.jar.loc}"/>
        <path refid="logon-mavendeps.compile.classpath"/>
   </path>

    <!-- ================================================================ -->
    <!--  initialization, cleanup and default targets                     -->
    <!-- ================================================================ -->
    <target name="all" depends="dist"
            description="build and test everything"/>

    <target name="toolbox-checkUptodate">
        <uptodate property="toolbox-isUptodate" targetfile=".classpath">
            <srcfiles refid="toolbox-sourcefiles"/>
        </uptodate>
    </target>

    <target name="toolbox" depends="toolbox-checkUptodate" unless="toolbox-isUptodate">
        <taskdef resource="adnant-taskdefs.xml"/> <!-- See documentation in adnant project's README -->
        <updatedotclasspath>
                <!-- See documentation of 'updatedotclasspath' in adnant project's README -->
            <con path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
            <var pathref="eclipse.lib.classpath" />
            <output path=".bin"/>
            <src path="/logon-common"/>
            <src path="/logon-common-web"/>
            <src path="/logon-persistence"/>
            <src path="/logon-business"/>
            <src path="${java.src.dir.name}"/>
            <lib path="${adntrace2-templates.jar}" sourcepath="${masterbuild.dir}/etc/adntrace2"/>
        </updatedotclasspath>
    </target>

    <target name="init" depends="toolbox"
            description="initialization project structure and environment">
        <tstamp/>
        <echo message="--------- ${ant.project.name}-${build.version} building on ${os.name} ---------"/>
        <echo message=" "/>
        <echo message="building file ${ant.file} with ${ant.version}"/>
        <echo message=""/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${lib.dir}"/>
        <mkdir dir="${webapps.dir}"/>
        <mkdir dir="${webapps.staging.dir}"/>
        <mkdir dir="${generated.dir}"/>
        <mkdir dir="${test.build.dir}"/>
        <mkdir dir="${test.log.dir}"/>
        <mkdir dir="${test.lib.dir}"/>
    </target>

    <target name="clean" depends="clean-test"
            description="cleans all generated files and directories" >
        <delete dir="${build.dir}"/>
    </target>

    <!-- ================================================================ -->
    <!--  compile targets                                                 -->
    <!-- ================================================================ -->
    <target name="build" depends="init, webapps"
            description="build target"/>

    <target name="compile" depends="compile-src, compile-test"/>

    <target name="compile-src">
        <echo message="${java.src.dir}"/>
        <javac
            source="${compile.source}"
            target="${compile.target}"
            destdir="${classes.dir}"
            debug="${compile.debug}"
            optimize="${compile.optimize}"
            deprecation="${compile.deprecation}"
            encoding="${compile.encoding}"
            includeantruntime="no">
            <src path="${java.src.dir}"/>
            <include name="**/*.java"/>
            <bootclasspath refid="compile.bootclasspath"/>
            <classpath refid="compile.classpath"/>
             <compilerarg line="-processor ch.adnovum.jcan.log.adntrace8.AdnTraceProcessor"/>
        </javac>
    </target>

    <!-- ================================================================ -->
    <!--  web application archives (WARs, EARs)                           -->
    <!-- ================================================================ -->
	<target name="war">
		<war warfile="${warfile}"
             webxml="${generated.dir}/gdi/webconfig/${zone}/WEB-INF/web.xml"
             update="false" compress="true">

            <manifest>
                <attribute name="Manifest-Version" value="1.0"/>
                <attribute name="Implementation-Title" value="${ant.project.name}-${zone}"/>
                <attribute name="Implementation-Vendor" value="${vendor}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Build-Date" value="${build.date}"/>
                <attribute name="Build-Stamp" value="${build.stamp}"/>
                <attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
                <attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
            </manifest>

        	<classes dir="${classes.dir}"/>
			<classes dir="${project-common-web.classes.dir}"/>

			<fileset dir="${project-common-web.resources.dir}"/>

        	<!-- webapp -->
			<fileset dir="${project-common-web.webapp.dir}"/>
            <fileset dir="${generated.dir}/gdi/webconfig/${zone}">
            	<include name="**/*.xml"/>
               	<exclude name="WEB-INF/web.xml"/>
            	<exclude name="WEB-INF/struts-config.xml"/>
            </fileset>

            <lib file="${espace.jar}"/>
			<lib file="${standard.jar}"/> <!-- actually not used at runtime, but some files refer to it, making it mandatory for jsp precompile -->
		    <lib file="${struts.jar}"/> <!-- actually not used at runtime, but some files refer to it, making it mandatory for jsp precompile -->
		    <lib file="${struts-el.jar}"/> <!-- actually not used at runtime, but some files refer to it, making it mandatory for jsp precompile -->
        </war>
	</target>
	
    <target name="webapps" depends="generateWebConfig, compile">
        <tstamp/>

        <!--<copy toDir="${build.dir}/resources/WEB_INF/classes" file="${masterbuild.dir}/etc/log4j.xml"/>-->
    	
        <antcall target="war">
    		<param name="warfile" value="${project-init-webapp-int.war}"/>
        	<param name="zone" value="int"/>
        </antcall>
    	
    	<antcall target="war">
    		<param name="warfile" value="${project-init-webapp-ext.war}"/>
        	<param name="zone" value="ext"/>
        </antcall>
    </target>

    <!-- ================================================================= -->
    <!-- === generator                                                 === -->
    <!-- ================================================================= -->

	<target name="generateWebConfig">
	    <gditask
		     cartridgePath="${subcomponent.common-web}/${etc.dir.name}/gdi/webconfig"
	    	 outputPath="${generated.dir}/gdi/webconfig/int">
	    	<classpath>
		    	<path refid="compile.classpath"/>
		        <path refid="gdi.classpath"/>
		    </classpath>
    		<input>
				<fileset dir="${java.src.dir}"/>
		    </input>
	    	<systemproperty name="strict" value="true"/>
	    	<systemproperty name="mergedir" value="${webmerge.dir}"/>
	    	<systemproperty name="additionalWatchPath" value="${webmerge.dir}"/>
	    	<systemproperty name="clientcachingdisabled" value="${client.caching.disabled}"/>
			<systemproperty name="redirectToHttps" value="${redirect_to_https.int}"/>
	    	<systemproperty name="loginconfig" value="${login.config.int}"/>
	    	<systemproperty name="securitydomain" value="java:/jaas/${login.domain.int}"/>
	    	<systemproperty name="encoding" value="${web.encoding}"/>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
	    </gditask>
	    <gditask
		     cartridgePath="${subcomponent.common-web}/${etc.dir.name}/gdi/webconfig"
	    	 outputPath="${generated.dir}/gdi/webconfig/ext">
	    	<classpath>
		    	<path refid="compile.classpath"/>
		        <path refid="gdi.classpath"/>
		    </classpath>
        	<input>
				<fileset dir="${java.src.dir}"/>
		    </input>
	    	<systemproperty name="strict" value="true"/>
	    	<systemproperty name="mergedir" value="${webmerge.dir}"/>
	    	<systemproperty name="additionalWatchPath" value="${webmerge.dir}"/>
	    	<systemproperty name="clientcachingdisabled" value="${client.caching.disabled}"/>
			<systemproperty name="redirectToHttps" value="${redirect_to_https.ext}"/>
	    	<systemproperty name="loginconfig" value="${login.config.ext}"/>
	    	<systemproperty name="securitydomain" value="java:/jaas/${login.domain.ext}"/>
	    	<systemproperty name="encoding" value="${web.encoding}"/>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
	    </gditask>
    </target>

    <!-- ================================================================= -->
    <!-- === distribution targets                                      === -->
    <!-- ================================================================= -->
    <target name="dist" description="build the distribution" unless="omit.subcomponent.init-web">
        <antcall target="realdist" inheritall="true"/>
    </target>
    <target name="realdist" depends="build">
        <copy todir="${dist.lib.dir}/int" file="${project-init-webapp-int.war}"/>
        <copy todir="${dist.lib.dir}/ext" file="${project-init-webapp-ext.war}"/>
    	<copy todir="${dist.dep.dir}" file="${project-common.jar.loc}"/>
        <copy todir="${dist.dep.dir}" file="${project-business-client.jar.loc}"/>
        <copy todir="${dist.dep.dir}" file="${jcan-log.jar}"/>
        <copy todir="${dist.dep.dir}" file="${jcan-optrace.jar}"/>
        <copy todir="${dist.dep.dir}" file="${commons-lang.jar}"/>
    	<copy todir="${dist.dep.dir}" file="${spring.jar}"/>
        <copy todir="${dist.dep.dir}">
            <fileset dir="${subcomponent.common-web}/${build.dir.name}/${dist.dir.name}/dep"/>
        </copy>
    </target>

    <!-- NOTE: what we build here is only used for development (enables faster dev-cycles) -->
    <target name="deploy" depends="dist"
            description="deploy this sub-project only">
        <copy todir="${deploy.dir}" verbose="true" failonerror="false">
            <fileset dir="${build.dir.name}/${dist.dir.name}/dep"/>
        </copy>
        <copy todir="${deploy.dir}" verbose="true" failonerror="false">
            <fileset dir="${build.dir.name}/${dist.dir.name}/lib/int"/>
        </copy>
    </target>

    <!-- ================================================================ -->
    <!-- source code tracing instrumentation targets                      -->
    <!-- ================================================================ -->
    <target name="adntrace2-instrument">
        <taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
        <adntrace2 operation="instrument"/>
    </target>

    <target name="adntrace2-refresh">
        <taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
        <adntrace2 operation="refresh"/>
    </target>

    <!-- ================================================================ -->
    <!--  externally defined tasks/targets                                -->
    <!-- ================================================================ -->
    <import file="./build-test.xml"/>

</project>
