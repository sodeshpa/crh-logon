# $Id$
#
# Global project environment

# base directory for external dependencies
EXT_PROJ_DIR=/share/java/jpository
MPOSITORY_DIR=/share/java/mpository

# Binrepo urls
BINREPO_URL=https://binrepo-central.adnovum.ch/artifactory
MPOSITORY_URL=https://binrepo.adnovum.ch/artifactory/adn-crhlogon-maven-vi
MAVEN_PUBLISH_NAME=adn-crhlogon-maven-build
MAVEN_PUBLISH_URL=${BINREPO_URL}/${MAVEN_PUBLISH_NAME}
MAVEN_PROVISION_NAME=adn-crhlogon-maven-provision
MAVEN_PROVISION_URL=${BINREPO_URL}/${MAVEN_PROVISION_NAME}
MAVEN_DELIVERY_NAME=adn-crhlogon-maven-delivery
MAVEN_DELIVERY_URL=${BINREPO_URL}/${MAVEN_DELIVERY_NAME}

# Java environment
JAVA_VERSION=jdk1.8.0_152
JAVA_ARCHIVE_NAME=${JAVA_VERSION}-linux-x64.tar.gz
JAVA_REPOURL=https://binrepo.adnovum.ch/artifactory/adn-generic-external/adnjdk/${JAVA_ARCHIVE_NAME}
#JAVA_HOME=${ADNDEVTOOLS_CACHE}/${JAVA_ARCHIVE_NAME}/${JAVA_VERSION}
JAVA_HOME=/share/java/jdk/1.8.0_152_x64

# set jdk and ant version to be used by this project
ANT_HOME=${EXT_PROJ_DIR}/adnovum/adnant/1.9.6.0/adnant/dist
AAL_HOME=${ANT_HOME}

# Appweb 3 toolbox check
APPWEB3_HOME=/share/install/appweb3/current/appweb3

#ANT_OPTS=-verbose
#ANT_OPTS=-Xmx256m
#ANT_OPTS=-verbose:class
ANT_OPTS="-XX:MaxPermSize=512m -Xms1536m -XX:InitialCodeCacheSize=64m -XX:ReservedCodeCacheSize=64m -XX:-UseGCOverheadLimit -Dorg.apache.jasper.compiler.Parser.STRICT_QUOTE_ESCAPING=false"
# Options used for the package build on the remote windows machines. Remove the large heap space requirement.
ANT_OPTS_CYGWIN="-XX:MaxPermSize=512m -XX:InitialCodeCacheSize=64m -XX:ReservedCodeCacheSize=64m -XX:-UseGCOverheadLimit"
# Required because the Logon NB is running on Solaris where the locale is not UTF-8 by default
LC_ALL=en_US.UTF-8
