<jxb:bindings version="1.0" 
  xmlns:jxb="http://java.sun.com/xml/ns/jaxb" 
  xmlns:xs="http://www.w3.org/2001/XMLSchema" 
  xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc" 
  jxb:extensionBindingPrefixes="xjc">
    <jxb:bindings schemaLocation="SalesDocumentNotification.xsd" node="/xs:schema">
        <jxb:bindings node="//xs:complexType[@name='SalesDocumentNotification']">
            <jxb:class name="SalesDocumentNotification"/>
        </jxb:bindings>
        <jxb:bindings node="//xs:complexType[@name='sales_document_notification']">
            <jxb:class name="SalesDocumentNotification2"/>
        </jxb:bindings>
    </jxb:bindings>
</jxb:bindings>