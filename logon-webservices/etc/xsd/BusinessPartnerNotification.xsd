            </xsd:element>
            <xsd:element name="SORTL" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>Sort field</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="10"/>
                    </xsd:restriction>
                </xsd:simpleType>
