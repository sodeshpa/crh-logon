<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2011 rel. 3 sp1 (http://www.altova.com) by concsg (CRH SERVICES EMEA) -->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<xsd:element name="VehicleNotification">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="vehicle_master_data" type="vehicle_master_data" maxOccurs="9999"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="vehicle_driver_category">
		<xsd:annotation>
			<xsd:documentation>Driver&apos;s License Category</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="LICENSE_CAT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Driver&apos;s License Category</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="LICENSE_CAT_TXT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Description of Driver&apos;s License Categories</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="30"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="vehicle_classification">
		<xsd:annotation>
			<xsd:documentation>Classification for Equipments</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KLART" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Class Type</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CLASS" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Class number</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="18"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="ATWRT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Characteristic Value</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="30"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="ATNAM" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Characteristic Name</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="30"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="vehicle_audit_data">
		<xsd:annotation>
			<xsd:documentation>Segment for audit data</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="ERDAT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Date on Which Record Was Created</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="8"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="ERZET" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Entry time</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="6"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="ERNAM" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Name of Person who Created the Object</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="12"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="AENAM" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Name of Person Who Changed Object</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="12"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="AEDAT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Changed On</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="8"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="UTIME" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Time of Last Change</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="6"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="vehicle_master_data">
		<xsd:annotation>
			<xsd:documentation>Truck general data</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="EQUNR" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Equipment Number</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="18"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="SHTXT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Description of technical object</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="40"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="STTXT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Description of maintenance status</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="40"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="EQTYP" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Equipment category</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="FLEET_CAT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Vehicle Type</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="10"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="GROES" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Size/dimensions</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="32"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="SWERKS" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Sender Plant</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="4"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="BUKRS" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Company Code</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="4"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="FLEET_NUM" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Identification number for fleet object</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="18"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="LICENSE_NUM" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>License plate number</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="15"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="FLEET_VIN" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Manufacturer Vehicle Identification Number for Fleet Object</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="30"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="CHASSIS_NUM" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Chassis number</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="30"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="BRGEW" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Gross Weight</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="15"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="GROSS_WGT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Total Weight Allowed</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="15"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="LOAD_WGT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Maximum load weight</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="15"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="LOAD_VOL" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Load volume</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="15"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="GEWEI" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Weight Unit</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="LOAD_LEN" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Load length</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="13"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="LOAD_DIM_UNIT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Unit for freight dimensions</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="VOL_UNIT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Volume unit</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="NUM_AXLE" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Number of axels that the fleet object contains</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="2"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="FLEET_USE" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Usage indicator</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="LULEINH" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Loading Units</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="8"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="RP_VARKAP" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Free Capacity Field with Variable Unit of Measure</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="9"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="RP_KAPUNIT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Unit of Measure for Var. Capacity Field</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="vehicle_transportation_planning_point" type="vehicle_transportation_planning_point" minOccurs="0" maxOccurs="9999"/>
			<xsd:element name="vehicle_partner_functions" type="vehicle_partner_functions" minOccurs="0" maxOccurs="9999"/>
			<xsd:element name="vehicle_trailer" type="vehicle_trailer" minOccurs="0" maxOccurs="9999"/>
			<xsd:element name="vehicle_classification" type="vehicle_classification" minOccurs="0" maxOccurs="9999"/>
			<xsd:element name="vehicle_driver_category" type="vehicle_driver_category" minOccurs="0" maxOccurs="9999"/>
			<xsd:element name="vehicle_audit_data" type="vehicle_audit_data" minOccurs="0" maxOccurs="9999"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="vehicle_trailer">
		<xsd:annotation>
			<xsd:documentation>Segment for trailer</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="KANTE" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Number of the link between two technical objects</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="18"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="KANXT" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Description of Object Link</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="40"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="STATUS" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Status of Link</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="1"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="EQVON" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Link from equipment</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="18"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="EQNACH" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Link to equipment</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="18"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="vehicle_partner_functions">
		<xsd:annotation>
			<xsd:documentation>Equipment Partner Functions</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="PARVW" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Partner Function</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="2"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="I_PARNR" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Partner</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="12"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="vehicle_transportation_planning_point">
		<xsd:annotation>
			<xsd:documentation>Transportation planning points</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="TPLST" minOccurs="0">
				<xsd:annotation>
					<xsd:documentation>Transportation planning point</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="4"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
</xsd:schema>
