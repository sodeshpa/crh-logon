                                <xsd:maxLength value="31"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="INTAD" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>Internet address of partner company clerk</xsd:documentation>
                        </xsd:annotation>
