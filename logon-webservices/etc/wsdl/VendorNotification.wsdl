                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="XEDIP" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>Indicator: Send Payment Advices by EDI</xsd:documentation>
                        </xsd:annotation>
