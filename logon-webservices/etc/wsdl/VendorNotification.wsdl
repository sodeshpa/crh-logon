                                <xsd:maxLength value="4"/>
                            </xsd:restriction>
                        </xsd:simpleType>
                    </xsd:element>
                    <xsd:element name="TLFXS" minOccurs="0">
                        <xsd:annotation>
                            <xsd:documentation>Accounting clerk's fax number at the customer/vendor</xsd:documentation>
                        </xsd:annotation>
