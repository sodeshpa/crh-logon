				<include name="**/*.java" />
			</fileset>
	</copy>
    </target>

    <target name="ddl-checkUptodate">
        <fileset id="xsd-files" dir="${xsd.dir}">
    		<include name="*.xsd" />
    	</fileset>
        <uptodate property="ddl-isUptodate" targetfile="${etc.entities.dir}/${ddl.file.name}">
            <srcfiles refid="xsd-files" />
        </uptodate>
        <echo message="checking against: ${etc.entities.dir}/${ddl.file.name}"/>
        <echo>${ddl-isUptodate}</echo>
    </target>

	<target name="generate-ddl" depends="init, ddl-checkUptodate" unless="ddl-isUptodate">
		<mkdir dir="${generated.ddl.dir}" />
		<mkdir dir="${generated.ddl.stage.dir}" />

		<copy toDir="${generated.ddl.stage.dir}">
			<fileset dir="${classes.origentities.dir}"/>
		</copy>

		<copy toDir="${generated.ddl.stage.dir}">
			<fileset dir="${resources.src.dir}" includes="**/persistence.xml" />
		</copy>

		<jar destfile="${webservices.ent.jar.tmp.loc}">
		    <fileset dir="${generated.ddl.stage.dir}" />
		</jar>

		<taskdef name="hibernatetool" classname="org.hibernate.tool.ant.HibernateToolTask"
			classpathref="hibernate.tools.classpath" />

		<hibernatetool destdir="${generated.ddl.dir}">
			<jpaconfiguration persistenceunit="logon-sapdata"/>
			<classpath>
				<path location="${webservices.ent.jar.tmp.loc}" />
				<path location="etc/cfg" />
			</classpath>
			<hbm2ddl export="false" create="true" outputfilename="${ddl.temp.file.name}" delimiter=";" />
		</hibernatetool>

		<delete dir="${generated.ddl.stage.dir}" />
		<concat destfile="${etc.entities.dir}/${ddl.file.name}">
			<path>
				<pathelement location="${etc.entities.dir}/README.basictables" />
				<pathelement location="${generated.ddl.dir}/${ddl.temp.file.name}" />
			</path>
			<filterchain>
				<scriptfilter language="javascript"><![CDATA[

					var lastline = new String(self.getToken());

					if (lastline.length > 2400) {
						var splitat;
						var fullline = "";

						do {
							splitat = lastline.substring(0, 2400).lastIndexOf(" ");
							fullline += lastline.substring(0, splitat) + "\n";
							lastline = lastline.substring(splitat, lastline.length);
						} while (lastline.length > 2400)

						fullline += lastline;
						self.setToken(fullline);
					}
		    	]]></scriptfilter>
			</filterchain>
		</concat>
		<echo message="SQL-script generated: ${etc.entities.dir}/${ddl.file.name}" />
	</target>

    <target name="generateXsd2wsdlTD">
        <java classname="ch.nevis.gdi.main.TemplateDesigner"
            fork="true" failonerror="true" newenvironment="true">
