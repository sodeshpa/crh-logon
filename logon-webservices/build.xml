<!-- Set project name to project's cvs module name, as project name will
     be used for toolbox scope checks -->

<project name="logon" default="dist" basedir=".">
    <description>${ant.project.name} project build file</description>

    <!-- ================================================================= -->
    <!-- === externally defined                                        === -->
    <!-- ================================================================= -->
    <import file="properties.xml"/>
    <import file="../common.xml"/>

    <!-- ================================================================= -->
    <!-- === maven like dependencies                                   === -->
    <!-- ================================================================= -->
    <import file="${AAL_HOME}/aal/aal-maven.xml"/>
    <import file="./build-deps.xml"/>
    <path id="eclipse.lib.classpath">
        <path refid="logon-mavendeps.compile.classpath"/> <!-- maven libs -->
    </path>

    <!-- ================================================================ -->
    <!--  define target specific classpaths (build, runtime, test)        -->
    <!-- ================================================================ -->
	<path id="axis2.classpath">
		<fileset dir="${AXIS2_HOME}/lib">
			<include name="*.jar"/>
		</fileset>
	</path>

	<path id="hyperjaxb3.classpath">
        <fileset dir="${HYPERJAXB3_HOME}/dist-src/lib">
            <include name="commons-lang-*.jar"/>
            <include name="jaxb-api-*.jar"/>
            <include name="runtime-*.jar"/>

            <include name="persistence-api-*.jar"/>
            <include name="hyperjaxb3-ejb-runtime-*.jar"/>

			<include name="junit-*.jar"/>
            <include name="hyperjaxb3-ejb-roundtrip-*.jar"/>
        </fileset>
    </path>

    <path id="hibernate.tools.classpath">
        <fileset dir="${HIBERNATE_TOOLS_HOME}/dist-bin/plugins/org.hibernate.eclipse_3.2.4.CR1-R200812191611/lib">
            <include name="**/*.jar" />
        </fileset>
        <fileset file="${commons-logging.jar}" />
		<fileset file="${oracle.jar}"/>
		<path refid="hyperjaxb3.classpath" />
    </path>

    <path id="compile.classpath">
        <pathelement location="${jcan-log.jar}" />
        <pathelement location="${log4j.jar}" />
		<path refid="axis2.classpath" />
        <pathelement location="etc/cfg" />
        <pathelement location="${hibernate-jpa2.jar}"/>
    	<pathelement location="${hibernate4.jar}"/>

        <pathelement location="${ejb3-persistence.jar}" />
        <pathelement location="${project-common.jar.loc}"/>
        <pathelement location="${project-business-client.jar.loc}"/>
        <pathelement location="${jcan-optrace.jar}"/>
    	<pathelement location="${picketbox.jar}"/>
    	<path refid="logon-mavendeps.compile.classpath"/>
    </path>

    <path id="ejbs.classpath">
    	<pathelement location="${jboss7-transaction.jar}"/>
        <pathelement location="${ejb3-persistence.jar}"/>

        <pathelement location="${jcan-log.jar}"/>
    	<pathelement location="${jcan-print.jar}"/>
        <pathelement location="${log4j.jar}"/>
        <pathelement location="${project-common.jar.loc}"/>
        <pathelement location="${project-business-client.jar.loc}"/>
        <pathelement location="${project-persistence.jar.loc}" />
    	<path refid="logon-mavendeps.compile.classpath"/>
    </path>

    <path id="xjc.classpath">
	    <pathelement location="${jcan-log.jar}" />
	    <fileset dir="${HYPERJAXB3_HOME}/dist-src/lib">
			<include name="*.jar"/>
	    </fileset>
    </path>

    <path id="testclient.runtime.classpath">
    	<fileset file="${jcan-log.jar}"/>
    	<fileset file="${commons-cli.jar}"/>
    	<fileset file="${commons-beanutils.jar}"/>
		<fileset file="${project-common.jar.loc}"/>
		<fileset file="${xmlbeans.logon.jar.loc}"/>
        <fileset dir="${HYPERJAXB3_HOME}/dist-src/lib">
			<include name="commons-lang-*.jar"/>
			<include name="jaxb-api-*.jar"/>
			<include name="runtime-*.jar"/>
			<include name="persistence-api-*.jar"/>
			<include name="hyperjaxb3-ejb-runtime-*.jar"/>
			<include name="junit-*.jar"/>
			<include name="hyperjaxb3-ejb-roundtrip-*.jar"/>
		</fileset>
		<fileset dir="${AXIS2_HOME}/lib">
			<include name="*.jar"/>
		</fileset>
	</path>

    <!-- ================================================================ -->
    <!--  initialization, cleanup and default targets                     -->
    <!-- ================================================================ -->
    <target name="all" depends="dist"
            description="build and test everything"/>

    <target name="toolbox-checkUptodate">
        <uptodate property="toolbox-isUptodate" targetfile=".classpath">
            <srcfiles refid="toolbox-sourcefiles"/>
        </uptodate>
    </target>

    <target name="toolbox" depends="toolbox-checkUptodate" unless="toolbox-isUptodate">
        <taskdef resource="adnant-taskdefs.xml"/> <!-- See documentation in adnant project's README -->

        <updatedotclasspath>
                <!-- See documentation of 'updatedotclasspath' in adnant project's README -->
            <con path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
            <output path=".bin"/>
            <src path="/logon-common"/>
            <src path="/logon-common-web"/>
            <src path="/logon-business"/>
            <src path="/logon-persistence"/>
            <src path="${java.src.dir.name}"/>
        	<src path="${build.dir.name}/${generated.dir.name}/client/src"/>
            <src path="${build.dir.name}/generated/gdi/services/src"/>
            <src path="${build.dir.name}/generated/gdi/mapper/src"/>
            <src path="src/ext/java"/>
            <src path="src/test/testclient/src"/>
            <src path="src/test/integration" />
        	<lib path="${AXIS2_HOME}/lib/wsdl4j-1.6.2.jar" />
        	<lib path="${HYPERJAXB3_HOME}/dist-src/lib/jaxb-impl-2.1.6.jar" />
            <lib path="${HYPERJAXB3_HOME}/dist-src/lib/jaxb-xjc-2.1.6.jar" />
            <lib path="${HYPERJAXB3_HOME}/dist-src/lib/hyperjaxb3-ejb-plugin-0.3.jar" />
            <lib path="${HYPERJAXB3_HOME}/dist-src/lib/hyperjaxb3-ejb-runtime-0.3.jar" />
            <lib path="${adntrace2-templates.jar}" sourcepath="${masterbuild.dir}/etc/adntrace2"/>
            <lib path="${xmlbeans.logon.jar.loc}" />
            <var pathref="eclipse.lib.classpath" />
        </updatedotclasspath>
    </target>

    <target name="init" depends="toolbox"
            description="initialization project structure and environment">
        <tstamp/>
        <echo message="--------- ${ant.project.name}-${build.version} building on ${os.name} ---------"/>
        <echo message=" "/>
        <echo message="building file ${ant.file} with ${ant.version}"/>
        <echo message=""/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${classes.dir}/utils"/>
        <mkdir dir="${classes.service.dir}"/>
		<mkdir dir="${classes.client.dir}"/>
		<mkdir dir="${classes.origentities.dir}"/>
		<mkdir dir="${classes.ejbs.dir}"/>
		<mkdir dir="${ext.dir}"/>
		<mkdir dir="${endorsed.jars.dir}"/>
        <mkdir dir="${lib.dir}"/>
        <mkdir dir="${test.build.dir}"/>
        <mkdir dir="${test.log.dir}"/>
        <mkdir dir="${test.lib.dir}"/>
    	<mkdir dir="${build.dir.name}/${generated.dir.name}/client/src"/>
		<mkdir dir="${generated.src.dir}" />
    </target>

    <target name="clean" depends="clean-generated-service, clean-generated-client, clean-generated-entities"
            description="cleans all generated files and directories" >
        <delete dir="${build.dir}"/>
    </target>

    <target name="clean-generated-service" description="cleans all files and directories generated for the service." >
        <delete dir="${generated.ser.dir}"/>
    </target>

    <target name="clean-generated-client" description="cleans all files and directories generated for the client" >
        <delete dir="${generated.cli.dir}"/>
    </target>

    <target name="clean-generated-entities" description="cleans all files and directories generated for the entities." >
        <delete dir="${generated.ent.dir}"/>
        <delete dir="${generated.ddl.dir}"/>
        <delete dir="${generated.xsd.dir}"/>
    </target>


    <!-- ================================================================ -->
    <!--  compile targets                                                 -->
    <!-- ================================================================ -->
    <target name="build" depends="build-ejbs, build-webservices"
            description="build target" />

	<target name="build-ejbs" depends="init, jars-ejbs" />

	<target name="compile" depends="compile-service">
        <javac
            source="${compile.source}"
            target="${compile.target}"
            destdir="${classes.dir}/utils"
            debug="${compile.debug}"
            optimize="${compile.optimize}"
            deprecation="${compile.deprecation}"
            encoding="${compile.encoding}"
            includeantruntime="no">
	        <src path="${java.src.dir}"/>
            <include name="**/ImportStarter.java"/>
            <include name="**/PdaSessionCleaner.java"/>
            <bootclasspath refid="compile.bootclasspath"/>
            <classpath refid="compile.classpath"/>
            <classpath location="${classes.ejbs.dir}"/>
            <compilerarg line="-processor ch.adnovum.jcan.log.adntrace8.AdnTraceProcessor"/>
        </javac>
    </target>

    <target name="compile-check-client" depends="init">
        <available classpathref="compile.classpath" property="xbeans.available" classname="org.apache.xmlbeans.XmlObject"/>
        <available classpathref="compile.classpath" property="stax.available" classname="javax.xml.stream.XMLStreamReader"/>
        <available classpathref="compile.classpath" property="axis2.available" classname="org.apache.axis2.engine.AxisEngine"/>
        <condition property="required.jars.available">
            <and>
                <isset property="xbeans.available"/>
                <isset property="stax.available"/>
                <isset property="axis2.available"/>
            </and>
        </condition>
        <echo message="XmlBeans Availability = ${xbeans.available}"/>
        <echo message="Stax Availability= ${stax.available}"/>
        <echo message="Axis2 Availability= ${axis2.available}"/>
    </target>

	<target name="check-compile-skeleton">
		<echo>Checking compilation for webservice: ${wsdl.id}</echo>
		<echo>                            against: ${classes.dir}/${wsdl.id}-compilation.status</echo>
		<fileset id="skeleton-sourcefiles" dir="${basedir}">
			<include name="${java.src.dir.name}/com/crh/logon/webservices/${wsdl.id}/**/*.java" />
	    	<include name="${java.src.dir.name}/com/crh/logon/exception/*.java" />
	    	<include name="${java.src.dir.name}/com/crh/logon/utils/*.java" />
	    	<include name="${build.dir.name}/${generated.dir.name}/${service.dir.name}/status" />
		</fileset>
		<uptodate property="compile-skeleton-isUptodate" targetfile="${classes.dir}/${wsdl.id}-compilation.status">
            <srcfiles refid="skeleton-sourcefiles"/>
        </uptodate>
		<echo>       compile-skeleton-isUptodate: ${compile-skeleton-isUptodate}</echo>
		<!-- pathconvert property="sfiles" refid="skeleton-sourcefiles" pathsep="; ">
			<flattenmapper />
		</pathconvert>
		<echo message="Files to compile:" />
		<echo message="${sfiles}" / -->
	</target>

    <target name="compile-skeleton" depends="check-compile-skeleton" unless="compile-skeleton-isUptodate">
		<echo message="---------  Compiling skeleton for ${wsdl.name} ---------" />
		<mkdir dir="${classes.service.dir}/${wsdl.id}" />
    	<loadfile srcFile="${wsdl.dir}/${wsdl.name}" property="referencedMappers">
		    <filterchain>
				<tokenfilter>
					<containsregex
						pattern="^.*&lt;xsd:complexType[^>]+name=&quot;([^&quot;]+)&quot;.*$"
						replace="\1" flags="gi"/>
					<deletecharacters chars="_"/>
				</tokenfilter>
		    </filterchain>
    	</loadfile>

		<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>
    	<mkdir dir="${generated.ser.dir}/${wsdl.id}/src/com/crh/logon/webservices/mapper/" />
    	<for list="${referencedMappers}" param="referencedMapper" parallel="true" delimiter="${line.separator}">
    		<sequential>
    			<copy toDir="${generated.ser.dir}/${wsdl.id}/src">
					<fileset dir="${generated.dir}/gdi/mapper/src" casesensitive="no">
						<include name="**/*@{referencedMapper}*.java" />
					</fileset>
				</copy>
			</sequential>
		</for>
    	<javac
    		source="${compile.source}"
    		target="${compile.target}"
    		destdir="${classes.service.dir}/${wsdl.id}"
    		debug="${compile.debug}"
    		optimize="${compile.optimize}"
    		deprecation="off"
    		encoding="${compile.encoding}"
    		includeantruntime="no">
	    	<src path="${java.src.dir}/com/crh/logon/webservices/${wsdl.id}" />
	    	<src path="${java.src.dir}/com/crh/logon/exception" />
	    	<src path="${java.src.dir}/com/crh/logon/utils" />
	    	<src path="${generated.ser.dir}/${wsdl.id}/src" />
	    	<bootclasspath refid="compile.bootclasspath"/>
	    	<classpath refid="compile.classpath"/>
	    	<classpath refid="hyperjaxb3.classpath"/>
	    	<classpath location="${webservices.ejbs.jar.loc}"/>
    	</javac>
		<echo message="compiled" file="${classes.dir}/${wsdl.id}-compilation.status" />
    </target>

	<target name="compile-service">
		<get-wsdl-list />

		<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>

		<!-- foreach list="${wsdl.names}" delimiter="; "
			target="compile-skeleton" param="wsdl.name" / -->
		<for list="${wsdl.names}" delimiter="; " param="wsdl.name">
			<sequential>
				<get-wsdl-id wsdlName="@{wsdl.name}" />
				<antcall target="compile-skeleton" inheritall="true">
					<param name="wsdl.name" value="@{wsdl.name}" />
					<param name="wsdl.id" value="${wsdl.id}" />
				</antcall>
			</sequential>
		</for>
    </target>

    <target name="compile-ejbs" depends="generateServices, generateMapper">
	    <javac
	        source="${compile.source}"
	        target="${compile.target}"
	        destdir="${classes.ejbs.dir}"
	        debug="${compile.debug}"
	        optimize="${compile.optimize}"
	        deprecation="${compile.deprecation}"
	        encoding="${compile.encoding}"
	        includeantruntime="no">
	        <src path="${java.src.dir}"/>
	        <src path="${generated.dir}/gdi/services/src"/>
	        <include name="**/services/**/*.java"/>
	        <include name="**/persistence/**/*.java"/>
	        <bootclasspath refid="compile.bootclasspath"/>
	        <classpath refid="ejbs.classpath" />
	        <classpath refid="hyperjaxb3.classpath" />
	    </javac>
    </target>

	<target name="compile-entities" depends="generateMovepkg">
        <javac
            source="${compile.source}"
            target="${compile.target}"
            destdir="${classes.origentities.dir}"
            debug="${compile.debug}"
            optimize="${compile.optimize}"
            deprecation="${compile.deprecation}"
            encoding="${compile.encoding}"
            includeantruntime="no">
            <src path="${generated.ent.src.dir}"/>
            <include name="**/*.java"/>
            <bootclasspath refid="compile.bootclasspath"/>
            <classpath refid="hyperjaxb3.classpath" />
        </javac>
    </target>

    <!-- ================================================================ -->
    <!--  java archives (JARs)                                            -->
    <!-- ================================================================ -->
	<target name="jars" depends="jars-service" />

	<target name="jar-service">
    	<echo message="---------  Creating AAR for ${wsdl.name} ---------" />
		<get-wsdl-id wsdlName="${wsdl.name}" />
    	<copy toDir="${classes.service.dir}/${wsdl.id}/META-INF" failonerror="false">
    		<fileset dir="${generated.ser.dir}/${wsdl.id}/${resources.dir.name}">
    			<include name="*.xml"/>
    			<include name="*.wsdl"/>
    			<include name="*.xsd"/>
    			<exclude name="**/schemaorg_apache_xmlbean/**"/>
    		</fileset>
    	</copy>
    	<jar destfile="${lib.dir}/logon-${wsdl.id}.aar">
    		<fileset dir="${classes.service.dir}/${wsdl.id}">
    			<exclude name="**/client"/>
    			<exclude name="**/client/**/*.class"/>
    			<exclude name="**/Test.class"/>
    		</fileset>
    	</jar>
    </target>

	<target name="jars-service" depends="compile">
    	<get-wsdl-list />

		<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>

		<foreach list="${wsdl.names}" delimiter="; "
			target="jar-service" param="wsdl.name" />
	</target>

    <target name="jars-ejbs" depends="compile-ejbs">
		<jar destfile="${webservices.ejbs.jar.loc}">
		    <fileset dir="${classes.ejbs.dir}" />
            <fileset dir="${resources.src.dir}">
                <exclude name="**/WEB-INF/**" />
            </fileset>
		</jar>
    </target>

	<target name="collect-sources-for-xmlbeans-jar">
    	<echo message="---------  Collecting files for ${wsdl.name} ---------" />
		<get-wsdl-id wsdlName="${wsdl.name}" />
    	<copy toDir="${xmlbeans.stage.dir}" includeEmptyDirs="false">
    		<fileset dir="${classes.service.dir}/${wsdl.id}">
                <exclude name="**/mapper/*.*"/>
                <exclude name="**/skeleton/*.*"/>
                <exclude name="**/META-INF/*.*"/>
		    </fileset>
		    <fileset dir="${generated.ser.dir}/${wsdl.id}/resources">
                <exclude name="**/services.xml"/>
                <exclude name="**/*.xsd"/>
		    </fileset>
    	</copy>
    </target>

    <target name="jars-xmlbeans" depends="check-jars-xmlbeans" unless="jars-xmlbeans-isUptodate">
	    <mkdir dir="${xmlbeans.stage.dir}" />
    	<get-wsdl-list />

		<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>

		<foreach list="${wsdl.names}" delimiter="; "
			target="collect-sources-for-xmlbeans-jar" param="wsdl.name" />

		<echo message=""/>
		<jar destfile="${xmlbeans.logon.jar.loc}">
		    <fileset dir="${xmlbeans.stage.dir}/" />
		</jar>
		<echo message="${xmlbeans.logon.jar.loc} has been created." />
		<delete dir="${xmlbeans.stage.dir}" />
    </target>

	<target name="check-jars-xmlbeans">
		<echo>checking against: ${xmlbeans.logon.jar.loc}</echo>
		<uptodate property="jars-xmlbeans-isUptodate" targetfile="${xmlbeans.logon.jar.loc}"
				  srcfile ="${generated.ser.dir}/status" />
		<echo>jars-xmlbeans-isUptodate: ${jars-xmlbeans-isUptodate}</echo>
	</target>


    <!-- ================================================================= -->
    <!-- === generator                                                 === -->
    <!-- ================================================================= -->
    <target name="webservice-server-checkUptodate">
		<fileset id="wsdl-files" dir="${wsdl.dir}">
			<include name="**/*.wsdl"/>
		</fileset>

        <uptodate property="webservice-server-isUptodate" targetfile="${generated.ser.dir}/status">
            <srcfiles refid="wsdl-files"/>
        </uptodate>
        <echo>checking against: ${generated.ser.dir}/status</echo>
        <echo>webservice-server-isUptodate: ${webservice-server-isUptodate}</echo>
    </target>

    <target name="generate-internal-wsdl">
		<copy toDir="${generated.wsdl.dir}">
			<fileset dir="${wsdl.dir}">
				<include name="**/*.wsdl" />
			</fileset>
		</copy>

		<echo message="host: ${webservices.host.url}" />

    	<!-- replace webservice host by an ant property -->
        <replaceregexp byline="true" encoding="utf-8" flags="g">
        	<regexp pattern="(&lt;soap:address location=&quot;)(https://logon.intranet-che)" />
        	<substitution expression="\1${webservices.host.url}"/>
			<fileset dir="${generated.wsdl.dir}" includes="**/*.wsdl" />
		</replaceregexp>
    </target>

    <target name="generate-empty-skeleton">
		<echo message="---------  Generating empty skeleton for ${wsdl.name} ---------" />
		<get-wsdl-id wsdlName="${wsdl.name}" />
		<mkdir dir="${generated.ser.dir}/${wsdl.id}" />
		<java classname="org.apache.axis2.wsdl.WSDL2Java" fork="true" failonerror="true"
			classpathref="compile.classpath">
			<arg line="-uri ${generated.wsdl.dir}/${wsdl.name}" />
			<arg line="-s" />
			<arg line="-ss" />
			<arg line="-sd" />
			<arg line="-ssi" />
			<arg line="-ap" />
			<arg line="-ns2p http://logon.intranet-che/logon=${webservices.package.prefix}.${wsdl.id}.documents"/>
			<arg line="-l java" />
			<arg line="-p ${webservices.package.prefix}.${wsdl.id}.skeleton" />
			<arg line="-d xmlbeans" />
			<arg line="-or" />
			<arg line="-o ${generated.ser.dir}/${wsdl.id}" />
		</java>
		<delete>
			<fileset dir="${generated.ser.dir}/${wsdl.id}" includes="**/*Skeleton*.java"/>
		</delete>
	</target>

	<target name="generate-service-skeleton" depends="init, webservice-server-checkUptodate" unless="webservice-server-isUptodate">
		<get-wsdl-list />

		<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>

		<foreach list="${wsdl.names}" delimiter="; "
			target="generate-empty-skeleton" param="wsdl.name" />

		<echo message="generated" file="${generated.ser.dir}/status" />
    </target>

    <target name="generateMapperTD">
        <java classname="ch.nevis.gdi.main.TemplateDesigner"
            fork="true" failonerror="true" newenvironment="true">
            <classpath refid="gdi.classpath"/>
            <arg line="${etc.dir}/gdi/mapper ${java.src.dir}/com/crh/logon/persistence/entities/sapdata ${generated.dir}/gdi/td/mapper"/>
        </java>
    </target>

    <target name="generateMapper">
    	<gditask classpathref="gdi.classpath"
             cartridgePath="${etc.dir}/gdi/mapper"
             outputPath="${generated.dir}/gdi/mapper">
			<input>
				<fileset dir="${java.src.dir}/com/crh/logon/persistence/entities/sapdata"/>
		    </input>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
        </gditask>
        <delete>
			<fileset dir="${generated.dir}/gdi/mapper" includes="**/*ObjectFactory*.java" />
        </delete>
    </target>

    <target name="generateServices">
    	<gditask classpathref="gdi.classpath"
             cartridgePath="${etc.dir}/gdi/services"
             outputPath="${generated.dir}/gdi/services">
			<input>
				<fileset dir="${wsdl.dir}"/>
		    </input>
			<systemproperty name="allfiles" value="true"/>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
    		<properties>
    			<fileset file ="${etc.dir}/movepkg.properties"/>
    			<fileset file ="${etc.dir}/cfg/sap_abbrev.properties"/>
    			<fileset file ="${all.properties}"/>
    		</properties>
        </gditask>
    </target>

    <target name="generateServicesTD">
        <java classname="ch.nevis.gdi.main.TemplateDesigner"
            fork="true" failonerror="true" newenvironment="true">
            <classpath refid="gdi.classpath"/>
            <jvmarg value="-Dallfiles=true"/>
           <arg line="${etc.dir}/gdi/services ${wsdl.dir} ${generated.dir}/gdi/td/services etc/movepkg.properties ${all.properties}"/>
        </java>
    </target>

    <target name="generate-internal-xsd">

    	<copy toDir="${generated.xsd.dir}" overwrite="yes">
			<fileset dir="${xsd.dir}">
				<include name="*" />
			</fileset>
		</copy>

    	<!-- add internal technical fields to xsds for logon usage (timestamp, etc.) -->
        <replaceregexp byline="false" encoding="utf-8">
        	<regexp pattern="(([\r\n\t ]*)(&lt;/xsd:sequence&gt;)([\r\n\t ]*)(&lt;/xsd:complexType&gt;))"/>
        	<substitution expression="\2&lt;xsd:element name=&quot;sapimp_imported_dat&quot; id=&quot;sapimp_imported_dat&quot; type=&quot;xsd:dateTime&quot; minOccurs=&quot;0&quot; /&gt;\2&lt;xsd:element name=&quot;sapimp_propagated_dat&quot; id=&quot;sapimp_propagated_dat&quot; type=&quot;xsd:dateTime&quot; minOccurs=&quot;0&quot; /&gt;\2&lt;xsd:element name=&quot;sapimp_status_cd&quot; id=&quot;sapimp_status_cd&quot; minOccurs=&quot;0&quot;&gt;&lt;xsd:simpleType&gt;&lt;xsd:restriction base=&quot;xsd:integer&quot;&gt;&lt;xsd:totalDigits value=&quot;2&quot;/&gt;&lt;/xsd:restriction&gt;&lt;/xsd:simpleType&gt;&lt;/xsd:element&gt;\2&lt;xsd:element name=&quot;sapimp_err_msg&quot; id=&quot;sapimp_err_msg&quot; minOccurs=&quot;0&quot;&gt;&lt;xsd:simpleType&gt;&lt;xsd:restriction base=&quot;xsd:string&quot;&gt;&lt;xsd:maxLength value=&quot;200&quot;/&gt;&lt;/xsd:restriction&gt;&lt;/xsd:simpleType&gt;&lt;/xsd:element&gt;\1"/>
			<fileset dir="${generated.xsd.dir}" includes="*.xsd" />
		</replaceregexp>
    </target>

    <target name="generate-entities" depends="generate-internal-xsd">
		<mkdir dir="${generated.ent.src.dir}" />

    	<javac
	        source="${compile.source}"
	        target="${compile.target}"
	        destdir="${ext.dir}"
	    	srcdir="${src.dir.name}/ext/java"
	        debug="${compile.debug}"
	        optimize="${compile.optimize}"
	        deprecation="${compile.deprecation}"
	        encoding="${compile.encoding}"
	        includeantruntime="no"
    		classpathref="xjc.classpath"/>

    	<copy todir="${ext.dir}" >
    		<fileset dir="${src.dir.name}/ext/resources"/>
    	</copy>

		<jar destfile="${ext.dir}/hyperjaxb3-ejb-deterministic.jar">
		    <fileset dir="${ext.dir}">
				<exclude name="hyperjaxb3-ejb-deterministic.jar"/>
		    </fileset>
		</jar>

		<taskdef name="xjc" classname="com.sun.tools.xjc.XJC2Task">
            <classpath>
                <pathelement location="${ext.dir}/hyperjaxb3-ejb-deterministic.jar" />
            	<path refid="xjc.classpath" />
            </classpath>
        </taskdef>

		<xjc destdir="${generated.ent.src.dir}" extension="true">
		    <arg line="
		    	-nv
		    	-p com.crh.logon.sapdata.request
		        -Xequals
		        -XhashCode
		        -XtoString
		        -Xhyperjaxb3-ejb-roundtripTestClassName=RoundtripTest
		        -Xhyperjaxb3-ejb"/>
			<binding dir="${generated.xsd.dir}">
				<include name="*.xjb"/>
			</binding>
		    <schema dir="${generated.xsd.dir}">
		        <include name="*.xsd"/>
		    </schema>
		</xjc>
    </target>

    <target name="entities-checkUptodate">
    	<!-- fileset id="entities" dir="${java.src.dir}">
    		<include name="**/persistence/**/*.java" />
    	</fileset>
        <uptodate property="entities-isUptodate">
            <srcfiles refid="entities" />
            <mapper type="merge" to="${xsd.dir}" />
        </uptodate>
        <echo>checking against: ${xsd.dir}/*.xsd</echo -->
    </target>

    <target name="generate-entities-main" depends="entities-checkUptodate" unless="entities-isUptodate">
