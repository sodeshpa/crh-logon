    <!-- ================================================================ -->
    <!--  Axis2 specific targets                                          -->
    <!-- ================================================================ -->
	<target name="axis-checkUptodate">
		<fileset id="lib-files" dir="${lib.dir}">
			<exclude name="${webservices.client.jar.name}" />
		</fileset>
		<uptodate property="axis-isUptodate" targetfile="${axis2.stage.dir}/WEB-INF/services/services.list">
			<srcfiles dir="${etc.dir}/axis2">
				<include name="axis2_template.xml"/>
			</srcfiles>
			<srcfiles refid="lib-files" />
		</uptodate>
		<echo>axis-isUptodate: ${axis-isUptodate}</echo>
	</target>

	<target name="axis2-init" depends="axis-checkUptodate" unless="axis-isUptodate">
		<echo message="--------- Initialization of Axis2 WebApplication ---------" />
		<mkdir dir="${axis2.stage.dir}" />
		<copy toDir="${axis2.stage.dir}">
            <fileset dir="${AXIS2_HOME}/webapp">
                <include name="**/**" />
                <exclude name="**/web.xml"/>
                <exclude name="**/log4j.properties"/>
            </fileset>
        </copy>

		<!-- Copying the axis2 repository from ../repository -->
		<copy toDir="${axis2.stage.dir}/WEB-INF">
		    <fileset dir="${AXIS2_HOME}/repository">
		        <include name="**/**" />
		    </fileset>
		</copy>

		<!-- Copying the webservices -->
		<copy toDir="${axis2.stage.dir}/WEB-INF/services">
		    <fileset dir="${lib.dir}">
		        <include name="*.aar" />
		    </fileset>
		</copy>

		<!-- Creating the services.list -->
		<path id="services.archives">
		    <fileset dir="${axis2.stage.dir}/WEB-INF/services">
		        <include name="*.aar" />
		    </fileset>
		</path>
		<pathconvert pathsep="${line.separator}" property="echo.services.archives" refid="services.archives">
		    <flattenmapper />
		</pathconvert>
		<echo file="${axis2.stage.dir}/WEB-INF/services/services.list" message="${echo.services.archives}" />

		<!-- Creating the modules.list -->
		<path id="modules.archives">
		    <fileset dir="${axis2.stage.dir}/WEB-INF/modules">
		        <include name="*.mar" />
		    </fileset>
		</path>
		<pathconvert pathsep="${line.separator}" property="echo.modules.archives" refid="modules.archives">
		    <flattenmapper />
		</pathconvert>
		<echo file="${axis2.stage.dir}/WEB-INF/modules/modules.list" message="${echo.modules.archives}" />

		<!-- Setting properties for axis2.xml -->
		<mkdir dir="${axis2.stage.dir}/WEB-INF/conf" />
		<copy file="${etc.dir}/axis2/axis2_template.xml" toFile="${axis2.stage.dir}/WEB-INF/conf/axis2.xml">
		    <filterchain>
				<expandproperties />
		    </filterchain>
		</copy>
	</target>

    <target name="war-checkUptodate">
        <uptodate property="war-isUptodate" targetfile="${war.dir}/${project-webservices.war.name}">
            <srcfiles dir="${axis2.stage.dir}"/>
            <srcfiles file="${xmlbeans.logon.jar.loc}"/>
        </uptodate>
        <echo>checking against: ${war.dir}/${project-webservices.war.name}</echo>
	<echo>war-isUptodate: ${war-isUptodate}</echo>
    </target>
<!--  -->
    <target name="build-webservices"
    	depends="generate-internal-wsdl, generate-service-skeleton, generate-client-stub, jars-service, jars-xmlbeans, axis2-init, war-checkUptodate"
    	unless="war-isUptodate">
		<echo message="--------- Building Axis2 WebApplication ---------" />

		<pathconvert property="manifest.classpath" pathsep=" ">
			<path refid="axis2.runtime.classpath"/>
			<mapper>
				<chainedmapper>
					<flattenmapper/>
					<globmapper from="*.jar" to="lib-axis2/*.jar"/>
				</chainedmapper>
			</mapper>
		</pathconvert>
		<mkdir dir="${war.dir}" />
		<war destfile="${war.dir}/${project-webservices.war.name}" webxml="${resources.src.dir}/WEB-INF/web.xml">
			<manifest>
				<attribute name="Class-Path" value="${manifest.classpath}"/>
			</manifest>
            <webinf dir="${axis2.stage.dir}/WEB-INF" />
            <fileset dir="${resources.src.dir}">
				<exclude name="**/META-INF/**" />
            </fileset>
            <classes dir="${classes.dir}/utils"/>
			<classes dir="${classes.ejbs.dir}">
				<include name="**/SapService.java" />
            </classes>
	    	<classes dir="${project-common-web.classes.dir}"/>
			<fileset dir="${project-common-web.resources.dir}"/>
            <lib file="${xmlbeans.logon.jar.loc}"/>
			<lib file="${webservices.ejbs.jar.loc}"/>
		</war>
    </target>

    <target name="axis2-deploy">
		<echo message="--------- Deploying Axis2 with webservices ---------" />
		<unwar src="${war.dir}/${project-webservices.war.name}" dest="${jboss.deploy.dir}/${project-webservices.war.name}" />
        <waitfor maxwait="3" maxwaitunit="minute" checkevery="500">
            <http url="http://localhost:15080/axis2"/>
        </waitfor>
		<echo message="--------- Axis2 Administration: http://localhost:15080/axis2/ ---------" />
    </target>

    <target name="axis2-undeploy">
		<echo message="-------- Undeploying Axis2 with webservices --------" />
		<delete dir="${jboss.deploy.dir}/${project-webservices.war.name}" />
    </target>


