	<macrodef name="get-wsdl-list">
		<sequential>
			<path id="wsdl-files">
				<fileset dir="${generated.wsdl.dir}">
					<include name="*.wsdl" />
				</fileset>
			</path>

			<pathconvert property="wsdl.names" refid="wsdl-files" pathsep="; ">
				<flattenmapper />
			</pathconvert>

			<echo message="WSDL-files to process:" />
			<echo message="${wsdl.names}" />
		</sequential>
	</macrodef>

	<macrodef name="get-wsdl-id">
		<attribute name="wsdlName" />
		<sequential>
			<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>
			<propertyregex property="wsdl.id"
				override="true"
				input="@{wsdlName}"
				regexp="(.*)\.wsdl$"
				select="\1"
				casesensitive="false"/>
		</sequential>
	</macrodef>

