			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
	    </gditask>
        <copy toDir="${xsd.dir}">
        	<fileset dir="${generated.dir}/gdi/cleanxsd" includes="*.xsd" />
        </copy>
    </target>

	<target name="generate-new-entities-and-ddl" depends="init, compile-entities, generate-ddl"
