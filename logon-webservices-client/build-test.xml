	<target name="test-integration" depends="compile-test"
            description="performs integration tests">

		<echo message="current: ${basedir}" />
    	<!-- junit tests -->
	    <junit fork="true" printsummary="true"
	           showoutput="yes" haltonfailure="no"
		       failureproperty="test.integration.failed" dir="${basedir}">
            <sysproperty key="wsclient.parallel.host.url" value="${mockup.parallel.host.url}"/>
            <sysproperty key="wsclient.parallel.nocall" value="${mockup.parallel.host.nocall}"/>
            <sysproperty key="wsclient.parallel.user" value="${mockup.parallel.host.user}"/>
            <sysproperty key="wsclient.parallel.password" value="${mockup.parallel.host.pwd}"/>
            <sysproperty key="wsclient.fsms.host.url" value="${mockup.fsms.host.url}"/>
            <sysproperty key="wsclient.fsms.nocall" value="${mockup.fsms.host.nocall}"/>
            <sysproperty key="wsclient.fsms.user" value="${mockup.fsms.host.user}"/>
            <sysproperty key="wsclient.fsms.password" value="${mockup.fsms.host.pwd}"/>
            <sysproperty key="wsclient.ffax.host.url" value="${mockup.ffax.host.url}"/>
            <sysproperty key="wsclient.ffax.nocall" value="${mockup.ffax.host.nocall}"/>
            <sysproperty key="wsclient.ffax.user" value="${mockup.ffax.host.user}"/>
            <sysproperty key="wsclient.ffax.password" value="${mockup.ffax.host.pwd}"/>
            <sysproperty key="wsclient.parallel.host.name.dotternhausen" value="${mockup.parallel.host.name.dotternhausen}"/>
            <sysproperty key="fullPropertyTracing" value="true"/>
	    	<sysproperty key="wsclient.pda.user" value="${mockup.pda.host.user}"/>
	    	<sysproperty key="wsclient.pda.password" value="${mockup.pda.host.pwd}"/>
	      	<sysproperty key="fullPropertyTracing" value="true"/>
			<formatter type="plain" usefile="false"/>
	        <formatter type="xml" usefile="true"/>
	        <batchtest todir="${test.reports.integration.dir}">
	            <fileset dir="${test.integration.dir}">
	                <include name="**/*Test*.java"/>
                    <exclude name="**/LogonToParallelTestCase.java" />
	                <exclude name="**/BaseClientTestCase.java" />
	            </fileset>
	        </batchtest>
	    	<classpath refid="test.integration.classpath"/>
	    	<!--<jvmarg value="-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=9999"/> -->
	    </junit>
	    <junitreport todir="${test.reports.integration.dir}">
	        <fileset dir="${test.reports.integration.dir}">
	            <include name="TEST-*.xml"/>
	        </fileset>
	            <report format="frames" todir="${test.reports.integration.dir}" styledir="${masterbuild.dir}/test/etc">
	        	    <param name="TESTTYPE" expression="Integration" />
        	    </report> 
	    </junitreport>
        <set-flag-file-if-property-set flagfile="${test.integration.failed.flag}" propertyname="test.integration.failed"
        	message="at least one test failed -> setting failure flag file"/>
		<fail if="test.integration.failed" message="at least one of the tests failed" />
		<echo message="all tests successful"/>
    </target>


	<target name="run-client" depends="jar-testclient" description="build and run test-stub">
		<path id="client.classpath">
