<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema
    targetNamespace="http://logon.holcim.com/LogonLDSInterface/notifications"
    xmlns:tns="http://logon.holcim.com/LogonLDSInterface/notifications"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:losc="http://logon.holcim.com/LogonLDSInterface/common_out">

    <xsd:import namespace="http://logon.holcim.com/LogonLDSInterface/common_out" schemaLocation="LogonLDSInterface_common_out.xsd"/>

    <xsd:element name="pdaLoginRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="losc:request">
                    <xsd:sequence>
                    	<xsd:element name="location" type="losc:locationData"/>
                        <xsd:element name="vehicle" type="losc:vehicleData">
                            <xsd:annotation>
                                <xsd:documentation>Date used to identify the vehicle which has logged in to the LDS.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="pdaLoginResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="losc:response" />
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="loadOrderNotificationRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="losc:request">
                    <xsd:sequence>
                        <xsd:element name="messageFunction">
                            <xsd:annotation>
                                <xsd:documentation>Possible values: new, update</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:enumeration value="new"/>
                                    <xsd:enumeration value="update"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="loadOrder" type="losc:loadOrderData"/>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="loadOrderNotificationResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="losc:response" />
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="deleteLoadOrderRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="losc:request">
                    <xsd:sequence>
                        <xsd:element name="loadOrderId">
                            <xsd:annotation>
                                <xsd:documentation>Uniquely identifies a load order. Guarantees that the same order can be loaded more than once (i.e. in case of re-routing).</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="25"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="deleteLoadOrderResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="losc:response" />
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>
