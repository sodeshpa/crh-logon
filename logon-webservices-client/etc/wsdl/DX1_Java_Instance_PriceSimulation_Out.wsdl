							<xsd:restriction base="xsd:decimal">
								<xsd:totalDigits value="28"/>
								<xsd:fractionDigits value="9"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CURRENCY" minOccurs="0">
