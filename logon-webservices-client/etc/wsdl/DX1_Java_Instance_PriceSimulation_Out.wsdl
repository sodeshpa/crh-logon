<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="PriceSimulation_Out" targetNamespace="urn:ea.crh.net:Sales:PriceSimulation" xmlns:rfc="urn:sap-com:document:sap:rfc:functions" xmlns:p2="urn:sap-com:document:sap:business" xmlns:p1="urn:ea.crh.net:Sales:PriceSimulation" xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy" xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
	<wsdl:documentation/>
	<wsp:UsingPolicy wsdl:required="true"/>
	<wsp:Policy wsu:Id="OP_PriceSimulation_Sync"/>
	<wsdl:types>
		<xsd:schema targetNamespace="urn:sap-com:document:sap:rfc:functions" xmlns="urn:sap-com:document:sap:rfc:functions" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
			<xsd:element name="ZFSD_PRICE_SIMULATION">
				<xsd:complexType>
					<xsd:all>
						<xsd:element name="CALLER" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>Calling system</xsd:documentation>
							</xsd:annotation>
							<xsd:simpleType>
								<xsd:restriction base="xsd:string">
									<xsd:maxLength value="18"/>
								</xsd:restriction>
							</xsd:simpleType>
						</xsd:element>
						<xsd:element name="ZSSD_PS_HEADER" type="ZSSD_PS_HEADER">
							<xsd:annotation>
								<xsd:documentation>Structure price simulation header_in</xsd:documentation>
							</xsd:annotation>
						</xsd:element>
						<xsd:element name="MESSAGETABLE">
							<xsd:annotation>
								<xsd:documentation>Return Parameter</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="BAPIRET2" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_CONDITIONS" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>Structure conditions-in</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_CONDITIONS" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_CONDITIONS_OUT" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>Price simulation</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_CONDITIONS_OUT" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_ITEMS" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>Items-in for price simulation</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_ITEMS" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_PARTNERS" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>PARTNERS_IN price simulation</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_PARTNERS" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_SCALES_OUT" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>SD structure for scales</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_SCALES" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
					</xsd:all>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="ZFSD_PRICE_SIMULATION.Response">
				<xsd:complexType>
					<xsd:all>
						<xsd:element name="ZSSD_PS_HEADER_OUT" type="ZSSD_PS_HEADER_OUT" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>Header out Price simulation</xsd:documentation>
							</xsd:annotation>
						</xsd:element>
						<xsd:element name="MESSAGETABLE">
							<xsd:annotation>
								<xsd:documentation>Return Parameter</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="BAPIRET2" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_CONDITIONS" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>Structure conditions-in</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_CONDITIONS" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_CONDITIONS_OUT" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>Price simulation</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_CONDITIONS_OUT" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_ITEMS" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>Items-in for price simulation</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_ITEMS" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_PARTNERS" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>PARTNERS_IN price simulation</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_PARTNERS" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
						<xsd:element name="ZTSD_PS_SCALES_OUT" minOccurs="0">
							<xsd:annotation>
								<xsd:documentation>SD structure for scales</xsd:documentation>
							</xsd:annotation>
							<xsd:complexType>
								<xsd:sequence>
									<xsd:element name="item" type="ZSSD_PS_SCALES" minOccurs="0" maxOccurs="unbounded"/>
								</xsd:sequence>
							</xsd:complexType>
						</xsd:element>
					</xsd:all>
				</xsd:complexType>
			</xsd:element>
			<xsd:simpleType name="date">
				<xsd:union memberTypes="xsd:date genericDate" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="urn:sap-com:document:sap:rfc:functions"/>
			</xsd:simpleType>
			<xsd:simpleType name="genericDate">
				<xsd:restriction base="xsd:string">
					<xsd:pattern value="....-..-.."/>
				</xsd:restriction>
			</xsd:simpleType>
			<xsd:complexType name="ZSSD_PS_HEADER">
				<xsd:annotation>
					<xsd:documentation>Structure price simulation header_in</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="DOC_TYPE" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Sales Document Type</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="4"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="SALES_ORG" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Sales Organization</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="4"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="DISTR_CHAN" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Distribution Channel</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="DIVISION" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Division</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="SALES_GRP" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Sales Group</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="SALES_OFF" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Sales Office</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="4"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="PRICE_GRP" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Price group (customer)</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CUST_GROUP" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Customer group</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="SALES_DIST" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Sales district</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="6"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="PRICE_LIST" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Price list type</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="PMNTTRMS" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Terms of Payment Key</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="4"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ORD_REASON" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Order reason (reason for the business transaction)</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="PRICE_DATE" type="date" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Date for pricing and exchange rate</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="CUST_GRP1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Split Criteria</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CUST_GRP2" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Customer group 2</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CUST_GRP3" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Invoice Layout</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CUST_GRP4" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Customer group 4</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CUST_GRP5" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Customer group 5</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="DOC_DATE" type="date" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Document Date (Date Received/Sent)</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
					<xsd:element name="SHIP_COND" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Shipping Conditions</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="COMP_CDE_B" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Company code to be billed</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="4"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ALTTAX_CLS" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Alternative tax classification</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAX_CLASS2" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax classification 2 for customer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAX_CLASS3" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax classification 3 for customer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAX_CLASS4" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax Classification 4 Customer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAX_CLASS5" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax classification 5 for customer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAX_CLASS6" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax classification 6 for customer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAX_CLASS7" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax classification 7 for customer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAX_CLASS8" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax classification 8 for customer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAX_CLASS9" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax classification 9 for customer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="PYMT_METH" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Payment Method</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CSTCNDGRP1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Customer condition group 1</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CSTCNDGRP2" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Split contract Bulk / Bag</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CSTCNDGRP3" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Customer condition group 3</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CSTCNDGRP4" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Customer condition group 4</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CSTCNDGRP5" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Customer condition group 5</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="CURRENCY" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>SD Document Currency</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="5"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAXDEP_CTY" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax departure country</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TAXDST_CTY" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Tax destination country</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TRANSPZONE" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Transportation zone to or from which the goods are delivered</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ZZTRAINST" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Train Station</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="6"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="ZSSD_PS_ITEMS">
				<xsd:annotation>
					<xsd:documentation>Items-in for price simulation</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="ITM_NUMBER" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Sales Document Item</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="6"/>
								<xsd:pattern value="\d+"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="MATERIAL" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Material Number</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="18"/>
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="BATCH" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Batch Number</xsd:documentation>
						</xsd:annotation>
