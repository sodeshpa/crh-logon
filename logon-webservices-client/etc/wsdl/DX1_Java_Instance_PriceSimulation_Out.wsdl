									<xsd:element name="MESSAGE_V2" minOccurs="0">
										<xsd:annotation>
											<xsd:documentation>Messages, message variables</xsd:documentation>
										</xsd:annotation>
										<xsd:simpleType>
											<xsd:restriction base="xsd:string">
												<xsd:maxLength value="50"/>
