  <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Webservice to provide fax functionality by using messaging server</wsdl:documentation>
  <wsdl:types>
    <s:schema elementFormDefault="qualified" targetNamespace="http://www.officemaster.de/">
      <s:complexType name="JobFile">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="FileName" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="OrigFileName" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="Stationery1st" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="StationeryOther" type="s:string" />
          <s:element minOccurs="1" maxOccurs="1" name="Stationery1stMerge" type="tns:MergeFlag" />
          <s:element minOccurs="1" maxOccurs="1" name="StationeryOtherMerge" type="tns:MergeFlag" />
          <s:element minOccurs="0" maxOccurs="1" name="JobData" type="s:base64Binary" />
        </s:sequence>
      </s:complexType>
      <s:simpleType name="MergeFlag">
        <s:restriction base="s:string">
          <s:enumeration value="UseOnlyFirstPage" />
          <s:enumeration value="UseAllPages" />
          <s:enumeration value="UseAllRepeatFirstPage" />
          <s:enumeration value="UseAllRepeatLastPage" />
        </s:restriction>
      </s:simpleType>
      <s:complexType name="JobDescription">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="OwnCsid" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="RemoteCsid" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="Header" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="Sender" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="ReceiverName" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="ReceiverNumber" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="JobFiles" type="tns:ArrayOfAnyType" />
          <s:element minOccurs="1" maxOccurs="1" name="Status" type="s:int" />
          <s:element minOccurs="1" maxOccurs="1" name="ErrStatus" type="s:int" />
          <s:element minOccurs="1" maxOccurs="1" name="ErrorCode" type="s:int" />
          <s:element minOccurs="0" maxOccurs="1" name="ErrorStatusText" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="ErrorText" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="JobType" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="ReceiverType" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="JobId" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="SendTime" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="JobStatus" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="NotifyComponent" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="NotifyAddress" type="s:string" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="ArrayOfAnyType">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="unbounded" name="anyType" nillable="true" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="ArrayOfString">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="unbounded" name="string" nillable="true" type="s:string" />
        </s:sequence>
      </s:complexType>
    </s:schema>
  </wsdl:types>
  <wsdl:message name="ErrorTextSoapIn" />
  <wsdl:message name="ErrorTextSoapOut">
    <wsdl:part name="ErrorTextResult" type="s:string" />
  </wsdl:message>
  <wsdl:message name="HelloWorldSoapIn" />
  <wsdl:message name="HelloWorldSoapOut">
    <wsdl:part name="HelloWorldResult" type="s:string" />
  </wsdl:message>
  <wsdl:message name="SendFaxTextSoapIn">
    <wsdl:part name="argsNumber" type="s:string" />
    <wsdl:part name="argsText" type="s:string" />
  </wsdl:message>
  <wsdl:message name="SendFaxTextSoapOut">
    <wsdl:part name="SendFaxTextResult" type="s:boolean" />
    <wsdl:part name="argsJobId" type="s:string" />
  </wsdl:message>
  <wsdl:message name="SendFaxFileSoapIn">
    <wsdl:part name="argsNumber" type="s:string" />
