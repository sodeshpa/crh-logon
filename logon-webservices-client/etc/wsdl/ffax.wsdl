    <wsdl:part name="argsStationeries" type="tns:ArrayOfString" />
  </wsdl:message>
  <wsdl:portType name="FFaxSoap">
    <wsdl:operation name="ErrorText">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Returns ErrorText</wsdl:documentation>
      <wsdl:input message="tns:ErrorTextSoapIn" />
      <wsdl:output message="tns:ErrorTextSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="HelloWorld">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Just returns "Hello World" to show it works</wsdl:documentation>
      <wsdl:input message="tns:HelloWorldSoapIn" />
      <wsdl:output message="tns:HelloWorldSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="SendFaxText">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Send fax by giving number and text</wsdl:documentation>
      <wsdl:input message="tns:SendFaxTextSoapIn" />
      <wsdl:output message="tns:SendFaxTextSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="SendFaxFile">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Send single document fax by giving number, filestream and filename</wsdl:documentation>
      <wsdl:input message="tns:SendFaxFileSoapIn" />
      <wsdl:output message="tns:SendFaxFileSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="SendFax">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Send single document fax by giving number and JobFile description</wsdl:documentation>
      <wsdl:input name="SendFaxJobfile" message="tns:SendFaxJobfileSoapIn" />
      <wsdl:output name="SendFaxJobfile" message="tns:SendFaxJobfileSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="SendJob">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Send multiple document fax by giving a complete Jobdescription</wsdl:documentation>
      <wsdl:input message="tns:SendJobSoapIn" />
      <wsdl:output message="tns:SendJobSoapOut" />
    </wsdl:operation>
    <wsdl:operation name="GetStationeries">
      <wsdl:documentation xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">Returns list of available stationery documents</wsdl:documentation>
      <wsdl:input message="tns:GetStationeriesSoapIn" />
      <wsdl:output message="tns:GetStationeriesSoapOut" />
    </wsdl:operation>
  </wsdl:portType>
