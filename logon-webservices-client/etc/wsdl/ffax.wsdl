  </wsdl:message>
  <wsdl:message name="SendFaxFileSoapOut">
    <wsdl:part name="SendFaxFileResult" type="s:boolean" />
    <wsdl:part name="argsJobId" type="s:string" />
  </wsdl:message>
  <wsdl:message name="SendFaxJobfileSoapIn">
    <wsdl:part name="argsNumber" type="s:string" />
    <wsdl:part name="argoJobFiles" type="tns:JobFile" />
  </wsdl:message>
  <wsdl:message name="SendFaxJobfileSoapOut">
    <wsdl:part name="SendFaxJobfileResult" type="s:boolean" />
    <wsdl:part name="argsJobId" type="s:string" />
  </wsdl:message>
  <wsdl:message name="SendJobSoapIn">
    <wsdl:part name="argoJobDesc" type="tns:JobDescription" />
  </wsdl:message>
