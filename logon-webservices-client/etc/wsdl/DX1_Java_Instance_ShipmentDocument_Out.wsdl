						minOccurs="0" maxOccurs="9" />
					<xsd:element name="shipment_stage_central_address"
						type="shipment_stage_central_address" minOccurs="0" maxOccurs="10" />
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="shipment_control_data">
				<xsd:annotation>
					<xsd:documentation>EDI_DC40</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="MESCOD" minOccurs="0">
