					<xsd:element name="ADDRESS_T" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Addr. type</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1" />
