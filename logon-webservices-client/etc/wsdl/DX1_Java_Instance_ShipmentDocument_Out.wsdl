							<xsd:documentation>Description for supplement 1
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ADD02_BEZEI" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Description of supplement 2
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ADD03_BEZEI" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Description of supplement 3
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ADD04_BEZEI" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Description of supplement 4
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="shipment_stage_addInfo">
				<xsd:annotation>
					<xsd:documentation>Shipment Stage - Additional Info ZE1EDK33
					</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="ZZ_VEHICLE" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Vehicle</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="18" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ZZ_VEHICLE_ID" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Vehicle ID</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ZZ_TRAILER" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Trailer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="18" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ZZ_TRAILER_ID" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Vehicle ID</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="shipment_header_addInfo">
				<xsd:annotation>
					<xsd:documentation>Shipment - Additional info ZE1EDT20
					</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="STATUS_SD" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Version Number Component</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="Z_TKNUMENCRYPTED" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Encrypted shipment document number
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="RPFAR1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Driver 1</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="RPMOWA" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Vehicle</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="18" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="RPANHAE" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Trailer</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="18" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ALLOWED_TWGT" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Allowed total weight of shipment
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="shipment_general_text">
				<xsd:annotation>
					<xsd:documentation>General Text Segment E1TXTP6</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="TDLINE" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Text Line</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="132" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="shipment_reference_number">
				<xsd:annotation>
					<xsd:documentation>IDOC Reference Number E1EDL55
					</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="QUALF" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>IDOC Qualifier Reference Number
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="REFNR" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>35-Character IDOC Reference Number
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="35" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="shipment_transport_additional_data">
				<xsd:annotation>
					<xsd:documentation>IDoc: Transport Additional Data E1EDT47
					</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="ADD01" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Suppl. 1</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ADD02" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Suppl. 2</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ADD03" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Suppl. 3</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ADD04" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Suppl. 4</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TEXT1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Addit.text 1</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TEXT2" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Addit.text 2</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TEXT3" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Addit.text 3</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TEXT4" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Addit.text 4</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="40" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="shipment_transport_additional_data_addInfo"
						type="shipment_transport_additional_data_addInfo" minOccurs="0"
						maxOccurs="9999" />
					<xsd:element name="shipment_transport_additional_data_desc"
						type="shipment_transport_additional_data_desc" minOccurs="0" />
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="shipment_header">
				<xsd:annotation>
					<xsd:documentation>IDoc: Shipment E1EDT20</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="TKNUM">
						<xsd:annotation>
							<xsd:documentation>Shipment Number</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="SHTYP" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Shipment type</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="4" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="VSART" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Shipping type</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="VSBED" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Shipping Conditions</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ROUTE" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Shipment route</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="6" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="SIGNI" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Container ID</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="20" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="EXTI1" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>External identification 1</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="20" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="EXTI2" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>External identification 2</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="20" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="TPBEZ" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Description of Shipment</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="20" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="STTRG" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Overall transportation status
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="DTMEG" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Unit of Weight for Transportation Planning
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="DISTZ" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Distance</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="15" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="MEDST" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Unit of measure for distance
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="3" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="SDABW" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Special processing indicator
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="4" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="FRKRL" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Shipment costs relevance</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="1" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="GESZTD" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Planned total time of transportation (in days)
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="12" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="FAHZTD" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Planned duration of transportation (in
								hours:minutes)</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="12" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="GESZTDA" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Actual total time of shipment (in days)
							</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="12" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="FAHZTDA" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Actual time needed for transporation (in
								hours:minutes)</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="12" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="WARZTD" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Planned waiting time of shipment (in
								hours:minutes)</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="12" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="WARZTDA" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Current waiting time of shipment (in
								hours:minutes)</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="12" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="shipment_audit" type="shipment_audit"
						minOccurs="0" maxOccurs="9999" />
					<xsd:element name="shipment_header_addInfo" type="shipment_header_addInfo"
						minOccurs="0" maxOccurs="9999" />
					<xsd:element name="shipment_central_address" type="shipment_central_address"
						minOccurs="0" maxOccurs="10" />
					<xsd:element name="shipment_date" type="shipment_date"
						minOccurs="0" maxOccurs="999" />
					<xsd:element name="shipment_text_header" type="shipment_text_header"
						minOccurs="0" maxOccurs="99" />
					<xsd:element name="shipment_stage" type="shipment_stage"
						minOccurs="0" maxOccurs="9999" />
					<xsd:element name="shipment_transport_additional_data"
						type="shipment_transport_additional_data" minOccurs="0" />
					<xsd:element name="shipment_delivery_header" type="shipment_delivery_header"
						minOccurs="0" maxOccurs="99999" />
				</xsd:sequence>
			</xsd:complexType>
			<xsd:complexType name="shipment_reference_addInfo">
				<xsd:annotation>
					<xsd:documentation>Reference - additional info ZE1EDL43
					</xsd:documentation>
				</xsd:annotation>
				<xsd:sequence>
					<xsd:element name="ZZ_WAD" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Waste Acceptance Document</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="30" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ZRJRSN" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Reason for rejection of quotations and sales
								orders</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="2" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="Z_VBELNRF" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Sales Document</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="10" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="Z_POSNRRF" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Sales Document Item</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="6" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="Z_REF_WERKS" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Plant (Own or External)</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="4" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
					<xsd:element name="ZZ_WAD2" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Waste Acceptance Document</xsd:documentation>
						</xsd:annotation>
						<xsd:simpleType>
							<xsd:restriction base="xsd:string">
								<xsd:maxLength value="30" />
							</xsd:restriction>
						</xsd:simpleType>
					</xsd:element>
