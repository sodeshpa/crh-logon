				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="shipment_document_creation" type="shipment_document_creation" />
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:complexType name="shipment_transport_additional_data_desc">
