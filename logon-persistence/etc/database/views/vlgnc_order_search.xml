        <!-- 2) Order Header comments: Initially coming from TLGNC_SHIPTO, but can be overridden on order creation / processing customer web order. -->
        <column name="NOTE_ORDER_MGMT" type="VARCHAR" size="256"
                description="Notes for the order management about the ship-to. Not modifiable by Call Center Agent. The initial content is composed of tlgnc_shipto.note_order_mgmt and tlgnc_shipto_sarea_restr.note_order_mgmt is set at order creation time."/>
		<!-- Field size is 300 becasue we misuse TLGNC_SHIPTO_SAREA_RESTR.NOTE_DELIVERY field for special customs information from Loruns to CH (Ticket ADN49541). -->
        <column name="NOTE_DELIVERY" type="VARCHAR" size="300"
                description="Additional text for the delivery note (PDF). The initial content is composed of tlgnc_shipto.note_delivery and tlgnc_shipto_sarea_restr.note_delivery, set at order creation time and can be modified."/>
        <column name="NOTE_DISPATCHING" type="VARCHAR" size="256"
                description="Notes for the Dispatching (Pool/Carrier). The initial content is composed of tlgnc_shipto.note_dispatching and tlgnc_shipto_sarea_restr.note_dispatching, set at order creation time and can be modified."/>
        <column name="NOTE_TRUCK_DRIVER" type="VARCHAR" size="256"
                description="Notes for the Driver. The initial content is composed of tlgnc_shipto.note_truck_driver and tlgnc_shipto_sarea_restr.note_truck_driver, set at order creation time and can be modified."/>
        <column name="NOTE_RAILWAY_DISP" type="VARCHAR" size="256"
                description="Notes for the Railway disposition, but in the UI called 'Spedition'. This is misleading, because the terminal screen for Trucks is called 'Spedition', but has definitely nothing to do with it. Anyway: The initial content is composed of tlgnc_shipto.note_railway_disp and tlgnc_shipto_sarea_restr.note_railway_disp, set at order creation time and can be modified."/>
        <column name="ORDER_NUMBER_FROM_SEQ_USAGE" type="VARCHAR" size="12"
                description="Order number according to the use case specified by 'order_number_seq_usage_cd', based on the configurable sequence counter from table tlngc_conf_seq_counters. Only meaningful if order_number_seq_usage_cd is not empty."/>
        <column name="LOADING_TS" type="DATE" description="Date and time when start-loading occurred."/>
		<column name="MATERIAL_PACKAGE_CD" required="true" type="VARCHAR" size="4"/>
        <column name="ITRACK_STATUS_CD" required="true" type="DECIMAL" size="1"/>
