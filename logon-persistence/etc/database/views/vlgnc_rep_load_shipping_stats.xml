        <column name="SAP_MATERIAL_TXT" required="true" type="VARCHAR" size="40"/>
        <column name="LANG_CD" required="true" type="VARCHAR" size="2"/>
        <column name="NET_QUANTITY" type="DECIMAL" size="12,4"/>
        <column name="BASE_UOM_CD" required="true" type="VARCHAR" size="3"/>
        <column name="LOADING_TS" type="DATE"/>
        <column name="UNLOADING_TS" type="DATE"/>
        <column name="PRODUCTION_PLANT" type="BOOLEAN"/>
    </table>
</database>