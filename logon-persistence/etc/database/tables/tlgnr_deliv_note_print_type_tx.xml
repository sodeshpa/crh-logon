<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNR_DELIV_NOTE_PRINT_TYPE_TX" refData="true"
           description="Language dependent attributes for Delivery Note Printing Type.">

