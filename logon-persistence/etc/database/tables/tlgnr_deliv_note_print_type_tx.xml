        <foreign-key foreignTable="TLGNR_LANG_BS" name="FK_TLGNR_DELIV_NOTE_PRTYPE_LNG">
            <reference local="LANG_CD" foreign="LANG_CD"/>
        </foreign-key>
    </table>
</database>
