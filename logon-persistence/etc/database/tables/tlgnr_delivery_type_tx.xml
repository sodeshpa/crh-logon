<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNR_DELIVERY_TYPE_TX" refData="true"
           description="Language dependent attributes of the LOGON Delivery Types.">

        <column name="DELIVERY_TYPE_CD" primaryKey="true" required="true" type="DECIMAL" size="2"
                description="Part of PK. FK tlgnr_delivery_type_bs. Code of the Reference Data."/>
        <column name="LANG_CD" primaryKey="true" required="true" type="VARCHAR" size="2"
                description="Part of PK. FK tlgnr_lang_bs."/>
        <column name="TXT" required="true" type="VARCHAR" size="40"
                description="Description of the code in the language lang_cd."/>

        <foreign-key foreignTable="TLGNR_DELIVERY_TYPE_BS" name="FK_TLGNR_DELIVERY_TYPE_TX">
            <reference local="DELIVERY_TYPE_CD" foreign="DELIVERY_TYPE_CD"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNR_LANG_BS" name="FK_TLGNR_DELIVERY_TYPE_LANG">
            <reference local="LANG_CD" foreign="LANG_CD"/>
        </foreign-key>
    </table>
</database>