                description="tlgnc_load.loaded_from_load_id, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_SAP_MATERIAL_ID" type="DECIMAL" size="12"
                description="tlgnc_load.sap_material_id, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_PRODUCTION_PLANT_CD" type="VARCHAR" size="4"
                description="tlgnc_load.production_plant_cd, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_TARE_QUANTITY" type="DECIMAL" size="12,4"
                description="tlgnc_load.tare_weight_t, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_NET_QUANTITY" type="DECIMAL" size="12,4"
                description="tlgnc_load.net_quantity, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_GROSS_QUANTITY" type="DECIMAL" size="12,4"
                description="tlgnc_load.gross_weight_t, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="NET_QUANTITY_UOM_CD" type="VARCHAR" size="3"
                description="tlgnc_load.net_quantity_uom_cd, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_LOAD_ORDER_ID" type="DECIMAL" size="12"
                description="tlgnc_load.load_order_id, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_CHAMBER_NUMBER" type="DECIMAL" size="1"
                description="tlgnc_load.chamber_number, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_LOADING_TS" type="DATE"
                description="tlgnc_load.loading_ts, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_UNLOADING_TS" type="DATE"
                description="tlgnc_load.unloading_ts, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_WS_SILO_NO" type="VARCHAR" size="20"
                description="tlgnc_load.ws_silo_no, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_SILO_NAME" type="VARCHAR" size="40"
                description="tlgnc_load.ws_silo_name, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_SAMPLE_NO" type="VARCHAR" size="20"
                description="tlgnc_load.ws_sample_no, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_WS_TARE_QUIT_WARN_FLAG" type="BOOLEAN"
        		description="tlgnc_load.ws_tare_quit_warn_flag, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_WS_DELIVERY_NOTE_NO" type="VARCHAR" size="12"
				description="tlgnc_load.ws_delivery_note_no, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_ORDER_TEMPLATE_NO" type="VARCHAR" size="12"
				description="tlgnc_load.ws_order_template_no, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_EICHBELEG1" type="VARCHAR" size="40"
				description="tlgnc_load.ws_eichbeleg1, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_EICHBELEG1_TIME" type="DATE"
				description="tlgnc_load.ws_eichbeleg1_time, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_WS_EICHBELEG1_BALANCE" type="VARCHAR" size="40"
                description="tlgnc_load.ws_eichbeleg1_balance, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_EICHBELEG2" type="VARCHAR" size="40"
				description="tlgnc_load.ws_eichbeleg2, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_EICHBELEG2_TIME" type="DATE"
				description="tlgnc_load.ws_eichbeleg2, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_WS_EICHBELEG2_BALANCE" type="VARCHAR" size="40"
                description="tlgnc_load.ws_eichbeleg2_balance, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_CUSTOMER_ORDER_NO" type="VARCHAR" size="20"
				description="tlgnc_load.ws_customer_order_no, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_ENTER_SHIPPPOINT_TIME" type="DATE"
				description="tlgnc_load.ws_enter_shippingpoint_time, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
		<column name="LOAD_WS_LEAVE_SHIPPPOINT_TIME" type="DATE"
				description="tlgnc_load.ws_leave_shippingpoint_time, referenced by tlgnc_order_item.load_id -> tlgnc_load.load_id."/>
        <column name="LOAD_WS_START_LOADINGPOINT_ID" type="DECIMAL" size="12"
                description="tlgnc_load.ws_start_loadingpoint_id, referenced by tlgnc_order_item.load_id. Note: This is the LOGON PK, not from the weighing system."/>
        <column name="LOAD_WS_END_LOADINGPOINT_ID" type="DECIMAL" size="12"
                description="tlgnc_load.ws_end_loadingpoint_id, referenced by tlgnc_order_item.load_id. Note: This is the LOGON PK, not from the weighing system."/>
        <column name="LOAD_WS_ORIG_TARE_MEASURE_T" type="DECIMAL" size="12,4"
                description="tlgnc_load.ws_original_tare_measure_t, referenced by tlgnc_order_item.load_id"/>
        <column name="LOAD_WS_ORIG_GROSS_MEASURE_T" type="DECIMAL" size="12,4"
                description="tlgnc_load.ws_original_gross_measure_t, referenced by tlgnc_order_item.load_id"/>
        <column name="LOAD_WS_TRUCK_PLATE_NO" type="VARCHAR" size="20"
        		description="tlgnc_load.ws_truck_plate_no, referenced by tlgnc_order_item.load_id"/>
		<column name="LOAD_WS_TRAILER_PLATE_NO" type="VARCHAR" size="20"
        		description="tlgnc_load.ws_trailer_plate_no, referenced by tlgnc_order_item.load_id"/>
        <column name="LOAD_WS_CARRIER" type="VARCHAR" size="35"
        		description="tlgnc_load.ws_carrier, referenced by tlgnc_order_item.load_id"/>		
        <column name="LOAD_LOADINGPOINT_ID" type="DECIMAL" size="12"
                description="tlgnc_order_item.loadingpoint_id."/>
        <column name="LOAD_STORAGE_LOCATION" type="VARCHAR" size="4"
                description="Storage location (real) of the SAP known plant used for goods movement request."/>
        <column name="LOAD_STORAGE_LOC_IN_TRANSIT" type="VARCHAR" size="4"
                description="Storage location (in transit/SAP virtual) of the SAP known plant used for goods movement request."/>
        <column name="LOAD_SENT_GOODSMOVE_TO_QUE_TS" type="TIMESTAMP"
                description="Timestamp where the goods movement request was queued to be sent to SAP."/>
        <column name="LOAD_SENT_GOODSMOVE_TO_SAP_TS" type="TIMESTAMP"
                description="Timestamp where the goods movement request was actually sent to SAP."/>
                
        <column name="LDS_LOADED_FLAG" type="DECIMAL" size="1"
                description="This indicator shows if an order has been loaded with an LDS or not."/>
                
        <!-- LOADINGPOINT_ID : Content of tlgnc_loadingpoint.-->
        <!-- SHIPPINGPOINT_ID: ignore! is contained on the order -->
        <column name="LP_LPOINT_NAME" type="VARCHAR" size="50"
                description="tlgnc_loadingpoint.loadingpoint_name, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_LPOINT_OBJECT_LABEL" type="VARCHAR" size="50"
                description="tlgnc_loadingpoint.loadingpoint_object_label, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_PACKAGE_TYPE_CD" type="DECIMAL" size="2"
                description="tlgnc_loadingpoint.package_type_cd, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_WEIGH_SYSTEM_LP_CD" type="DECIMAL" size="2"
                description="tlgnc_loadingpoint.weigh_system_lp_cd, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_DELIV_NOTE_PRINT_TYPE_CD" type="DECIMAL" size="2"
                description="tlgnc_loadingpoint.deliv_note_print_type_cd, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_WEIGH_SYS_LOADINGPOINT_NO" type="VARCHAR" size="10"
                description="tlgnc_loadingpoint.WEIGH_SYSTEM_LOADINGPOINT_NO, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_PRINTER_CD" type="DECIMAL" size="4"
                description="tlgnc_loadingpoint.printer_cd, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_LOADINGPOINT_COMMENT" type="VARCHAR" size="250"
                description="tlgnc_loadingpoint.loadingpoint_comment, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_ACTIVE_FLAG" type="BOOLEAN"
                description="tlgnc_loadingpoint.active_flag, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_LOADING_TIME" type="DECIMAL" size="10"
                description="tlgnc_loadingpoint.laoding_time, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <column name="LP_GROSS_WEIGHT_LIMIT_KG" type="DECIMAL" size="10"
                description="tlgnc_loadingpoint.gross_weight_limit_kg, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.loadingpoint_id."/>
        <!-- RFIDOBJECT_ID : Content of tlgnc_rfidobject.-->
        <column name="LP_RFID_OBJECT_LABEL" type="VARCHAR" size="200"
                description="tlgnc_rfidobject.object_label, referenced by tlgnc_order_item.loadingpoint_id -> tlgnc_loadingpoint.rfidobject_id -> tlgnc_rfidobject.rfidobject_id"/>

		<column name="OI_SAP_MATERIAL_ID" required="true" type="DECIMAL" size="12"
                description="tlgnc_order_item.sap_material_id."/>

		<!-- SAP_MATERIAL_ID : Content of tlgns_sap_material.-->
		<column name="MAT_SAP_MATERIAL_NO" required="true" type="VARCHAR" size="18"
                description="tlgns_sap_material.sap_material_no, referenced by tlgnc_order_item.sap_material_id -> tlgns_sap_material.sap_material_id."/>
		<!-- SAP_IFC_ID: ignore, is only for technical reasons. --> 
        <column name="MAT_MATERIAL_GROUP_DESC" type="VARCHAR" size="20"
                description="tlgns_sap_material.material_group_desc, referenced by tlgnc_order_item.sap_material_id -> tlgns_sap_material.sap_material_id."/>
        <column name="MAT_BASE_UOM_CD" required="true" type="VARCHAR" size="3"
                description="tlgns_sap_material.base_uom_cd, referenced by tlgnc_order_item.sap_material_id -> tlgns_sap_material.sap_material_id."/>
        <column name="MAT_NORM_DESC" type="VARCHAR" size="40"
                description="Since LOGON 1.4: tlgnc_mat_plant.norm_desc of the material/oi_production_plant_cd. Before: tlgns_sap_material.product_hierarchy_desc, referenced by tlgnc_order_item.sap_material_id -> tlgns_sap_material.sap_material_id."/>
        <column name="MAT_DIVISION_CD" type="VARCHAR" size="2"
                description="tlgns_sap_material.division, referenced by tlgnc_order_item.sap_material_id -> tlgns_sap_material.sap_material_id."/>
        <column name="MAT_IND_STANDARD_DESC" type="VARCHAR" size="18"
                description="tlgns_sap_material.industry_standard_desc, referenced by tlgnc_order_item.sap_material_id -> tlgns_sap_material.sap_material_id."/>
        <column name="MAT_MATERIAL_PACKAGE_CD" required="true" type="VARCHAR" size="4"
                description="tlgns_sap_material.material_package_cd, referenced by tlgnc_order_item.sap_material_id -> tlgns_sap_material.sap_material_id."/>
        <column name="MAT_MARKED_FOR_DELETION" type="BOOLEAN"
                description="tlgns_sap_material.marked_for_deletion, referenced by tlgnc_order_item.sap_material_id -> tlgns_sap_material.sap_material_id."/>
		
		<!-- tlgns_sap_material_alt_uom: ignore (we don't use this in Logon currently) -->
		<!-- tlgns_sap_mat_description: ignore (we don't include texts in this table) -->
		<!-- tlgns_sap_material_plant:ignore (fields are not used, with exeption of the plant_cd itself, which is stored anyway on order_item) -->

		<!-- SAP_MATERIAL_ID and TLGNC_ORDER.SAREA_CD: Content of tlgns_sap_material_sare.-->
        <column name="MAT_SA_SALES_UOM_CD" type="VARCHAR" size="3"
                description="tlgns_sap_material_sare.sales_uom_cd, referenced by tlgnc_order.sarea_cd -> tlgns_sap_material_sare.sales_uom_cd and tlgnc_order_item.sap_material_id -> tlgns_sap_material_sare.sap_material_id"/>
		
        <column name="OI_PRODUCTION_PLANT_CD" required="true" type="VARCHAR" size="4"
                description="tlgnc_order_item.production_plant_cd."/>
        <column name="OI_CURRENCY_CD" required="true" type="VARCHAR" size="3"
                description="tlgnc_order_item.currency_cd."/>
        <column name="OI_RATE" type="DECIMAL" size="10,3"
                description="tlgnc_order_item.rate."/>
        <column name="OI_ORDERED_UOM_CD" type="VARCHAR" size="3"
                description="tlgnc_order_item.ordered_uom_cd."/>
