                description="tlgnc_order_item.delivered_quantity."/>
		
        <column name="OI_STORAGE_LOCATION" type="VARCHAR" size="4"
                description="a) tlgnc_mat_shippingpoint.storage_location, but if null: b) tlgnc_shippingpoint.storage_location. The Storage Location, where the material is kept at the shippingpoint. Depends on Shippingpoint and Material. Note that this field does NOT respect SAP-send logic (fallback rail_chain/send_to_sap_shippingpoint)."/>
		<column name="OI_SHIPTO_SILO_ID" type="DECIMAL" size="12"
                description="tlgnc_order_item.shipto_silo_id"/>
        <column name="OI_SHIPTO_SILO_VERIF_TYPE_CD" type="DECIMAL" size="2"
                description="tlgnc_order_item.shipto_silo_verif_type_cd"/>

                

