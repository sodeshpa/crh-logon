<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNF_ORDER_ITEM_FINAL"
           description="Frozen data of an order item at the time the order was set to 'finished', i.e. i.e. transition from status 15=delivered to status 16=finished. See tlgnf_order_final for detailed description of the business purpose.">

        <column name="ORDER_ITEM_FINAL_ID" primaryKey="true" required="true" type="DECIMAL" size="12"
                description="PK"/>
        <column name="ORDER_FINAL_ID" required="true" type="DECIMAL" size="12"
                description="FK tlgnf_order_final."/>
        <column name="OI_ORDER_ITEM_ID" required="true" type="DECIMAL" size="12"
                description="tlgnc_order_item.order_item_id. Unique. If an order changes after the original 'finish' operation (Examples: Update delivery quantities due to credit note, updated costs, changed Billto, ...) the original order_final record together with its order_item_final records is updated."/>"/>
        <column name="OI_ORDER_ID" required="true" type="DECIMAL" size="12"
                description="tlgnc_order_item.order_id. FK tlgnf_order. The Order to which the Order Item belongs."/>
        <column name="OI_ORDER_NUMBER" type="DECIMAL" size="12"
                description="tlgnc_order.order_number."/>
        <column name="OI_ORDER_ITEM_NO" required="true" type="DECIMAL" size="3"
                description="tlgnc_order_item.order_item_no."/>
        <column name="OI_LOAD_ID" type="DECIMAL" size="12"
                description="tlgnc_order_item.load_id."/>
        <column name="OI_MIX_DESIGN_ID" type="DECIMAL" size="12"
                description="tlgnc_order_item.mix_design_id."/>
        

        <!-- LOAD_ID : Content of tlgnc_load.-->
