        <column name="OI_LR_UOM_DENOMINATOR" type="DECIMAL" size="5"
                description="tlgnc_order_item.lr_uom_denominator."/>    
        <column name="OI_RETURN_QUANT_HANDLING_CD" type="DECIMAL" size="2"
