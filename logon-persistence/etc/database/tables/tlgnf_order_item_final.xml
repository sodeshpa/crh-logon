        <column name="OI_HANDLING_COST_MAT" type="DECIMAL" size="11,2"
                description="tlgnc_order_item.handling_cost_mat"/>
        <column name="OI_IUD_COST" type="DECIMAL" size="11,2"
                description="tlgnc_order_item.iud_cost"/>
        <column name="OI_OUT_COST" type="DECIMAL" size="11,2"
                description="tlgnc_order_item.out_cost"/>
        <column name="OI_DELIVERY_DAT_EXCHANGE_RATE" type="DECIMAL" size="12,4"
