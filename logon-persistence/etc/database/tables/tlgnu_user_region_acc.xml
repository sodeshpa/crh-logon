<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
  <table name="TLGNU_USER_REGION_ACC" description="Access Control/Data restriction table. Defines the company codes (TLGNR_REGION_BS) a user has access to.">
    <column name="USER_REGION_ACC_ID" primaryKey="true" required="true" type="DECIMAL" size="12" description="PK"/>
    <column name="USER_ID" required="true" type="DECIMAL" size="12" description="FK tlgnu_user. The Logon user."/>
    <column name="REGION_CD" required="true" type="VARCHAR" size="3" description="FK TLGNR_REGION_BS The REGION code for which access is granted."/>
    <foreign-key foreignTable="TLGNR_REGION_BS" name="FK_TLGNR_REGION_BS">
      <reference local="REGION_CD" foreign="REGION_CD"/>
    </foreign-key>
    <foreign-key foreignTable="TLGNU_USER" name="FK_REGION_ACC_USER">
      <reference local="USER_ID" foreign="USER_ID"/>
    </foreign-key>
    <unique name="UQ_TLGNU_USER_REGIONCD_ACC">
      <unique-column name="USER_ID"/>
      <unique-column name="REGION_CD"/>
    </unique>
  
	</table>
</database>
