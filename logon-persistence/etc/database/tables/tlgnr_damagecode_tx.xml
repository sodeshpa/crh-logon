<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNR_DAMAGECODE_TX" refData="true"
           description="Reference data for damage codes (for repair orders).">

        <column name="DAMAGECODE_CD" primaryKey="true" required="true" type="DECIMAL" size="12"
                description="Part of PK. FK tlgnr_damagecode_bs."/>
        <column name="DAMAGECODE_TXT" required="true" type="VARCHAR" size="20"
                description="Actual reference code displayed (such as for example 1.1.1 or 2.1.4.1)."/>
        <column name="LANG_CD" primaryKey="true" required="true" type="VARCHAR" size="2"
                description="Part of PK. FK tlgnr_lang_bs. For example de, en, ..."/>

        <column name="TXT" required="true" type="VARCHAR" size="300"
                description="Detailed description of the code."/>
        <column name="RISKCLASS" type="VARCHAR" size="250"
                description="Risk class of the damage."/>
				
        <foreign-key foreignTable="TLGNR_DAMAGECODE_BS" name="FK_TLGNR_DAMAGECODE_TX">
            <reference local="DAMAGECODE_CD" foreign="DAMAGECODE_CD"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNR_LANG_BS" name="FK_TLGNR_DAMAGECODE_LANG">
            <reference local="LANG_CD" foreign="LANG_CD"/>
        </foreign-key>
    </table>
</database>