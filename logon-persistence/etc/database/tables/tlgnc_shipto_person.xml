<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNC_SHIPTO_PERSON" description="Contact person for a shipto">
        <column name="SHIPTO_PERSON_ID" primaryKey="true" required="true" type="DECIMAL" size="12" description="PK"/>
        <column name="SHIPTO_ID" required="true" type="DECIMAL" size="12" description="FK tlgnc_shipto. Shipto to which the contact person belongs."/>
        <column name="PERSON_ID" required="true" type="DECIMAL" size="12" description="FK tlgnv_person. Pontact person."/>
        <column name="FUNCTION" type="VARCHAR" size="100" description="The function of the contact person."/>
        <foreign-key foreignTable="TLGNC_SHIPTO" name="FK_TLGNC_SHIPTOPERSON_SHIPTO">
            <reference local="SHIPTO_ID" foreign="SHIPTO_ID"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNC_PERSON" name="FK_TLGNC_SHIPTOPERSON_PERSON">
            <reference local="PERSON_ID" foreign="PERSON_ID"/>
        </foreign-key>
    </table>
</database>