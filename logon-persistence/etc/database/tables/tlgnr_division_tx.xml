<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNR_DIVISION_TX" refData="true" 
    description="Table Implementation of the Divisions text values">
        <column name="DIVISION_CD" primaryKey="true" required="true" type="VARCHAR" size="2" 
        description="PK. Code of the Division Data"/>
        
        <column name="LANG_CD" primaryKey="true" required="true" type="VARCHAR" size="2"
                description="Part of PK. FK tlgnr_lang_bs."/>
        <column name="TXT" required="true" type="VARCHAR" size="30"
                description="Description of the code in the language lang_cd."/>
                
        <foreign-key foreignTable="TLGNR_DIVISION_BS" name="FK_TLGNR_DIVISION_TX">
            <reference local="DIVISION_CD" foreign="DIVISION_CD"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNR_LANG_BS" name="FK_TLGNR_DIVISION_LANG">
            <reference local="LANG_CD" foreign="LANG_CD"/>
        </foreign-key>
        
    </table>
</database>
