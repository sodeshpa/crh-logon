<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNC_POOL_TX"
           description="Language dependent data of a pool. Is modelled similar to the concept of reference data.">

        <column name="POOL_ID" primaryKey="true" required="true" type="DECIMAL" size="12"
                description="Part of PK. FK tlgnc_pool."/>
        <column name="LANG_CD" primaryKey="true" required="true" type="VARCHAR" size="2"
                description="Part of PK. FK tlgnr_lang_bs. For example de, en, ..."/>
        <column name="NAME" type="VARCHAR" size="30"
                description="Name of the Pool in language LANG_CD."/>

        <foreign-key foreignTable="TLGNC_POOL" name="FK_TLGNC_POOL_TX">
            <reference local="POOL_ID" foreign="POOL_ID"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNR_LANG_BS" name="FK_TLGNC_POOL_LANG">
            <reference local="LANG_CD" foreign="LANG_CD"/>
        </foreign-key>
    </table>
</database>
