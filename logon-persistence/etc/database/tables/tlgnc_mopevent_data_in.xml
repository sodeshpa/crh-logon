<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNC_MOPEVENT_DATA_IN" description="Contains the specific datas of a Message sent form MOP to Logon.">
        <column name="MOPEVENT_DATA_IN_ID" primaryKey="true" required="true" type="DECIMAL" size="12"
                description="PK"/>
        <column name="MOPEVENT_HEADER_IN_ID" required="true" type="DECIMAL" size="12"
                description="FK of mopevent_header_in table"/>
        <column name="NAME" required="true" type="VARCHAR" size="30"
                description="Name of a specific event data. e.g. for event login: PIN, UserId, ... "/>
        <column name="VALUE" type="VARCHAR" size="250"
                description="Value of the specific event data."/>
                       
        <foreign-key foreignTable="TLGNC_MOPEVENT_HEADER_IN" name="FK_TLGNC_MOPEVENTHEADER_IN_ID">
            <reference local="MOPEVENT_HEADER_IN_ID" foreign="MOPEVENT_HEADER_IN_ID"/>
        </foreign-key>
                
    </table>
</database>
