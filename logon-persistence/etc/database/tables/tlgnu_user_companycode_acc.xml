<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNU_USER_COMPANYCODE_ACC"
           description="Access Control/Data restriction table. Defines the company codes (tlgnr_companycode_bs) a user has access to.">

        <column name="USER_COMPANYCODE_ACC_ID" primaryKey="true" required="true" type="DECIMAL" size="12"
                description="PK"/>
        <column name="USER_ID" required="true" type="DECIMAL" size="12"
                description="FK tlgnu_user. The Logon user."/>
        <column name="COMPANYCODE_CD" required="true" type="VARCHAR" size="4"
                description="FK tlgnr_companycode_bs The company code for which access is granted."/>

        <foreign-key foreignTable="TLGNR_COMPANYCODE_BS" name="FK_TLGNR_COMPANYCODE_BS">
            <reference local="COMPANYCODE_CD" foreign="COMPANYCODE_CD"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNU_USER" name="FK_COMPANYCODE_ACC_USER">
            <reference local="USER_ID" foreign="USER_ID"/>
        </foreign-key>
        <unique name="UQ_TLGNU_USER_COMPCD_ACC">
            <unique-column name="USER_ID"/>
            <unique-column name="COMPANYCODE_CD"/>
        </unique>
    </table>
</database>