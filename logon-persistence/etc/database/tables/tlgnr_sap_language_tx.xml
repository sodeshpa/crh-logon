<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNR_SAP_LANGUAGE_TX" refData="true"
           description="SAP country reference table">

        <column name="SAP_LANGUAGE_CD" primaryKey="true" required="true" type="VARCHAR" size="3"
                description="Part of PK. FK tlgnr_sap_language_bs. SAP country code"/>
        <column name="LANG_CD" primaryKey="true" required="true" type="VARCHAR" size="2"
                description="Part of PK. FK tlgnr_lang_bs. For example de, en, ..."/>
        <column name="TXT" required="true" type="VARCHAR" size="40"
                description="Name of the language SAP_LANGUAGE_CD in the language LANG_CD."/>

        <foreign-key foreignTable="TLGNR_SAP_LANGUAGE_BS" name="FK_TLGNR_SAP_LANGUAGE_BS">
            <reference local="SAP_LANGUAGE_CD" foreign="SAP_LANGUAGE_CD"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNR_LANG_BS" name="TLGNR_SAP_LANGUAGE_TX_LANG_BS">
            <reference local="LANG_CD" foreign="LANG_CD"/>
        </foreign-key>

      </table>
</database>