<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNU_USER_SGROUP_ACC"
           description="Access Control/Data restriction table. Defines the Sales Organisation (tlgnr_sgroup_bs) a user has access to.">

        <column name="USER_SGROUP_ACC_ID" primaryKey="true" required="true" type="DECIMAL" size="12"
                description="PK"/>
        <column name="USER_ID" required="true" type="DECIMAL" size="12"
                description="FK tlgnu_user. The Logon user."/>
        <column name="SGROUP_CD" required="true" type="VARCHAR" size="4"
                description="FK tlgnr_sgroup_bs. The Sales Group for which access is granted."/>

        <foreign-key foreignTable="TLGNU_USER" name="FK_TLGNU_USER_SGROUP_ACC_USER">
            <reference local="USER_ID" foreign="USER_ID"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNR_SGROUP_BS" name="FK_TLGNU_USER_SGROUP_ACC_SGRP">
            <reference local="SGROUP_CD" foreign="SGROUP_CD"/>
        </foreign-key>

        <unique name="UQ_TLGNU_USER_SGROUP_ACC">
            <unique-column name="USER_ID"/>
            <unique-column name="SGROUP_CD"/>
        </unique>
    </table>
</database>
