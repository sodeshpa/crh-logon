<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNU_USER_PLANT_ACC"
           description="Access Control/Data restriction table. Defines the Plants (tlgnr_blant_bs) a user has access to. Can be supply and production plants.">

        <column name="USER_PLANT_ACC_ID" primaryKey="true" required="true" type="DECIMAL" size="12"
                description="PK"/>
        <column name="USER_ID" required="true" type="DECIMAL" size="12"
                description="FK tlgnu_user. The Logon user."/>
        <column name="PLANT_CD" required="true" type="VARCHAR" size="4"
                description="FK tlgnr_plant_bs. The plant (supply plant, production plant) for which access is granted."/>

        <foreign-key foreignTable="TLGNR_PLANT_BS" name="FK_TLGNU_USER_PLANT_ACC_PLANT">
            <reference local="PLANT_CD" foreign="PLANT_CD"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNU_USER" name="FK_TLGNU_USER_PLANT_ACC_USER">
            <reference local="USER_ID" foreign="USER_ID"/>
        </foreign-key>
        <unique name="UQ_TLGNU_USER_PLANT_ACC">
            <unique-column name="USER_ID"/>
            <unique-column name="PLANT_CD"/>
        </unique>
    </table>
</database>