<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNR_RETURN_ORDER_REASON_TX" refData="true"
           description="Return order reason description table.">
        
        <column name="RETURN_ORDER_REASON_CD" primaryKey="true" required="true" type="VARCHAR" size="3"
                description="Part of PK. FK tlgnr_return_order_reason_bs. Code of the Reference Data."/>
        <column name="LANG_CD" primaryKey="true" required="true" type="VARCHAR" size="2"
                description="Part of PK. FK tlgnr_lang_bs. For example de, en, ..."/>
        <column name="TXT" required="true" type="VARCHAR" size="40"
                description="Description of the Return order reason in the language lang_cd."/>
		
		<foreign-key foreignTable="TLGNR_RETURN_ORDER_REASON_BS" name="FK_TLGNR_RET_ORDER_REASON_TX">
            <reference local="RETURN_ORDER_REASON_CD" foreign="RETURN_ORDER_REASON_CD"/>
        </foreign-key>
		<foreign-key foreignTable="TLGNR_LANG_BS" name="FK_TLGNR_RET_ORDER_REASON_LANG">
            <reference local="LANG_CD" foreign="LANG_CD"/>
        </foreign-key>
    </table>
</database>
