<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNR_DAMAGECODE_BS" refData="true"
           description="Reference data for damage codes (for repair orders).">
           					
        <column name="DAMAGECODE_CD" primaryKey="true" required="true" type="DECIMAL" size="12"
            description="PK, unique identifier for the damage code. Textual representation, and textual categorization (such as 1.1.1, 2.6 etc) is in the TLGNR_DAMAGECODE_TX table."/>"/>
			
		<column name="CTL_ACT_CD" required="true" type="BOOLEAN"
                description="Active Flag. When new data is entered, only reference data with active flag are available for selection normally."/>
				
    </table>
</database>