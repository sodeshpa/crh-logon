<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNU_USER_ROLE"
           description="Relationship between users and roles. Defines the roles a user is authorized for. A user can have several roles and is therefore granted all functions contained in the union of all his roles.">

        <column name="USER_ROLE_ID" primaryKey="true" required="true" type="DECIMAL" size="12"
                description="PK"/>
        <column name="USER_ID" required="true" type="DECIMAL" size="12"
                description="FK tlgnu_user. The User to which a role is granted."/>
        <column name="ROLE_ID" required="true" type="DECIMAL" size="12"
                description="FK tlgnu_role. The Role."/>

        <foreign-key foreignTable="TLGNU_USER" name="FK_TLGNU_USER_ROLE_USER">
            <reference local="USER_ID" foreign="USER_ID"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNU_ROLE" name="FK_TLGNU_USER_ROLE_ROLE">
            <reference local="ROLE_ID" foreign="ROLE_ID"/>
        </foreign-key>

        <unique name="UQ_TLGNU_USER_ROLE">
            <unique-column name="USER_ID"/>
            <unique-column name="ROLE_ID"/>
        </unique>
    </table>
</database>