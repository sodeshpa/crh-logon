<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNU_USER_SOLDTO_BP_ACC"
           description="Access Control/Data restriction table. Defines the Sold-To Business Partners (tlgns_sap_bp with bp_is_soldto=1) a user has access to. For users of 'customer' (tlgnu_user.user_type_cd=1) at least 1 entry in this table (identical to tlgnu_user.sap_bp_id) is required for security reasons.">

        <column name="USER_SOLDTO_BP_ACC_ID" primaryKey="true" required="true" type="DECIMAL" size="12"
                description="PK"/>
        <column name="USER_ID" required="true" type="DECIMAL" size="12"
                description="FK tlgnu_user. The Logon user."/>
        <column name="SOLDTO_SAP_BP_ID" required="true" type="DECIMAL" size="12"
                description="FK tlgns_sap_bp. The Soldto for which access is granted."/>

        <foreign-key foreignTable="TLGNS_SAP_BP" name="FK_TLGNU_USRSOLDTOB_ACC_BILLBP">
            <reference local="SOLDTO_SAP_BP_ID" foreign="SAP_BP_ID"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNU_USER" name="FK_TLGNU_USRSOLDTOBPACC_USR">
            <reference local="USER_ID" foreign="USER_ID"/>
        </foreign-key>
        <unique name="UQ_TLGNU_USER_SOLDTO_BP_ACC">
            <unique-column name="USER_ID"/>
            <unique-column name="SOLDTO_SAP_BP_ID"/>
        </unique>
    </table>
</database>