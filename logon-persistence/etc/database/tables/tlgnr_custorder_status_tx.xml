<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNR_CUSTORDER_STATUS_TX" refData="true"
           description="Language dependent attributes for Customer Order Status.">

        <column name="CUSTORDER_STATUS_CD" primaryKey="true" required="true" type="DECIMAL" size="2"
                description="Part of PK. FK tlgnr_custorder_status_bs. Code of the Reference Data."/>
        <column name="LANG_CD" primaryKey="true" required="true" type="VARCHAR" size="2"
                description="Part of PK. FK tlgnr_lang_bs."/>
        <column name="TXT" required="true" type="VARCHAR" size="30"
                description="Description of the Customer Order Status in the language lang_cd."/>

        <foreign-key foreignTable="TLGNR_CUSTORDER_STATUS_BS" name="FK_TLGNR_CUSTORDER_STATUS_TX">
            <reference local="CUSTORDER_STATUS_CD" foreign="CUSTORDER_STATUS_CD"/>
        </foreign-key>
        <foreign-key foreignTable="TLGNR_LANG_BS" name="FK_TLGNR_CUSTORDER_STATUS_LANG">
            <reference local="LANG_CD" foreign="LANG_CD"/>
        </foreign-key>
    </table>
</database>
