<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
  <table name="TLGNC_REGION_POOL" description="The Pools assigned to a certain Region Pool:Region is M:N.">
    <column name="REGION_POOL_ID" primaryKey="true" required="true" type="DECIMAL" size="12" description="PK"/>
    <column name="POOL_ID" required="true" type="DECIMAL" size="12" description="FK tlgnc_pool. The Pool to which a Carrier is assigned."/>
    <column name="REGION_CD" required="true" type="VARCHAR" size="3" description="FK TLGNR_REGION_BS"/>
    <foreign-key foreignTable="TLGNC_POOL" name="FK_TLGNC_CP_TLGNC_POOL">
      <reference local="POOL_ID" foreign="POOL_ID"/>
    </foreign-key>
    <foreign-key foreignTable="TLGNR_REGION_BS" name="FK_TLGNC_CP_TLGNR_REGION_BS">
      <reference local="REGION_CD" foreign="REGION_CD"/>
    </foreign-key>
    <unique name="UQ_TLGNC_REGION_POOL">
      <unique-column name="POOL_ID"/>
      <unique-column name="REGION_CD"/>
    </unique>
  
	</table>
</database>
