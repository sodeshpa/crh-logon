<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
    <table name="TLGNR_ORDER_CREATION_TYPE_TX" refData="true"
           description="Language dependent attributes for Order Creation Type.">

        <column name="ORDER_CREATION_TYPE_CD" primaryKey="true" required="true" type="DECIMAL" size="2"
                description="Part of PK. FK tlgnr_order_creation_type_bs. Code of the Reference Data."/>
        <column name="LANG_CD" primaryKey="true" required="true" type="VARCHAR" size="2"
                description="Part of PK. FK tlgnr_lang_bs."/>
        <column name="TXT" required="true" type="VARCHAR" size="30"
                description="Description of the Order Creation Type in the language lang_cd."/>

        <foreign-key foreignTable="TLGNR_ORDER_CREATION_TYPE_BS" name="FK_TLGNR_ORDER_CREATION_TYP_TX">
            <reference local="ORDER_CREATION_TYPE_CD" foreign="ORDER_CREATION_TYPE_CD"/>
