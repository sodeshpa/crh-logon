        <foreign-key foreignTable="TLGNR_LANG_BS" name="FK_TLGNR_ORDER_CREATION_TYP_LN">
            <reference local="LANG_CD" foreign="LANG_CD"/>
        </foreign-key>
    </table>
</database>
