<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE database SYSTEM "http://db.apache.org/torque/dtd/database">
<database name="Logon" xmlns="http://db.apache.org/schemas">
	<table name="TLGNC_DEMAND_PLAN"
		   description="Demand plans for the future">
		<column name="DEMAND_PLAN_ID" primaryKey="true" required="true" type="DECIMAL" size="12" description="PK" />
		<column name="SHIPTO_ID" required="true" type="DECIMAL" size="12" description="FK tlgnc_shipto." />
		<column name="SAP_MATERIAL_ID" required="true" type="DECIMAL" size="12" description="FK tlgns_sap_material." />
		<column name="PLANNED_WEIGHT_T" required="true" type="DECIMAL" size="12,4"
				description="The planned demand in the given date-range for the set shipto and material." />
		<column name="START_DATE" required="true" type="DATE"
				description="Start of the planned demand range." />
		<column name="END_DATE" required="true" type="DATE"
				description="Start of the planned demand range." />

		<foreign-key foreignTable="TLGNC_SHIPTO" name="FK_TLGNC_DEMAND_PLAN_SHIPTO">
			<reference local="SHIPTO_ID" foreign="SHIPTO_ID" />
		</foreign-key>
		<foreign-key foreignTable="TLGNS_SAP_MATERIAL" name="FK_TLGNC_DEMAND_PLAN_MAT">
			<reference local="SAP_MATERIAL_ID" foreign="SAP_MATERIAL_ID" />
		</foreign-key>

	</table>
</database>