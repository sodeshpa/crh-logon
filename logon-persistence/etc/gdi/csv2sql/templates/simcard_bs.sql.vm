set define off

create or replace procedure upsert_simcard_bs (
    v_issuer_number   in varchar2,
    v_simcard_number  in varchar2,
    v_phone_number    in varchar2
) is
    v_existing    number; -- number of existing records of that key (0 or 1)
    v_existing_id number; -- ID of existing record of that key, if exist
begin

  select count(simcard_cd) into v_existing from tlgnr_simcard_bs
    where issuer_number = v_issuer_number and simcard_number = v_simcard_number;

  if (v_existing > 0) then

    select simcard_cd into v_existing_id from tlgnr_simcard_bs
      where issuer_number = v_issuer_number and simcard_number = v_simcard_number;

    update tlgnr_simcard_bs set
      phone_number = v_phone_number,
      ctl_mod_uid=1,
      ctl_mod_ts=systimestamp
    where
      simcard_cd = v_existing_id;

  else

    insert into tlgnr_simcard_bs (
      simcard_cd,
      issuer_number,
      simcard_number,
      phone_number,
      ctl_act_cd,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
    ) values (
      slgnr_simcard_bs.nextval,
      v_issuer_number,
      v_simcard_number,
      v_phone_number,
      1,
      1, systimestamp, 1, systimestamp
    );
  end if;
end;
/
