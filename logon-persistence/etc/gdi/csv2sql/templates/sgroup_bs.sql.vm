create or replace procedure upsert_sgroup_bs (
    v_sgroup_cd       in varchar2,
    v_sgroup_name     in varchar2,
    v_ctl_act_cd      in number,
    v_email_addresses in varchar2
) is
    v_existing number; -- number of existing records of that key (0 or 1)
begin
  select count(sgroup_cd) into v_existing from tlgnr_sgroup_bs where sgroup_cd = v_sgroup_cd;
  if (v_existing > 0) then
    update tlgnr_sgroup_bs set
      sgroup_name=v_sgroup_name,
      ctl_act_cd=v_ctl_act_cd,
      email_addresses=v_email_addresses,
      ctl_mod_uid=1,
      ctl_mod_ts=systimestamp
    where
      sgroup_cd=v_sgroup_cd and (
        /* to identify if something has changed at all, null must be handled specially, because "null != 'something'" would be false! */
        nvl(sgroup_name, '(NULL)') != nvl(v_sgroup_name, '(NULL)')
        or ctl_act_cd != v_ctl_act_cd
        or nvl(email_addresses, '(NULL)') != nvl(v_email_addresses, '(NULL)')
      );
  else
    insert into tlgnr_sgroup_bs (
      sgroup_cd,
      sgroup_name,
      ctl_act_cd,
      email_addresses,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
    ) values (
      v_sgroup_cd,
      v_sgroup_name,
      v_ctl_act_cd,
      v_email_addresses,
      1, systimestamp, 1, systimestamp
    );
  end if;
end upsert_sgroup_bs;
/
