-------------------------------------------------------------------------------
-- is_different_varchar2
-------------------------------------------------------------------------------
-- compares two varchars.
-- They are identical either if a) both are null, b) they are equal by "="
-- They are different if a) either is null and the other not, b) different by "="
create or replace function is_different_varchar2 (
  i_a in varchar2,
  i_b in varchar2)
  return number is
  begin
    if ((i_a != i_b)
        or (i_a is null and i_b is not null)
        or (i_a is not null and i_b is null)) then
      return 1;
    end if;
    return 0;
  end;
/
show errors;

-------------------------------------------------------------------------------
-- upsert_companycode_bs
-------------------------------------------------------------------------------
create or replace
procedure upsert_companycode_bs (
  p_companycode_cd          in varchar2,
  p_companycode_name        in varchar2,
  p_region_cd              in varchar2,
  p_ctl_act_cd              in number)
is
  v_exists_flag             number;        -- number of existing records of that key (0 or 1)

  begin
    dbms_output.enable(100000);

    dbms_output.put_line('Insert or Update tlgnr_companycode_bs (' || p_companycode_cd || ', ''' || p_companycode_name || ''', ctl_act_cd=' || p_ctl_act_cd || ')');

    select count(bs.companycode_cd) into v_exists_flag
    from tlgnr_companycode_bs bs
    where bs.companycode_cd = p_companycode_cd;

    if (v_exists_flag > 0) then
      if (p_ctl_act_cd != 1) then
        dbms_output.put_line ('NOT updating tlgnr_companycode_bs (CD=' || p_companycode_cd || ') because ctl_act_cd is 0 in loader and data in DB may be better maintained.');
      else
        update tlgnr_companycode_bs set
          /* companycode_cd: cannot update because this is the key */
          companycode_name      = p_companycode_name,
          region_cd            = p_region_cd,
          ctl_act_cd            = p_ctl_act_cd,
          ctl_mod_uid           = 1,
          ctl_mod_ts            = systimestamp
        where
          companycode_cd = p_companycode_cd                                  and
          ( 1 = is_different_varchar2(companycode_name, p_companycode_name)  or
            ctl_act_cd != p_ctl_act_cd  /* not nullable */
          )
        ;
        dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnr_companycode_bs (CD=' || p_companycode_cd || ').');
      end if;
    else
      insert into tlgnr_companycode_bs (
        companycode_cd,
        companycode_name,
        region_cd,
        ctl_act_cd,
        ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
      ) values (
        p_companycode_cd,
        p_companycode_name,
        p_region_cd,
        p_ctl_act_cd,
        1, systimestamp, 1, systimestamp
      );
      dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnr_companycode_bs (CD=' || p_companycode_cd || ').');
    end if;

  end upsert_companycode_bs;
/
show errors;


