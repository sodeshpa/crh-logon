create or replace
procedure insert_rail_timetable_entry (
  v_railway_station_country_from in number,
  v_railway_station_from in varchar2,
  v_train_no_departure in varchar2,
  v_dep_witching_time_min in number,
  v_dep_time_min in number,
  v_railway_station_country_to in number,
  v_railway_station_to in varchar2,
  v_train_no_arrival in varchar2,
  v_days_offset in number,
  v_arr_time_min in number,
  v_arr_switching_time_min in number,
  v_comment in varchar2
) is

v_dep_railway_station_id number;
v_arr_railway_station_id number;
begin
  select rs.railway_station_id into v_dep_railway_station_id from tlgnc_railway_station rs where rs.uic_country_cd = v_railway_station_country_from and rs.railway_station_no = lpad(v_railway_station_from, 6, '0');
  select rs.railway_station_id into v_arr_railway_station_id from tlgnc_railway_station rs where rs.uic_country_cd = v_railway_station_country_to and rs.railway_station_no = lpad(v_railway_station_to, 6, '0');
  insert into tlgnc_rail_timetable (
    rail_timetable_id,
    dep_railway_station_id,
    dep_train_no,
    dep_switching_time_min,
    dep_time_min,
    arr_railway_station_id,
    arr_offset_days,
    arr_train_no,
    arr_time_min,
    arr_switching_time_min,
    timetable_comment,
    active_flag,
    ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
  ) values (
    slgnc_rail_timetable.nextval,
    v_dep_railway_station_id,
    v_train_no_departure,
    v_dep_witching_time_min,
    v_dep_time_min,
    v_arr_railway_station_id,
    v_days_offset,
    v_train_no_arrival,
    v_arr_time_min,
    v_arr_switching_time_min,
    v_comment,
    1,
    1, systimestamp, 1, systimestamp
  );
end;
/
show errors;

