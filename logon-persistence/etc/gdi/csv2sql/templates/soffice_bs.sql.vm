set define off

create or replace procedure upsert_soffice_bs (
    v_soffice_cd       in varchar2,
    v_soffice_name     in varchar2,
    v_ctl_act_cd      in number
) is
    v_existing number; -- number of existing records of that key (0 or 1)
begin
  select count(soffice_cd) into v_existing from tlgnr_soffice_bs where soffice_cd = v_soffice_cd;
  if (v_existing > 0) then
    update tlgnr_soffice_bs set
      soffice_name=v_soffice_name,
      ctl_act_cd=v_ctl_act_cd,
      ctl_mod_uid=1,
      ctl_mod_ts=systimestamp
    where
      soffice_cd=v_soffice_cd and (
        /* to identify if something has changed at all, null must be handled specially, because "null != 'something'" would be false! */
        nvl(soffice_name, '(NULL)') != nvl(v_soffice_name, '(NULL)')
        or ctl_act_cd != v_ctl_act_cd
      );
  else
    insert into tlgnr_soffice_bs (
      soffice_cd,
      soffice_name,
      ctl_act_cd,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
    ) values (
      v_soffice_cd,
      v_soffice_name,
      v_ctl_act_cd,
      1, systimestamp, 1, systimestamp
    );
  end if;
end upsert_soffice_bs;
/
