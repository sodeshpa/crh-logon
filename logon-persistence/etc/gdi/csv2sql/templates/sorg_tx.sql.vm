create or replace
procedure insnotexist_sorg_tx (
    p_sorg_cd                      in varchar2,
    p_lang_cd                      in varchar2,
    p_address_name                 in varchar2,
    p_line_phone                   in varchar2,
    p_line_fax                     in varchar2,
    p_line_tax                     in varchar2,
    p_line_email                   in varchar2,
    p_image_del_note_general_info  in varchar2
) is
    v_exists_flag     number;      -- number of existing records of that key (0 or 1)
begin
  dbms_output.enable(100000);

  -- --------------------------------------------------------------------------
  -- Lookup tlgnr_sorg_tx
  
  select count(s.sorg_cd) into v_exists_flag
    from tlgnr_sorg_tx s
  where s.sorg_cd = p_sorg_cd and s.lang_cd = p_lang_cd;

  if (v_exists_flag > 0) then
  
    -- Never update, because data in DB may be more accorate. We dont know if the tlgnr_sorg_bs had been updated or not, because it's completely independent.
    dbms_output.put_line ('NOT updating tlgnr_sorg_tx with (sorg_cd, lang_cd) = (' || p_sorg_cd || ', ' || p_lang_cd || ') - data in DB may be better maintained.');

  else
    insert into tlgnr_sorg_tx (
      sorg_cd,
      lang_cd,
      address_name,
      line_phone,
      line_fax,
      line_tax,
      line_email,
      image_del_note_general_info,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
    ) values (
      p_sorg_cd,
      p_lang_cd,
      p_address_name,
      p_line_phone,
      p_line_fax,
      p_line_tax,
      p_line_email,
      p_image_del_note_general_info,
      1, systimestamp, 1, systimestamp
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnr_sorg_tx (sorg_cd, lang_cd) = (' || p_sorg_cd || ', ' || p_lang_cd || '), address_name = ' || p_address_name || ', etc.');
  end if;

end insnotexist_sorg_tx;
/
show errors;

