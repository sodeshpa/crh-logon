set define off
set serveroutput on

create or replace procedure upsert_trailer (
    v_vendor_sap_no               in varchar2,
    v_active_flag                 in number,
    v_trailer_name                in varchar2,
    v_trailer_plate_no            in varchar2,
    v_trailer_trsp_cat_cd         in number,
    v_trailer_type_cd             in number,
    v_trailer_comment             in varchar2,
    v_tare_weight_t               in number,
    v_manufacturer                in varchar2,
    v_axis_count                  in varchar2,
    v_volume_m3                   in number,
    v_branding_flag               in number,
    v_rfidobject_id               in number,
    v_current_truck_plate_no      in varchar2
) is
    v_existing                    number; -- number of existing records of that key (0 or 1)
    v_existing_id                 number; -- ID of existing record of that key, if exist
    v_exists_truck                number; -- number of existing records of tlgnc_truck with the number plate referred by this trailer (0 or 1)
    v_existing_truck_id           number := NULL ; -- ID of existing record of that key, if exist (for lookup of Truck Number Plate)
begin
  dbms_output.enable(100000);
  -- A record is identified by sap_vendor_id + trailer name
  -- Watch out when it had been renamed -> duplicate. Alternative: number plate, but the current ones don't look good enough
  select count(trailer_id) into v_existing
    from tlgnc_trailer t
    inner join tlgnc_carrier c on (t.carrier_id = c.carrier_id)
    inner join tlgns_sap_vendor s on (c.sap_vendor_id = s.sap_vendor_id)
  where s.sap_id = v_vendor_sap_no
    and t.trailer_name = v_trailer_name;

  -- Preparation: lookup TRUCK_ID by truck_plate_no if passed
  if (v_current_truck_plate_no is not null) then
    select count(truck_id) into v_exists_truck from tlgnc_truck t where t.truck_plate_no = v_current_truck_plate_no;
    if (v_exists_truck > 0) then
      select t.truck_id into v_existing_truck_id
      from tlgnc_truck t where t.truck_plate_no = v_current_truck_plate_no;
    else
      dbms_output.put_line ('  ERROR: tlgnc_trailer: TRUCK ''' || v_current_truck_plate_no ||''' not found! Will use null instead = no current truck.');
    end if;
  end if;


  if (v_existing > 0) then
    -- update
    select trailer_id into v_existing_id
      from tlgnc_trailer t
      inner join tlgnc_carrier c on (t.carrier_id = c.carrier_id)
      inner join tlgns_sap_vendor s on (c.sap_vendor_id = s.sap_vendor_id)
    where s.sap_id = v_vendor_sap_no
      and t.trailer_name = v_trailer_name;

    update tlgnc_trailer set
      /* trailer_id, carrier_id - do not update */
      active_flag = v_active_flag,
      /* trailer_name - do not update */
      trailer_plate_no          = v_trailer_plate_no,
      trailer_trsp_cat_cd       = v_trailer_trsp_cat_cd,
      trailer_type_cd           = v_trailer_type_cd,
      trailer_comment           = v_trailer_comment,
      tare_weight_t             = v_tare_weight_t,
      manufacturer              = v_manufacturer,
      axis_count                = v_axis_count,
      volume_m3                 = v_volume_m3,
      branding_flag             = v_branding_flag,
      /* rfidobject_id - do not update */
      /* current_truck_id - do not update, should be done with a proper composition change */
      /* do not touch ctl_cre_uid,ctl_cre_ts */
      ctl_mod_uid=1,
      ctl_mod_ts=systimestamp,
      ctl_tcn = ctl_tcn+1
    where
      trailer_id = v_existing_id and (  1 != 1
        /* to identify if something has changed at all, null must be handled specially, because "null != 'something'" would be false! */
        or active_flag                    != v_active_flag
        /* v_trailer_name - do not update */
        or nvl(trailer_plate_no, '(NULL)')!= nvl(v_trailer_plate_no, '(NULL)')
        or trailer_trsp_cat_cd            != v_trailer_trsp_cat_cd
        or trailer_type_cd                != v_trailer_type_cd
        or nvl(trailer_comment, '(NULL)') != nvl(v_trailer_comment, '(NULL)')
        or tare_weight_t                  != v_tare_weight_t
        or nvl(manufacturer, '(NULL)')    != nvl(v_manufacturer, '(NULL)')
        or nvl(axis_count, '(NULL)')      != nvl(v_axis_count, '(NULL)')
        or volume_m3                      != v_volume_m3
        or branding_flag                  != v_branding_flag
        /* rfidobject_id, current_truck_id : never update */
      );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_trailer with id=' || v_existing_id || '; owned by vendor sap id=' || v_vendor_sap_no || '.');

  else
    insert into tlgnc_trailer (
      trailer_id,
      carrier_id,
      active_flag,
      sap_vehicle_char_cd,
      trailer_name,
      trailer_plate_no,
      trailer_trsp_cat_cd,
      trailer_type_cd,
      trailer_comment,
      tare_weight_t,
      manufacturer,
      axis_count,
      volume_m3,
      branding_flag,
      rfidobject_id,
      current_truck_id,
      nr_chambers,
      max_net_weight_chamber1_t,
      max_net_weight_chamber2_t,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) (select
        slgnc_trailer.nextval,
        c.carrier_id,
        v_active_flag,
        0,
        v_trailer_name,
        v_trailer_plate_no,
        v_trailer_trsp_cat_cd,
        v_trailer_type_cd,
        v_trailer_comment,
        v_tare_weight_t,
        v_manufacturer,
        v_axis_count,
        v_volume_m3,
        v_branding_flag,
        null /* Ignore rfidobject_id */,
        v_existing_truck_id,
        1,
        0,
        0,
        1, systimestamp, 1, systimestamp, 0
      from tlgnc_carrier c
      inner join tlgns_sap_vendor s on (c.sap_vendor_id = s.sap_vendor_id)
      where s.sap_id = v_vendor_sap_no
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_trailer with new id=' || slgnc_trailer.currval || '; owned by vendor sap id=' || v_vendor_sap_no || '.');

  end if;
end upsert_trailer;
/
show errors;

