-- upsert_mat_compat
-------------------------------------------------------------------------------
create or replace
procedure upsert_mat_compat (
    p_from_sap_material_no         in varchar2,
    v_insignificant_threshold_perc in number,
    v_force_identical_threshold_pc in number,
    v_compat_comment               in varchar2,
    v_incompat_comment             in varchar2
) is
    v_exists_flag     number; -- number of existing records of that key (0 or 1)
    v_existing_id     number; -- ID of existing record of that key, if exist
    v_sap_material_id number; -- ID of the 'from' sap_material
begin
  dbms_output.enable(100000);

  -- Lookup Material
  select count(m.sap_material_id) into v_exists_flag
    from tlgns_sap_material m
  where m.sap_material_no = p_from_sap_material_no;
  if (v_exists_flag = 0) then
    dbms_output.put_line ('  ERROR: tlgnc_mat_compat: Material with SAP-No ''' || p_from_sap_material_no ||''' not found! Cannot insert mat_compat.');
    return;
  end if;
  select m.sap_material_id into v_sap_material_id
    from tlgns_sap_material m
  where m.sap_material_no = p_from_sap_material_no;

  -- Check for existing mat_compat entry: Is identified also by the SAP Material no!
  select count(mat_compat_id) into v_exists_flag
    from tlgnc_mat_compat mc
  where mc.from_sap_material_id = v_sap_material_id;

  if (v_exists_flag > 0) then
    -- update
    select mat_compat_id into v_existing_id
      from tlgnc_mat_compat mc
    where mc.from_sap_material_id = v_sap_material_id;

    update tlgnc_mat_compat set
      /* mat_compat_id: never updated. from_sap_material_id: as long as this is the business key, cannot change either, actually. */
      from_sap_material_id           = v_sap_material_id,
      insignificant_threshold_perc   = v_insignificant_threshold_perc,
      force_identical_threshold_perc = v_force_identical_threshold_pc,
      compat_comment                 = v_compat_comment,
      incompat_comment               = v_incompat_comment,
      ctl_mod_uid = 1,
      ctl_mod_ts  = systimestamp,
      ctl_tcn     = ctl_tcn+1
    where
        mat_compat_id = v_existing_id and (    1 != 1
        /* to identify if something has changed at all, null must be handled specially for nullable fields, because "null != 'something'" would be false! */
        or from_sap_material_id           != v_sap_material_id               /* not nullable */
        or insignificant_threshold_perc   != v_insignificant_threshold_perc  /* not nullable */
        or force_identical_threshold_perc != v_force_identical_threshold_pc  /* not nullable */
        or 1 = is_different_varchar2 (compat_comment, v_compat_comment)
        or 1 = is_different_varchar2 (incompat_comment, v_incompat_comment)
      );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_mat_compat with id=' || v_existing_id || '; sap_material_id/no=' || v_sap_material_id || '/' || p_from_sap_material_no || '.');

  else
    insert into tlgnc_mat_compat (
      mat_compat_id,
      from_sap_material_id,
      insignificant_threshold_perc,
      force_identical_threshold_perc,
      compat_comment,
      incompat_comment,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) values (
      slgnc_mat_compat.nextval,
      v_sap_material_id,
      v_insignificant_threshold_perc,
      v_force_identical_threshold_pc,
      v_compat_comment,
      v_incompat_comment,
      1, systimestamp, 1, systimestamp, 0
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_mat_compat with new id=' || slgnc_mat_compat.currval || '; sap_material_id/no=' || v_sap_material_id || '/' || p_from_sap_material_no || '.');
  end if;
end upsert_mat_compat;
/
show errors;

