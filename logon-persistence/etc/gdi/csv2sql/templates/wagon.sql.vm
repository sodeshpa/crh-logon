    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_wagon with new id=' || slgnc_wagon.currval || '; rfidobject_id=' || v_rfidobject_id || '; wagon_no=' || v_wagon_no_logon || '.');
  end if;
end upsert_wagon;
