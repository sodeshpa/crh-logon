  dbms_output.enable(100000);

  -- Normalizing input data with how we have it in DB
  v_wagon_no_logon := regexp_replace (v_wagon_no, '[[:punct:][:blank:]]');
  /*dbms_output.put_line ('  DEBUG: v_wagon_no=' || v_wagon_no || ', v_wagon_no_logon=' || v_wagon_no_logon || '.'); */

  v_mech_load_change_logon := 0;
  if (v_mech_load_change = 'Ja') then
    v_mech_load_change_logon := 1;
  end if;

  -- Lookup Type
  select count(wagon_type_cd) into v_existing
    from tlgnr_wagon_type_bs wt
  where wt.wagon_type_name = v_wagon_type;
  if (v_existing = 0) then
    dbms_output.put_line ('  ERROR: tlgnc_wagon: Type ''' || v_wagon_type ||''' not found! Cannot insert wagon.');
    return;
  end if;
  select wt.wagon_type_cd into v_wagon_type_cd
    from tlgnr_wagon_type_bs wt 
  where wt.wagon_type_name = v_wagon_type;

  -- Lookup Keeper
  select count(wagon_keeper_id) into v_existing
    from tlgnc_wagon_keeper wk 
  where wk.wagon_keeper_name = v_keeper;
  if (v_existing = 0) then
    dbms_output.put_line ('  ERROR: tlgnc_wagon: Keeper ''' || v_keeper ||''' not found! Cannot insert wagon.');
    return;
  end if;
  select wk.wagon_keeper_id into v_wagon_keeper_id
    from tlgnc_wagon_keeper wk 
  where wk.wagon_keeper_name = v_keeper;

  -- Lookup return_location by sap_bp_id if passed
  if (v_return_location is not null) then
    select count(sap_bp_id) into v_return_shipto_sap_bp_exists from tlgns_sap_bp b
      where b.sap_id = v_return_location and b.bp_is_shipto = 1;
    if (v_return_shipto_sap_bp_exists > 0) then
      select b.sap_bp_id into v_return_shipto_sap_bp_id
      from tlgns_sap_bp b
      where b.sap_id = v_return_location and b.bp_is_shipto = 1;
    else
      dbms_output.put_line ('  WARNING: tlgnc_wagon: SAP BP ''' || v_return_location ||''' not found! No return location set, recommend to correct data and update wagon.');
      /* not setting to inactive, can still be used, it's a non-mandatory field */
    end if;
  end if;

