set define off
set serveroutput on
-- Default Logon NLS settings - Number format expected with ".", not ","!!
@set_logon_session_settings.sql

create or replace procedure upsert_mat_plant (
    v_sap_material_no               in varchar2,
    v_plant_cd                      in varchar2,
    v_variable_prod_cost_mat        in number,
    v_future_variable_prod_cost     in number,
    p_future_valid_from_dat         in varchar2,
    v_currency_cd                   in varchar2,
    v_cpd_number                    in varchar2,
    v_chromat_reduction_months      in number            
) is
    v_existing    number; -- number of existing records of that key (0 or 1)
    v_existing_id number; -- ID of record to update
    /*-- For lookups */
    v_exists_material               number; -- number of existing records of tlgns_sap_material referred by this mat_plant (0 or 1)
    v_existing_material_id          number := NULL ; -- ID of existing record of that key, if exist (for lookup of material)
    /*-- Parameters/Variables --*/
    /*   May need to be changed if something nok. Initial variable value := passed param value */
    v_future_valid_from_dat    date := NULL;

begin
  -- Preparation: Check date for type / null
  if (p_future_valid_from_dat is not null and length(p_future_valid_from_dat)>8) then
    v_future_valid_from_dat := to_date(substr(p_future_valid_from_dat, 1, 8),'YY-MM-DD');
  end if;

  -- Preparation: lookup by sap_material_no
  select count(sap_material_id) into v_exists_material from tlgns_sap_material m where m.sap_material_no = v_sap_material_no;
  if (v_exists_material > 0) then
    select m.sap_material_id into v_existing_material_id
      from tlgns_sap_material m
      where m.sap_material_no = v_sap_material_no;
  else
    dbms_output.put_line ('  ERROR: tlgnc_mat_plant: SAP Material ''' || v_sap_material_no ||''' not found! Add material, and then rerun this script again.');
    return;
  end if;

  -- A record is identified by e.g. mat_id=1404839, plant='S101' 
  select count(p.mat_plant_id) into v_existing
    from tlgnc_mat_plant p
  where p.sap_material_id = v_existing_material_id
    and p.plant_cd = v_plant_cd;

  if (v_existing > 0) then
    -- update
    select p.mat_plant_id into v_existing_id
      from tlgnc_mat_plant p
    where p.sap_material_id = v_existing_material_id
      and p.plant_cd = v_plant_cd;

    update tlgnc_mat_plant set
      /* do not touch mat_plant_id, sap_material_id, plant_cd */
      variable_prod_cost_mat = v_variable_prod_cost_mat,
      future_variable_prod_cost_mat = v_future_variable_prod_cost,
      future_valid_from_dat = v_future_valid_from_dat,
      currency_cd = v_currency_cd,
      cpd_number = v_cpd_number,
      chromat_reduction_months = v_chromat_reduction_months,
      /* do not touch ctl_cre_uid,ctl_cre_ts */
      ctl_mod_uid = 1,
      ctl_mod_ts = systimestamp,
      ctl_tcn = ctl_tcn+1
    where
      mat_plant_id = v_existing_id and ( (1 != 1)
        /* to identify if something has changed at all, null must be handled specially for nullable fields, because "null != 'something'" would be false! */
        or variable_prod_cost_mat                       !=  v_variable_prod_cost_mat
          or (variable_prod_cost_mat is null            and v_variable_prod_cost_mat is not null)
          or (variable_prod_cost_mat is not null        and v_variable_prod_cost_mat is null)
        or future_variable_prod_cost_mat                !=  v_future_variable_prod_cost
          or (future_variable_prod_cost_mat is null     and v_future_variable_prod_cost is not null)
          or (future_variable_prod_cost_mat is not null and v_future_variable_prod_cost is null)
        or future_valid_from_dat                        !=  v_future_valid_from_dat
          or (future_valid_from_dat is null             and v_future_valid_from_dat is not null)
          or (future_valid_from_dat is not null         and v_future_valid_from_dat is null)
        or currency_cd                                  !=  v_currency_cd
          or (currency_cd is null                       and v_currency_cd is not null)
          or (currency_cd is not null                   and v_currency_cd is null)
        or nvl(cpd_number,   '(NULL)') != nvl(v_cpd_number,    '(NULL)')
        or chromat_reduction_months    != v_chromat_reduction_months
          or (chromat_reduction_months is null     and v_chromat_reduction_months is not null)
          or (chromat_reduction_months is not null and v_chromat_reduction_months is null)
       );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_mat_plant with id=' || v_existing_id || '; plant_cd=' || v_plant_cd || ', logon_material_id/sap_material_no=' || v_existing_material_id || '/' || v_sap_material_no ||'.');

  else
    -- insert
    insert into tlgnc_mat_plant (
      mat_plant_id,
      sap_material_id,
      plant_cd,
      variable_prod_cost_mat,
      future_variable_prod_cost_mat,
      future_valid_from_dat,
      currency_cd,
      cpd_number,
      chromat_reduction_months,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) values (
        slgnc_mat_plant.nextval,
        v_existing_material_id,
        v_plant_cd,
        v_variable_prod_cost_mat,
        v_future_variable_prod_cost,
        v_future_valid_from_dat,
        v_currency_cd,
        v_cpd_number,
        v_chromat_reduction_months,
        1, systimestamp, 1, systimestamp, 0
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_mat_plant with new id=' || slgnc_mat_plant.currval || '; plant_cd=' || v_plant_cd || ', logon_material_id/sap_material_no=' || v_existing_material_id || '/' || v_sap_material_no ||'.');

  end if;
end;
/
