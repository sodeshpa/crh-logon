set define off
set serveroutput on

create or replace procedure upsert_printer_bs (
    v_printer_cd       in number,
    v_printer_name     in varchar2,
    v_printer_uri      in varchar2,
    v_printer_type     in varchar2,
    p_printer_comment  in varchar2,
    v_printer_plant    in varchar2,
    v_printer_lp       in varchar2,
    v_ctl_act_cd       in number
) is
    v_existing number; -- number of existing records of that key (0 or 1)
    v_existing_id   number; -- ID of existing record of that key, if exist
    v_printer_comment  varchar2(200) := v_printer_plant || ', ' || v_printer_lp || ', ' || p_printer_comment;
begin
  dbms_output.enable(100000);
  

  -- A record is identified by the printer_name.
  -- Watch out when it had been renamed -> duplicate.

  select count(printer_cd) into v_existing
  from tlgnr_printer_bs
  where printer_name = v_printer_name;

  if (v_existing > 0) then
    select printer_cd into v_existing_id
    from tlgnr_printer_bs
    where printer_name = v_printer_name;

    update tlgnr_printer_bs set
      printer_name     = v_printer_name,
      printer_uri      = v_printer_uri,
      printer_type     = v_printer_type,
      printer_comment  = v_printer_comment,
      ctl_act_cd       = v_ctl_act_cd,
      /* do not touch ctl_cre_uid,ctl_cre_ts */
      ctl_mod_uid      = 1,
      ctl_mod_ts       = systimestamp
    where
      printer_cd = v_existing_id and (1 != 1 
        /* to identify if something has changed at all, null must be handled specially, because "null != 'something'" would be false! */
        or printer_name                   != v_printer_name       /* can not be different, as long as this is used as the business key... */
        or printer_uri                    != v_printer_uri        /* not nullable */
        or nvl(printer_type,    '(NULL)') != nvl(v_printer_type,    '(NULL)')
        or nvl(printer_comment, '(NULL)') != nvl(v_printer_comment, '(NULL)')
        or ctl_act_cd                     != v_ctl_act_cd
        /* Do NOT test for ctl_mod_uid, ctl_mod_ts */
      );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnr_printer_bs with id=' || v_existing_id || ', name=' || v_printer_name ||'.');

  else
    insert into tlgnr_printer_bs (
      printer_cd,
      printer_name,
      printer_uri,
      printer_type,
      printer_comment,
      ctl_act_cd,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
    ) values (
      v_printer_cd, /* slgnr_printer_bs.nextval - sequence does not work for NGE, where it is generated to start at 1'000'000'000 but cd is only number(4)*/
      v_printer_name,
      v_printer_uri,
      v_printer_type,
      v_printer_comment,
      v_ctl_act_cd,
      1, systimestamp, 1, systimestamp
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnr_printer_bs with new id=' || v_printer_cd || ', name=' || v_printer_name || '.');

  end if;
end upsert_printer_bs;
/
