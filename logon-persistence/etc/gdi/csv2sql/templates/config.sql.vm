-- is_different_varchar2
-------------------------------------------------------------------------------
-- compares two varchars.
-- They are identical either if a) both are null, b) they are equal by "="
-- They are different if a) either is null and the other not, b) different by "="
create or replace function is_different_varchar2 (
    i_a in varchar2,
    i_b in varchar2)
  return number is
begin
  if ((i_a != i_b)
    or (i_a is null and i_b is not null)
    or (i_a is not null and i_b is null)) then
      return 1;
  end if;
  return 0;
end;
/
show errors;

-- Handle config values as follows:
-- - identify by key + instance
-- - if not exist: insert
-- - if exit: do not update ALL, but only the min, max and description.
--   => an already existing value is NEVER updated by this function.
create or replace procedure insert_notexists_config (
    v_key                          in varchar2,
    v_instance                     in varchar2,
    v_min_value                    in varchar2,
    v_max_value                    in varchar2,
    v_value                        in varchar2,
    v_description                  in varchar2
) is
    v_existing                     number;     -- number of existing records of that key (0 or 1)
    v_existing_id                  number;     -- ID of existing record of that key+instance if exist
    v_existing_value               varchar2(1000 char);   -- Value of existing record of that key+instance if exist
begin
  dbms_output.enable(100000);
  
  -- A record is identified by key + instance e.g. 'edifact_import.proxy_host', 'dev'
  select count(cfg.config_cd) into v_existing
    from tlgnr_config cfg
  where cfg.key = v_key and  1 != is_different_varchar2(cfg.instance, v_instance);

  if (v_existing > 0) then
    -- update would normally occur, but here, we NEVER update the value.
    -- TODO: Could check if different, and diplay a WARNING if this is the case? Careful with logging passwords from config!
    select cfg.config_cd into v_existing_id
      from tlgnr_config cfg
    where cfg.key = v_key and 1 != is_different_varchar2 (cfg.instance, v_instance);

    select value into v_existing_value
      from tlgnr_config cfg
    where cfg.config_cd = v_existing_id;

    dbms_output.put_line ('tlgnc_config: Entry key/inst=[' || v_key || '/' || v_instance || '] already EXISTS with config_cd =' || v_existing_id || ', value = ' || v_existing_value || '. Keep existing value, only update min/max/description.');

    update tlgnr_config cfg set
      /* do not touch config_cd, key, instance, value */
      cfg.min_value    = v_min_value,
      cfg.max_value    = v_max_value,
      cfg.description  = v_description,
      cfg.ctl_mod_uid  = 1,
      cfg.ctl_mod_ts   = systimestamp
      -- no TCN on tlgnr_config...
    where config_cd = v_existing_id and ( 1 != 1
      or 1 = is_different_varchar2 (cfg.min_value, v_min_value)
      or 1 = is_different_varchar2 (cfg.max_value, v_max_value)
      or 1 = is_different_varchar2 (cfg.description, v_description)
    );
    dbms_output.put_line ('tlgnr_config: UPDATED min/max/desc if needed: ' || SQL%ROWCOUNT ||' for config_cd=' || v_existing_id || '; key/inst=[' || v_key ||'/'|| v_instance || '].');

  else
    insert into tlgnr_config (
      config_cd,
      key,
      instance,
      min_value,
      max_value,
      value,
      description,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts)
    values (
      slgnr_config.nextval,
      v_key,
      v_instance,
      v_min_value,
      v_max_value,
      v_value,
      v_description,
      1, systimestamp, 1, systimestamp
    );
    dbms_output.put_line ('tlgnr_config: INSERTED ' || SQL%ROWCOUNT ||' tlgnr_config with new id=' || slgnr_config.currval || '; key/inst=[' || v_key ||'/'|| v_instance || '].');

  end if;
end insert_notexists_config;
/
show errors;


