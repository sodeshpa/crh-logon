set define off
set serveroutput on

create or replace procedure upsert_truck (
    v_vendor_sap_no               in varchar2,
    v_active_flag                 in number,
    v_truck_name                  in varchar2,
    v_truck_plate_no              in varchar2,
    v_truck_transport_cat_cd      in number,
    v_truck_type_cd               in number,
    v_manufacturer                in varchar2,
    v_axis_count                  in varchar2,
    v_euro_norm                   in varchar2,
    v_max_gross_weight_t          in number,
    v_tare_weight_t               in number,
    v_has_dustfilter_flag         in number,
    v_volume_m3                   in number,
    v_branding_flag               in number,
    v_truck_comment               in varchar2,
    v_pda_available_flag          in number,
    v_homebase_coord_lat          in number,
    v_homebase_coord_lon          in number,
    v_rfidobject_id               in number,
    v_current_trailer_plate_no    in varchar2, /* Was moved in DB refactoring for 1.1, to trailer.current_truck_id. Always null here. */
    v_pools                       in varchar2
) is
    v_existing      number; -- number of existing records of that key (0 or 1)
    v_existing_id   number; -- ID of existing record of that key, if exist
    v_exists_trailer               number; -- number of existing records of tlgnc_trailer with the number plate referred by this truck (0 or 1)
    v_existing_trailer_id          number := NULL ; -- ID of existing record of that key, if exist (for lookup of Trailer Number Plate)
    sql_statement   varchar2(500);
begin
  dbms_output.enable(100000);
  -- A record is identified by sap_vendor_id + truck name
  -- Watch out when it had been renamed -> duplicate. Alternative: number plate, but the current ones don't look good enough
  select count(truck_id) into v_existing
    from tlgnc_truck t
    inner join tlgnc_carrier c on (t.carrier_id = c.carrier_id)
    inner join tlgns_sap_vendor s on (c.sap_vendor_id = s.sap_vendor_id)
  where s.sap_id = v_vendor_sap_no
    and t.truck_name = v_truck_name;

  -- Preparation: lookup TRAILER_ID by v_current_trailer_plate_no if passed
  if (v_current_trailer_plate_no is not null) then
    select count(trailer_id) into v_exists_trailer from tlgnc_trailer t where t.trailer_plate_no = v_current_trailer_plate_no;
    if (v_exists_trailer > 0) then
      select t.trailer_id into v_existing_trailer_id
      from tlgnc_trailer t where t.trailer_plate_no = v_current_trailer_plate_no;
    else
      dbms_output.put_line ('  ERROR: tlgnc_truck: TRAILER ''' || v_current_trailer_plate_no ||''' not found! Will use null instead = no current trailer.');
    end if;
  end if;

  if (v_existing > 0) then
    -- update
    select truck_id into v_existing_id
      from tlgnc_truck t
      inner join tlgnc_carrier c on (t.carrier_id = c.carrier_id)
      inner join tlgns_sap_vendor s on (c.sap_vendor_id = s.sap_vendor_id)
    where s.sap_id = v_vendor_sap_no
      and t.truck_name = v_truck_name;

    update tlgnc_truck set
      /* truck_id, carrier_id - do not update */
      active_flag             = v_active_flag,
      truck_plate_no          = v_truck_plate_no,
      truck_transport_cat_cd  = v_truck_transport_cat_cd,
      truck_type_cd           = v_truck_type_cd,
      manufacturer            = v_manufacturer,
      axis_count              = v_axis_count,
      euro_norm               = v_euro_norm,
      max_gross_weight_t      = v_max_gross_weight_t,
      tare_weight_t /*1.0: tara_weight_t, 1.1: tare_weight_t */ = v_tare_weight_t,
      has_dustfilter_flag     = v_has_dustfilter_flag,
      volume_m3               = v_volume_m3,
      branding_flag           = v_branding_flag,
      truck_comment           = v_truck_comment,
      pda_available_flag      = v_pda_available_flag,
      homebase_coord_lat      = v_homebase_coord_lat,
      homebase_coord_lon      = v_homebase_coord_lon,
      /* rfidobject_id - do not update */
      /* current_trailer_id - do not update, should be done with a proper composition change. But was moved in 1.1 DB refactoring to trailer.current_truck_id anyway. */
      /* do not touch ctl_cre_uid,ctl_cre_ts */
      ctl_mod_uid = 1,
      ctl_mod_ts  = systimestamp,
      ctl_tcn     = ctl_tcn+1
    where
      truck_id = v_existing_id and (    1 != 1
        /* to identify if something has changed at all, null must be handled specially, because "null != 'something'" would be false! */
        or active_flag                       != v_active_flag
        or nvl(truck_plate_no, '(NULL)')  != nvl(v_truck_plate_no, '(NULL)')
        or truck_transport_cat_cd         != v_truck_transport_cat_cd
        or truck_type_cd                  != v_truck_type_cd
        or nvl(manufacturer, '(NULL)')    != nvl(v_manufacturer, '(NULL)')
        or nvl(axis_count, '(NULL)')      != nvl(v_axis_count, '(NULL)')
        or nvl(euro_norm, '(NULL)')       != nvl(v_euro_norm, '(NULL)')
        or max_gross_weight_t             != v_max_gross_weight_t
        /* 1.0: tara_weight, 1.1: tare_weight_t */
        or tare_weight_t                  != v_tare_weight_t
        or has_dustfilter_flag            != v_has_dustfilter_flag
        or volume_m3                      != v_volume_m3
        or branding_flag                  != v_branding_flag
        or nvl(truck_comment, '(NULL)')   != nvl(v_truck_comment, '(NULL)')
        or pda_available_flag             != v_pda_available_flag
        or homebase_coord_lat             != v_homebase_coord_lat
        or homebase_coord_lon             != v_homebase_coord_lon
        /* rfidobject_id - do not update */
      );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_truck with id=' || v_existing_id || '; owned by vendor sap id=' || v_vendor_sap_no || '.');

    -- Pool assignment are not updated, too complicated for a dataload, too easy for Crh to set in the UI.

  else
    insert into tlgnc_truck (
      truck_id,
      carrier_id,
      active_flag,
      sap_vehicle_char_cd,
      truck_name,
      truck_plate_no,
      truck_transport_cat_cd,
      truck_type_cd,
      manufacturer,
      axis_count,
      euro_norm,
      max_gross_weight_t,
      tare_weight_t /*1.0: tara_weight_t, 1.1: tare_weight_t */,
      has_dustfilter_flag,
      volume_m3,
      branding_flag,
      truck_comment,
      pda_available_flag,
      homebase_coord_lat,
      homebase_coord_lon,
      rfidobject_id,
      /* current_trailer_id only in 1.0, no longer in 1.1 */
      /* Only since 1.1: */
      nr_chambers,
      max_net_weight_chamber1_t,
      max_net_weight_chamber2_t,
      priority,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) ( select
        slgnc_truck.nextval,
        c.carrier_id,
        v_active_flag,
        0,
        v_truck_name,
        v_truck_plate_no,
        v_truck_transport_cat_cd,
        v_truck_type_cd,
        v_manufacturer,
        v_axis_count,
        v_euro_norm,
        v_max_gross_weight_t,
        v_tare_weight_t,
        v_has_dustfilter_flag,
        v_volume_m3,
        v_branding_flag,
        v_truck_comment,
        v_pda_available_flag,
        v_homebase_coord_lat,
        v_homebase_coord_lon,
        null /* Ignore rfidobject_id */,
        /* v_existing_trailer_id only in 1.0, no longer in 1.1 */
        1,
        v_max_gross_weight_t - v_tare_weight_t,
        0,
        99,
        1, systimestamp, 1, systimestamp, 0
      from tlgnc_carrier c
      inner join tlgns_sap_vendor s on (c.sap_vendor_id = s.sap_vendor_id)
      where s.sap_id = v_vendor_sap_no
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_truck with new id=' || slgnc_truck.currval || '; owned by vendor sap id=' || v_vendor_sap_no || '.');

    /* hack with execute immediate, because we want truck pools to be something like 1,2,3 to get 'where pool_id in (1,2,3)' */
    sql_statement := '
    insert into tlgnc_pool_truck (
      pool_truck_id, pool_id, truck_id,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) ( select
        slgnc_pool_truck.nextval, p.pool_id, slgnc_truck.currval,
        1, systimestamp, 1, systimestamp, 0
      from tlgnc_pool p
      where p.pool_id in ('|| v_pools ||') )';
    -- dbms_output.put_line (sql_statement); /* debug */
    execute immediate sql_statement;
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_pool_truck with last id=' || slgnc_pool_truck.currval || ' for pools=' || v_pools || '.');

  end if;
end upsert_truck;
/
show errors;

