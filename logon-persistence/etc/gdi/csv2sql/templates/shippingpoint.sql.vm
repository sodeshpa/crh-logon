-- upsert_shippingpoint
-------------------------------------------------------------------------------
create or replace procedure upsert_shippingpoint (
    v_plant_cd                  in varchar2, /* sp.plant_cd */
    v_sap_shippingpoint_no      in varchar2, /* sp.sap_shippingpoint_no */
    v_known_also_in_sap_flag    in number,
    v_shippingpoint_name        in varchar2,
    v_shipppoint_type_cd        in number,
    v_sap_shipping_cond_cd      in varchar2,
    v_storage_location          in varchar2,
    v_uic_country_cd            in number,
    v_railway_station_no        in varchar2,
    v_railway_staion_ld_point   in varchar2,
    v_weigh_system_sp_cd        in varchar2,
    v_lds_server                in varchar2,
    v_shippingpoint_comment     in varchar2,
    v_coord_lat                 in number,
    v_coord_lon                 in number,
    v_coord_fix_flag            in number,
    v_geofence_radius           in number,
    v_send_plant_cd             in varchar2, /* sp.plant_cd for send_sap */
    v_send_sap_shippingpoint_no in varchar2  /* sp.sap_shippingpoint_no for send_sap */
    /* no support for uom_cd, var_handling_cost_mat, future_var_handling_cost_mat, future_valid_from_dat, currency_cd */
) is
    v_existing                  number; -- number of existing records of that key (0 or 1)
    v_existing_id               number; -- ID of existing record of that key, if exist
    v_railway_station_id        number; -- Looked up ID of railway station
    v_send_sap_shippingpoint_id number; -- Looked up ID of send to SAP shippingpoint id
begin
  dbms_output.enable(100000);

  -- Preparation: Lookup railway station
  if (v_uic_country_cd is not null and v_railway_station_id is not null) then
    select rs.railway_station_id into v_railway_station_id
      from tlgnc_railway_station rs
    where rs.uic_country_cd = v_uic_country_cd
      and rs.railway_station_no = lpad(v_railway_station_no, 6, '0');
  end if;

  -- Preparation: Lookup send SAP Shippingpoint id
  if (v_send_plant_cd is not null and v_send_sap_shippingpoint_no is not null) then
    /* TODO: could add verbose output, if lookup fails. Low prio */
    select shippingpoint_id into v_send_sap_shippingpoint_id
      from tlgnc_shippingpoint sp
    where sp.plant_cd = v_send_plant_cd
      and sp.sap_shippingpoint_no = v_send_sap_shippingpoint_no;
  end if;

  -- A record is identified by e.g. plant='S101' sap_sp_no='S036'
  select count(shippingpoint_id) into v_existing
    from tlgnc_shippingpoint sp
  where sp.plant_cd = v_plant_cd
    and sp.sap_shippingpoint_no = v_sap_shippingpoint_no;

  if (v_existing > 0) then
    -- update
    select shippingpoint_id into v_existing_id
      from tlgnc_shippingpoint sp
    where sp.plant_cd = v_plant_cd
      and sp.sap_shippingpoint_no = v_sap_shippingpoint_no;

    update tlgnc_shippingpoint set
      /* do not touch shippingpoint_id, plant/sap_shippingpoint_no */
      known_also_in_sap_flag        = v_known_also_in_sap_flag,
      shippingpoint_name            = v_shippingpoint_name,
      shipppoint_type_cd            = v_shipppoint_type_cd,
      sap_shipping_cond_cd          = v_sap_shipping_cond_cd,
      storage_location              = v_storage_location,
      railway_station_id            = v_railway_station_id,
      railway_station_loading_point = v_railway_staion_ld_point,
      weigh_system_sp_cd            = v_weigh_system_sp_cd,
      lds_server                    = v_lds_server,
      shippingpoint_comment         = v_shippingpoint_comment,
      coord_lat                     = v_coord_lat,
      coord_lon                     = v_coord_lon,
      coord_fix_flag                = v_coord_fix_flag,
      geofence_radius               = v_geofence_radius,
      send_sap_shippingpoint_id     = v_send_sap_shippingpoint_id,
      /* no support for uom_cd, var_handling_cost_mat, future_var_handling_cost_mat, future_valid_from_dat, currency_cd */
      /* do not touch ctl_cre_uid,ctl_cre_ts */
      ctl_mod_uid=1,
      ctl_mod_ts=systimestamp,
      ctl_tcn = ctl_tcn+1
    where
      shippingpoint_id = v_existing_id and ( 1 != 1
        /* to identify if something has changed at all, null must be handled specially, because "null != 'something'" would be false! */
        or 1 = is_different_varchar2 (plant_cd                     , v_plant_cd)
        or 1 = is_different_varchar2 (sap_shippingpoint_no         , v_sap_shippingpoint_no)
        or 1 = is_different_number   (known_also_in_sap_flag       , v_known_also_in_sap_flag)
        or 1 = is_different_varchar2 (shippingpoint_name           , v_shippingpoint_name)
        or 1 = is_different_number   (shipppoint_type_cd           , v_shipppoint_type_cd)
        or 1 = is_different_varchar2 (sap_shipping_cond_cd         , v_sap_shipping_cond_cd)
        or 1 = is_different_varchar2 (storage_location             , v_storage_location)
        or 1 = is_different_number   (railway_station_id           , v_railway_station_id)
        or 1 = is_different_varchar2 (railway_station_loading_point, v_railway_staion_ld_point)
        or 1 = is_different_number   (weigh_system_sp_cd           , v_weigh_system_sp_cd)
        or 1 = is_different_varchar2 (lds_server                   , v_lds_server)
        or 1 = is_different_varchar2 (shippingpoint_comment        , v_shippingpoint_comment)
        or 1 = is_different_number   (coord_lat                    , v_coord_lat)
        or 1 = is_different_number   (coord_lon                    , v_coord_lon)
        or 1 = is_different_number   (coord_fix_flag               , v_coord_fix_flag)
        or 1 = is_different_number   (geofence_radius              , v_geofence_radius)
        or 1 = is_different_number   (send_sap_shippingpoint_id    , v_send_sap_shippingpoint_id)
        /* no parameters currently: uom_cd, var_handling_cost_mat, future_var_handling_cost_mat, future_valid_from_dat, currency_cd */
      );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_shippingpoint with id=' || v_existing_id || '; plant_cd=' || v_plant_cd || ', sap_shippingpoint_no=' || v_sap_shippingpoint_no || ', name=' || v_shippingpoint_name ||'.');

  else
    insert into tlgnc_shippingpoint (
      shippingpoint_id,
      plant_cd,
      sap_shippingpoint_no,
      known_also_in_sap_flag,
      shippingpoint_name,
      shipppoint_type_cd,
      sap_shipping_cond_cd,
      storage_location,
      railway_station_id,
      railway_station_loading_point,
      weigh_system_sp_cd,
      lds_server,
      shippingpoint_comment,
      coord_lat,
      coord_lon,
      coord_fix_flag,
      geofence_radius,
      send_sap_shippingpoint_id,
      fvl_mix_shipto_per_wagon_flag,
      /* no support for uom_cd, var_handling_cost_mat, future_var_handling_cost_mat, future_valid_from_dat, currency_cd */
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) values (
      slgnc_shippingpoint.nextval,
      v_plant_cd,
      v_sap_shippingpoint_no,
      v_known_also_in_sap_flag,
      v_shippingpoint_name,
      v_shipppoint_type_cd,
      v_sap_shipping_cond_cd,
      v_storage_location,
      v_railway_station_id,
      v_railway_staion_ld_point,
      v_weigh_system_sp_cd,
      v_lds_server,
      v_shippingpoint_comment,
      v_coord_lat,
      v_coord_lon,
      v_coord_fix_flag,
      v_geofence_radius,
      v_send_sap_shippingpoint_id,
      0,
      /* no support for uom_cd, var_handling_cost_mat, future_var_handling_cost_mat, future_valid_from_dat, currency_cd */
      1, systimestamp, 1, systimestamp, 0
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_shippingpoint with new id=' || slgnc_shippingpoint.currval || '; plant_cd=' || v_plant_cd || ', sap_shippingpoint_no=' || v_sap_shippingpoint_no || ', name=' || v_shippingpoint_name ||'.');

  end if;
end upsert_shippingpoint;
/
show errors;

