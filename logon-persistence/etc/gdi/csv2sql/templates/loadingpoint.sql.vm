-- upsert_loadingpoint
-------------------------------------------------------------------------------
create or replace procedure upsert_loadingpoint (
    v_sp_plant_cd               in varchar2, /* sp.plant_cd */
    v_sp_sap_shippingpoint_no   in varchar2, /* sp.sap_shippingpoint_no */
    v_loadingpoint_name         in varchar2,
    v_loadingpoint_object_label in varchar2,
    v_package_type_cd           in number,
    v_weigh_system_lp_cd        in number,
    v_deliv_note_print_type_cd  in number,
    v_weigh_system_lp_no        in varchar2,
    v_printer_name              in varchar2,
    v_loadingpoint_comment      in varchar2,
    v_active_flag               in number,
    v_loading_time              in number,
    v_gross_weight_limit_kg     in number,
    v_rfidobject_id             in number
) is
    v_existing      number; -- number of existing records of that key (0 or 1)
    v_existing_id   number; -- ID of existing record of that key, if exist
begin
  dbms_output.enable(100000);

  -- A record is identified by e.g. plant='S101' sap_sp_no='S036' PLUS NAME (at least for now...)
  -- Watch out when it had been renamed -> duplicate. Alternative: LSID, but it's not mandatory!!!
  select count(loadingpoint_id) into v_existing
    from tlgnc_loadingpoint lp
    inner join tlgnc_shippingpoint sp on (lp.shippingpoint_id = sp.shippingpoint_id)
  where sp.plant_cd = v_sp_plant_cd
    and sp.sap_shippingpoint_no = v_sp_sap_shippingpoint_no
    and lp.loadingpoint_name = v_loadingpoint_name;

  if (v_existing > 0) then
    -- update
    select loadingpoint_id into v_existing_id
      from tlgnc_loadingpoint lp
      inner join tlgnc_shippingpoint sp on (lp.shippingpoint_id = sp.shippingpoint_id)
    where sp.plant_cd = v_sp_plant_cd
      and sp.sap_shippingpoint_no = v_sp_sap_shippingpoint_no
      and lp.loadingpoint_name = v_loadingpoint_name;

    update tlgnc_loadingpoint set
      /* do not touch loadingpoint_id, shippingpoint_id (plant/sap_shippingpoint_no) */
      loadingpoint_name         = v_loadingpoint_name,
      loadingpoint_object_label = v_loadingpoint_object_label,
      package_type_cd           = v_package_type_cd,
      weigh_system_lp_cd        = v_weigh_system_lp_cd,
      deliv_note_print_type_cd  = v_deliv_note_print_type_cd,
      weigh_system_loadingpoint_no = v_weigh_system_lp_no,
      /*v_printer_cd            = lookup: v_printer_name, lookup needed to find printer cd!*/
      loadingpoint_comment      = v_loadingpoint_comment,
      active_flag               = v_active_flag,
      loading_time              = v_loading_time,
      gross_weight_limit_kg     = v_gross_weight_limit_kg,
      /*rfidobject_id             = v_rfidobject_id - never update */
      /* do not touch ctl_cre_uid,ctl_cre_ts */
      ctl_mod_uid=1,
      ctl_mod_ts=systimestamp,
      ctl_tcn = ctl_tcn+1
    where
      loadingpoint_id=v_existing_id and ( 1 != 1
        /* to identify if something has changed at all, null must be handled specially, because "null != 'something'" would be false! */
        or 1 = is_different_varchar2 (loadingpoint_name            , v_loadingpoint_name)
        or 1 = is_different_varchar2 (loadingpoint_object_label    , v_loadingpoint_object_label)
        or 1 = is_different_number   (package_type_cd              , v_package_type_cd)
        or 1 = is_different_number   (weigh_system_lp_cd           , v_weigh_system_lp_cd)
        or 1 = is_different_number   (deliv_note_print_type_cd     , v_deliv_note_print_type_cd)
        or 1 = is_different_varchar2 (weigh_system_loadingpoint_no , v_weigh_system_lp_no)
        /*v_printer_cd : lookup v_printer_name, lookup needed to find printer cd!*/
        or 1 = is_different_varchar2 (loadingpoint_comment         , v_loadingpoint_comment)
        or 1 = is_different_number   (active_flag                  , v_active_flag)
        or 1 = is_different_number   (loading_time                 , v_loading_time)
        or 1 = is_different_number   (gross_weight_limit_kg        , v_gross_weight_limit_kg)
        /* rfidobject_id : never update */
      );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_loadingpoint with id=' || v_existing_id || '; plant_cd=' || v_sp_plant_cd || ', sap_shippingpoint_no=' || v_sp_sap_shippingpoint_no || ', name=' || v_loadingpoint_name ||'.');

  else
    insert into tlgnc_loadingpoint (
      loadingpoint_id,
      shippingpoint_id,
      loadingpoint_name,
      loadingpoint_object_label,
      package_type_cd,
      weigh_system_lp_cd,
      deliv_note_print_type_cd,
      weigh_system_loadingpoint_no,
      /* FIXME: printer_cd missing */
      loadingpoint_comment,
      active_flag,
      loading_time,
      gross_weight_limit_kg,
      rfidobject_id,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) (select
        slgnc_loadingpoint.nextval,
        sp.shippingpoint_id,
        v_loadingpoint_name,
        v_loadingpoint_object_label,
        v_package_type_cd,
        v_weigh_system_lp_cd,
        v_deliv_note_print_type_cd,
        v_weigh_system_lp_no,
        v_loadingpoint_comment,
        v_active_flag,
        v_loading_time,
        v_gross_weight_limit_kg,
        null, /* Ignore rfidobject_id */
        1, systimestamp, 1, systimestamp, 0
      from tlgnc_shippingpoint sp
      where sp.plant_cd = v_sp_plant_cd
      and   sp.sap_shippingpoint_no = v_sp_sap_shippingpoint_no
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_loadingpoint with new id=X; plant_cd=' || v_sp_plant_cd || ', sap_shippingpoint_no=' || v_sp_sap_shippingpoint_no || ', name=' || v_loadingpoint_name ||'.');

  end if;
end upsert_loadingpoint;
/
show errors;

