set define off
set serveroutput on

create or replace procedure upsert_railway_station (
    v_uic_country_cd            in number,
    v_railway_station_no        in varchar2, 
    v_railway_station_name      in varchar2, 
    v_active_flag     			in number
) is
    v_existing      number; -- number of existing records of that key (0 or 1)
    v_existing_id   number; -- ID of existing record of that key, if exist
    v_count_uic_country  number; -- number of existing records of UIC countries (0 or 1)
    v_railway_station_pad  varchar2(6); -- number of existing records of UIC countries (0 or 1)
begin
  dbms_output.enable(100000);
  
  -- A record is identified by e.g. uic_country_cd='85' and railway_station_no='0xxxxx'
 
  -- Check if uic_country_cd known
  select count(uic_country_cd) into v_count_uic_country from tlgnr_uic_country_bs where uic_country_cd =  v_uic_country_cd;
  
  if (v_count_uic_country > 0) then

    -- Make sure that railway_station_no is 6 dgits long. otherwise fill with leeding zeros. 
    v_railway_station_pad := lpad(v_railway_station_no, 6, '0');

	  select count(railway_station_id) into v_existing
	    from tlgnc_railway_station rws
	    where uic_country_cd = v_uic_country_cd and railway_station_no = v_railway_station_pad;
	  if (v_existing > 0) then
	    -- update
	    select railway_station_id into v_existing_id
	      from tlgnc_railway_station rws
	      where uic_country_cd = v_uic_country_cd and railway_station_no = v_railway_station_pad;
	
	    update tlgnc_railway_station set
	      /* do not touch railway_station_id */
	      railway_station_name      = v_railway_station_name,
	      active_flag				= v_active_flag,
	      /* do not touch ctl_cre_uid,ctl_cre_ts */
	      ctl_mod_uid=1,
	      ctl_mod_ts=systimestamp,
	      ctl_tcn = ctl_tcn+1
	    where
	      railway_station_id=v_existing_id and (
          /* to identify if something has changed at all, null must be handled specially, because "null != 'something'" would be false! */
          nvl(railway_station_name, '(NULL)') != nvl(v_railway_station_name, '(NULL)')
          or active_flag                      != v_active_flag
        );
	    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_railway_station with id=' || v_existing_id || '; uic_country_cd=' || v_uic_country_cd || ', railway_station_no=' || v_railway_station_pad ||'.');
	
	  else
	    insert into tlgnc_railway_station (
	      railway_station_id,
	      uic_country_cd,
	      railway_station_no,
	      railway_station_name,
	      active_flag,
	      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
	    ) values (
	        slgnc_railway_station.nextval,
	        v_uic_country_cd,
	        v_railway_station_pad,
	        v_railway_station_name,
	        v_active_flag,
	        1, systimestamp, 1, systimestamp, 0
	    );
	    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_railway_station with new id=' || slgnc_railway_station.currval || '; uic_country_cd=' || v_uic_country_cd || ', railway_station_no=' || v_railway_station_pad || ', railway_station_name=' || v_railway_station_name ||'.');
	  end if;
  else
    dbms_output.put_line ('ERROR: Could not insert record. UIC Country Code not found. uic_country_cd=' || v_uic_country_cd || ', railway_station_no=' || v_railway_station_pad || ', railway_station_name=' || v_railway_station_name ||'.');	 

  end if;
end upsert_railway_station;
/
show errors;

#parse("macros.hvm")
