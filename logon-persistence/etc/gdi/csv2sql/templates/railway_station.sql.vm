#set($railway_station_name = $railway_station_name.replaceAll("'", "''"))
#set($active_flag = "#get(3)")
prompt Inserting/Updating tlgnc_railway_station '$uic_country_cd' '$railway_station_no'
execute upsert_railway_station ('$uic_country_cd', '$railway_station_no', '$railway_station_name', $active_flag);

#end
#end
