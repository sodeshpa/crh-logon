-- upsert_plant
-------------------------------------------------------------------------------
create or replace
procedure upsert_plant (
    p_companycode_cd               in varchar2,
    p_plant_cd                     in varchar2,
    p_plant_name                   in varchar2,
    p_production_plant             in number,
    p_sap_inventory_managed        in number,
    p_coord_lat                    in number,
    p_coord_lon                    in number,
    p_storage_loc_bag_in_transit   in varchar2,
    p_storage_loc_bulk_in_transit  in varchar2,
    p_ctl_act_cd                   in number
) is
    v_exists_flag     number;      -- number of existing records of that key (0 or 1)
    v_existing_id     number;      -- ID of existing record of that key, if exist
    v_production_plant             number := p_production_plant;
    v_sap_inventory_managed        number := p_sap_inventory_managed;
begin
  dbms_output.enable(100000);

  -- Be tolerant against bad initial data input: treat null as 0 for non-nullable numbers
  if (v_production_plant is null) then
    v_production_plant := 0;
  end if;
  if (v_sap_inventory_managed is null) then
    v_sap_inventory_managed := 0;
  end if;
  

  -- --------------------------------------------------------------------------
  -- ----- Start with PLANT, because there is a FK from plant_compcode -> plant.

  -- Lookup plant.
  select count(p.plant_cd) into v_exists_flag
    from tlgnr_plant_bs p
  where p.plant_cd = p_plant_cd;

  if (v_exists_flag > 0) then
    -- update, bot ONLY if the new record is ACTIVE
      /*
        Reason for this: C0 and C1 initial data are "the same", but not maintained in the same good quality.
        So, if we load data from both clusters, it could be that the less well maintained would overwrite the good.
        Because this is bad we at least require it to be active!
      */
    if (p_ctl_act_cd != 1) then
      dbms_output.put_line ('NOT updating tlgnr_plant_bs with plant_cd = ' || p_plant_cd || ', because ctl_act_cd is 0 in loader and data in DB may be better maintained.');
    
    else
    
      update tlgnr_plant_bs set
        /* plant_cd: cannot update because this is the key */
        plant_name                  = p_plant_name,
        production_plant            = v_production_plant,
        sap_inventory_managed       = v_sap_inventory_managed,
        coord_lat                   = p_coord_lat,
        coord_lon                   = p_coord_lon,
        storage_loc_bag_in_transit  = p_storage_loc_bag_in_transit,
        storage_loc_bulk_in_transit = p_storage_loc_bulk_in_transit,
        ctl_act_cd                  = p_ctl_act_cd,
        ctl_mod_uid = 1,
        ctl_mod_ts  = systimestamp
      where
        plant_cd = p_plant_cd and (    1 != 1
          /* to identify if something has changed at all, null must be handled specially for nullable fields, because "null != 'something'" would be false! */
          or plant_name            != p_plant_name            /* not nullable */
          or 1 = is_different_number   (production_plant, v_production_plant)
          or 1 = is_different_number   (sap_inventory_managed, v_sap_inventory_managed)
          or 1 = is_different_number   (coord_lat, p_coord_lat)
          or 1 = is_different_number   (coord_lon, p_coord_lon)
          or 1 = is_different_varchar2 (storage_loc_bag_in_transit,  p_storage_loc_bag_in_transit)
          or 1 = is_different_varchar2 (storage_loc_bulk_in_transit, p_storage_loc_bulk_in_transit)
          or ctl_act_cd            != p_ctl_act_cd            /* not nullable */
      );
      dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnr_plant_bs with plant_cd' || p_plant_cd || '; plant_name = ' || p_plant_name || '.');
  end if;

  else
    insert into tlgnr_plant_bs (
      plant_cd,
      plant_name,
      production_plant,
      sap_inventory_managed,
      coord_lat,
      coord_lon,
      storage_loc_bag_in_transit,
      storage_loc_bulk_in_transit,
      ctl_act_cd,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
    ) values (
      p_plant_cd,
      p_plant_name,
      v_production_plant,
      v_sap_inventory_managed,
      p_coord_lat,
      p_coord_lon,
      p_storage_loc_bag_in_transit,
      p_storage_loc_bulk_in_transit,
      p_ctl_act_cd,
      1, systimestamp, 1, systimestamp
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnr_plant_bs with plant_cd=' || p_plant_cd || '; plant_name = ' || p_plant_name || '.');
  end if;

  -- --------------------------------------------------------------------------
  -- ----- Same, but with Plant_COMPCODE. Do an INDEPENDENT insert or update!

  -- Lookup plant_compcode.
  -- By plant_cd is enough, not by (plant, companycode_cd). Reason: plant : plant_compcode is 1:1
  select count(pc.plant_compcode_id) into v_exists_flag
    from tlgnc_plant_compcode pc
  where pc.plant_cd = p_plant_cd;

  if (v_exists_flag > 0) then
    -- update
    select pc.plant_compcode_id into v_existing_id
      from tlgnc_plant_compcode pc
    where pc.plant_cd = p_plant_cd;

    update tlgnc_plant_compcode set
      /* plant_compcode_id: cannot updated because this is the key */
      /* plant_cd: makes no sense to update, because lookup was via this key */
      companycode_cd = p_companycode_cd,
      ctl_mod_uid = 1,
      ctl_mod_ts  = systimestamp,
      ctl_tcn     = ctl_tcn+1
    where
        plant_compcode_id = v_existing_id and (    1 != 1
        /* to identify if something has changed at all, null must be handled specially for nullable fields, because "null != 'something'" would be false! */
        or companycode_cd != p_companycode_cd /* not nullable */
    );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_plant_compcode with id=' || v_existing_id || '; plant_cd/companycode_cd ' || p_plant_cd || '/' || p_companycode_cd || '.');

  else
    insert into tlgnc_plant_compcode (
      plant_compcode_id,
      plant_cd,
      companycode_cd,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) values (
      slgnc_plant_compcode.nextval,
      p_plant_cd,
      p_companycode_cd,
      1, systimestamp, 1, systimestamp, 0
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_plant_compcode with new id=' || slgnc_plant_compcode.currval || '; plant_cd/companycode_cd ' || p_plant_cd || '/' || p_companycode_cd || '.');
  end if;
end upsert_plant;
/
show errors;

