set define off
set serveroutput on

create or replace procedure upsert_pda_device (
    v_pda_device_no   in varchar2,
    v_sap_vendor_id   in varchar2,
    p_active_flag     in number
) is
    v_existing        number; -- number of existing records of that key (0 or 1)
    /*-- For lookups */
    v_exists_vendor                number; -- number of existing records of tlgns_sap_vendor referred by this device  (0 or 1)
    v_existing_carrier_id          number := NULL ; -- ID of existing record of that key, if exist (for lookup of vendor/carrier)
    /*-- Parameter/Variables --*/
    /*   May need to be changed if some conditions are not ok, such as invalid Vendor. Initial variable value := passed param value */
    v_active_flag   number := p_active_flag;
begin

  -- Preparation: lookup by sap_vendor_id if passed
  if (v_sap_vendor_id is not null) then
    select count(sap_vendor_id) into v_exists_vendor from tlgns_sap_vendor v where v.sap_id = v_sap_vendor_id;
    if (v_exists_vendor > 0) then
      select c.carrier_id into v_existing_carrier_id
      from tlgns_sap_vendor v
      inner join tlgnc_carrier c on (c.sap_vendor_id = v.sap_vendor_id)
      where v.sap_id = v_sap_vendor_id;
    else
      dbms_output.put_line ('  ERROR: tlgnc_pda_device: SAP Vendor ''' || v_sap_vendor_id ||''' not found! Use null, i.e. not assigned to a vendor, and set to inactive. Correct manually!');
      v_active_flag := 0;
    end if;
  end if;


  select count(pda_device_id) into v_existing from tlgnc_pda_device where pda_device_no = v_pda_device_no;
  if (v_existing > 0) then
    update tlgnc_pda_device set
      carrier_id=v_existing_carrier_id,
      active_flag=v_active_flag,
      ctl_mod_uid=1,
      ctl_mod_ts=systimestamp
    where
      pda_device_no=v_pda_device_no and (1 != 1
        /* to identify if something has changed at all, null must be handled specially for nullable fields, because "null != 'something'" would be false! */
        or carrier_id   != v_existing_carrier_id
          or (carrier_id is null     and v_existing_carrier_id is not null)
          or (carrier_id is not null and v_existing_carrier_id is null)
        or active_flag  != v_active_flag
      );
    dbms_output.put_line ('  INFO: tlgnc_pda_device UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_pda_device with pda_device_no=' || v_pda_device_no ||'.');

  else
    insert into tlgnc_pda_device (
      pda_device_id,
      pda_device_no,
      carrier_id,
      active_flag,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
    ) values (
      slgnc_pda_device.nextval,
      v_pda_device_no,
      v_existing_carrier_id,
      v_active_flag,
      1, systimestamp, 1, systimestamp
    );
    dbms_output.put_line ('  INFO: tlgnc_pda_device: INSERTED ' || SQL%ROWCOUNT ||' with new pda_device_id=' || slgnc_pda_device.currval ||', owned by carrier_id=' || v_existing_carrier_id || '.');

  end if;
end;
/
show errors;

