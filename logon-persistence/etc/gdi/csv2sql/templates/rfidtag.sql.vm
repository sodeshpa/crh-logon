set define off
set serveroutput on

create or replace procedure upsert_rfidtag (
    v_name                      in varchar2,
    v_rfid_identity             in varchar2,
    v_active_flag               in number
) is
    v_existing      number; -- number of existing rfidtag-records of that key (0 or 1)
    v_existing_id   number; -- ID of existing record of that key, if exist
begin
  dbms_output.enable(100000);

  -- A record is identified by the label/name, e.g. name=100033
  select count(rfidtag_id) into v_existing
    from tlgnc_rfidtag t
  where t.name = v_name;

  if (v_existing > 0) then
    -- update
    select rfidtag_id into v_existing_id
      from tlgnc_rfidtag t
    where t.name = v_name;

    update tlgnc_rfidtag set
      /* do not touch rfidtag_id, or the associated rfidobject_id */
      name                      = v_name,
      rfid_identity             = v_rfid_identity,
      active_flag               = v_active_flag,
      /* do not touch ctl_cre_uid,ctl_cre_ts */
      ctl_mod_uid               = 1,
      ctl_mod_ts                = systimestamp,
      ctl_tcn                   = ctl_tcn+1
    where
      rfidtag_id = v_existing_id and ( 1 != 1
        /* to identify if something has changed at all, null must be handled specially, because "null != 'something'" would be false! */
        or nvl(name,          '(NULL)') != nvl(v_name,          '(NULL)') /* can actually never be different, as it is (currently) the identifier... */
        or nvl(rfid_identity, '(NULL)') != nvl(v_rfid_identity, '(NULL)')
        or active_flag                  != v_active_flag
      );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_rfidtag with id=' || v_existing_id || '; name=' || v_name || ', rfid_identity=' || v_rfid_identity || '.');

  else
    insert into tlgnc_rfidtag (
      rfidtag_id,
      rfidobject_id,
      name,
      rfid_identity,
      active_flag,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) values (
        slgnc_rfidtag.nextval,
        null /* newly added tags are never directly assigned/in use */,
        v_name,
        v_rfid_identity,
        v_active_flag,
        1, systimestamp, 1, systimestamp, 0
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_rfidtag with new id=' || slgnc_rfidtag.currval || '; name=' || v_name || ', rfid_identity=' || v_rfid_identity || '.');

  end if;
end upsert_rfidtag;
/
show errors;

#parse("macros.hvm")
#foreach ($row in $current)
#if (!$row.get(0).startsWith("#"))
