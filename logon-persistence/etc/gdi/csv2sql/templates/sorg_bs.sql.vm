-------------------------------------------------------------------------------
create or replace
procedure upsert_sorg_bs (
    p_sorg_cd                      in varchar2,
    p_companycode_cd               in varchar2,
    p_sorg_name                    in varchar2,
    p_logo_image_name              in varchar2,
    p_address_street               in varchar2,
    p_address_countrycity          in varchar2,
    p_skip_send_distance_sap_sd    in number,
    p_salesdoc_return_auart        in varchar2,
    p_ctl_act_cd                   in number
) is
    v_exists_flag     number;      -- number of existing records of that key (0 or 1)
begin
  dbms_output.enable(100000);

  -- --------------------------------------------------------------------------
  -- Lookup tlgnr_sorg_bs
  
  select count(s.sorg_cd) into v_exists_flag
    from tlgnr_sorg_bs s
  where s.sorg_cd = p_sorg_cd;

  if (v_exists_flag > 0) then
  
    -- update, bot ONLY if the new record is ACTIVE
      /*
        Reason for this: C0 and C1 initial data are "the same", but not maintained in the same good quality.
        So, if we load data from both clusters, it could be that the less well maintained would overwrite the good.
        Because this is bad we at least require it to be active!
      */
    if (p_ctl_act_cd != 1) then
      dbms_output.put_line ('NOT updating tlgnr_sorg_bs with sorg_cd = ' || p_sorg_cd || ', because ctl_act_cd is 0 in loader and data in DB may be better maintained.');
      
    else

      update tlgnr_sorg_bs set
        /* sorg_cd: cannot update because this is the key */
        companycode_cd                 = p_companycode_cd,
        sorg_name                      = p_sorg_name,
        logo_image_name                = p_logo_image_name,
        address_street                 = p_address_street,
        address_countrycity            = p_address_countrycity,
        skip_send_distance_sap_sd      = p_skip_send_distance_sap_sd,
        salesdoc_return_auart          = p_salesdoc_return_auart,
        ctl_act_cd                     = p_ctl_act_cd,
        ctl_mod_uid                    = 1,
        ctl_mod_ts                     = systimestamp
      where
        sorg_cd = p_sorg_cd and (    1 != 1
          /* to identify if something has changed at all, null must be handled specially for nullable fields, because "null != 'something'" would be false! */
          or 1 = is_different_varchar2 (companycode_cd                 , p_companycode_cd)
          or 1 = is_different_varchar2 (sorg_name                      , p_sorg_name)
          or 1 = is_different_varchar2 (logo_image_name                , p_logo_image_name)
          or 1 = is_different_varchar2 (address_street                 , p_address_street)
          or 1 = is_different_varchar2 (address_countrycity            , p_address_countrycity)
          or 1 = is_different_varchar2 (skip_send_distance_sap_sd      , p_skip_send_distance_sap_sd)
          or 1 = is_different_varchar2 (salesdoc_return_auart          , p_salesdoc_return_auart)
          or 1 = is_different_number   (ctl_act_cd                     , p_ctl_act_cd)
      );
      dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnr_sorg_bs, cd=' || p_sorg_cd || ', sorg_name = ' || p_sorg_name || '.');
    end if;

  else
    insert into tlgnr_sorg_bs (
      sorg_cd,
      companycode_cd,
      sorg_name,
      logo_image_name,
      address_street,
      address_countrycity,
      skip_send_distance_sap_sd,
      salesdoc_return_auart,
      ctl_act_cd,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
    ) values (
      p_sorg_cd,
      p_companycode_cd,
      p_sorg_name,
      p_logo_image_name,
      p_address_street,
      p_address_countrycity,
      p_skip_send_distance_sap_sd,
      p_salesdoc_return_auart,
      p_ctl_act_cd,
      1, systimestamp, 1, systimestamp
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnr_sorg_bs (cd=' || p_sorg_cd || '), sorg_name = ' || p_sorg_name || ', skip_send_distance_sap_sd = ' || p_skip_send_distance_sap_sd || ', salesdoc_return_auart = ' || p_salesdoc_return_auart || ', ctl_act_cd = ' || p_ctl_act_cd || '.');
  end if;

end upsert_sorg_bs;
/
show errors;

