set define off
set serveroutput on

create or replace procedure upsert_container (
    v_vendor_sap_no               in varchar2,
    p_active_flag                 in number,
    p_container_no                in varchar2,
    p_container_name              in varchar2,
    v_container_trsp_cat_cd       in number,
    v_container_type_cd           in number,
    v_uic_profile                 in varchar2,
    v_length_ft                   in number,
    v_width_mm                    in number,
    v_height_mm                   in number,
    v_tare_weight_t               in number,
    v_volume_m3                   in number,
    v_manufacturer                in varchar2,
    v_branding_flag               in number,
    v_container_comment           in varchar2,
    v_homebase_coord_lat          in number,
    v_homebase_coord_lon          in number
    /* rfidobject_id: always set to null (will be generated), not even passed as parameter */
    /* CURRENT_TRUCK_ID, CURRENT_TRAILER_ID, CURRENT_WAGON_ID: not set, not even passed as parameter */
) is
    v_existing                    number; -- number of existing records of that key (0 or 1)
    v_existing_id                 number; -- ID of existing record of that key, if exist
    v_exists_vendor               number; -- number of existing records of tlgns_sap_vendor referred by this container (0 or 1)
    v_existing_carrier_id         number := NULL ; -- ID of existing record of that key, if exist (for lookup of vendor)
    /*-- Parameter/Variables --*/
    /*   May need to be changed if some conditions are not ok, such as invalid Vendor. Initial variable value := passed param value */
    v_active_flag    number       := p_active_flag;
    v_container_no   varchar2(20) := p_container_no;
    v_container_name varchar2(30) := p_container_name;

begin
  dbms_output.enable(100000);
  -- Reduce the container number to just letters and digits, i.e. no blanks, no punctuation
  v_container_no := regexp_replace (v_container_no, '[[:punct:][:blank:]]');

  -- A record is identified by container number
  select count(container_id) into v_existing
    from tlgnc_container t
  where t.container_no = v_container_no;

  -- Preparation: lookup CARRIER_ID in vendor+carrier
  select count(sap_vendor_id) into v_exists_vendor from tlgns_sap_vendor v where v.sap_id = v_vendor_sap_no;
  if (v_exists_vendor > 0) then
    select c.carrier_id into v_existing_carrier_id
    from tlgns_sap_vendor v inner join tlgnc_carrier c on (v.sap_vendor_id = c.sap_vendor_id)
    where v.sap_id = v_vendor_sap_no;
  else
    dbms_output.put_line ('  ERROR: tlgnc_container: SAP Vendor ''' || v_vendor_sap_no ||''' not found! Cannot insert/update this container.');
    return;
  end if;

  if (v_existing > 0) then
    -- update
    select container_id into v_existing_id
      from tlgnc_container t
    where t.container_no = v_container_no;

    update tlgnc_container set
      /* container_id, container_no: do not update */
      carrier_id                = v_existing_carrier_id,
      active_flag               = v_active_flag,
      container_name            = v_container_name,
      container_trsp_cat_cd     = v_container_trsp_cat_cd,
      container_type_cd         = v_container_type_cd,
      uic_profile               = v_uic_profile,
      length_ft                 = v_length_ft,
      width_mm                  = v_width_mm,
      height_mm                 = v_height_mm,
      tare_weight_t             = v_tare_weight_t,
      volume_m3                 = v_volume_m3,
      manufacturer              = v_manufacturer,
      branding_flag             = v_branding_flag,
      container_comment         = v_container_comment,
      homebase_coord_lat        = v_homebase_coord_lat,
      homebase_coord_lon        = v_homebase_coord_lon,
      /* rfidobject_id - do not update */
      /* current_truck_id, current_trailer_id, current_wagon_id - do not update, should be done with a proper composition change */
      /* do not touch ctl_cre_uid,ctl_cre_ts */
      ctl_mod_uid               = 1,
      ctl_mod_ts                = systimestamp,
      ctl_tcn                   = ctl_tcn+1
    where
      container_id = v_existing_id and (  1 != 1
        /* to identify if something has changed at all, null must be handled specially FOR NULLABLE fields,
           because "null != 'something'" would be false! For text, use '(NULL)', for numbers -1 (as dummy/marker) */
        or carrier_id                       != v_existing_carrier_id
        or active_flag                      != v_active_flag
        /* v_container_no - do not update */
        or nvl(container_name,    '(NULL)') != nvl(v_container_name,     '(NULL)')
        or container_trsp_cat_cd            != v_container_trsp_cat_cd
        or container_type_cd                != v_container_type_cd
        or nvl(container_comment, '(NULL)') != nvl(v_container_comment,  '(NULL)')
        or nvl(uic_profile,       '(NULL)') != nvl(v_uic_profile,        '(NULL)')
        or nvl(length_ft,         -1      ) != nvl(v_length_ft,          -1      )
        or nvl(width_mm,          -1      ) != nvl(v_width_mm,           -1      )
        or nvl(height_mm,         -1      ) != nvl(v_height_mm,          -1      )
        or nvl(tare_weight_t,     -1      ) != nvl(v_tare_weight_t,      -1      )
        or nvl(volume_m3,         -1      ) != nvl(v_volume_m3,          -1      )
        or nvl(manufacturer,      '(NULL)') != nvl(v_manufacturer,       '(NULL)')
        or nvl(branding_flag,     -1      ) != nvl(v_branding_flag,      -1      )
        or nvl(container_comment, '(NULL)') != nvl(v_container_comment,  '(NULL)')
        or nvl(homebase_coord_lat,-1      ) != nvl(v_homebase_coord_lat, -1      ) /* actually not fully correct, (-1/-1) would be valid coord... */
        or nvl(homebase_coord_lon,-1      ) != nvl(v_homebase_coord_lon, -1      ) /* actually not fully correct, (-1/-1) would be valid coord... */
        /* rfidobject_id, current_truck_id, current_trailer_id, current_wagon_id : never update */
      );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_container with id=' || v_existing_id || '; owned by vendor sap id=' || v_vendor_sap_no || '.');

  else
    insert into tlgnc_container (
      container_id,
      carrier_id,
      active_flag,
      container_no,
      container_name,
      container_trsp_cat_cd,
      container_type_cd,
      uic_profile,
      length_ft,
      width_mm,
      height_mm,
      tare_weight_t,
      volume_m3,
      max_net_weight_t,
      manufacturer,
      branding_flag,
      container_comment,
      homebase_coord_lat,
      homebase_coord_lon,
      rfidobject_id,
      current_truck_id,
      current_trailer_id,
      current_wagon_id,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) values (
        slgnc_container.nextval,
        v_existing_carrier_id,
        v_active_flag,
        v_container_no,
        v_container_name,
        v_container_trsp_cat_cd,
        v_container_type_cd,
        v_uic_profile,
        v_length_ft,
        v_width_mm,
        v_height_mm,
        v_tare_weight_t,
        v_volume_m3,
        999, /* FIXME - get from CSV, and include here PLUS in update/where */
        v_manufacturer,
        v_branding_flag,
        v_container_comment,
        v_homebase_coord_lat,
        v_homebase_coord_lon,
        null /* no rfidobject_id, will be generated */ ,
        null /* no current_truck_id */ ,
        null /* no current_trailer_id */ ,
        null /* no current_wagon_id */ ,
        1, systimestamp, 1, systimestamp, 0
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_container with new id=' || slgnc_container.currval || '; owned by vendor sap id=' || v_vendor_sap_no || '.');

  end if;
end upsert_container;
/
show errors;

