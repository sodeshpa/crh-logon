set define off
set serveroutput on

-- We do not update tlgns_sap_vendor. Updates happen through SAP import!
-- We could move the creation of carrier/pools into it's own "upsert",
-- but that is rather a nice to have. They can modify that in the UI for
-- an existing carrier, or re-assign pools.
create or replace procedure insert_notexists_vendor_etc (
    v_sap_id                       in varchar2,
    v_sap_ifc_id                   in varchar2,
    v_account_group                in varchar2,
    v_marked_for_deletion          in varchar2,
    v_name1                        in varchar2,
    v_name2                        in varchar2,
    v_country_cd                   in varchar2,
    v_postal_code                  in varchar2,
    v_city                         in varchar2,
    v_location_district            in varchar2,
    v_region                       in varchar2,
    v_street                       in varchar2,
    v_house_number                 in varchar2,
    v_lang_cd                      in varchar2,
    v_vat_registration_number      in varchar2,
    v_carrier_display_name         in varchar2,
    v_carrier_active_flag          in varchar2,
    v_carrier_pools                in varchar2,
    v_transmit_to_carrier_flag	   in varchar2
) is
    v_existing      number; -- number of existing records of that key (0 or 1)
    v_existing_id   number; -- ID of existing record of that key, if exist
    sql_statement   varchar2(500);
begin
  dbms_output.enable(100000);
  -- A record is identified by sap_id (the ID in SAP)
  select count(sap_vendor_id) into v_existing
    from tlgns_sap_vendor
  where sap_id = v_sap_id;

  if (v_existing > 0) then
    -- update would normally occur.
    -- But here, we leave it, data from SAP should be more up to date than what we have!!
    select sap_vendor_id into v_existing_id
      from tlgns_sap_vendor
    where sap_id = v_sap_id;
    dbms_output.put_line ('SAP Vendor ' || v_sap_id|| ' already exists with Logon sap_vendor_id=' || v_existing_id || '. Keep existing values (from SAP), do not update');

    -- however, carrier is safe to update!
    update tlgnc_carrier set
      /* do not touch carrier_id, sap_vendor_id*/
      display_name = v_carrier_display_name,
      active_flag  = v_carrier_active_flag,
      transmit_to_carrier_flag = v_transmit_to_carrier_flag,
      ctl_mod_uid  = 1,
      ctl_mod_ts   = systimestamp,
      ctl_tcn      = ctl_tcn+1
    where sap_vendor_id = v_existing_id and ( 1 != 1
      or display_name != v_carrier_display_name /*not nullable*/
      or active_flag  != v_carrier_active_flag   /*not nullable*/
      or transmit_to_carrier_flag  != transmit_to_carrier_flag   /*not nullable*/
    );
    dbms_output.put_line ('  tlgnc_carrier: UPDATED if needed: ' || SQL%ROWCOUNT ||' for sap_vendor_id=' || v_existing_id || '; sap_id=' || v_sap_id ||'.');

  else
    insert into tlgns_sap_vendor (
      sap_vendor_id,
      sap_id, sap_ifc_id,
      account_group,
      marked_for_deletion,
      name1, name2,
      country_cd, postal_code, city,
      location_district, region,
      street, house_number,
      lang_cd,
      vat_registration_number,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn)
    values (
      slgns_sap_vendor.nextval,
      v_sap_id, lpad(v_sap_id, 10, '0'),
      v_account_group,
      v_marked_for_deletion,
      v_name1, v_name2,
      v_country_cd, v_postal_code, v_city,
      v_location_district, v_region,
      v_street, v_house_number,
      v_lang_cd,
      v_vat_registration_number,
      1, systimestamp, 1, systimestamp, 0
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgns_sap_vendor with new id=' || slgns_sap_vendor.currval || '; sap_id=' || v_sap_id ||'.');

    insert into tlgnc_carrier (
      carrier_id,
      sap_vendor_id,
      display_name,
      active_flag,
      transmit_to_carrier_flag,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn)
    values (
      slgnc_carrier.nextval,
      slgns_sap_vendor.currval,
      v_carrier_display_name,
      v_carrier_active_flag,
      v_transmit_to_carrier_flag,
      1, systimestamp, 1, systimestamp, 0
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_carrier with new id=' || slgnc_carrier.currval || '; sap_vendor_id=' || slgns_sap_vendor.currval ||'.');

    /* hack with execute immediate, because we want v_carrier_pools to be something like 1,2,3 to get 'where pool_id in (1,2,3)' */
    sql_statement := '
    insert into tlgnc_pool_carrier (
      pool_carrier_id, pool_id, carrier_id,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
    ) ( select
        slgnc_pool_carrier.nextval, p.pool_id, slgnc_carrier.currval,
        1, systimestamp, 1, systimestamp, 0
      from tlgnc_pool p
      where p.pool_id in ('|| v_carrier_pools ||') )';
    /*dbms_output.put_line (sql_statement); - debug*/
    execute immediate sql_statement;
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_pool_carrier with last id=' || slgnc_pool_carrier.currval || ' for pools=' || v_carrier_pools || '.');

  end if;
end insert_notexists_vendor_etc;
/
show errors;


