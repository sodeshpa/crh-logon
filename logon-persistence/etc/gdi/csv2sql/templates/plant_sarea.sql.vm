-------------------------------------------------------------------------------
-- insert_missing_plant_sarea
-------------------------------------------------------------------------------
create or replace
procedure insert_missing_plant_sarea (
    p_plant_cd                     in varchar2,
    p_sorg_cd                      in varchar2,
    p_distribution_channel         in varchar2
) is 
    v_exists_flag     number;      -- number of existing records of that key (0 or 1)
    v_existing_id     number;      -- ID of existing record of that key, if exist
begin
  dbms_output.enable(100000);
  
  -- --------------------------------------------------------------------------
  -- Loop through all matching tlgnc_sarea

  for curr_sarea in (
    select * from tlgnc_sarea sa
      where sa.sorg_cd = p_sorg_cd and sa.distribution_channel = p_distribution_channel
  )
  loop
    -- check if an entry in plant_sarea alreay exists for the curr_sarea
    select count(*) into v_exists_flag
      from tlgnc_plant_sarea psa
    where psa.plant_cd = p_plant_cd and psa.sarea_id = curr_sarea.sarea_id;
    
    if (v_exists_flag > 0) then
      -- update (if there would be something to be updated)
      select psa.plant_sarea_id into v_existing_id
        from tlgnc_plant_sarea psa
      where psa.plant_cd = p_plant_cd and psa.sarea_id = curr_sarea.sarea_id;

      dbms_output.put_line ('  Entry tlgnc_plant_sarea already exists for (plant, sorg-dist-div) = ' || p_plant_cd || ', ' || curr_sarea.sorg_cd || '-' || curr_sarea.distribution_channel || '-' || curr_sarea.division_cd || '), id = ' || v_existing_id || '. Do nothing.');
    else
      -- insert missing entry
      insert into tlgnc_plant_sarea (
        plant_sarea_id,
        plant_cd,
        sarea_id,
        ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts, ctl_tcn
      ) values (
        slgnc_plant_sarea.nextval,
        p_plant_cd,
        curr_sarea.sarea_id,
        1, systimestamp, 1, systimestamp, 0
      );
      dbms_output.put_line ('  INSERTED ' || SQL%ROWCOUNT ||' tlgnc_plant_sarea (ID=' || slgnc_plant_sarea.currval || ') for (plant, sorg-dist-div) = ' || p_plant_cd || ', ' || curr_sarea.sorg_cd || '-' || curr_sarea.distribution_channel || '-' || curr_sarea.division_cd || ').');
    end if;
  end loop;
end insert_missing_plant_sarea;
/
show errors;

