set define off
set serveroutput on

create or replace procedure upsert_rail_distance (
  v_dep_station_country    in number,
  v_dep_station_number     in varchar2,
  v_arr_station_country    in number,
  v_arr_station_number     in varchar2,
  p_tariff_distance_km     in number
) is
  v_existing                  number; -- number of existing records of that key (0 or 1)
  v_existing_id               number; -- ID of existing record of that key, if exist
  v_dep_railway_station_id    number; -- Looked up ID of departure station
  v_arr_railway_station_id    number; -- Looked up ID of arrival station
  v_tariff_distance_m         number(10,0) := p_tariff_distance_km * 1000;
begin
  dbms_output.enable(100000);

  select rs.railway_station_id into v_dep_railway_station_id
  from tlgnc_railway_station rs
  where rs.uic_country_cd = v_dep_station_country
  and rs.railway_station_no = lpad(v_dep_station_number, 6, '0');

  select rs.railway_station_id into v_arr_railway_station_id
  from tlgnc_railway_station rs
  where rs.uic_country_cd = v_arr_station_country
  and rs.railway_station_no = lpad(v_arr_station_number, 6, '0');

  -- A record is identified by e.g. DEP_RAILWAY_STATION_ID and ARR_RAILWAY_STATION_ID
  select count(rail_distance_id) into v_existing
    from tlgnc_rail_distance rd
  where rd.DEP_RAILWAY_STATION_ID = v_dep_railway_station_id
    and rd.ARR_RAILWAY_STATION_ID = v_arr_railway_station_id;

  if (v_existing > 0) then
    -- update
    select rail_distance_id into v_existing_id
      from tlgnc_rail_distance rd
    where rd.DEP_RAILWAY_STATION_ID = v_dep_railway_station_id
    and rd.ARR_RAILWAY_STATION_ID = v_arr_railway_station_id;

    update tlgnc_rail_distance set
      /* do not touch rail_distance_id */
      dep_railway_station_id    = v_dep_railway_station_id,
      arr_railway_station_id    = v_arr_railway_station_id,
      tariff_distance_m         = v_tariff_distance_m,
      /* do not touch ctl_cre_uid,ctl_cre_ts */
      ctl_mod_uid = 1,
      ctl_mod_ts = systimestamp,
      ctl_tcn = ctl_tcn+1
    where
      rail_distance_id = v_existing_id and ( 1 != 1
        /* to identify if something has changed at all, nullable fields must be handled specially, because "null != 'something'" would be false! */
        or dep_railway_station_id    != v_dep_railway_station_id
        or arr_railway_station_id    != v_arr_railway_station_id
        or tariff_distance_m         != v_tariff_distance_m
    );
    dbms_output.put_line ('UPDATED if needed: ' || SQL%ROWCOUNT ||'. Existing tlgnc_rail_distance with id=' || v_existing_id || '; dep=' || v_dep_station_country || '-' || v_dep_station_number || '(' ||v_dep_railway_station_id || '), arr=' || v_arr_station_country || '-' || v_arr_station_number || '(' || v_arr_railway_station_id || '), tariff km=' || p_tariff_distance_km || '.');

  else

    insert into tlgnc_rail_distance (
      rail_distance_id,
      dep_railway_station_id,
      arr_railway_station_id,
      tariff_distance_m,
      active_flag,
      ctl_cre_uid, ctl_cre_ts, ctl_mod_uid, ctl_mod_ts
    ) values (
      slgnc_rail_distance.nextval,
      v_dep_railway_station_id,
      v_arr_railway_station_id,
      v_tariff_distance_m,
      1,
      1, systimestamp, 1, systimestamp
    );
    dbms_output.put_line ('INSERTED ' || SQL%ROWCOUNT ||' tlgnc_rail_distance with new id=' || slgnc_rail_distance.currval || '; dep=' || v_dep_station_country || '-' || v_dep_station_number || '(' ||v_dep_railway_station_id || '), arr=' || v_arr_station_country || '-' || v_arr_station_number || '(' || v_arr_railway_station_id || '), tariff km=' || p_tariff_distance_km || '.');

  end if;
end upsert_rail_distance;
/
show errors;

