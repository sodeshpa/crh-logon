prompt Updating or inserting tlgnc_rail_distance '$railway_station_country_from'-'$railway_station_from' - '$railway_station_country_to'-'$railway_station_to: $tariff_km.
execute upsert_rail_distance ($railway_station_country_from, '$railway_station_from', $railway_station_country_to, '$railway_station_to', $tariff_km);

