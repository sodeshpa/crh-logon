create or replace procedure delete_shipto (i_shipto_id in number) is

  cursor cur_shipto_sarea is
  select sarea.shipto_sarea_id
  from tlgnc_shipto_sarea sarea
  where sarea.shipto_id = i_shipto_id;
    
  cursor cur_shipto_silo is
  select silo.shipto_silo_id
  from tlgnc_shipto_silo silo
  where silo.shipto_id = i_shipto_id;
    
begin

  -- dbms_output.put_line('delete_shipto: Deleting ship-to persons ...');
  
  delete from tlgnc_shipto_person
  where shipto_id = i_shipto_id;

  -- dbms_output.put_line('delete_shipto: Deleted ' || sql%rowcount || ' records.');

  -- dbms_output.put_line('delete_shipto: Deleting ship-to sales areas ...');  
  
  for shipto_sarea in cur_shipto_sarea
  loop
    -- dbms_output.put_line('delete_shipto:  Processing shipto_sarea_id ''' || shipto_sarea.shipto_sarea_id || ''' ...');
    delete_shipto_sarea(shipto_sarea.shipto_sarea_id);
  end loop;

  -- dbms_output.put_line('delete_shipto: Deleting ship-to silos ...');  
  
  for shipto_silo in cur_shipto_silo
  loop
    -- dbms_output.put_line('delete_shipto:  Processing shipto_silo_id ''' || shipto_silo.shipto_silo_id || ''' ...');
    delete_shipto_silo(shipto_silo.shipto_silo_id);
  end loop;

  -- dbms_output.put_line('delete_shipto: Deleting ship-to truck types ...');
  
  delete from tlgnc_shipto_truck_type
  where shipto_id = i_shipto_id;

  -- dbms_output.put_line('delete_shipto: Deleted ' || sql%rowcount || ' records.');

  -- dbms_output.put_line('delete_shipto: Deleting ship-to wagon types ...');
  
  delete from tlgnc_shipto_wagon_type
  where shipto_id = i_shipto_id;

  -- dbms_output.put_line('delete_shipto: Deleted ' || sql%rowcount || ' records.');

  delete from tlgnc_shipto
  where shipto_id = i_shipto_id;

end delete_shipto;
/
show errors;

create or replace procedure delete_sap_bp_sarea (i_sap_bp_sarea_id in number) is

begin

  delete from tlgns_sap_bp_pf_shipto
  where sap_bp_sarea_id = i_sap_bp_sarea_id
    or shipto_sap_bp_sarea_id = i_sap_bp_sarea_id;
  
  delete from tlgns_sap_bp_pf_soldto
  where sap_bp_sarea_id = i_sap_bp_sarea_id
    or soldto_sap_bp_sarea_id = i_sap_bp_sarea_id;
  
  delete from tlgns_sap_bp_pf_billto
  where sap_bp_sarea_id = i_sap_bp_sarea_id
    or billto_sap_bp_sarea_id = i_sap_bp_sarea_id;
  
  delete from tlgns_sap_bp_pf_payer
  where sap_bp_sarea_id = i_sap_bp_sarea_id
    or payer_sap_bp_sarea_id = i_sap_bp_sarea_id;
  
  delete from tlgns_sap_bp_sarea
  where sap_bp_sarea_id = i_sap_bp_sarea_id;
  
end delete_sap_bp_sarea;
/
show errors;

create or replace procedure delete_sap_bp (i_sap_id in varchar2) is
    
  cursor cur_sap_bp_sarea(v_sap_bp_id in number) is
  select sarea.sap_bp_sarea_id
  from tlgns_sap_bp_sarea sarea
  where sarea.sap_bp_id = v_sap_bp_id;
  
  cursor cur_shipto(v_shipto_sap_bp_id in number) is
  select shipto.shipto_id
  from tlgnc_shipto shipto
  where shipto.shipto_sap_bp_id = v_shipto_sap_bp_id;
  
  cursor cur_shipto_sarea_restr_billto(v_billto_sap_bp_id in number) is
  select restr.shipto_sarea_restr_id
  from tlgnc_shipto_sarea_restr restr
  where restr.billto_sap_bp_id = v_billto_sap_bp_id;
  
  cursor cur_shipto_sarea_restr_payer(v_payer_sap_bp_id in number) is
  select restr.shipto_sarea_restr_id
  from tlgnc_shipto_sarea_restr restr
  where restr.payer_sap_bp_id = v_payer_sap_bp_id;
  
  l_sap_bp_id                 number;
  l_shipto_id                 number;
    
  e_integrity_violation exception;
  pragma exception_init (e_integrity_violation, -2292);

begin
  dbms_output.enable(100000);
  
  l_sap_bp_id := null;
  l_shipto_id := null;
  
  begin
    
    select sap_bp_id
    into l_sap_bp_id
    from tlgns_sap_bp
    where sap_id = i_sap_id;
    
    exception
    when no_data_found then
      dbms_output.put_line('delete_bp: No sap bp found for sap_id ''' || i_sap_id || '''. Skipping record.');
      return;
  
  end;
  
  dbms_output.put_line('delete_sap_bp: Deleting sap_bp_id ''' || l_sap_bp_id || ''' ...');
  
  -- dbms_output.put_line('delete_sap_bp:  Deleting bp sales areas ...');
  
  for sap_bp_sarea in cur_sap_bp_sarea(l_sap_bp_id)
  loop
    -- dbms_output.put_line('delete_sap_bp:   Processing sap_bp_sarea_id ''' || sap_bp_sarea.sap_bp_sarea_id || ''' ...');
    delete_sap_bp_sarea(sap_bp_sarea.sap_bp_sarea_id);
  end loop;
  
  -- dbms_output.put_line('delete_sap_bp:  Deleting bp company codes ...');

  delete from tlgns_sap_bp_companycode
  where sap_bp_id = l_sap_bp_id;

  -- dbms_output.put_line('delete_sap_bp:  Deleted ' || sql%rowcount || ' records.');

  -- dbms_output.put_line('delete_sap_bp:  Deleting ship-to ...');
  
  begin
  
    select shipto_id
    into l_shipto_id
    from tlgnc_shipto
    where shipto_sap_bp_id = l_sap_bp_id;
    
    exception
    when no_data_found then
      dbms_output.put_line('delete_sap_bp:   There is no ship-to for this business partner.');
  
  end;
  
  if l_shipto_id is not null then
  
    dbms_output.put_line('delete_sap_bp:   Deleting ship-to with shipto_id ''' || l_shipto_id || ''' ...');
    delete_shipto(l_shipto_id);
   
  end if;
  
  -- dbms_output.put_line('delete_sap_bp:  Deleting ship-to bill-tos for bill-to ...');
  
  delete from tlgnc_shipto_billto
  where billto_sap_bp_id = l_sap_bp_id;
  
  -- dbms_output.put_line('delete_sap_bp:  Deleted ' || sql%rowcount || ' records.');

  -- dbms_output.put_line('delete_sap_bp:  Deleting ship-to sales area restrictions for bill-to ...');
  
  for shipto_sarea_restr in cur_shipto_sarea_restr_billto(l_sap_bp_id)
  loop
    -- dbms_output.put_line('delete_sap_bp:   Processing shipto_sarea_restr_id ''' || shipto_sarea_restr.shipto_sarea_restr_id || ''' ...');
    delete_shipto_sarea_restr(shipto_sarea_restr.shipto_sarea_restr_id);
  end loop;
  
  -- dbms_output.put_line('delete_sap_bp:  Deleting ship-to sales area restrictions for payer ...');  
  
  for shipto_sarea_restr in cur_shipto_sarea_restr_payer(l_sap_bp_id)
  loop
    -- dbms_output.put_line('delete_sap_bp:   Processing shipto_sarea_restr_id ''' || shipto_sarea_restr.shipto_sarea_restr_id || ''' ...');
    delete_shipto_sarea_restr(shipto_sarea_restr.shipto_sarea_restr_id);
  end loop;
  
  -- dbms_output.put_line('delete_sap_bp:  Deleting bill-to rules for bill-to ...');
  
  delete from tlgnc_shipto_sarea_restr_btrul
  where billto_sap_bp_id = l_sap_bp_id;
  
  -- dbms_output.put_line('delete_sap_bp:  Deleted ' || sql%rowcount || ' records.');
  
  delete from tlgns_sap_bp
  where sap_bp_id = l_sap_bp_id;
  
  exception
  when e_integrity_violation then
    dbms_output.put_line('delete_sap_bp:  DELETION FAILED for business partner with sap_id ''' || i_sap_id || ''': ' || sqlerrm || '.');

end delete_sap_bp;
/
show errors;

