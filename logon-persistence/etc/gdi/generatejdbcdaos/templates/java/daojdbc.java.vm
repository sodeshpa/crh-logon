    public List<${className}Value> findRecords(short skip, short numRecs, Map<String, ColumnRestriction> restriction) throws DAOException {
		// [[
		List<${className}Value> result = null;
		Object[][] params = {{"skip", skip + ""},
							{"numRecs", numRecs + ""},
							{"restriction", restriction}};
		boolean logDebugEnabled = LOG.isDebugEnabled();
		if (logDebugEnabled) {
			LOG.entering(this, "findRecords", params);
		}
		// ]]
		try {
			if (restriction == null || restriction.isEmpty()) {
				return result = null;
			}
			
			String whereClause = JDBCImplUtil.generateWhereClause(restriction);
			List valuesList = JDBCImplUtil.getValues(restriction);
			return result = findRecords(skip, numRecs, whereClause, valuesList);
		}
		finally {
		// [[
			if (logDebugEnabled) {
				LOG.exiting(result);
			}
		// ]]
		}
    }
    
    /**
     * 
     * @param whereClause
     * @return
     */
    public List<${className}Value> findRecords(short skip, short numRecs, String whereClause, List searchValues) throws DAOException {
		// [[
		List<${className}Value> result = null;
		Object[][] params = {{"skip", skip + ""},
							{"numRecs", numRecs + ""},
							{"whereClause", whereClause}};
		boolean logDebugEnabled = LOG.isDebugEnabled();
		if (logDebugEnabled) {
			LOG.entering(this, "findRecords", params);
		}
		// ]]
		Connection	conn = null;
		PreparedStatement ps = null;
		try {
			if (StringUtils.empty(whereClause)) {
				return result = null;
			}

			conn = getConnection();
			
			if (logDebugEnabled) {
				LOG.debug("Select clause: " + SQL_SELECT);
				LOG.debug("Where clause: " + whereClause);
			}

			ps = conn.prepareStatement(SQL_SELECT + " " + whereClause);
			if (searchValues != null && !searchValues.isEmpty()) {
				for (int index = 0; index < searchValues.size(); index++) {
					Object val = (Object)searchValues.get(index);
					JDBCImplUtil.setPsValue(ps, index + 1, val);
				}
			}
			if (numRecs <= 0) {
				// get all records
				numRecs = 0;
			}
			if ((skip > 0) && (numRecs > 0)) {
				ps.setMaxRows(skip + numRecs);
			}
			else {
				ps.setMaxRows(numRecs);
			}

			ResultSet rs;
			try {
				rs = ps.executeQuery();
			}
			catch (SQLException sqlException) {
				logError(sqlException, (C_NAME + ".findRecords"));

				throw new DAOException(
						DAOException.TYPE_DATA_TIER, sqlException);
			}

			${className}Value to = null;
			int	i = 0;
			while (rs.next()) {
				if (skip > 0) {
					skip--;
					continue;
				}

				if (to == null) {
					to = new ${className}Value();
				}

				fillResultValues(rs, to);
				if (logDebugEnabled) {
					LOG.debug("rec " + i + ": " + to);
				}
				i++;

				if (result == null) {
					result = new ArrayList<${className}Value>();
				}
				result.add(to);
			}			
			return result;
		}
		catch (SQLException e) {
			logError(e, (C_NAME + ".findRecords"));
			throw new DAOException(DAOException.TYPE_DATA_TIER, e);
		}
		finally {
			// [[
			if (logDebugEnabled) {
				LOG.exiting("num entries found: " + ((result != null) ? result.size() : 0));
			}
			// ]]
			cleanup(ps, "findRecords");
			ps = null;
		}
    }	
	
