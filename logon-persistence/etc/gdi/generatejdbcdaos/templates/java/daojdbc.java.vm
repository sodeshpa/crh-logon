	/** 
	 * Cleanup call resources
	 * 
	 * @param connection to be closed
	 * @param statement to be deallocated
	 * @param method
	 */
	private void cleanup(Statement statement, String method) throws DAOException {
		// [[
		Object[][] params = {{"statement", statement},
							{"method", method}};
		boolean logDebugEnabled = LOG.isDebugEnabled();
		if (logDebugEnabled) {
			LOG.entering(this, "cleanup", params);
		}
		// ]]
		try {
			if (statement != null) {
				statement.close();
			}
		}
		catch (SQLException se) {
			logError(se, (C_NAME + "." + method + ": statement.close() failed"));
			throw new DAOException(DAOException.TYPE_DATA_TIER, se);
		}
		finally {
		// [[
			if (logDebugEnabled) {
				LOG.exiting();
			}
		// ]]
		}
	}

