	private Boolean canCheckEquality(Object thisObject, Object thatObject) {
		if (thisObject == null) {
			if (thatObject == null) {
				return true;
			}
			return false;
		}
		if (thatObject == null) {
			return false;
		}
		return null;
	}

	private boolean equalsFK(Object thisObject, Object thatObject) {
		return thisObject == null ? (thatObject == null ? true : false) : (thisObject.equals(thatObject));
	}
	
