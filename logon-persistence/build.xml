<!--
 Author            : AdNovum Informatik AG
 Version Number    : $Revision$
 Date of last edit : $Date$
-->

<!-- Set project name to project's cvs module name, as project name will
     be used for toolbox scope checks -->

<project name="logon" default="dist" basedir=".">
    <description>${ant.project.name} project build file</description>

    <!-- ================================================================= -->
    <!-- === externally defined                                        === -->
    <!-- ================================================================= -->
    <import file="properties.xml"/>
    <import file="../common.xml"/>
    <import file="${GDI_DDL_HOME}/macros/macros.xml"/>
    <!-- <import file="${GDI_JPA_HOME}/macros/macros.xml"/> -->

    <!-- ================================================================= -->
    <!-- === maven like dependencies                                   === -->
    <!-- ================================================================= -->
    <import file="${AAL_HOME}/aal/aal-maven.xml"/>
    <import file="./build-deps.xml"/>    
    <path id="eclipse.lib.classpath">
        <path refid="logon-mavendeps.compile.classpath"/> <!-- maven libs -->
    </path>

    <!-- ================================================================ -->
    <!-- for executing scripts                                               -->
    <!-- ================================================================ -->
    <import file="${AAL_HOME}/aal/aal-db-oracle.xml"/>

	<!-- ================================================================ -->
    <!--  define target specific classpaths (build, runtime, test)        -->
    <!-- ================================================================ -->
    <path id="compile.classpath">
    	<pathelement location="${j2ee.jar}"/>
        <pathelement location="${jcan-log.jar}"/>
        <pathelement location="${log4j.jar}"/>
        <pathelement location="${commons-lang.jar}"/>
        <pathelement location="${hibernate-annotations.jar}"/>
    	<pathelement location="${hibernate-jpa2.jar}"/>
    	<pathelement location="${hibernate4.jar}"/>
		<pathelement location="${opencsv.jar}"/>
		<pathelement location="${project-common.jar.loc}"/>
    </path>

    <!-- ================================================================ -->
    <!--  initialization, cleanup and default targets                     -->
    <!-- ================================================================ -->
    <target name="all" depends="dist"
            description="build and test everything"/>

    <target name="toolbox-checkUptodate">
        <uptodate property="toolbox-isUptodate" targetfile=".classpath">
            <srcfiles refid="toolbox-sourcefiles"/>
        </uptodate>
    </target>

    <target name="toolbox" depends="toolbox-checkUptodate" unless="toolbox-isUptodate">
        <taskdef resource="adnant-taskdefs.xml"/> <!-- See documentation in adnant project's README -->

        <updatedotclasspath>
                <!-- See documentation of 'updatedotclasspath' in adnant project's README -->
            <con path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
            <output path=".bin"/>
            <src path="/logon-common"/>
            <src path="${build.dir.name}/generated/gdi/generatejdbcdaos/src"/>
            <src path="${build.dir.name}/generated/gdi/generatedauthorizer/src"/>
        	<src path="${build.dir.name}/generated/jpa/metamodel/src"/>
            <src path="${java.src.dir.name}"/>
        	<lib path="${adntrace2-templates.jar}" sourcepath="${masterbuild.dir}/etc/adntrace2"/>
		</updatedotclasspath>
    </target>

    <target name="init" depends="toolbox"
            description="initialization project structure and environment">
        <tstamp/>
        <echo message="--------- ${ant.project.name}-${build.version} building on ${os.name} ---------"/>
        <echo message=" "/>
        <echo message="building file ${ant.file} with ${ant.version}"/>
        <echo message=""/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${lib.dir}"/>
        <mkdir dir="${generated.dir}"/>
        <mkdir dir="${test.build.dir}"/>
        <mkdir dir="${test.log.dir}"/>
        <mkdir dir="${test.lib.dir}"/>
    	
    	<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>
	    <if>
		    <equals arg1="${environment}" arg2="dev" />
		    <then>
			    <property name="build.date" value="January 1 1970"/>
			    <property name="build.stamp" value="197001010000"/>
		    </then>
		    <else>
			    <property name="build.date" value="${TODAY}"/>
			    <property name="build.stamp" value="${DSTAMP}${TSTAMP}"/>
		    </else>
		</if>
    </target>

    <target name="clean" depends="clean-test"
            description="cleans all generated files and directories" >
        <delete dir="${build.dir}"/>
    </target>

    <!-- ================================================================ -->
    <!--  compile targets                                                 -->
    <!-- ================================================================ -->
    <target name="build" depends="init, jars, generateDdl"
            description="build target"/>

    <target name="compile" depends="compile-src, compile-test"/>

    <target name="compile-src" depends="generate">
        <javac
            source="${compile.source}"
            target="${compile.target}"
            destdir="${classes.dir}"
            debug="${compile.debug}"
            optimize="${compile.optimize}"
            deprecation="${compile.deprecation}"
            encoding="${compile.encoding}"
            includeantruntime="no">
            <src path="${java.src.dir}"/>
            <!-- <src path="${build.dir.name}/generated/gdi/adxml2entities/src"/> -->
            <src path="${generated.dir}/gdi/generatejdbcdaos/src"/>
            <!-- <src path="${build.dir.name}/generated/gdi/jpa-dao-persistence/src"/> -->
            <src path="${generated.dir}/gdi/generatedauthorizer/src"/>
        	<src path="${generated.dir}/jpa/metamodel/src"/>
            <include name="**/*.java"/>
            <bootclasspath refid="compile.bootclasspath"/>
            <classpath refid="compile.classpath"/>
        </javac>
    </target>

    <!-- ================================================================ -->
    <!--  java archives (JARs)                                            -->
    <!-- ================================================================ -->
	<target name="jars" depends="compile">
        <tstamp/>

        <!-- class files for application -->
        <jar jarfile="${project-persistence-client.jar.loc}">
            <manifest>
                <attribute name="Manifest-Version" value="1.0"/>
                <attribute name="Implementation-Title" value="${ant.project.name}"/>
                <attribute name="Implementation-Vendor" value="${vendor}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Build-Date" value="${build.date}"/>
                <attribute name="Build-Stamp" value="${build.stamp}"/>
                <attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
                <attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
            </manifest>
            <fileset dir="${classes.dir}">
                <include name="**/BaseEntity.class"/>
                <include name="**/dto/**/*.class"/>
                <include name="**/entities/**/*.class"/>
                <include name="**/authorization/**/*.class"/>
                <include name="**/filter/**/*.class"/>
            	<exclude name="org/hibernate/**"/>
            	<exclude name="**/dao/**/*.class"/>
            </fileset>
        </jar>

    	<jar jarfile="${project-persistence.jar.loc}">
            <manifest>
                <attribute name="Manifest-Version" value="1.0"/>
                <attribute name="Implementation-Title" value="${ant.project.name}"/>
                <attribute name="Implementation-Vendor" value="${vendor}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Build-Date" value="${build.date}"/>
                <attribute name="Build-Stamp" value="${build.stamp}"/>
                <attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
                <attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
            </manifest>
            <fileset dir="${classes.dir}">
                <include name="**/*.class"/>
            	<exclude name="**/dao/**/*.class"/>
            	<exclude name="org/hibernate/**"/>
            </fileset>
        </jar>
		
		<jar jarfile="${opt.ora.dialect.jar.loc}">
            <manifest>
                <attribute name="Manifest-Version" value="1.0"/>
                <attribute name="Implementation-Title" value="${opt.ora.dialect.jar.name}"/>
                <attribute name="Implementation-Vendor" value="${vendor}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Build-Date" value="${build.date}"/>
                <attribute name="Build-Stamp" value="${build.stamp}"/>
                <attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
                <attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
            </manifest>
            <fileset dir="${classes.dir}">
                <include name="org/hibernate/**/*.class"/>
            </fileset>
        </jar>
		
		<jar jarfile="${project-persistence-daojdbc.jar.loc}">
            <manifest>
                <attribute name="Manifest-Version" value="1.0"/>
                <attribute name="Implementation-Title" value="${opt.ora.dialect.jar.name}"/>
                <attribute name="Implementation-Vendor" value="${vendor}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Build-Date" value="${build.date}"/>
                <attribute name="Build-Stamp" value="${build.stamp}"/>
                <attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
                <attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
            </manifest>
            <fileset dir="${classes.dir}">
            	<include name="**/dao/**/*.class"/>
            </fileset>
        </jar>
     </target>

    <!-- ================================================================= -->
    <!-- === generator                                                 === -->
    <!-- ================================================================= -->
    <target name="generateExtendedAdxml">
    	<generateExtendedAdxml classpathref="gdi.ddl.classpath">
    		<additionalSystemProperties>
    			<systemproperty name="modifiedInputOnly" value="true"/>
    		</additionalSystemProperties>
		</generateExtendedAdxml>
    </target>

	<target name="generateEntities" description="Generate entities into build folder" depends="init, generateExtendedAdxml">
		<gditask classpathref="gdi.ddl.classpath"
				 cartridgePath="${etc.dir}/gdi/adxml2entities"
				 outputPath="${generated.dir}/gdi/adxml2entities">
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
			<input>
				<fileset dir="${generated.dir}/gdi/extend-adxml" />
			</input>
			<properties>
				<fileset file="${etc.dir}/mappings.properties" />
				<fileset file="${etc.dir}/gdi.properties" />
			</properties>
		</gditask>
	</target>
    
    <target name="generateDdl" depends="generateExtendedAdxml" unless="omit.subcomponent.persistence.sql">
    	<generateDdl classpathref="gdi.ddl.classpath"/>
	        
	    <!-- Logon specific DDL/SQL scripts -->
	    <gditask classpathref="gdi.classpath"
		     cartridgePath="${etc.dir}/gdi/database"
		     outputPath="${generated.dir}/gdi/adxml2ddl">
    		<input>
				<fileset dir="${build.dir}/generated/gdi/extend-adxml"/>
		    </input>
		    <systemproperty name="modifiedInputOnly" value="true"/>
	    	
	    	<!-- We have to generate this (sadly), because if
	    	it does the up-to-date check it will always skip it;
	    	since standard SQL scrips are generated in line 206
	    	to the same output directory from the same input.
	    	ADN76485 nemes -->
		    <systemproperty name="noUptodateCheck" value="true"/>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
	    </gditask>
	    
    	<!-- Initial/ref/etc. data -->
    	<gditask classpathref="gdi.classpath"
		     cartridgePath="${etc.dir}/gdi/csv2sql"
		     outputPath="${generated.dir}/gdi/csv2sql">
	    	<input>
				<fileset dir="${etc.dir}/csv"/>
		    </input>
	        <systemproperty name="csv_separator" value=";"/>
		    <systemproperty name="csv_quote_character" value='"'/>
		    <systemproperty name="csv_skip_lines" value="0"/>
   			<systemproperty name="modifiedInputOnly" value="true"/>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
	    </gditask>
    </target>
    
    <target name="generate" depends="generateExtendedAdxml">
     	<!-- <generateJpa>
     		<additionalSystemProperties>
    			<systemproperty name="modifiedInputOnly" value="true"/>
    		</additionalSystemProperties>
		</generateJpa> -->
		
     	<gditask classpathref="gdi.classpath"
		     cartridgePath="${etc.dir}/gdi/generatejdbcdaos"
		     outputPath="${generated.dir}/gdi/generatejdbcdaos">
	    	<input>
				<fileset dir="${build.dir}/generated/gdi/extend-adxml"> 
	    			<include name="**/tlgnu_user.xml"/>
	    			<include name="**/tlgnc_person.xml"/>
	    			<include name="**/tlgnu_user_activity.xml"/>
	    			<include name="**/vlgnu_user_activity_log.xml"/>
	    			<include name="**/tlgnr_user_activity_action_bs.xml"/>
	    			<include name="**/tlgnr_user_activity_action_tx.xml"/>
	    			<include name="**/tlgnr_config.xml"/>
					<include name="**/tlgnc_config_login_module.xml"/>
	    			<include name="**/tlgnr_text_bs.xml"/>
	    			<include name="**/tlgnr_text_tx.xml"/>
				</fileset>
		    </input>
		    <properties>
			    <fileset file="${etc.dir}/gdi/generatejdbcdaos/mappings.properties"/>
		    </properties>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
	    </gditask>
		
     	<gditask classpathref="gdi.classpath"
		     cartridgePath="${etc.dir}/gdi/generatedauthorizer"
		     outputPath="${generated.dir}/gdi/generatedauthorizer">
	    	<input>
				<fileset dir="${build.dir}/generated/gdi/extend-adxml" />
		    </input>
		    <properties>
			    <fileset file="${etc.dir}/mappings.properties"/>
		    </properties>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
	    </gditask>

    	<!-- JPA 2 metamodel generation --> 
    	<mkdir dir="${generated.dir}/jpa/metamodel/src"/>
        <javac
            source="${compile.source}"
            target="${compile.target}"
            destdir="${generated.dir}/jpa/metamodel/src"
            debug="${compile.debug}"
            optimize="${compile.optimize}"
            deprecation="${compile.deprecation}"
            encoding="${compile.encoding}"
            includeantruntime="no">
            <src path="${java.src.dir}"/>
            <!-- <src path="${build.dir.name}/generated/gdi/adxml2entities/src"/> -->
            <src path="${generated.dir}/gdi/generatejdbcdaos/src"/>
            <!-- <src path="${build.dir.name}/generated/gdi/jpa-dao-persistence/src"/> -->
            <src path="${generated.dir}/gdi/generatedauthorizer/src"/>
            <include name="**/*.java"/>
            <bootclasspath refid="compile.bootclasspath"/>
            <classpath>
                <path refid="compile.classpath"/>
                <path refid="logon-mavendeps.compile.classpath"/>
            </classpath>
        	<compilerarg value="-proc:only"/>
        	<compilerarg value="-AaddSuppressWarningsAnnotation=true"/>
        </javac>
    </target>

    <target name="csv2sqlTD">
        <java classname="ch.nevis.gdi.main.TemplateDesigner"
            fork="true" failonerror="true" newenvironment="true">
            <jvmarg value="-Dcsv_separator=;"/>
            <jvmarg value='-Dcsv_quote_character="'/>
            <jvmarg value="-Dcsv_skip_lines=0"/>
            <classpath refid="gdi.classpath"/>
            <arg line="${etc.dir}/gdi/csv2sql etc/csv ${generated.dir}/gdi/td/csv2sql ${etc.dir}/gdi/csv2sql/gdi.properties"/>
        </java>
    </target>

    <target name="db2local" description="Dumps the database structure" depends="ddlutils, oraviews"/>

    <target name="ddlutils" description="Dumps the database structure">
        <taskdef name="databaseToDdl" classname="org.apache.ddlutils.task.DatabaseToDdlTask">
          <classpath refid="ddlutils.classpath"/>
        </taskdef>

        <mkdir dir="${generated.dir}/ddlutils"/>
        <databaseToDdl modelName="Logon" verbosity="DEBUG" schemapattern="${db.connection.username}">
            <database url="${refdb.connection.url}"
                      driverClassName="oracle.jdbc.driver.OracleDriver"
                      username="${db.connection.username}"
                      password="${db.connection.password}"/>
            <writeschematofile outputfile="${generated.dir}/ddlutils/schema.xml"/> 
        </databaseToDdl>

        <!-- we have to patch the xml file so that xmlbeans (in gdi) recognizes the xml -->
        <replaceregexp byline="true" encoding="UTF-8">
            <regexp pattern="(&lt;database) (name=.*?)"/>
            <substitution expression="\1 xmlns='http://db.apache.org/schemas' \2"/>
            <fileset file="${generated.dir}/ddlutils/schema.xml"/>
        </replaceregexp>
    </target>

    <target name="oraviews" description="Generates mapping files for views in DB, which can be CVS added/updated after verification.">
        <views2adxml 
        	jdbcdriverclass="oracle.jdbc.driver.OracleDriver" 
        	dbname="Logon"
        	jdbcUrl="${db.connection.url}"
			schema="${db.connection.schema_owner}"
			user="${db.connection.schema_owner}"
            password="${db.connection.schema_owner_pwd}"
            classpathref="gdi.classpath" />
    </target>

	<path id="jpa.classpath">
		<path refid="gdi.classpath"/>
		<!-- NOTE: these are NOT build-requirements! -->
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/hibernate3.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/hibernate-annotations.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/hibernate-entitymanager.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/ejb3-persistence.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/client/jboss-common-client.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/client/jboss-ejb3-client.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/jboss-j2ee.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/dom4j.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/javassist.jar"/>
		<pathelement location="${MPOSITORY_DIR}/commons-collections/commons-collections/3.2.2/commons-collections-3.2.2.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/cglib.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/antlr.jar"/>
		<pathelement location="/share/java/jpository/jakarta/commons-lang/2.3/commons-lang-2.3.jar"/>
		<pathelement location="/share/java/jpository/opensource/jboss/4.2.3/dist-bin/server/all/lib/hsqldb.jar"/>
		<pathelement location="${build.dir}/jpaconsole"/>
		<pathelement location="${project-persistence.jar.loc}"/>
	</path>


	<!-- marius/2012-11-29: taken from adnant, aal-gdi-persistence.xml -->
    <!-- generator libs -->
    <path id="gdi.ddl.classpath">
        <fileset dir="${GDI_DDL_HOME}/lib">
            <include name="**/*.jar"/>
        </fileset>
        <path refid="gdi.classpath" />
    </path>

	<target name="oradbdiff" depends="generateExtendedAdxml">
        <mkdir dir="${build.dir}/gdi/input/dbschema2csv"/>
        <touch file="${build.dir}/gdi/input/dbschema2csv/result.properties"/>
		<copy todir="${build.dir}/jpaconsole/META-INF" file="../test/etc/persistence.xml" overwrite="true" filtering="true">
			<filterchain>
				<expandproperties/>
			</filterchain>
		</copy>
		
		<gditask classpathref="jpa.classpath"
             cartridgePath="${GDI_DDL_HOME}/cartridges/dbschema2csv"
             outputPath="${generated.dir}/gdi/dbschema2csv">
			<input>
				<fileset dir="${build.dir}/gdi/input/dbschema2csv"/>
		    </input>
		    <properties>
				<fileset file="${etc.dir}/mappings.properties"/>
			</properties>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
        </gditask>		
		
		<gditask classpathref="gdi.classpath"
             cartridgePath="${GDI_DDL_HOME}/cartridges/xmlschema2csv"
             outputPath="${generated.dir}/gdi/xmlschema2csv">
			<input>
				<fileset dir="${build.dir}/generated/gdi/extend-adxml" />
		    </input>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
        </gditask>

		<java classname="ch.nevis.gdi.ddl.tools.OraDbDiff"
            fork="true" failonerror="true" newenvironment="true">
			<classpath refid="jpa.classpath"/>
		</java>
	</target>
	
	<target name="generateDeleteBp">
		<gditask classpathref="gdi.classpath"
		 cartridgePath="${etc.dir}/gdi/deletebp"
		 outputPath="${generated.dir}/gdi">
		<input>
			<fileset dir="${etc.dir}/csv/deletebp"/>
		</input>
		<systemproperty name="csv_separator" value=";"/>
		<systemproperty name="csv_quote_character" value='"'/>
		<systemproperty name="csv_skip_lines" value="0"/>
		<systemproperty name="modifiedInputOnly" value="true"/>
		<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
		</gditask>
  </target>

  <target name="copy-sql" depends="generateDdl">
    <copy todir="${build.dir}/sql">
      <fileset dir="${generated.dir}/gdi/adxml2ddl/sql"/>
      <fileset dir="${generated.dir}/gdi/csv2sql"/>
      <filterchain>
        <linecontainsregexp negate="true">
          <regexp pattern="slgns_sap_bp_pf_ssapbpsareai|slgns_sap_bp_pf_ssareaid"/>
        </linecontainsregexp>
      </filterchain>
    </copy>
    <copy todir="${build.dir}/sql">
      <fileset dir="${etc.dir}/sql"/>
      <filterchain>
        <linecontainsregexp negate="true">
          <regexp pattern="^spool"/>
        </linecontainsregexp>        
      </filterchain>
    </copy>
  </target>
	
    <!-- ================================================================= -->
    <!-- === distribution targets                                      === -->
    <!-- ================================================================= -->
    <target name="dist" description="build the distribution" unless="omit.subcomponent.persistence">
        <antcall target="realdist" inheritall="true"/>
    </target>
	
    <target name="realdist" depends="build, jars">
        <copy todir="${dist.lib.dir}" file="${project-persistence.jar.loc}"/>
        <copy todir="${dist.lib.dir}" file="${project-persistence-client.jar.loc}"/>
	<copy todir="${dist.lib.dir}" file="${opt.ora.dialect.jar.loc}"/>
        <copy todir="${dist.dep.dir}" file="${project-common.jar.loc}"/>
        <copy todir="${dist.dep.dir}" file="${jcan-log.jar}"/>
        <copy todir="${dist.dep.dir}" file="${commons-lang.jar}"/>
    	<copy todir="${dist.dep.dir}" file="${opencsv.jar}"/> 
    	<!--
			logon-business will use the sources to generate RefDataServiceBean.
			logon-admin-web will use the sources to generate TableBeans.
		-->
		<copy todir="${dist.dir}/src">
			<fileset dir="${java.src.dir}">
            	<include name="**/entities/**" />
            </fileset>

		</copy>
    	
    	<!-- JBoss 7 -->
    	<copy todir="${dist.lib.dir}" file="${project-persistence-daojdbc.jar.loc}"/>
    </target>

    <!-- NOTE: what we build here is only used for development (enables faster dev-cycles) -->
    <target name="deploy" depends="dist" description="deploy this sub-project only">
        <echo>nothing to deploy here!</echo>
    </target>

    <!-- ================================================================ -->
    <!-- source code tracing instrumentation targets                      -->
    <!-- ================================================================ -->
    <target name="adntrace2-instrument">
        <taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
        <adntrace2 operation="instrument"/>
    </target>

    <target name="adntrace2-refresh">
        <taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
        <adntrace2 operation="refresh"/>
    </target>
	
	<target name="load-metadata">
		<sql classpath="${hsqldb.jar}" driver="org.hsqldb.jdbcDriver" password="" url="${hibernate.connection.url}" userid="sa" src="${etc.dir}/sql/refdata/table_meta.sql"/>
		<sql classpath="${hsqldb.jar}" driver="org.hsqldb.jdbcDriver" password="" url="${hibernate.connection.url}" userid="sa" src="${etc.dir}/sql/refdata/column_meta.sql"/>
		<sql classpath="${hsqldb.jar}" driver="org.hsqldb.jdbcDriver" password="" url="${hibernate.connection.url}" userid="sa" src="${etc.dir}/sql/refdata/cat.sql"/>
	</target>

  <target name="db-patch" description="Execute a sql patchfile to dev-maintained DBs. See usage with adnant db-patch-help.">
    <property name="patchDir" value="${subcomponent.persistence}/${generated.patch.dir}"/>
    <echo>Executing patch to the following DBs: ${db.patched.list}</echo>
    <echo>Using ${patchDir}</echo>
	  <for list="${db.patched.list}" param="dbname">
      <sequential>
	      <sqlplus script="${patchDir}"
	        user="${db.@{dbname}.user}"
	        password="${db.@{dbname}.password}"
	        hostname="${db.@{dbname}.hostname}"
	        port="${db.@{dbname}.port}"
	        sid="${db.@{dbname}.sid}"
          run.dir="${masterbuild.dir}" />
      </sequential>
    </for>
  </target>

  <target name="db-patch-help" description="db-patch howto">
    <echo>-----------------------------------------------------------------------------------------------</echo>
    <echo>
      The db-patch target will execute a SQL script found here:
      ${generated.patch.dir} 
      which includes the user-made sql script here:
      ${user.patch.dir}

      You can generate the a patch stubs there by calling the db-patch-generate target
      
      Then insert the SQL statements you want to execute on the servers into ${user.patch.dir}

      Currently, the wrapper script will only include the session related settings in logon-persistence,
      from here: logon-persistence/etc/sql/set_logon_session_settings.sql
      
      The list of DBs, on which the sql patch is exectuted can be 
      altered too, in config/logon-db.properties, edit db.patched.list.

      You can override the default location in config/logon-db.properties,
      or use -DpatchDir=somelocation ir -DuserPatchDir=someotherlocation.
      Pay attention however to execute the session related configurations, 
      such as "alter session set nls_length_semantics=CHAR;" or to include
      the file set_logon_session_settings.sql
    </echo>
    <echo>-----------------------------------------------------------------------------------------------</echo>
    <echo>
      #Example for usage:
      adnant db-patch-generate
      #edit the patch file, insert your patches
      gedit ${user.patch.dir}
      adnant db-patch
      
      #Example to run the command with your own patch:
      adnant db-patch -DpatchDir=/local/workspaces/8/logon/logon/do-not-commit-patch.sql
    </echo>
    <echo>-----------------------------------------------------------------------------------------------</echo>
  </target>

  <target name="db-patch-generate" description="Generates a patch. See usage with adnant db-patch-help.">
    <property name="patchDir" value="${subcomponent.persistence}/${generated.patch.dir}"></property>
    <property name="userPatchDir" value="${subcomponent.persistence}/${user.patch.dir}"></property>
    <echo file="${patchDir}">@@${subcomponent.persistence}/etc/sql/set_logon_session_settings.sql</echo>
    <echo file="${patchDir}" append="true">${line.separator}</echo>
    <echo file="${patchDir}" append="true">@@${userPatchDir}</echo>
    <echo file="${patchDir}" append="true">${line.separator}</echo>
    <echo file="${userPatchDir}" >-- Insert your patch here </echo>
    <echo file="${userPatchDir}" append="true">${line.separator}</echo>
    <echo>Generated wrapper script here: ${patchDir}</echo>
    <echo>Edit the file ${userPatchDir}</echo>
  </target>


