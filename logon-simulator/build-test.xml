	<!-- Command line arguments see at https://www.soapui.org/test-automation/running-from-command-line/load-tests.html -->
	<target name="test-load-ws" description="WS testing suite for load testing. Contains order creation requests and PDA login.">
		<property name="testsuite" value="Load CEM Test Suite" />
		<property name="JAVA" value="java" />	
		<sequential>
			<echo>===================================================================================</echo>		
			<echo/>
			<echo>LOGON SIMULATOR LOAD TEST</echo>
			<echo/>	
			<echo>Running soapUI Project: integration-tests</echo>
			<echo/>	
			<echo>Test Suite : "${testsuite}"</echo>
			<echo/>
			<echo >===================================================================================</echo>
			<echo/>
			<echo/>
			<property environment="env" />
					<exec resultproperty="test.integration.result" executable="${SOAPUI_5_HOME}bin/loadtestrunner.sh">
						<env key="PATH" path="${JAVA_HOME}/bin:${env.PATH}" />
						<arg value="-f" />
						<arg value="${test.reports.integration.dir}/" />
						<arg value="-s" />
						<arg value="${testsuite}" />
						<arg value="-e" />
						<arg value="${ws.logon.ldsevent.consumer.url}" />
						<arg value="-t" />
						<arg value="${basedir}/soapui-settings.xml" />						
						<arg value="${soapui.int.project.file}" />
						<arg value="-r" />
					</exec>

			<!-- catch exit code from SoapUI to detect failed test cases -->
			<condition property="test.integration.failed" value="true">
				<not>
					<equals arg1="${test.integration.result}" arg2="0"/>
				</not>
			</condition>
			<!-- integration tests:  --> 
			
			<junitreport todir="${test.reports.integration.dir}">
				<fileset dir="${test.reports.integration.dir}">
					<include name="TEST-*.xml"/>
				</fileset>
                <report format="frames" todir="${test.reports.integration.dir}" styledir="${masterbuild.dir}/test/etc">
            	    <param name="TESTTYPE" expression="Integration" />
           	    </report> 
			</junitreport>

			<set-flag-file-if-property-set flagfile="${test.integration.failed.flag}" propertyname="test.integration.failed"
				message="at least one test failed --> setting failure flag file" />
			<fail if="test.integration.failed" message="at least one of the tests failed"/>
			<echo message="all tests successful"/>		
		</sequential>
	</target>

	<!--  Keep as report only the statistics, plain text file. -->
	<target name="test-load-report" description="copies over load test related files to NB report area">
		<echo message="Merge statistics.txts into one file ${subcomponent.test-load}/build/test/reports/load/statistics_all.txt" />	
		<shellscript shell="sh">			
		find ${test.reports.integration.dir} -name '*statistics.txt' -print | xargs grep . -h  >> ${subcomponent.test-load}/build/test/reports/load/statistics_all.txt
		</shellscript>						
	</target>

