<?xml version="1.0" encoding="UTF-8"?>
<definitions targetNamespace="http://logon.holcim.com/2009/09/MOPEvent/" xmlns:tns="http://logon.holcim.com/2009/09/MOPEvent/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"  xmlns="http://schemas.xmlsoap.org/wsdl/">
  <types>
    <xsd:schema elementFormDefault="qualified" targetNamespace="http://logon.holcim.com/2009/09/MOPEvent/">
      <xsd:include schemaLocation="xsd/MOPData_v1_1_0_complex_types.xsd"/>
    </xsd:schema>
  </types>
  <message name="consume_message">
    <part name="mopMessage" element="partns:MOPMessage" xmlns:partns="http://logon.holcim.com/2009/09/MOPEvent/"/>
  </message>
  <message name="consume_status">
    <part name="status" element="partns:MOPMessageStatus" xmlns:partns="http://logon.holcim.com/2009/09/MOPEvent/"/>
  </message>
  <portType name="MOPEventPort">
    <operation name="consume">
      <input message="tns:consume_message"/>
      <output message="tns:consume_status"/>
    </operation>
  </portType>
  <binding name="MOPEventPort" type="tns:MOPEventPort">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="consume">
      <soap:operation soapAction="consume"/>
      <input>
        <soap:body use="literal" />
      </input>
      <output>
        <soap:body use="literal" />
      </output>
    </operation>
  </binding>
  <service name="MOPEventConsumer">
    <port name="MOPEventPort" binding="tns:MOPEventPort">
      <soap:address location="https://logon.holcim.com/logon/webservices-mop-incoming/services/MOPEventConsumer"/>
    </port>
  </service>
</definitions>
