Created On    : 26-Feb-2009 / uma
ADN Bugzilla  : -
ADN Change ID : PERSIST229: Corrections in sap_material, and updated sap_vendor to spec.
Cust Bug ID   : -
Platform      : -
Component     : -
Symptoms      : A few datatypes and in sap_material were wrong (text instead
		of decimal). Also, renaming marked_for_deletion into active_flag
		was a bad idea.
Description   : -
Fix           : Corrected types (and db comments), introduced more FK to
		tlgnr_lang, and renamed back to marked_for_deletion. Is consistent
		with all tlgns_sap_ tables.
Workaround    : Manually on DHULGN01:
		alter TABLE TLGNS_SAP_MATERIAL add (
		    MARKED_FOR_DELETION              VARCHAR2(1)          NULL
		);
		alter TABLE TLGNS_SAP_MATERIAL modify active_flag NULL;
		-- do this afternoon:
		-- alter TABLE TLGNS_SAP_MATERIAL drop column active_flag;
		ALTER TABLE         TLGNS_SAP_MATERIAL_DESCRIPTION
		    ADD CONSTRAINT  FK_TLGNS_SAP_MAT_DESC_LANG
			FOREIGN KEY     (LANG_CD)
			REFERENCES      TLGNR_LANG_BS (LANG_CD);
		alter TABLE TLGNS_SAP_MATERIAL_PLANT  modify (
			VAL_STANDARD_PRICE               DECIMAL(11,2),
			VAL_MOVING_AVG_PRICE             DECIMAL(11,2),
            VAL_CURRENCY                     VARCHAR2(5)
		);
		alter TABLE TLGNS_SAP_VENDOR add (
		    LANG_CD                          VARCHAR2(2)          NULL
		);
		-- Do later:
        -- alter TABLE TLGNS_SAP_VENDOR drop column LANGUAGE_CD;
		ALTER TABLE         TLGNS_SAP_VENDOR
		    ADD CONSTRAINT  FK_TLGNS_SAP_VENDOR_LANG
			FOREIGN KEY     (LANG_CD)
			REFERENCES      TLGNR_LANG_BS (LANG_CD);
Release Notes : -
Dependants    : -
Requires      : -
