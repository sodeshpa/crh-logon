             Note that this prefixing of the shipto id is necessary, because silos standing at different shipto can be called identical.
         -->
        <unique name="UQ_TLGNC_RFIDOBJECT_TYPE_LABEL">
            <unique-column name="RFIDOBJECT_TYPE_CD"/>
            <unique-column name="OBJECT_LABEL"/>
        </unique>
