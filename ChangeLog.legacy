	-- SOLDTO_SAP_BP_ID will be NOT NULL in a real DB!!
	alter TABLE TLGNC_ORDER_BULKPRD add (
	    SOLDTO_SAP_BP_ID                 DECIMAL(12)          NULL,
	    ACTUAL_DELIVERY_DAT              DATE                 NULL
	);
	ALTER TABLE         TLGNC_ORDER_BULKPRD
	    ADD CONSTRAINT  FK_TLGNC_ORDER_BULKPRD_SOLD
	    FOREIGN KEY     (SOLDTO_SAP_BP_ID)
	    REFERENCES      TLGNS_SAP_SHIPTO (SAP_BP_ID);
	CREATE INDEX I_ORDER_BULKPRD_16                ON TLGNC_ORDER_BULKPRD             (SOLDTO_SAP_BP_ID);
