if (quantity != null) {
	BigDecimal quantityInTons = convertToTons(fromUom, quantity);
	if (quantityInTons != null) {
		BigDecimal quantityInKg = quantityInTons.multiply(new BigDecimal(1000));
		allItemsNetWeight = allItemsNetWeight.add(quantityInKg);
	}
}

