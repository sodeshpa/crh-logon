			(received in various requests)

			endLoadingPartData.affectedOrders.logonOrderNo 8 -> 12
			(received in EndLoadingRequest, not used in logon at the moment)

			addServiceMaterialsToOrderRequest.logonOrderNo 8 -> 12
			(used to lookup the order)

			selectLoadOrderForLoadingRequest.orderValidation.logonOrderNo 8 -> 12
			(used in ordervalidation to lookup the order)
			
			endLoadingRequest.returnPallets.logonOrderNo 8 -> 12 
			(not used currently)

			logon-webservices-client/etc/wsdl/xsd/LogonLDSInterface_notifications.xsd
			(no mentioned fields used)

			logon-webservices-client/etc/wsdl/xsd/LogonLDSInterface_common_out.xsd
			orderData.logonOrderNo 8 -> 12
			(sent in various responses, set from order.ordernumber)

			endLoadingPartData.affectedOrders.logonOrderNo 8 -> 12
			(not used in this context)

Fix           : -
Workaround    : -
Release Notes : -
Dependants    : -
Requires      : -
Pkg Changes   : -
Affected Files:

M logon-common/etc/gdi/xml2beans_in/input/logon_lds_interface.xsd
M logon-webservices-client/etc/wsdl/xsd/LogonLDSInterface_common_out.xsd

