<project name="logon" default="dist" basedir=".">
	<description>${ant.project.name} project build file</description>

	<!-- ================================================================= -->
	<!-- === externally defined                                        === -->
	<!-- ================================================================= -->
	<import file="properties.xml"/>
	<import file="../common.xml"/>
	<import file="macros.xml"/>

	<!-- ================================================================ -->
	<!--  define target specific classpaths (build, runtime, test)        -->
	<!-- ================================================================ -->
	<path id="axis2.classpath">
		<fileset dir="${AXIS2_HOME}/lib">
			<include name="*.jar"/>
		</fileset>
	</path>

	<path id="compile.classpath">
		<pathelement location="${project-common.jar.loc}"/>
		<pathelement location="${project-persistence.jar.loc}"/>
		<pathelement location="${project-business.jar.loc}"/>
		<pathelement location="${project-common-web.classes.dir}"/>
		<pathelement location="${hibernate-jpa2.jar}"/>
		<pathelement location="${hibernate4.jar}"/>
		<pathelement location="${commons-lang.jar}" />
		<pathelement location="${jcan-log.jar}" />
		<pathelement location="${log4j.jar}" />
		<pathelement location="${commons-beanutils.jar}" />
		<path refid="axis2.classpath" />
	</path>

	<path id="axis2.class.path">
		<pathelement path="${java.class.path}"/>
		<pathelement path="${maven.class.path}"/>
		<path refid="axis2.classpath"/>
		<path refid="compile.classpath"/>
	</path>

	<!-- ================================================================ -->
	<!--  initialization, cleanup and default targets                     -->
	<!-- ================================================================ -->
	<target name="all" depends="dist"
			description="build and test everything"/>

	<target name="toolbox-checkUptodate">
		<uptodate property="toolbox-isUptodate" targetfile=".classpath">
			<srcfiles refid="toolbox-sourcefiles"/>
		</uptodate>
	</target>

	<target name="toolbox" depends="toolbox-checkUptodate" unless="toolbox-isUptodate">
		<taskdef resource="adnant-taskdefs.xml"/> <!-- See documentation in adnant project's README -->

		<updatedotclasspath>
			<!-- See documentation of 'updatedotclasspath' in adnant project's README -->
			<con path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
			<output path=".bin"/>
			<src path="/logon-common"/>
			<src path="/logon-persistence"/>
			<src path="/logon-business"/>
			<src path="/logon-common-web"/>
			<src path="${java.src.dir.name}"/>
			<src path="${build.dir.name}/${generated.dir.name}/${src.dir.name}"/>
			<lib path="${adntrace2-templates.jar}" sourcepath="${masterbuild.dir}/etc/adntrace2"/>
		</updatedotclasspath>
	</target>

	<target name="init" depends="toolbox"
			description="initialization project structure and environment">
		<tstamp/>
		<echo message="--------- ${ant.project.name}-${build.version} building on ${os.name} ---------"/>
		<echo message=""/>
		<echo message="building file ${ant.file} with ${ant.version}"/>
		<echo message=""/>
		<mkdir dir="${build.dir}"/>
		<mkdir dir="${classes.dir}"/>
		<mkdir dir="${lib.dir}"/>
		<mkdir dir="${test.build.dir}"/>
		<mkdir dir="${test.log.dir}"/>
		<mkdir dir="${test.lib.dir}"/>
	</target>

	<target name="clean" description="cleans all generated files and directories" >
		<delete dir="${build.dir}"/>
	</target>

	<!-- ================================================================ -->
	<!--  compile targets                                                 -->
	<!-- ================================================================ -->
	<target name="build" depends="war" description="build target" />

	<!-- compilation target was generated by axis2, see 'generator' section  and
         'Auto generated ant build file contents' -->
	<target name="compile" depends="compile-src, compile-test"/>

	<target name="compile-src" depends="init, generate">
		<javac
				source="${compile.source}"
				target="${compile.target}"
				destdir="${classes.dir}"
				debug="${compile.debug}"
				optimize="${compile.optimize}"
				deprecation="${compile.deprecation}"
				encoding="${compile.encoding}"
				includeantruntime="no">
			<src path="${java.src.dir}"/>
			<src path="${build.dir.name}/${generated.dir.name}/${src.dir.name}"/>
			<include name="**/*.java"/>
			<bootclasspath refid="compile.bootclasspath"/>
			<classpath refid="compile.classpath"/>
		</javac>
	</target>

	<!-- ================================================================ -->
	<!--  java archives (JARs, WARs)                                      -->
	<!-- ================================================================ -->
	<target name="war-checkUptodate">
		<uptodate property="war-isUptodate" targetfile="${war.dir}/${project-webservices-oc-incoming.war.name}">
			<srcfiles dir="${axis2.stage.dir}"/>
		</uptodate>
		<echo>war-isUptodate: ${war-isUptodate}</echo>
	</target>

	<target name="war" depends="axis2-init, war-checkUptodate" unless="war-isUptodate">
		<pathconvert property="manifest.classpath" pathsep=" ">
			<path refid="axis2.runtime.classpath"/>
			<mapper>
				<chainedmapper>
					<flattenmapper/>
					<globmapper from="*.jar" to="lib-axis2/*.jar"/>
				</chainedmapper>
			</mapper>
		</pathconvert>
		<mkdir dir="${war.dir}" />
		<war destfile="${war.dir}/${project-webservices-oc-incoming.war.name}" webxml="${resources.src.dir}/WEB-INF/web.xml">
			<manifest>
				<attribute name="Class-Path" value="${manifest.classpath}"/>
			</manifest>
			<classes dir="${project-common-web.classes.dir}"/>
			<fileset dir="${project-common-web.resources.dir}"/>
			<fileset dir="${resources.src.dir}">
				<include name="WEB-INF/*.xml"/>
				<exclude name="WEB-INF/web.xml"/>
			</fileset>
			<webinf dir="${axis2.stage.dir}/WEB-INF" />
		</war>
	</target>

	<target name="axis-checkUptodate">
		<fileset id="lib-files" dir="${lib.dir}">
			<exclude name="${webservices.client.jar.name}" />
		</fileset>
		<uptodate property="axis-isUptodate" targetfile="${axis2.stage.dir}/WEB-INF/services/services.list">
			<srcfiles dir="${etc.dir}/axis2">
				<include name="axis2_template.xml"/>
			</srcfiles>
			<srcfiles refid="lib-files" />
		</uptodate>
		<echo>axis-isUptodate: ${axis-isUptodate}</echo>
	</target>

	<target name="axis2-init" depends="jar.server, axis-checkUptodate" unless="axis-isUptodate">
		<mkdir dir="${axis2.stage.dir}" />
		<copy toDir="${axis2.stage.dir}">
			<fileset dir="${AXIS2_HOME}/webapp">
				<include name="**/**" />
				<exclude name="**/web.xml"/>
				<exclude name="**/log4j.properties"/>
			</fileset>
		</copy>

		<!-- Copying the axis2 repository from ../repository -->
		<copy toDir="${axis2.stage.dir}/WEB-INF">
			<fileset dir="${AXIS2_HOME}/repository">
				<include name="**/**" />
			</fileset>
		</copy>

		<!-- Copying the webservices -->
		<copy toDir="${axis2.stage.dir}/WEB-INF/services">
			<fileset dir="${lib.dir}">
				<include name="*.aar" />
			</fileset>
		</copy>

		<!-- Creating the services.list -->
		<path id="services.archives">
			<fileset dir="${axis2.stage.dir}/WEB-INF/services">
				<include name="*.aar" />
			</fileset>
		</path>
		<pathconvert pathsep="${line.separator}" property="echo.services.archives" refid="services.archives">
			<flattenmapper />
		</pathconvert>
		<echo file="${axis2.stage.dir}/WEB-INF/services/services.list" message="${echo.services.archives}" />

		<!-- Creating the modules.list -->
		<path id="modules.archives">
			<fileset dir="${axis2.stage.dir}/WEB-INF/modules">
				<include name="*.mar" />
			</fileset>
		</path>
		<pathconvert pathsep="${line.separator}" property="echo.modules.archives" refid="modules.archives">
			<flattenmapper />
		</pathconvert>
		<echo file="${axis2.stage.dir}/WEB-INF/modules/modules.list" message="${echo.modules.archives}" />

		<!-- Setting properties for axis2.xml -->
		<mkdir dir="${axis2.stage.dir}/WEB-INF/conf" />
		<copy file="${etc.dir}/axis2/axis2_template.xml" toFile="${axis2.stage.dir}/WEB-INF/conf/axis2.xml">
			<filterchain>
				<expandproperties />
			</filterchain>
		</copy>
	</target>

	<!-- ================================================================= -->
	<!-- === generator                                                 === -->
	<!-- ================================================================= -->
	<target name="generate-checkUptodate">
		<uptodate property="generate-isUptodate"
				  targetfile="${war.dir}/${project-webservices-oc-incoming.war.name}">
			<srcfiles dir="${wsdl.dir}">
				<include name="**/*.wsdl" />
				<include name="**/*.xsd" />
			</srcfiles>
		</uptodate>
		<echo>generate-isUptodate: ${generate-isUptodate}</echo>
	</target>

	<target name="generate" depends="correctWsdls, generate-checkUptodate" unless="generate-isUptodate">
		<antcall target="init-services" />

		<echo message="---------  Generating WebService classes (stub, skeleton interface, etc) for ${logonocifc.wsdl.name} ---------" />
		<java classname="org.apache.axis2.wsdl.WSDL2Java" fork="true"
			  classpathref="compile.classpath">
			<arg line="-uri ${generated.wsdl.dir}/${logonocifc.wsdl.name}" />
			<arg line="-ss" />
			<arg line="-sd" />
			<arg line="-o ${generated.dir}" />
			<arg line="-p ${webservices.package.prefix.logonocifc}"/>
			<arg line="-ssi" />
			<arg line="-sin LogonOCInterfaceConsumerInterface" />
			<arg line="-scn LogonOCInterfaceConsumer" />
		</java>
		<antcall target="update-services" />

		<antcall target="finalize-services" />
		<delete includeemptydirs="true" failonerror="false">
			<!-- Silly axis generates stuff we don't need/want in the axis2/apache/org -->
			<fileset dir="${generated.dir}/src/axis2"/>
			<fileset dir="${generated.dir}" includes="**/LogonOCInterfaceConsumer.java"/>
		</delete>
	</target>

	<target name="correctWsdls">
		<copy toDir="${generated.wsdl.dir}">
			<fileset dir="${wsdl.dir}">
				<include name="**/*.wsdl" />
				<include name="**/*.xsd" />
			</fileset>
		</copy>

		<echo message="host: ${webservices.host.url}" />

		<replaceregexp byline="true" encoding="utf-8" flags="g">
			<regexp pattern="(&lt;soap:address location=&quot;)(https://logon.crh.com)" />
			<substitution expression="\1${webservices.host.url}"/>
			<fileset dir="${generated.wsdl.dir}" includes="**/*.wsdl" />
		</replaceregexp>
	</target>

	<!-- ================================================================= -->
	<!-- === distribution targets                                      === -->
	<!-- ================================================================= -->
	<target name="dist" description="build the distribution" unless="omit.subcomponent.webservices-oc-incoming">
		<antcall target="realdist" inheritall="true"/>
	</target>
	<target name="realdist" depends="build">
		<copy todir="${dist.lib.dir}/wars" file="${war.dir}/${project-webservices-oc-incoming.war.name}" verbose="true" />
		<copy todir="${dist.dep.dir}/lib" file="${jcan-log.jar}"/>
		<copy todir="${dist.dep.dir}/lib" file="${jcan-optrace.jar}"/>
		<copy todir="${dist.dep.dir}/lib" file="${commons-beanutils.jar}"/>
		<copy todir="${dist.dep.dir}" file="${commons-collections.jar}"/>
		<copy todir="${dist.dep.dir}/lib-axis2">
			<path refid="axis2.runtime.classpath"/>
		</copy>
		<copy todir="${dist.dep.dir}/lib" file="${project-common.jar.loc}"/>
		<copy todir="${dist.dep.dir}/lib" file="${project-persistence-client.jar.loc}"/>
		<copy todir="${dist.dep.dir}/lib" file="${project-business-client.jar.loc}" />
		<copy todir="${dist.dep.dir}/lib">
			<fileset dir="${subcomponent.common-web}/${build.dir.name}/${dist.dir.name}/dep"/>
		</copy>
	</target>

	<!-- NOTE: what we build here is only used for development (enables faster dev-cycles) -->
	<target name="deploy" depends="dist" description="deploy this sub-project only">
		<echo>nothing to deploy here!</echo>
	</target>

	<!-- ================================================================ -->
	<!-- source code tracing instrumentation targets                      -->
	<!-- ================================================================ -->
	<target name="adntrace2-instrument">
		<taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
		<adntrace2 operation="instrument"/>
	</target>

	<target name="adntrace2-refresh">
		<taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
		<adntrace2 operation="refresh"/>
	</target>

	<!-- ================================================================ -->
	<!-- Auto generated ant build file contents...                        -->
	<!-- ================================================================ -->
	<property environment="env"/>
	<target name="jar.server" depends="compile-src">
		<copy toDir="${classes.dir}/META-INF" failonerror="false">
			<fileset dir="${generated.wsdl.dir}">
				<include name="**/*.wsdl"/>
				<include name="**/*.xsd"/>
			</fileset>
		</copy>
		<copy toDir="${classes.dir}/META-INF" failonerror="false">
			<fileset dir="${resources.src.dir}">
				<include name="**/*.xml"/>
			</fileset>
		</copy>
		<jar destfile="${lib.dir}/${name}.aar">
			<fileset dir="${classes.dir}">
				<exclude name="**/testclient"/>
				<exclude name="**/testclient/**/*.class"/>
			</fileset>
		</jar>
	</target>

	<!-- ================================================================ -->
	<!--  externally defined tasks/targets                                -->
	<!-- ================================================================ -->
	<import file="./build-test.xml"/>
</project>
