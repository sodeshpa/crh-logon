<!-- Set project name to project's cvs module name, as project name will
     be used for toolbox scope checks -->

<project name="logon" default="dist" basedir="." xmlns:if="ant:if" xmlns:unless="ant:unless">
    <description>${ant.project.name} project build file</description>

    <!-- ================================================================= -->
    <!-- === externally defined                                        === -->
    <!-- ================================================================= -->
    <import file="properties.xml"/>
    <import file="../common.xml"/>

    <!-- ================================================================= -->
    <!-- === maven like dependencies                                   === -->
    <!-- ================================================================= -->
    <import file="${AAL_HOME}/aal/aal-maven.xml"/>
    <import file="./build-deps.xml"/>
    <path id="eclipse.lib.classpath">
        <path refid="logon-mavendeps.test.classpath"/> <!-- maven libs -->
    </path>

    <!-- ================================================================ -->
    <!--  define target specific classpaths (build, runtime, test)        -->
    <!-- ================================================================ -->

	<path id="axis2.classpath">
		<fileset dir="${AXIS2_HOME}/lib">
			<include name="*.jar"/>
			<exclude name="gson-*.jar"/>
		</fileset>
	</path>

    <path id="compile.classpath">
        <path refid="logon-mavendeps.compile.classpath"/>
    	<pathelement location="${hibernate-annotations.jar}"/>
    	<pathelement location="${hibernate-jpa2.jar}"/>
        <pathelement location="${jcan-log.jar}"/>
    	<pathelement location="${jcan-print.jar}"/>
        <pathelement location="${log4j.jar}"/>
    	<pathelement location="${commons-lang.jar}"/>
        <pathelement location="${commons-beanutils.jar}"/>
        <pathelement location="${commons-collections.jar}"/>
        <pathelement location="${jcan-optrace.jar}"/>
    	<pathelement location="${commons-net.jar}"/>
    	<pathelement location="${hibernate4.jar}"/>
        <pathelement location="${commons-io.jar}"/>
        <pathelement location="${mail.jar}"/>
		<pathelement location="${opencsv.jar}"/>
		<pathelement location="${ostermillerutils.jar}"/>
    	<pathelement location="${project-common.jar.loc}"/>
    	<pathelement location="${project-persistence.jar.loc}"/>
        <pathelement location="${project-pdf-generator.jar.loc}"/>
    	<pathelement location="${project-webservices-client.dist.loc}/lib/${project-webservices-client.jar.name}"/>
    	<pathelement location="${poi.jar}"/>
    	<pathelement location="${icu4j.jar}"/>
    	<pathelement location="${jsch.jar}"/>
    	<pathelement location="${ojdbc6.jar}"/>
    	<path refid="axis2.classpath" />
    </path>

    <path id="businessinterfacetest.classpath">
        <path refid="compile.classpath"/>
    	<pathelement location="${classes.dir}"/>
    </path>

	<macrodef name="openapi-generate">
		<attribute name="language" />
		<attribute name="inputFile" />
		<attribute name="outputDir" />
		<attribute name="library" default="" />
		<attribute name="configFile" default="" />
		<attribute name="templateDir" default="" />
		<attribute name="globalProperties" default="" />
		<attribute name="additionalProperties" default="" />
		<attribute name="verbose" default="" />
		<element name="rawOptions" optional="true"/>
		<sequential>
			<java classname="org.openapitools.codegen.OpenAPIGenerator" classpathref="openapi-generator.classpath"
				  fork="true" failonerror="true" newenvironment="true">
				<arg line="generate"/>
				<arg line="-g @{language}"/>
				<arg line="-i @{inputFile}"/>
				<arg line="-o @{outputDir}"/>
				<arg line="--library @{library}" unless:blank="@{library}"/>
				<arg line="-c @{configFile}" unless:blank="@{configFile}"/>
				<arg line="-t @{templateDir}" unless:blank="@{templateDir}"/>
				<arg line="--global-property @{globalProperties}" unless:blank="@{globalProperties}"/>
				<arg line="--additional-properties @{additionalProperties}" unless:blank="@{additionalProperties}"/>
				<arg line="-v --global-property debugOpenAPI,debugOperations,debugModels" if:true="@{verbose}"/>
				<rawOptions />
			</java>
		</sequential>
	</macrodef>

	<target name="openapi-gen-help">
		<java classname="org.openapitools.codegen.OpenAPIGenerator" classpathref="openapi-generator.classpath"
			  fork="true" failonerror="true" newenvironment="true">
			<arg line="help generate"/>
		</java>
	</target>

	<target name="openapi-gen-java-help">
		<java classname="org.openapitools.codegen.OpenAPIGenerator" classpathref="openapi-generator.classpath"
			  fork="true" failonerror="true" newenvironment="true">
			<arg line="config-help -g java"/>
		</java>
	</target>

	<macrodef name="swagger-codegen">
		<attribute name="language" />
		<attribute name="inputFile" />
		<attribute name="outputDir" />
		<attribute name="library" default="" />
		<attribute name="configFile" default="" />
		<attribute name="templateDir" default="" />
		<attribute name="additionalProperties" default="" />
		<attribute name="verbose" default="" />
		<element name="rawOptions" optional="true"/>
		<sequential>
			<java classname="io.swagger.codegen.v3.cli.SwaggerCodegen" classpathref="swagger-codegen.classpath"
				  fork="true" failonerror="true" newenvironment="true">
				<arg line="generate"/>
				<arg line="-l @{language}"/>
				<arg line="-i @{inputFile}"/>
				<arg line="-o @{outputDir}"/>
				<arg line="--library @{library}" unless:blank="@{library}"/>
				<arg line="-c @{configFile}" unless:blank="@{configFile}"/>
				<arg line="-t @{templateDir}" unless:blank="@{templateDir}"/>
				<arg line="--additional-properties=@{additionalProperties}" unless:blank="@{additionalProperties}"/>
				<arg line="-v --global-property debugOpenAPI,debugOperations,debugModels" if:true="@{verbose}"/>
				<rawOptions />
			</java>
		</sequential>
	</macrodef>

	<target name="swagger-gen-java-help">
		<java classname="io.swagger.codegen.v3.cli.SwaggerCodegen" classpathref="swagger-codegen.classpath"
			  fork="true" failonerror="true" newenvironment="true">
			<arg line="config-help -l java"/>
		</java>
	</target>

    <!-- ================================================================ -->
    <!--  initialization, cleanup and default targets                     -->
    <!-- ================================================================ -->

    <target name="all" depends="dist"
            description="build and test everything"/>

    <target name="toolbox-checkUptodate">
        <uptodate property="toolbox-isUptodate" targetfile=".classpath">
            <srcfiles refid="toolbox-sourcefiles"/>
        </uptodate>
    </target>

    <target name="toolbox" depends="toolbox-checkUptodate" unless="toolbox-isUptodate">

        <taskdef resource="adnant-taskdefs.xml" /> <!-- See documentation in adnant project's README -->

        <updatedotclasspath>
            <!-- See documentation of 'updatedotclasspath' in adnant project's README -->
            <con path="org.eclipse.jdt.launching.JRE_CONTAINER" />
            <var pathref="eclipse.lib.classpath" />
            <output path=".bin" />
            <src path="/logon-common" />
            <src path="/logon-persistence" />
            <src path="/logon-webservices-client" />
            <src path="/logon-pdf-generator" />
            <src path="${generated.openapi.itrack.src.dir}" />
            <src path="${generated.openapi.heremap.routing.src.dir}" />
            <src path="${build.dir.name}/generated/gdi/ejb3/src" />
            <src path="${build.dir.name}/generated/gdi/refdataservice/src" />
            <src path="${build.dir.name}/generated/gdi/authorizertest/src" />
            <src path="${build.dir.name}/generated/gdi/configcsv2java/src" />
            <src path="${build.dir.name}/generated/gdi/atlascsv2java/src" />
            <src path="${build.dir.name}/generated/sources" />
            <src path="${java.src.dir.name}" />
            <src path="${java.test.src.dir.name}/unit" />
            <src path="${java.test.src.dir.name}/integration" />
            <src path="${test.etc.dir}" />
            <src path="${test.build.etc.dir}" />
            <src path="${build.dir.name}/eventbeans" />
            <lib path="${adntrace2-templates.jar}" sourcepath="${masterbuild.dir}/etc/adntrace2" />
        </updatedotclasspath>

    </target>

    <target name="init" depends="toolbox"
            description="initialization project structure and environment">
        <tstamp/>
        <echo message="--------- ${ant.project.name}-${build.version} building on ${os.name} ---------"/>
        <echo message=" "/>
        <echo message="building file ${ant.file} with ${ant.version}"/>
        <echo message=""/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${lib.dir}"/>
        <mkdir dir="${generated.dir}"/>
        <mkdir dir="${generated.dir}/sources"/>
        <mkdir dir="${test.build.dir}"/>
        <mkdir dir="${test.log.dir}"/>
        <mkdir dir="${test.lib.dir}"/>

    	<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>
	    <if>
		    <equals arg1="${environment}" arg2="dev" />
		    <then>
			    <property name="build.date" value="January 1 1970"/>
			    <property name="build.stamp" value="197001010000"/>
		    </then>
		    <else>
			    <property name="build.date" value="${TODAY}"/>
			    <property name="build.stamp" value="${DSTAMP}${TSTAMP}"/>
		    </else>
		</if>
	</target>

    <target name="clean" depends="clean-test"
            description="cleans all generated files and directories" >
        <delete dir="${build.dir}"/>
    </target>

    <!-- ================================================================ -->
    <!--  compile targets                                                 -->
    <!-- ================================================================ -->
    <target name="build" depends="jars"
            description="build target"/>

    <target name="compile" depends="compile-src, compile-test"/>

    <target name="compile-src" depends="init, generate, authorizertest">
        <javac
            source="${compile.source}"
            target="${compile.target}"
            destdir="${classes.dir}"
            debug="${compile.debug}"
            optimize="${compile.optimize}"
            deprecation="${compile.deprecation}"
            encoding="${compile.encoding}"
            includeantruntime="no">
            <src path="${java.src.dir}"/>
            <src path="${generated.openapi.itrack.src.dir}"/>
            <src path="${generated.openapi.heremap.routing.src.dir}"/>
            <src path="${generated.dir}/gdi/ejb3/src"/>
            <src path="${generated.dir}/gdi/refdataservice/src"/>
            <src path="${generated.dir}/gdi/authorizertest/src"/>
            <src path="${generated.dir}/gdi/configcsv2java/src"/>
            <src path="${generated.dir}/gdi/atlascsv2java/src"/>
            <include name="**/*.java"/>
            <bootclasspath refid="compile.bootclasspath"/>
            <classpath refid="compile.classpath" />
            <compilerarg line="-processor ch.adnovum.jcan.log.adntrace8.AdnTraceProcessor"/>
            <compilerarg line="-s ${generated.dir}/sources"/>
        </javac>

        <java classname="com.crh.logon.business.services.test.BusinessInterfaceTester"
            fork="true" failonerror="true" newenvironment="true">
            <classpath refid="businessinterfacetest.classpath"/>
        </java>

    </target>


    <!-- ================================================================ -->
    <!--  java archives (JARs)                                            -->
    <!-- ================================================================ -->
	<target name="jars" depends="compile">
        <tstamp/>

        <!-- class files for application -->
        <jar jarfile="${project-business.jar.loc}">
            <manifest>
                <attribute name="Manifest-Version" value="1.0"/>
                <attribute name="Implementation-Title" value="${ant.project.name}"/>
                <attribute name="Implementation-Vendor" value="${vendor}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Build-Date" value="${build.date}"/>
                <attribute name="Build-Stamp" value="${build.stamp}"/>
                <attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
                <attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
            </manifest>
            <fileset dir="${classes.dir}">
                <include name="**/*.class"/>
            	<exclude name="**/ServiceLocatorTest.class"/>
            </fileset>
            <fileset dir="${resources.src.dir}">
                <include name="**/*.*"/>
            </fileset>
            <fileset dir="${generated.dir}/gdi/ejb3">
				<include name="META-INF/*.*" />
			</fileset>
        </jar>

        <jar jarfile="${project-business-client.jar.loc}"
             basedir="${classes.dir}">
            <manifest>
                <attribute name="Manifest-Version" value="1.0"/>
                <attribute name="Implementation-Title" value="${ant.project.name}"/>
                <attribute name="Implementation-Vendor" value="${vendor}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Build-Date" value="${build.date}"/>
                <attribute name="Build-Stamp" value="${build.stamp}"/>
                <attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
                <attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
            </manifest>
            <include name="com/crh/logon/business/factories/*.class"/>
            <include name="com/crh/logon/business/services/interfaces/*.class"/>
            <include name="com/crh/logon/business/services/localinterfaces/*.class"/>
            <include name="com/crh/logon/business/rfidadministration/parameters/*.class"/>
            <include name="com/crh/logon/business/rfidadministration/*.class"/>
            <include name="com/crh/logon/business/services/delegates/*.class"/>
            <include name="com/crh/logon/business/services/utils/*.class"/>
            <include name="com/crh/logon/business/services/beans/*.class"/>
            <include name="com/crh/logon/business/services/beans/pdf/*.class"/>
            <include name="com/crh/logon/business/services/beans/pdf/deliverynote/*.class"/>
            <include name="com/crh/logon/business/services/reporting/*.class"/>
            <include name="com/crh/logon/business/ordercreation/constants/*.class"/>
            <include name="com/crh/logon/business/ordercreation/*.class"/>
            <include name="com/crh/logon/business/ordercreation/dto/*.class"/>
			<include name="com/crh/logon/business/itrack/model/*.class"/>
			<include name="com/crh/logon/business/itrack/dto/*.class"/>
            <include name="com/crh/logon/business/services/utils/validation/reason/*.class"/>
            <include name="com/crh/logon/business/services/utils/validation/*.class"/>
            <include name="com/crh/logon/business/services/orderdetail/dto/*.class"/>
            <include name="com/crh/logon/business/common/generics/*.class"/>
        </jar>
     </target>

    <!-- ================================================================= -->
    <!-- === generator                                                 === -->
    <!-- ================================================================= -->
    <target name="generate">
    	<gditask classpathref="gdi.classpath"
             cartridgePath="${etc.dir}/gdi/refdataservice"
             outputPath="${generated.dir}/gdi/refdataservice">
         	<input>
    			<fileset dir="${project-persistence.dist.loc}/src"/>
		    </input>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
        </gditask>

    	<!-- refdataservice generates a refdata service which needs to be handled as well -->
        <copy todir="${build.dir}/services">
            <fileset dir="${java.src.dir}">
        	    <include name="**/services/**/*.*"/>
            </fileset>
            <fileset dir="${generated.dir}/gdi/refdataservice/src">
        	    <include name="**/services/**/*.*"/>
            </fileset>
        </copy>

    	<gditask classpathref="gdi.classpath"
             cartridgePath="${etc.dir}/gdi/ejb3"
             outputPath="${generated.dir}/gdi/ejb3">
	     	<input>
				<fileset dir="${build.dir}/services"/>
		    </input>
    		<properties>
            	<fileset file ="${all.properties}"/>
    		</properties>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
        </gditask>

        <gditask classpathref="gdi.classpath"
             cartridgePath="${subcomponent.common}/etc/gdi/configcsv2java"
             outputPath="${generated.dir}/gdi/configcsv2java">
        	<input>
				<fileset dir="${subcomponent.persistence}/etc/csv/refdata"/>
			</input>
			<systemproperty name="csv_separator" value=";"/>
	     	<systemproperty name="csv_quote_character" value='"'/>
	     	<systemproperty name="csv_skip_lines" value="1"/>
	     	<systemproperty name="ConfigInitializer" value="generate"/> <!-- only generate ConfigInitializer here -->
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
        </gditask>

        <!-- ATLAS interface DTOs -->
        <gditask classpathref="gdi.classpath"
            cartridgePath="${etc.dir}/gdi/atlascsv2java/cartridge"
            outputPath="${generated.dir}/gdi/atlascsv2java">
            <input>
                <fileset dir="${etc.dir}/gdi/atlascsv2java/input"/>
            </input>
            <systemproperty name="csv_separator" value=";"/>
            <systemproperty name="csv_quote_character" value='"'/>
            <systemproperty name="csv_skip_lines" value="1"/>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
        </gditask>

		<openapi-generate language="java" library="resteasy"
						  inputFile="${etc.dir}/openapi-itrack.json" outputDir="${generated.openapi.itrack.dir}" templateDir="${openapi.template.dir}"
						  globalProperties="apis,models,apiTests=false,apiDocs=false,modelTests=false,modelDocs=false"
						  additionalProperties="apiPackage=com.crh.logon.business.itrack.api,modelPackage=com.crh.logon.business.itrack.model,dateLibrary=java8,disallowAdditionalPropertiesIfNotPresent=false">
			<rawOptions>
				<sysproperty key="supportingFiles" value="ApiClient.java,ApiException.java,Pair.java,Configuration.java"/>
			</rawOptions>
		</openapi-generate>
		<openapi-generate language="java" library="resteasy"
						  inputFile="${etc.dir}/openapi-heremap-routing.yaml" outputDir="${generated.openapi.heremap.routing.dir}" templateDir="${openapi.template.dir}"
						  globalProperties="apis,models,apiTests=false,apiDocs=false,modelTests=false,modelDocs=false"
						  additionalProperties="apiPackage=com.crh.logon.business.heremap.routing.api,modelPackage=com.crh.logon.business.heremap.routing.model,dateLibrary=java8,disallowAdditionalPropertiesIfNotPresent=false">
			<rawOptions>
				<sysproperty key="supportingFiles" value="ApiClient.java,ApiException.java,Pair.java,Configuration.java"/>
				<arg line="--import-mappings OneOfAuthErrorResponseSchemaRoutingErrorResponse=java.lang.Object"/>
			</rawOptions>
		</openapi-generate>

		<!--
		<swagger-codegen language="java" library="okhttp-gson" inputFile="${etc.dir}/openapi-itrack.json" outputDir="${generated.openapi.itrack.dir}"
						 additionalProperties="apiPackage=com.crh.logon.business.itrack.api,modelPackage=com.crh.logon.business.itrack.model,dateLibrary=java8,disallowAdditionalPropertiesIfNotPresent=false"/>
		<swagger-codegen language="java" library="okhttp-gson" inputFile="${etc.dir}/openapi-heremap-routing.yaml" outputDir="${generated.openapi.heremap.routing.dir}"
						 additionalProperties="apiPackage=com.crh.logon.business.heremap.routing.api,modelPackage=com.crh.logon.business.heremap.routing.model,dateLibrary=java8,disallowAdditionalPropertiesIfNotPresent=false,legacyDiscriminatorBehavior=false">
		-->
	</target>

    <target name="generateEjb3TD" depends="generate">
        <java classname="ch.nevis.gdi.main.TemplateDesigner"
            fork="true" failonerror="true" newenvironment="true">
            <classpath refid="gdi.classpath"/>
            <arg line="${etc.dir}/gdi/ejb3 ${build.dir}/services ${generated.dir}/gdi/td/ejb3 ${all.properties}"/>
        </java>
    </target>

	<target name="authorizertest">
    	<gditask classpathref="gdi.classpath"
             cartridgePath="${etc.dir}/gdi/authorizertest"
             outputPath="${generated.dir}/gdi/authorizertest">
	     	<input>
				<fileset dir="${project-persistence.dist.loc}/src"/>
		    </input>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
        </gditask>
	</target>

	<target name="authorizertestTD">
        <java classname="ch.nevis.gdi.main.TemplateDesigner"
            fork="true" failonerror="true" newenvironment="true">
            <classpath refid="gdi.classpath"/>
            <arg line="${etc.dir}/gdi/authorizertest ${project-persistence.dist.loc}/src ${generated.dir}/gdi/td/authorizertest"/>
        </java>
	</target>

    <!-- ================================================================= -->
    <!-- === distribution targets                                      === -->
    <!-- ================================================================= -->
    <target name="dist" description="build the distribution" unless="omit.subcomponent.business">
        <antcall target="realdist" inheritall="true"/>
    </target>
	<target name="realdist" depends="jars">
		<copy todir="${dist.lib.dir}" file="${project-business.jar.loc}" />
		<copy todir="${dist.lib.dir}" file="${project-business-client.jar.loc}" />
		<copy todir="${dist.dep.dir}/lib" file="${project-common.jar.loc}" />
		<copy todir="${dist.dep.dir}/lib" file="${project-persistence.jar.loc}" />
		<copy todir="${dist.dep.dir}/lib" file="${project-pdf-generator.jar.loc}" />
		<copy todir="${dist.dep.dir}/lib" file="${jcan-log.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${jcan-print.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${commons-lang.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${commons-beanutils.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${commons-collections.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${jcan-optrace.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${commons-net.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${commons-io.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${opencsv.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${ostermillerutils.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${poi.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${icu4j.jar}" />
		<copy todir="${dist.dep.dir}">
			<fileset dir="${project-webservices-client.dist.loc}/dep" />
		</copy>
		<copy todir="${dist.dep.dir}/lib">
			<fileset dir="${project-webservices-client.dist.loc}/lib" />
		</copy>

		<!-- JBoss 7 -->
		<copy todir="${dist.dep.dir}/lib" file="${jcan-commons.jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${jsch.jar}" />

		<!-- Kafka client dependencies -->
		<copy todir="${dist.dep.dir}/lib" file="${org.apache.kafka:kafka-clients:jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${com.github.luben:zstd-jni:jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${org.lz4:lz4-java:jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${org.xerial.snappy:snappy-java:jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${com.fasterxml.jackson.core:jackson-databind:jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${com.fasterxml.jackson.core:jackson-core:jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${com.fasterxml.jackson.core:jackson-annotations:jar}" />
		<copy todir="${dist.dep.dir}/lib" file="${com.fasterxml.jackson.datatype:jackson-datatype-jsr310:jar}" />
		<copy todir="${dist.dep.dir}/lib">
			<resources>
				<file file="${io.swagger:swagger-annotations:jar}"/>

			</resources>
		</copy>
	</target>

    <!-- NOTE: what we build here is only used for development (enables faster dev-cycles) -->
    <target name="deploy" depends="dist, createBusinessEar"
            description="deploy this sub-project only">
        <!-- must rename to 'logon-int.ear' to enable jndi-lookups under 'logon-int' -->
        <copy file="${project-business.ear}" tofile="${deploy.dir}/logon-int.ear" verbose="true"/>
    </target>

    <target name="createBusinessEar" depends="generateEarDesc"
            description="deploy this sub-project only">
        <copy todir="${build.dir}/earmodules2" verbose="true" flatten="true" includeEmptyDirs="false" failonerror="false">
            <fileset dir="${build.dir}/business_ear_stage/ejbs"/>
        </copy>
	<copy todir="${build.dir}/earmodules2/lib" verbose="true" flatten="true" includeEmptyDirs="false" failonerror="false">
		<fileset dir="${build.dir}/business_ear_stage/lib"/>
        </copy>
	<copy todir="${build.dir}/earmodules2/lib-axis2" verbose="true" flatten="true" includeEmptyDirs="false" failonerror="false">
		<fileset dir="${build.dir}/business_ear_stage/lib-axis2"/>
        </copy>
        <ear destfile="${project-business.ear}"
                 appxml="${generated.dir}/gdi/businessear/application.xml">
		    <manifest>
		        <attribute name="Manifest-Version" value="1.0"/>
		        <attribute name="Implementation-Title" value="${ant.project.name}"/>
		        <attribute name="Implementation-Vendor" value="${vendor}"/>
		        <attribute name="Implementation-Version" value="${build.version}"/>
		        <attribute name="Build-Date" value="${TODAY}"/>
		        <attribute name="Build-Stamp" value="${DSTAMP}${TSTAMP}"/>
		        <attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
		        <attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
		    </manifest>
		<fileset dir="${build.dir}/earmodules2"/>
        </ear>
    </target>

    <target name="prepareBusinessEar">
        <copy todir="${build.dir}/business_ear_stage/lib" verbose="true" failonerror="false">
            <fileset dir="${subcomponent.common}/${build.dir.name}/${dist.dir.name}/dep"/>
        </copy>
        <copy todir="${build.dir}/business_ear_stage/lib" verbose="true" failonerror="false">
            <fileset dir="${subcomponent.business}/${build.dir.name}/${dist.dir.name}/dep/lib"/>
        </copy>
	<copy todir="${build.dir}/business_ear_stage/lib-axis2" verbose="true" failonerror="false">
		<fileset dir="${subcomponent.business}/${build.dir.name}/${dist.dir.name}/dep/lib-axis2"/>
        </copy>
        <copy todir="${build.dir}/business_ear_stage/ejbs" verbose="true" failonerror="false">
            <fileset dir="${subcomponent.business}/${build.dir.name}/${dist.dir.name}/lib"/>
        </copy>

        <copy todir="${build.dir}/business_ear_stage/lib" verbose="true" failonerror="false">
            <fileset dir="${subcomponent.webservices}/${build.dir.name}/${dist.dir.name}/dep/lib"/>
        </copy>
	<copy todir="${build.dir}/business_ear_stage/lib-axis2" verbose="true" failonerror="false">
		<fileset dir="${subcomponent.webservices}/${build.dir.name}/${dist.dir.name}/dep/lib-axis2"/>
        </copy>
        <copy todir="${build.dir}/business_ear_stage/ejbs" verbose="true" failonerror="false">
            <fileset dir="${subcomponent.webservices}/${build.dir.name}/${dist.dir.name}/lib/ejbs"/>
        </copy>
    </target>

    <target name="generateEarDesc" depends="prepareBusinessEar">
    	<gditask classpathref="gdi.classpath"
             cartridgePath="${subcomponent.application}/${etc.dir.name}/gdi/ear"
             outputPath="${generated.dir}/gdi/businessear">
    		<input>
        		<fileset dir="${build.dir}/business_ear_stage"/>
        	</input>
            <systemproperty name="allfiles" value="true"/>
    		<systemproperty name="pwd" value="${build.dir}/stage"/>
			<systemproperty name="host" value="${host}"/>
			<systemproperty name="port" value="${http.port}"/>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
			<properties>
				<fileset file="${subcomponent.application}/${etc.dir.name}/application.properties"/>
			</properties>
        </gditask>
    </target>

