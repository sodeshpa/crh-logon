{
	"openapi": "3.0.1",
	"info": {
		"title": "iTrack RESTful API",
		"description": "This is a proposed API for CRH to get vehicle data from iTrack",
		"termsOfService": "https://www.idatatelematics.com/official-documents/#general-terms-and-conditions",
		"contact": {
			"name": "iData customer service",
			"url": "https://www.idatatelematics.com/contact-us",
			"email": "info@idata.hu"
		},
		"version": "1.0"
	},
	"servers": [
		{
			"url": "https://api.itrack.hu/rest",
			"description": "Generated server url"
		}
	],
	"tags": [
		{
			"name": "crh",
			"description": "CRH interface"
		}
	],
	"paths": {
		"/api/crh/v1/unloads": {
			"get": {
				"tags": [
					"crh"
				],
				"summary": "Get unloads for a target in the given interval",
				"operationId": "getUnloadsForTarget",
				"parameters": [
					{
						"name": "targetId",
						"in": "query",
						"description": "identifier of the Target",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int32"
						}
					},
					{
						"name": "fromTime",
						"in": "query",
						"description": "beginning of the interval in UTC in ISO 8601 datetime format",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time",
							"example": "2021-05-01T17:00:00Z"
						}
					},
					{
						"name": "toTime",
						"in": "query",
						"description": "end of the interval in UTC in ISO 8601 datetime format",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time",
							"example": "2021-05-01T17:00:00Z"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Unloads"
								},
								"example": {
									"targetId": 12345,
									"validUntilTime": "2021-05-02T17:00:00Z",
									"values": [
										{
											"shipToId": "HU",
											"unloadTime": "2021-05-02T10:00:00Z",
											"startTime": "2021-05-02T09:55:00Z"
										},
										{
											"shipToId": "HU",
											"unloadTime": "2021-05-02T15:00:00Z",
											"startTime": "2021-05-02T14:45:00Z"
										}
									],
									"type": "unload"
								}
							}
						}
					},
					"400": {
						"description": "Bad Request",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestRequestError"
								},
								"example": {
									"exceptionClass": "com.idata.gps.DeviceException",
									"message": "Target has no device",
									"requestInfo": "description=uri=/api/test/v1/targets;client=10.0.0.0;user=testuser params=[[targetId,[123]]"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestRequestError"
								},
								"example": {
									"exceptionClass": "com.idata.gps.DeviceException",
									"message": "Target has no device",
									"requestInfo": "description=uri=/api/test/v1/targets;client=10.0.0.0;user=testuser params=[[targetId,[123]]"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Forbidden"
					},
					"404": {
						"description": "Not Found"
					}
				},
				"security": [
					{
						"basic_user_password": []
					}
				]
			}
		},
		"/api/crh/v1/tollAmount": {
			"get": {
				"tags": [
					"crh"
				],
				"summary": "Get toll amount for a target in the given interval in HUF",
				"operationId": "getTollAmountForTarget",
				"parameters": [
					{
						"name": "targetId",
						"in": "query",
						"description": "identifier of the Target",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int32"
						}
					},
					{
						"name": "fromTime",
						"in": "query",
						"description": "beginning of the interval in UTC in ISO 8601 datetime format",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time",
							"example": "2021-05-01T17:00:00Z"
						}
					},
					{
						"name": "toTime",
						"in": "query",
						"description": "end of the interval in UTC in ISO 8601 datetime format",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time",
							"example": "2021-05-01T17:00:00Z"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TollAmount"
								},
								"example": {
									"targetId": 12345,
									"tollAmount": 20391.0472,
									"tollAmountGross": 25896.63,
									"tollAmountNet": 20391.0472
								}
							}
						}
					},
					"413": {
						"description": "Response size limit exceeded",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestRequestError"
								},
								"example": {
									"exceptionClass": "com.idata.gps.DeviceException",
									"message": "Target has no device",
									"requestInfo": "description=uri=/api/test/v1/targets;client=10.0.0.0;user=testuser params=[[targetId,[123]]"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestRequestError"
								},
								"example": {
									"exceptionClass": "com.idata.gps.DeviceException",
									"message": "Target has no device",
									"requestInfo": "description=uri=/api/test/v1/targets;client=10.0.0.0;user=testuser params=[[targetId,[123]]"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Forbidden"
					},
					"404": {
						"description": "Not Found"
					}
				},
				"security": [
					{
						"basic_user_password": []
					}
				]
			}
		},
		"/api/crh/v1/targets": {
			"get": {
				"tags": [
					"crh"
				],
				"summary": "Get all targets",
				"description": "Only active targets are returned.",
				"operationId": "getAllTargets",
				"responses": {
					"500": {
						"description": "Internal Server Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestRequestError"
								},
								"example": {
									"exceptionClass": "com.idata.gps.DeviceException",
									"message": "Target has no device",
									"requestInfo": "description=uri=/api/test/v1/targets;client=10.0.0.0;user=testuser params=[[targetId,[123]]"
								}
							}
						}
					},
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/Target"
									}
								},
								"example": [
									{
										"id": 12345,
										"name": "ABC-123"
									},
									{
										"id": 45678,
										"name": "ABC-456"
									}
								]
							}
						}
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Forbidden"
					},
					"404": {
						"description": "Not Found"
					}
				},
				"security": [
					{
						"basic_user_password": []
					}
				]
			}
		},
		"/api/crh/v1/targets/{id}": {
			"get": {
				"tags": [
					"crh"
				],
				"summary": "Get a target",
				"description": "Only active targets are returned.",
				"operationId": "getTargetById",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "identifier of the Target",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int32"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Target"
								},
								"example": {
									"id": 12345,
									"name": "ABC-123"
								}
							}
						}
					},
					"404": {
						"description": "Target not found"
					},
					"500": {
						"description": "Internal Server Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestRequestError"
								},
								"example": {
									"exceptionClass": "com.idata.gps.DeviceException",
									"message": "Target has no device",
									"requestInfo": "description=uri=/api/test/v1/targets;client=10.0.0.0;user=testuser params=[[targetId,[123]]"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Forbidden"
					}
				},
				"security": [
					{
						"basic_user_password": []
					}
				]
			}
		},
		"/api/crh/v1/positions/last": {
			"get": {
				"tags": [
					"crh"
				],
				"summary": "Get last positions of targets",
				"description": "Should have rights for all targets",
				"operationId": "getLastPositions",
				"parameters": [
					{
						"name": "targetIds",
						"in": "query",
						"description": "identifiers of the Targets",
						"required": true,
						"schema": {
							"type": "array",
							"items": {
								"type": "integer",
								"format": "int32"
							}
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/Position"
									}
								},
								"example": [
									{
										"targetId": 12345,
										"time": "2021-05-01T17:00:00Z",
										"valid": true,
										"longitude": 47.47,
										"latitude": 19.19,
										"speed": 50,
										"engineOn": true
									},
									{
										"targetId": 45678,
										"time": "2021-05-02T17:00:00Z",
										"valid": true,
										"longitude": 47.74,
										"latitude": 19.91,
										"speed": 90,
										"engineOn": true
									}
								]
							}
						}
					},
					"500": {
						"description": "Internal Server Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestRequestError"
								},
								"example": {
									"exceptionClass": "com.idata.gps.DeviceException",
									"message": "Target has no device",
									"requestInfo": "description=uri=/api/test/v1/targets;client=10.0.0.0;user=testuser params=[[targetId,[123]]"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Forbidden"
					},
					"404": {
						"description": "Not Found"
					}
				},
				"security": [
					{
						"basic_user_password": []
					}
				]
			}
		},
		"/api/crh/v1/odometerReadings": {
			"get": {
				"tags": [
					"crh"
				],
				"summary": "Get odometer readings of a target at the endpoints of the given interval.",
				"operationId": "getOdometerReadings",
				"parameters": [
					{
						"name": "targetId",
						"in": "query",
						"description": "identifier of the Target",
						"required": true,
						"schema": {
							"type": "integer",
							"format": "int32"
						}
					},
					{
						"name": "fromTime",
						"in": "query",
						"description": "beginning of the interval in UTC in ISO 8601 datetime format",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time",
							"example": "2021-05-01T17:00:00Z"
						}
					},
					{
						"name": "toTime",
						"in": "query",
						"description": "end of the interval in UTC in ISO 8601 datetime format",
						"required": true,
						"schema": {
							"type": "string",
							"format": "date-time",
							"example": "2021-05-01T17:00:00Z"
						}
					}
				],
				"responses": {
					"404": {
						"description": "No odometer reading found"
					},
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/OdometerReadings"
								},
								"example": {
									"targetId": 12345,
									"fromKm": 45698.87,
									"fromKmTime": "2021-05-01T17:00:00Z",
									"toKm": 65478.89,
									"toKmTime": "2021-05-02T17:00:00Z"
								}
							}
						}
					},
					"400": {
						"description": "Bad Request",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestRequestError"
								},
								"example": {
									"exceptionClass": "com.idata.gps.DeviceException",
									"message": "Target has no device",
									"requestInfo": "description=uri=/api/test/v1/targets;client=10.0.0.0;user=testuser params=[[targetId,[123]]"
								}
							}
						}
					},
					"500": {
						"description": "Internal Server Error",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RestRequestError"
								},
								"example": {
									"exceptionClass": "com.idata.gps.DeviceException",
									"message": "Target has no device",
									"requestInfo": "description=uri=/api/test/v1/targets;client=10.0.0.0;user=testuser params=[[targetId,[123]]"
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized"
					},
					"403": {
						"description": "Forbidden"
					}
				},
				"security": [
					{
						"basic_user_password": []
					}
				]
			}
		}
	},
	"components": {
		"schemas": {
			"Unload": {
				"type": "object",
				"properties": {
					"shipToId": {
						"type": "string",
						"description": "The identifier of the shipTo where the unloading was / is done"
					},
					"unloadTime": {
						"type": "string",
						"description": "Unload time in UTC in ISO 8601 datetime format",
						"format": "date-time",
						"example": "2021-05-01T17:00:00Z"
					},
					"startTime": {
						"type": "string",
						"description": "Start time in UTC in ISO 8601 datetime format",
						"format": "date-time",
						"example": "2021-05-01T17:00:00Z"
					}
				},
				"description": "Stores shipTo identifier and unload time for a target."
			},
			"Unloads": {
				"type": "object",
				"properties": {
					"targetId": {
						"type": "integer",
						"description": "The database generated vehicle identifier",
						"format": "int32"
					},
					"validUntilTime": {
						"type": "string",
						"description": "Data validity time in UTC in ISO 8601 datetime format",
						"format": "date-time",
						"example": "2021-05-01T17:00:00Z"
					},
					"values": {
						"type": "array",
						"description": "List of shipTo identifiers and unload times for a target.",
						"items": {
							"$ref": "#/components/schemas/Unload"
						}
					},
					"type": {
						"type": "string",
						"description": "Unload type"
					}
				},
				"description": "Stores multiple shipTo identifiers and unload times for a target."
			},
			"RestRequestError": {
				"type": "object",
				"properties": {
					"exceptionClass": {
						"type": "string",
						"description": "The exception's class name"
					},
					"message": {
						"type": "string",
						"description": "The message why the request was not successful"
					},
					"requestInfo": {
						"type": "string",
						"description": "Information about the request"
					}
				},
				"description": "Stores error information for a request"
			},
			"TollAmount": {
				"type": "object",
				"properties": {
					"targetId": {
						"type": "integer",
						"description": "The database generated vehicle identifier",
						"format": "int32"
					},
					"tollAmount": {
						"type": "number",
						"description": "Toll amount in HUF",
						"format": "float"
					},
					"tollAmountGross": {
						"type": "number",
						"description": "Gross value of toll amount in HUF",
						"format": "float"
					},
					"tollAmountNet": {
						"type": "number",
						"description": "Net value of toll amount in HUF",
						"format": "float"
					}
				},
				"description": "Stores the net and gross values of the toll amount for a target in HUF"
			},
			"Target": {
				"type": "object",
				"properties": {
					"id": {
						"type": "integer",
						"description": "The database generated vehicle identifier",
						"format": "int32"
					},
					"name": {
						"type": "string",
						"description": "The vehicle name or license plate number"
					}
				},
				"description": "An iTrack specific concept for a tracked object, which is also a source of time series data."
			},
			"Position": {
				"type": "object",
				"properties": {
					"targetId": {
						"type": "integer",
						"description": "The database generated vehicle identifier",
						"format": "int32"
					},
					"time": {
						"type": "string",
						"description": "Status time in UTC in ISO 8601 datetime format",
						"format": "date-time",
						"example": "2021-05-01T17:00:00Z"
					},
					"valid": {
						"type": "boolean",
						"description": "Validity of the GPS coodinates and speed"
					},
					"longitude": {
						"type": "number",
						"description": "Geographic coordinate that specifies the east-west position",
						"format": "double"
					},
					"latitude": {
						"type": "number",
						"description": "Geographic coordinate that specifies the north-south position",
						"format": "double"
					},
					"speed": {
						"type": "integer",
						"description": "GPS-based speed",
						"format": "int32"
					},
					"engineOn": {
						"type": "boolean",
						"description": "Ignition switch state"
					}
				},
				"description": "Stores coordinates, speed, ignition state of a target."
			},
			"OdometerReadings": {
				"type": "object",
				"properties": {
					"targetId": {
						"type": "integer",
						"description": "The database generated vehicle identifier",
						"format": "int32"
					},
					"fromKm": {
						"type": "number",
						"description": "The odometer reading at the beginning of the interval",
						"format": "double"
					},
					"fromKmTime": {
						"type": "string",
						"description": "The odometer reading time in UTC in ISO 8601 datetime format",
						"format": "date-time",
						"example": "2021-05-01T17:00:00Z"
					},
					"toKm": {
						"type": "number",
						"description": "The odometer reading at the end of the interval",
						"format": "double"
					},
					"toKmTime": {
						"type": "string",
						"description": "The odometer reading time in UTC in ISO 8601 datetime format",
						"format": "date-time",
						"example": "2021-05-01T17:00:00Z"
					}
				},
				"description": "Stores odometer readings of a target at the endpoints of the given interval."
			}
		},
		"securitySchemes": {
			"basic_user_password": {
				"type": "http",
				"description": "Use your iTrack username and password for basic authentication",
				"scheme": "basic"
			}
		}
	}
}
