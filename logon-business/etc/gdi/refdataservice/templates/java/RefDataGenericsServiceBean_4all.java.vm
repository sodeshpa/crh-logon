	public LangTxEntity findLangTxEntity(Locale locale, String langCd) {
		String jpqlQuery = "SELECT l FROM LangTxEntity l JOIN FETCH l.langTxPK.langBs b WHERE l.langTxPK.lang1Cd = :language AND b.langCd = :langCd";
		Query query = em.createQuery(jpqlQuery);
		query.setParameter("language", locale.getLanguage());
		query.setParameter("langCd", langCd);
		return findSingle(LangTxEntity.class, query);
	}

