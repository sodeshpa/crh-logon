	public <T> List<T> findTxEntityFiltered(Class<T> clazz, Filter<T> filter, Integer recordCount, int skip) {
		
		StringBuilder jpqlQuery = createSelectStatement(clazz);
		jpqlQuery = appendJoinFetchStatement(clazz, jpqlQuery);
		jpqlQuery = appendWhereConditions(jpqlQuery, filter);
		jpqlQuery = appendOrderByExpressions(jpqlQuery, filter);
		Query query = createQueryFromJPQL(jpqlQuery, filter, recordCount, skip);
		
		return find(clazz, query);
	}

	private <T> StringBuilder createSelectStatement(Class<T> clazz){

		JPAQuery<T> jpaQuery = new JPAQueryImpl<T>(clazz);

		final String entityName = clazz.getSimpleName();		
		StringBuilder jpqlQuery = new StringBuilder();
		jpqlQuery.append("SELECT x FROM ").append(entityName).append(" x ");
		
		return jpqlQuery;
	}
	
	private <T> StringBuilder appendJoinFetchStatement(Class<T> clazz, StringBuilder jpqlQuery){

		final String bsEntityKeyName = bsEntityKeyNames.get(clazz);
		jpqlQuery.append("JOIN FETCH x.").append(bsEntityKeyName).append(" ");
		
		return jpqlQuery;
	}
	
	private <T> StringBuilder appendWhereConditions(StringBuilder jpqlQuery, Filter<T> filter){
		
		if (filter != null) {
			jpqlQuery.append(filter.toJPAQL());
		}
		
		return jpqlQuery;
	}
	
	private <T> StringBuilder appendOrderByExpressions(StringBuilder jpqlQuery, Filter<T> filter){
		
		if (filter != null && filter.getOrderByExpressions() != null) {
			List<Order> orders = filter.getOrderByExpressions();
			
			if ( !orders.isEmpty() ) {
				jpqlQuery.append(" order by ");
			
				for (Iterator<Order> it = orders.iterator(); it.hasNext();) {
					Order order = it.next();
					jpqlQuery.append(order.toJPAQL());
					if (it.hasNext()) {
						jpqlQuery.append(", ");
					}
				}
			}
		}
		
		return jpqlQuery;
	}
	
	private <T> Query createQueryFromJPQL(StringBuilder jpqlQuery, Filter<T> filter, Integer recordCount, int skip){
		
		Query query = em.createQuery(jpqlQuery.toString());
		if (filter != null && filter.getInputParameters() != null) {
				Map<String, Object> inputParameters = filter.getInputParameters();
				for (Iterator<Entry<String, Object>> iterator = inputParameters.entrySet().iterator(); iterator.hasNext();) {
					Entry<String, Object> entry = iterator.next();
					query.setParameter(entry.getKey(), entry.getValue());
				}
		}
		if(recordCount != null){
			query.setMaxResults(recordCount);
		}
		query.setFirstResult(skip);
				
		return query;
	}
	
