 This deployment descriptor creates JNDI mappings without the application name 
 for the EJBs. This way, logon-int and logon-ext can use the same lookups.
 Note: jndi-name is for remote interfaces, local-jndi-name is for local.
-->
#set ($services = [])
#foreach ($current in $all)
#set ($isEjb = false)
#foreach ($c in $current.getClasses())
#if ($c.name.endsWith("ServiceBean"))
#set ($isEjb = true)
#set ($currentClass = $c)
#end
#end
#if ($isEjb)
#set ($dummy = $services.add($currentClass))
#end
#end
<jboss>
  <enterprise-beans>
#foreach ($currentClass in $services)
#set ($ifc = $currentClass.name.replace("Bean", ""))
#set ($ejbtype = "session")
#set ($classAnnotations = $currentClass.annotations)
#foreach ($annotation in $classAnnotations)
#if ($annotation.type == "javax.ejb.MessageDriven")
#set ($ejbtype = "message-driven")
#end
#end

    <$ejbtype>
        <ejb-name>$currentClass.name</ejb-name>
        <jndi-name>java:global/logon/logon-business//$currentClass.name!com.crh.logon.business.services.interfaces.${ifc}</jndi-name>
    </$ejbtype>
#end

  </enterprise-beans>
</jboss>