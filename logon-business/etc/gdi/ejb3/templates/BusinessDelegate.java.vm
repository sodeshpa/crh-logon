    private void whereAmI() {
    	final int maxdepth = 8; // 3
    	try {
    		throw new Throwable();
    	}
    	catch (Throwable t) {
    		StackTraceElement[] stack = t.getStackTrace();
    		String msg = "";
    		for (int i = 1; i < ((stack.length < maxdepth) ? stack.length : maxdepth); i++) {
    			StackTraceElement element = stack[i];
    			String fn = element.getFileName();
    			if (fn == null) {
    				fn = "Unknown Source";
    			}
    			else {
    				fn += ":" + element.getLineNumber();
    			}
    			if (element.getClassName().contains("com.crh.logon")) {
                    LOG.error("    at " +  element.getClassName() + "." + element.getMethodName() + "(" + fn + ")");
    			}
    		}
    	}
    }

    private TransferContext createCtx(boolean remotecall) {
        Long userId = AuthUtils.getUserId();

/*
        if (op == null) {
            TransferContext ctx = new TransferContext(userId, "???", "???", remotecall);
            return ctx;
        }
*/
        RequestContext requestContext = op.getRequestContext();
/*
        if (requestContext == null) {
            TransferContext ctx = new TransferContext(userId, "???", "???", remotecall);
            return ctx;
        }
*/
        String id = requestContext.getId();
        String principal = requestContext.getPrincipal();
        TransferContext ctx = new TransferContext(userId, principal, id, remotecall);
        return ctx;
    }
