	<definition name="BagTerminalAssignmentListTile.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/bagterminal/BagTerminalAssignmentList.jsp"/>
	</definition>
	
	<definition name="SelectNewTruckTile.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/bagterminal/BagTerminalNewTruckSelector.jsp"/>
	</definition>
	
	<!-- ==================This fatal error is only called from the logout, ===================================  -->
	<!-- ==================in other cases TerminalFatalError is called see global-forwards=====================  -->	
	<definition name="LogoutFatalError.def" path="/WEB-INF/jsp/FatalErrorTile.jsp"/>
