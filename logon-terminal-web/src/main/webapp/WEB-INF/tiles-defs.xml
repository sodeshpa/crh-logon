<!DOCTYPE tiles-definitions PUBLIC
       "-//Apache Software Foundation//DTD Tiles Configuration 1.1//EN"
       "http://struts.apache.org/dtds/tiles-config_1_1.dtd">

<!-- Definitions for Tiles documentation   -->

<tiles-definitions>

	<!-- =======================================================  -->
	<!-- Master definitions                                       -->
	<!-- =======================================================  -->

	<!-- Main layout used as a root for other page definitions.   -->
	
	<!-- =======================================================  -->
	<!-- Page definitions - login/logout                          -->
	<!-- =======================================================  -->

	<definition name="Logout.def" path="/WEB-INF/jsp/TerminalLogoutTile.jsp"/>
	
		
	<definition name="terminalcommon" path="/WEB-INF/jsp/TerminalMainLayout.jsp">
	    <put name="terminalheader" value="/WEB-INF/jsp/TerminalHeaderTile.jsp"/>
	    <put name="errors" value="/WEB-INF/jsp/TerminalErrorsTile.jsp"/>
	</definition>

	<definition name="TerminalEntryTile.def" path="/WEB-INF/jsp/ApplicationEntry.jsp"/>
	
	<definition name="LogoutCounter.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/TerminalLogoutCounterTile.jsp"/>
	</definition>
	<!-- ==================Pickup order ======================  -->	
	
	
	<definition name="PickupListTile.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/pickup/PickupListTile.jsp"/>
	</definition>
	<definition name="PickupCreateTile.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/pickup/PickupCreateTile.jsp"/>
	</definition>	
	<definition name="PickupShiptoSelector.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/pickup/PickupShiptoSelector.jsp"/>
	</definition>
		<definition name="PickupBilltoSelector.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/pickup/PickupBilltoSelector.jsp"/>
	</definition>
		<definition name="PickupProductSelector.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/pickup/PickupProductSelector.jsp"/>
	</definition>
	<definition name="PickupProductTypeSelector.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/pickup/PickupProductTypeSelector.jsp"/>
	</definition>
	<definition name="PickupQuantitySelector.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/pickup/PickupQuantitySelector.jsp"/>
