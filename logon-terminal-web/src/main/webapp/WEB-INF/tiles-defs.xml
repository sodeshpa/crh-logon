	<definition name="PalletsTile.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/pickup/PickupPaletQuantitySelector.jsp"/>
	</definition>
	<definition name="PickupDeliveryNoteTile.def" extends="terminalcommon">
		<put name="body" value="/WEB-INF/jsp/pickup/PickupDeliveryNote.jsp"/>
	</definition>	
	
