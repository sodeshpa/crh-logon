      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="leaveStartpointRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="enterEndpointRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="marketInfoRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="shipToId" type="eb:id" minOccurs="0"/> <!-- This field is deprecated (see ADN48868) -->
          <xsd:element name="assignmentPartId" type="eb:id" minOccurs="0"/>
          <xsd:element name="message" type="xsd:string"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="deliveryNoteRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
          <xsd:element name="shipToId" type="eb:id"/>
          <xsd:element name="signatureName" type="xsd:string" minOccurs="0"/>
          <xsd:element name="signature" type="xsd:string" minOccurs="0"/>
          <xsd:element name="note" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="messageAckRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="messageId" type="eb:id"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="messageToLogonRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="message" type="xsd:string"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="waitingOnShippingpointRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentId" type="eb:id"/>
