          <xsd:element name="containerLabel" type="xsd:string" minOccurs="0"/>
          <xsd:element name="containerRfidIdentity" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="scanSiloRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
          <xsd:element name="siloLabel" type="xsd:string" minOccurs="0"/>
          <xsd:element name="siloRfidIdentity" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="startLoadMopRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id" minOccurs="0"/>
          <xsd:element name="assignmentId" type="eb:id"/>
          <xsd:element name="loadingpointLabel" type="xsd:string" minOccurs="0"/>
          <xsd:element name="loadingpointRfidIdentity" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="endLoadMopRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id" minOccurs="0"/>
          <xsd:element name="assignmentId" type="eb:id"/>
          <xsd:element name="netWeightKg" type="xsd:decimal"/>
          <xsd:element name="totalWeightKg" type="xsd:decimal"/>
          <xsd:element name="tareWeightKg" type="xsd:decimal"/>
          <xsd:element name="loadingpointLabel" type="xsd:string" minOccurs="0"/>
          <xsd:element name="loadingpointRfidIdentity" type="xsd:string" minOccurs="0"/>
          <xsd:element name="accurateWeights" type="xsd:boolean"/>
          <xsd:element name="loadedQuantityInPieces" type="xsd:decimal" minOccurs="0"/>          
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="skipLdsLoadingRequest">
