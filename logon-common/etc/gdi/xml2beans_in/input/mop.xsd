      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentId" type="eb:id"/>
          <xsd:element name="loadingpointLabel" type="xsd:string" minOccurs="0"/>
          <xsd:element name="loadingpointRfidIdentity" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="requestTruckLoadRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="wagonEmptyRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
          <xsd:element name="wagonLabel" type="xsd:string" minOccurs="0"/>
          <xsd:element name="wagonRfidIdentity" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="enterShipToRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
          <xsd:element name="shipToId" type="eb:id" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType> 
  
  <xsd:complexType name="leaveShipToRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
          <xsd:element name="shipToId" type="eb:id" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  
  <xsd:complexType name="startUnloadRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
          <xsd:element name="unloadOrderItemId" type="eb:id"/>
          <xsd:element name="shipToSiloLabel" type="xsd:string" minOccurs="0"/>
          <xsd:element name="shipToSiloRfidIdentity" type="xsd:string" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="endUnloadRequest">
    <xsd:complexContent>
      <xsd:extension base="mop:mopRequest">
        <xsd:sequence>
          <xsd:element name="assignmentPartId" type="eb:id"/>
          <xsd:element name="unloadOrderItemId" type="eb:id"/>
          <xsd:element name="shipToSiloLabel" type="xsd:string" minOccurs="0"/>
          <xsd:element name="shipToSiloRfidIdentity" type="xsd:string" minOccurs="0"/>
          <xsd:element name="remainingQuantityPresent" type="xsd:boolean"/>
          <xsd:element name="returnedQuantity" type="xsd:decimal" minOccurs="0"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="geoPositionRequest">
