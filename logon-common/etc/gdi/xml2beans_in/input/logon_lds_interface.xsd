                            <xsd:annotation>
                                <xsd:documentation>The SAP Ship-To Business Partern Id. The ID used by SAP including the leading zeros.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="10"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="soldTo" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>The SAP Sold-To Business Partern Id. The ID used by SAP including the leading zeros.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="10"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="location" type="tns:locationData" minOccurs="0"/>
                        <xsd:element name="materialRestriction" minOccurs="0" maxOccurs="unbounded">
