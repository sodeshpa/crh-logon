                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:boolean"/>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="ldsCustomerOrderNo" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Customer order number / external order number.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="20"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="ldsDeliveryNoteNo" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Delivery note number from the LDS for this order.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="12"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="ldsEnterShippingpointTime" minOccurs="0"
                            type="xsd:dateTime">
                            <xsd:annotation>
                                <xsd:documentation>The time the truck entered the shippoingpoint/plant area.
        This value is considered if there are no PDAs involved.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="ldsLeaveShippingpointTime" minOccurs="0"
                            type="xsd:dateTime">
                            <xsd:annotation>
                                <xsd:documentation>Time the truck leaves the shippoingpoint/plant area.
        This value is considered if there are no PDAs involved.
        In WeWaS, this corresponds to the print delivery note event
        or similar event. Later that can be identified and related to
        this specific truck and order.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element minOccurs="0" name="suppressDeliveryNotePrinting">
                            <xsd:annotation>
                                <xsd:documentation>Override of all other settings. No delivery note will be printed at all. Also suppresses printing of collective delivery note, but only if this is the last endLoadingRequest of that customer order (no 'memory' of this option).</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:boolean"> </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="noteDelivery" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Remark relevant for delivery note (and later invoice).</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="256"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="noteLDS" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Remark for operator of LDS and/or truck driver. To be displayed somewhere on the LDS screen.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="256"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="setLoadOrder2LoadedResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:response">
                    <xsd:sequence>
                        <xsd:element name="order" type="tns:orderData" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>The final commercial order including data received in setLoadOrder2LoadedRequest.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="cancelLoadingRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:request">
                    <xsd:sequence>
                        <xsd:element name="loadOrderId">
                            <xsd:annotation>
                                <xsd:documentation>Uniquely identifies a load order. Guarantees that the same order can be loaded more than once (i.e. in case of re-routing).</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="25"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="cancelLoadingResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:response"/>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="createCompletedCustomerOrderRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:request">
                    <xsd:sequence>
                        <xsd:element name="order" type="tns:orderData"/>
                        <xsd:element name="vehicle" type="tns:vehicleData"/>
                        <xsd:element maxOccurs="unbounded" name="completedLoadOrderItem"
                            type="tns:completedLoadOrderItemData"/>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="createCompletedCustomerOrderResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:response"/>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="getOrdersForCarriersRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:request">
                    <xsd:sequence>
                        <xsd:element name="selectedCarriers" type="tns:vendorData" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>Selected Carriers.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="lastChangeFrom" type="xsd:dateTime">
                            <xsd:annotation>
                                <xsd:documentation>Filter parameter for the orders returned. Must be in the past. Only those orders will be returned, which were last changed between the lastChangeFrom and lastChangeTo parameters.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="lastChangeTo" type="xsd:dateTime">
                            <xsd:annotation>
                                <xsd:documentation>Filter parameter for the orders returned. Must be in the past. Only those orders will be returned, which were last changed between the lastChangeFrom and lastChangeTo parameters.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="page">
                            <xsd:annotation>
                                <xsd:documentation>The number of the requested page. Each response returns n orders (n=predefined value, maximum number of orders in a response). Specify this parameter as page=1 to get results 1-n, page 2 to get orders from n+1 until 2n etc.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:decimal">
                                    <xsd:minInclusive value="1"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="encodedOrderNumbers" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>The encoded order numbers for all pages. Mandatory for not-first page requests.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="1000"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getOrdersForCarriersResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:response">
                    <xsd:sequence>
                        <xsd:element name="order" type="tns:orderListData" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="totalNumberOfPages" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>The total number of pages. Number of all orders/n (n=predefined value, maximum number of orders in a response). Returned only if the first page is requested.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:decimal">
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="encodedOrderNumbers" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>Sent back only if the first page was requested (getOrdersForCarriersResponse.page=1). This value is expected in getOrdersForCarriersRequest.encodedOrderNumbers if not the first page is requested from Logon (getOrdersForCarriersRequest.page is other, than 1). Empty in case there are no orders matching the filter criteria.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="1000"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="scheduleAssignmentRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:request">
                    <xsd:sequence>
                        <xsd:element name="plannedLoading" type="xsd:dateTime" minOccurs="1">
                            <xsd:annotation>
                                <xsd:documentation>Time when the assignment is supposed to start.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="vehicle" type="tns:vehicleData" minOccurs="1">
                            <xsd:annotation>
                                <xsd:documentation>Data used to identify the vehicle. Note: When receiving the request Logon will update the commercial and executing carrier of the order with the values received in the request.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                        <xsd:element name="logonOrderNo" minOccurs="1">
                            <xsd:annotation>
                                <xsd:documentation>LOGON Single Delivery Order number</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="12"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="scheduleAssignmentResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:response"/>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="releaseAssignmentRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:request">
                    <xsd:sequence>
                        <xsd:element name="logonOrderNo" minOccurs="1">
                            <xsd:annotation>
                                <xsd:documentation>LOGON Single Delivery Order number</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="12"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="releaseAssignmentResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:response"/>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="addReturnOrderRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:request">
                    <xsd:sequence>
                        <xsd:element name="logonOrderNo" minOccurs="1">
                            <xsd:annotation>
                                <xsd:documentation>LOGON Single Delivery Order number</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="12"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="orderItemReturnData" type="tns:orderItemReturnData" minOccurs="1"
                                     maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>Return data for a specific material in the Logon order.</xsd:documentation>
                            </xsd:annotation>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="addReturnOrderResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="tns:response">
                    <xsd:sequence>
                        <xsd:element name="order" type="tns:orderData" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>

    <xsd:complexType name="orderItemReturnData">
        <xsd:annotation>
            <xsd:documentation>Return data for an order item.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="sapMaterial" minOccurs="1">
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="18"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="returnedUom" minOccurs="1">
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="3"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="deliveredQuantity" type="xsd:decimal" minOccurs="1"/>
            <xsd:element name="returnedQuantity" type="xsd:decimal" minOccurs="1"/>
            <xsd:element name="dateOfReturn" type="xsd:dateTime" minOccurs="0"/>
            <xsd:element name="returnOrderReason" minOccurs="1">
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="3"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="returnMaterialUsageCd" type="xsd:decimal" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
</xsd:schema>
