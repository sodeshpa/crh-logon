                                <xsd:documentation>The SAP Ship-To Business Partern Id. The ID used by SAP including the leading zeros.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="10"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="soldTo" minOccurs="0">
                            <xsd:annotation>
                                <xsd:documentation>The SAP Soldto-To Business Partern Id. The ID used by SAP including the leading zeros.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="10"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="materialRestriction" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>List of SAP material numbers including leading zeros. Tells which materials can be loaded on the current loadingpoint. Restricts the list of possible orders in LOGON.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="18"/>
                                </xsd:restriction>
                            </xsd:simpleType>
