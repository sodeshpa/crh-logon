<?xml version="1.0" encoding="UTF-8"?>
<!--
    xmlns:ai="http://jaxb.dev.java.net/plugin/if_insertion"
    jaxb:extensionBindingPrefixes="ai"
-->
<xsd:schema
    targetNamespace="http://logon.holcim.com/eventbeans/in/logon_oc_interface"
    xmlns:ocns="http://logon.holcim.com/eventbeans/in/logon_oc_interface"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:ebin="http://logon.holcim.com/eventbeans/in"
    xmlns:jaxb="http://java.sun.com/xml/ns/jaxb"
    jaxb:version="2.0"
    elementFormDefault="qualified">
  <xsd:import schemaLocation="eventbeans.xsd" namespace="http://logon.holcim.com/eventbeans"/>
  <xsd:import schemaLocation="eventbeans-in.xsd" namespace="http://logon.holcim.com/eventbeans/in"/>

  <xsd:complexType name="request" abstract="true">
    <xsd:complexContent>
      <xsd:extension base="ebin:logonEventRequest">
        <xsd:sequence>
          <xsd:element name="clientType" type="xsd:string"/>
          <xsd:element name="language" type="xsd:string"/>
          <xsd:element name="simulateOnly" type="xsd:boolean"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="response">
    <xsd:complexContent>
      <xsd:extension base="ebin:logonEventResponse" />
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:simpleType name="responseCode">
    <xsd:annotation>
      <xsd:appinfo>
        <jaxb:typesafeEnumClass/>
      </xsd:appinfo>
    </xsd:annotation>
    <xsd:restriction base="xsd:integer">
      <xsd:enumeration value="10000">
        <xsd:annotation>
          <xsd:appinfo>
            <jaxb:typesafeEnumMember name="OK"/>
          </xsd:appinfo>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="10101">
        <xsd:annotation>
          <xsd:appinfo>
            <jaxb:typesafeEnumMember name="TECHNICAL_ERROR"/>
          </xsd:appinfo>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="10201">
        <xsd:annotation>
          <xsd:appinfo>
            <jaxb:typesafeEnumMember name="MANDATORY_FIELD_MISSING"/>
          </xsd:appinfo>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="10202">
        <xsd:annotation>
          <xsd:appinfo>
            <jaxb:typesafeEnumMember name="MANDATORY_FIELD_ERROR"/>
          </xsd:appinfo>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="10401">
        <xsd:annotation>
          <xsd:appinfo>
            <jaxb:typesafeEnumMember name="APPLICATION_ERROR"/>
          </xsd:appinfo>
        </xsd:annotation>
      </xsd:enumeration>
      <!--
      	for additional possibilities see
      	logon-persistence/etc/sql/refdata/tlgnr_mop_status.sql
      	after "prompt INSERTING into TLGNR_MOP_STATUS_TX - EN"
      -->
    </xsd:restriction>
  </xsd:simpleType>

<!--  BEGIN LogonLDSInterface_common (but without header, request, response) -->
    <xsd:complexType name="businessPartnerContactData">
        <xsd:annotation>
            <xsd:documentation>Business partner data used only if the partner is a one-time partner.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="name1" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Last name / company name if the partner is a one-time partner.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="35"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="name2" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>First name / company name 2 if the partner is a one-time partner</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="35"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="street" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Street and house number if the partner is a one-time partner</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="35"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="zipCode" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Zip code / postal code if the partner is a one-time partner</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="10"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="city" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>City  if the partner is a one-time partner.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="35"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="country" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Country code  if the partner is a one-time partner.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="3"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="phoneNumber" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Phone number. From TLGNS_SAP_BP.PHONE_NUMBER. Mandatory on ITA delivery note.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="16"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="vatRegistrationNumber" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>VAT registration number. From TLGNS_SAP_BP.VAT_REGISTRATION_NUMBER. Mandatory on ITA delivery note.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="20"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="vendorData">
        <xsd:annotation>
            <xsd:documentation>Detailed vendor data (id, address) used in the response messages.</xsd:documentation>
        </xsd:annotation>
        <xsd:sequence>
            <xsd:element name="sapVendorId" minOccurs="1" >
                <xsd:annotation>
                    <xsd:documentation>SAP vendor id.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="10"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="name1" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Last name / company name 1 from SAP.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="35"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="name2" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>First name / company name 2 from SAP.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="35"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="street" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Street and house number from SAP.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="35"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="zipCode" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Zip code / postal code from SAP.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="10"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="city" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>City from SAP.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="35"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="country" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Country code from SAP.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="3"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="phoneNumber" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>Phone number. From TLGNS_SAP_VENDOR.PHONE_NUMBER. Mandatory on ITA delivery note.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="16"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="taxNumber" minOccurs="0" >
                <xsd:annotation>
                    <xsd:documentation>TAX number. From TLGNS_SAP_VENDOR.TAX_NUMBER3. Mandatory on ITA delivery note.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="18"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>



    <!-- END LogonLDSInterface_common -->
    <xsd:element name="createPickupCustomerOrderRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="ocns:request">
                    <xsd:sequence>
                        <xsd:element name="order" minOccurs="1">
                            <xsd:complexType>
                                <xsd:sequence>
                                    <xsd:element name="contractNumber" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP contract number. </xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="custorderCustrefNo" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Customer reference number. </xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="35"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="soldTo" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>Sold-to (customer) SAP id including leading zeros.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element name="sapId" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Sold-to (customer) SAP id including leading zeros..</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="10"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="businessPartnerContactData" type="ocns:businessPartnerContactData" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Contact data in case one-time-soldto.</xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                    <xsd:element name="shipTo" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>Ship-to (customer) SAP id including leading zeros.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element name="sapId" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Ship-to (customer) SAP id including leading zeros..</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="10"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="businessPartnerContactData" type="ocns:businessPartnerContactData" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Contact data in case one-time-shipto.</xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                    <xsd:element name="billToSapId" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Bill-to SAP id including leading zeros..</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="payerSapId" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Payer SAP id including leading zeros..</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="supplyPlantNo" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP plant number (from which goods are issued). Important if an LDS uses a central server (and not one per plant) to know for which plant a message is relevant.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="shippingpointNo" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP shipping point number (from which goods are issued).</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="earliestDeliveryTime" type="xsd:dateTime" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Earliest delivery time of order (customer time windows). If not set, actual date/time is used [createCustomerOrder]. </xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="latestDeliveryTime" type="xsd:dateTime" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Latest delivery time of order (customer time window). If not set, the ship-to's closing time of the same day is used (must be bigger than 'now') </xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="printDeliveryNote" type="xsd:boolean" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Flag to control if a delivery note on paper should be generated, with the comments contained in order.NOTE_DELIVERY and order_item.ITEM_NOTE_DELIVERY. The flag has an effect during event endLoad.</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="orderItem" minOccurs="1" maxOccurs="unbounded">
                                        <xsd:annotation>
                                            <xsd:documentation>Order item (TLGNC_ORDER_ITEM).</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element name="materialNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP Ifc Material Number including leading zeros.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="18"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="contractItemNumber" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP contract item number. Can be eft empty for advance payment contracts.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="6"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="prodPlantNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP identifier of the plant where the material defined by materialNo is produced.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantity" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Quantity of the material to be loaded in the unit of measure defined by 'quantityUom'.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantityUom" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>The unit of measure 'quantity' is measured in. Must be SAP base UoM, sales UoM or any UoM which is defined in alternative UoM of the material.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="3"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="loadingpointNo" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Identification number of the loading point in the LDS. This is a non-LOGON identifier of this loading point and must be unique in combination with shippingpointNo. If set, loading is only allowed at this loading point (e.g. specific silo at cement plant). If empty, all loading points are allowed.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="12"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                    <xsd:element name="serviceMaterial" minOccurs="0" maxOccurs="unbounded">
                                        <xsd:annotation>
                                            <xsd:documentation>Service materials.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element name="materialNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP Ifc Material Number including leading zeros.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="18"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="contractItemNumber" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP contract item number. Can be left empty for advance payment contracts.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="6"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="prodPlantNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP identifier of the plant where the material defined by materialNo is produced.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantity" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Quantity of the material to be loaded in the unit of measure defined by 'quantityUom'.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantityUom" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>The unit of measure 'quantity' is measured in. Must be SAP base UoM, sales UoM or any UoM which is defined in alternative UoM of the material.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="3"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                </xsd:sequence>
                            </xsd:complexType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="createPickupCustomerOrderResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="ocns:response">
                    <xsd:sequence>
                        <xsd:element name="customerOrderNo" minOccurs="0" >
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="8"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="order" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>Pickup single delivery order.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:complexType>
                                <xsd:sequence>
                                    <xsd:element name="logonOrderNo" minOccurs="1">
                                        <xsd:annotation>
                                            <xsd:documentation>LOGON order number (or delivery number in CRH terminology). Printed on delivery
                                                note. The same order can be loaded several times (re-scheduling).
                                            </xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="12"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                </xsd:sequence>
                            </xsd:complexType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="createRoadDirectCustomerOrderRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="ocns:request">
                    <xsd:sequence>
                        <xsd:element name="order" minOccurs="1" >
                            <xsd:complexType>
                                <xsd:sequence>
                                    <xsd:element name="contractNumber" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP contract number.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="custorderCustrefNo" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Customer reference number.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="35"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="soldTo" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>Sold-to (customer) SAP id including leading zeros.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element name="sapId" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Sold-to (customer) SAP id including leading zeros..</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="10"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="businessPartnerContactData" type="ocns:businessPartnerContactData" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Contact data in case one-time-soldto.</xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                    <xsd:element name="shipTo" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>Ship-to (customer) SAP id including leading zeros.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element name="sapId" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Ship-to (customer) SAP id including leading zeros..</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="10"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="businessPartnerContactData" type="ocns:businessPartnerContactData" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Contact data in case one-time-shipto.</xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                    <xsd:element name="billToSapId" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Bill-to SAP id including leading zeros..</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="payerSapId" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Payer SAP id including leading zeros..</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="supplyPlantNo" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP plant number (from which goods are issued). Important if an LDS uses a central server (and not one per plant) to know for which plant a message is relevant.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="shippingpointNo" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP shipping point number (from which goods are issued).</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="noteDelivery" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Remark relevant for delivery note (and later invoice).</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="256"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="noteScheduling" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Scheduling note.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string"/>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="driverComment" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Comment for the driver.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="256"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="earliestDeliveryTime" type="xsd:dateTime" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Earliest delivery time of order (customer time windows). If not set, actual date/time is used [createPickupCustomerOrder]. For information only [loadOrderNotification, etc.].</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="latestDeliveryTime" type="xsd:dateTime" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>Latest delivery time of order (customer time window). If not set, the ship-to's closing time of the same day is used (must be bigger than 'now') [createPickupCustomerOrder]. For information only [loadOrderNotification, etc.].</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="printDeliveryNote" type="xsd:boolean" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation> Flag to control if a delivery note (Lieferschein) on paper should be generated, with the comments contained in order.NOTE_DELIVERY and order_item.ITEM_NOTE_DELIVERY. The flag has an effect during event endLoad.</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="printCollectiveDeliveryNote" type="xsd:boolean" minOccurs="0" >
                                        <xsd:annotation>
                                            <xsd:documentation>If flag is set, LOGON prints a delivery note at the end of the order, containing a list of all deliveries. Else printing is supressed.</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="orderItem" minOccurs="1" maxOccurs="unbounded">
                                        <xsd:annotation>
                                            <xsd:documentation>Order item (TLGNC_ORDER_ITEM).</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element name="materialNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP Ifc Material Number including leading zeros.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="18"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="contractItemNumber" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP contract item number. Can be left empty for advance payment contracts.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="6"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="prodPlantNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP identifier of the plant where the material defined by materialNo is produced.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantity" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Quantity of the material to be loaded in the unit of measure defined by 'quantityUom'.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantityUom" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>The unit of measure 'quantity' is measured in. Must be SAP base UoM, sales UoM or any UoM which is defined in alternative UoM of the material.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="3"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="loadingpointNo" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Identification number of the loading point in the LDS. This is a non-LOGON identifier of this loading point and must be unique in combination with shippingpointNo. If set, loading is only allowed at this loading point (e.g. specific silo at cement plant). If empty, all loading points are allowed.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="12"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                    <xsd:element name="serviceMaterial" minOccurs="0" maxOccurs="unbounded">
                                        <xsd:annotation>
                                            <xsd:documentation>Service materials.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:complexType>
                                            <xsd:sequence>
                                                <xsd:element name="materialNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP Ifc Material Number including leading zeros.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="18"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="contractItemNumber" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP contract item number. Can be left empty for advance payment contracts.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="6"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="prodPlantNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP identifier of the plant where the material defined by materialNo is produced.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantity" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Quantity of the material to be loaded in the unit of measure defined by 'quantityUom'.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantityUom" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>The unit of measure 'quantity' is measured in. Must be SAP base UoM, sales UoM or any UoM which is defined in alternative UoM of the material.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="3"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                </xsd:sequence>
                            </xsd:complexType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="createRoadDirectCustomerOrderResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="ocns:response">
                    <xsd:sequence>
                        <xsd:element name="customerOrderNo" minOccurs="0">
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="8"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="order" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation>
                                <xsd:documentation>Road direct single delivery order.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:complexType>
                                <xsd:sequence>
                                    <xsd:element name="logonOrderNo" minOccurs="1">
                                        <xsd:annotation>
                                            <xsd:documentation>LOGON order number (or delivery number in CRH terminology). Printed on delivery
                                                note.
                                                The
                                                same order can be loaded several times (re-scheduling).
                                            </xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="12"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="orderStatusCd" minOccurs="1">
                                        <xsd:annotation>
                                            <xsd:documentation>LOGON order status code.
                                            </xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="2"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="poolName" minOccurs="0">
                                        <xsd:annotation>
                                            <xsd:documentation>Pool Name.
                                            </xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="30"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="commercialCarrier" type="ocns:vendorData" minOccurs="0">
                                        <xsd:annotation>
                                            <xsd:documentation>Commercial carrier (forwarding agent).</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="executingCarrier" type="ocns:vendorData" minOccurs="0">
                                        <xsd:annotation>
                                            <xsd:documentation>Executing carrier (subcontractor).</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="warningMultipleDispocard" type="xsd:boolean" minOccurs="1">
                                        <xsd:annotation>
                                            <xsd:documentation>true' in case multiple preferred ship-to sales area default candidates were found for the input parameters. 'false' if there was only one matching ship-to sales area default candidate for the input parameters.</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                </xsd:sequence>
                            </xsd:complexType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getContractQuantityCalculationRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="ocns:request">
                    <xsd:sequence>
                        <xsd:element name="soldToSapId" minOccurs="1" >
                            <xsd:annotation>
                                <xsd:documentation>Selected sold-to SAP business partner SAP id including leading zeros.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="10"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="shiptoSapId" minOccurs="0" >
                            <xsd:annotation>
                                <xsd:documentation>Selected ship-to SAP business partner. SAP id including leading zeros.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="10"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="sorgCd" minOccurs="0" >
                            <xsd:annotation>
                                <xsd:documentation>Sales organisation code of the ship-to sales area.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="4"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="contractNumber" minOccurs="0" >
                            <xsd:annotation>
                                <xsd:documentation>SAP contract number.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="10"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getContractQuantityCalculationResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="ocns:response">
                    <xsd:sequence>
                        <xsd:element name="contractQuantityCalculation" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation/>
                            <xsd:complexType>
                                <xsd:annotation>
                                    <xsd:documentation>Type encapsulating open quantity data information of the SAP materials within the SAP contract.</xsd:documentation>
                                </xsd:annotation>
                                <xsd:sequence>
                                    <xsd:element name="soldToSapId" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>sold-to SAP business partner. SAP id including leading zeros.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="shiptoSapId" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>sold-to SAP business partner. SAP id including leading zeros.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="contractNumber" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP contract number.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="contractType" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP contract type (SalesDocument field BSART). Examples: Generic Contract, Free Of Charge, Stock Transfer, Cash Sales.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="materialQuantity" minOccurs="0" maxOccurs="unbounded">
                                        <xsd:annotation/>
                                        <xsd:complexType>
                                            <xsd:annotation>
                                                <xsd:documentation>SAP Material open quantity information.</xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:sequence>
                                                <xsd:element name="materialNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP material number including the leading zeros.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="18"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="targetQuantityUom" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>The unit of measurement of the total target quantity defined in the SAP contract - target unit of measurement. The availableQuantity is also ment in this unit of measurement. </xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="3"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="totalTargetQuantity" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Target quantity for the SAP material. The total target quantity is calculated considering all SAP contract items for the material in the SAP contract. Sum of the target quantitities.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="availableQuantity" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Available quantity for the SAP material: totalTargetQuantity-totalUsedQuantity. Total used quantity is calculated considering all order items from all orders except deleted orders (finished as well) created for the SAP contract and material. It's unit of measurement is returned in the field targetQuantityUom.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="availableQuantityInTons" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>AvailableQuantity converted to tons. Empty if not possible to convert to tons.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="openQuantity" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Open quantity in the targetQuantityUom for the SAP material from SAP point of view. Sum of ordered, loaded and delivered quantity of order items for the SAP contract and SAP material. All orders are considered except finished and deleted orders. Finished orders are already sent to SAP, and so they are not considered open anymore for SAP.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="openQuantityInTons" minOccurs="0" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>openQuantity converted to tons. Empty if not possible to convert to tons.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                </xsd:sequence>
                            </xsd:complexType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getOrdersRequest">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="ocns:request">
                    <xsd:sequence>
                        <xsd:element name="soldToSapId" minOccurs="1" >
                            <xsd:annotation>
                                <xsd:documentation>Selected sold-to SAP business partner SAP id including leading zeros.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="10"/>
                                    <xsd:minLength value="1"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="shiptoSapId" minOccurs="0" >
                            <xsd:annotation>
                                <xsd:documentation>Selected ship-to SAP business partner. SAP id including leading zeros.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="10"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="orderCreationType" minOccurs="0" >
                            <xsd:annotation>
                                <xsd:documentation>Creation type code of the order</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:decimal">
                                    <xsd:totalDigits value="2" />
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="selectedLogonOrders" minOccurs="0" maxOccurs="50">
                            <xsd:annotation>
                                <xsd:documentation>Selected LOGON Single Delivery Order numbers.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="12"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="page" minOccurs="1" >
                            <xsd:annotation>
                                <xsd:documentation>The number of the requested page. Each response returns n orders (n=predefined value, maximum number of orders in a response). Specify this parameter as page=1 to get results 1-n, page 2 to get orders from n+1 until 2n etc.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:decimal">
                                    <xsd:minInclusive value="1"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="encodedOrderNumbers" minOccurs="0" >
                            <xsd:annotation>
                                <xsd:documentation>The encoded order numbers for all pages. Mandatory for not-first page requests.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="1000"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
    <xsd:element name="getOrdersResponse">
        <xsd:complexType>
            <xsd:complexContent>
                <xsd:extension base="ocns:response">
                    <xsd:sequence>
                        <xsd:element name="order" minOccurs="0" maxOccurs="unbounded">
                            <xsd:annotation/>
                            <xsd:complexType>
                                <xsd:annotation>
                                    <xsd:documentation>Corresponds to a row of TLGNC_ORDER, but only reduced information, which is appropriate in a response containing a lot of commercial orders. Used by customer portal.</xsd:documentation>
                                </xsd:annotation>
                                <xsd:sequence>
                                    <xsd:element name="logonOrderNo" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation> LOGON order number (or delivery number in CRH terminology). Printed on delivery note.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="12"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="sorgCd" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>Sales organization code of the order.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="soldToSapId" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>sold-to SAP business partner SAP id including leading zeros.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="shiptoSapId" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>ship-to SAP business partner SAP id including leading zeros.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="earliestDeliveryTime" type="xsd:dateTime" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>Earliest delivery time of order (customer time windows).</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="latestDeliveryTime" type="xsd:dateTime" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>Latest delivery time of order (customer time window). </xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:element>
                                    <xsd:element name="supplyPlantNo" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP plant number (from which goods are issued).</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="shippingpointNo" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>SAP shipping point number (from which goods are issued).</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="deliveryType" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>Determines the use case. Supported delivery types are Road Direct DDP, and Pickup EXW.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="4"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="orderStatus" minOccurs="1" >
                                        <xsd:annotation>
                                            <xsd:documentation>Order status. Possible values: OPEN, IN TRANSIT, FINISHED</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:simpleType>
                                            <xsd:restriction base="xsd:string">
                                                <xsd:maxLength value="10"/>
                                            </xsd:restriction>
                                        </xsd:simpleType>
                                    </xsd:element>
                                    <xsd:element name="orderItems" minOccurs="1" maxOccurs="unbounded">
                                        <xsd:annotation>
                                            <xsd:documentation>Order item (TLGNC_ORDER_ITEM), but only reduced order item data, which is appropriate in a message containing multiple orders.</xsd:documentation>
                                        </xsd:annotation>
                                        <xsd:complexType>
                                            <xsd:annotation>
                                                <xsd:documentation>Corresponds to a row of TLGNC_ORDER_ITEM, but only reduced item data, which is appropriate in a message, where multiple orders might be present.</xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:sequence>
                                                <xsd:element name="logonOrderItemNumber" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>LOGON order item number.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="3"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="materialNo" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>SAP material number</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="18"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantity" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>Loaded quantity of the material in the unit of measure defined by 'quantityUom'.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:decimal">
                                                            <xsd:totalDigits value="12"/>
                                                            <xsd:fractionDigits value="4"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                                <xsd:element name="quantityUom" minOccurs="1" >
                                                    <xsd:annotation>
                                                        <xsd:documentation>The unit of measure 'quantity' is measured in. Must be SAP base UoM, sales UoM or any UoM which is defined in alternative UoM of the material.</xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:maxLength value="3"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:element>
                                            </xsd:sequence>
                                        </xsd:complexType>
                                    </xsd:element>
                                </xsd:sequence>
                            </xsd:complexType>
                        </xsd:element>
                        <xsd:element name="totalNumberOfPages" minOccurs="1" >
                            <xsd:annotation>
                                <xsd:documentation>The total number of pages. Number of all orders/n (n=predefined value, maximum number of orders in a response). Returned only if the first page is requested.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:decimal"/>
                            </xsd:simpleType>
                        </xsd:element>
                        <xsd:element name="encodedOrderNumbers" minOccurs="0" >
                            <xsd:annotation>
                                <xsd:documentation>Sent back only if the first page was requested (getOrdersRequest.page=1). This value is expected in getOrdersRequest.encodedOrderNumbers if not the first page is requested from Logon (getOrdersRequest.page is other, than 1). Empty in case there are no orders matching the filter criteria.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                                <xsd:restriction base="xsd:string">
                                    <xsd:maxLength value="1000"/>
                                </xsd:restriction>
                            </xsd:simpleType>
                        </xsd:element>
                    </xsd:sequence>
                </xsd:extension>
            </xsd:complexContent>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>
