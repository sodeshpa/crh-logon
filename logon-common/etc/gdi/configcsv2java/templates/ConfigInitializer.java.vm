	private static String getDbConnectionUrl() {
    	
    	// There are more (nicer) ways to retrieve the DB URL:
		// - through JMX (requires the credentials)
		// - through JBoss specific class (requires dependencies to JBoss 
		// classes and reflection to access private fields).
		// The solution here is not specific to JBoss, but does require to 
		// open/close an SQL connection.
		Connection conn = null;
		try {
			DataSource logonDs = (DataSource)new InitialContext().lookup("java:jboss/datasources/logonDs");
			conn = logonDs.getConnection();
			return conn.getMetaData().getURL();
		} 
		catch (Exception e) {
			LOG.info("DB connection url could not be determined");
		}
		finally {
			if (conn != null) {
				try {
					conn.close();
				}
				catch (SQLException e) {
					LOG.error("error closing connection", e);
				}
			}
		}
		
		return null;
    }

	private static boolean handleLogonException(
			String key, 
			String val, 
			String type, 
			ArrayList errors,
			boolean fail, 
			boolean hasFailed, 
			LogonException logonException) {
		if (logonException.getReason() == Reason.RES_ERROR_CONFIG_NOT_EXISTENT) {
		    String msg = "non existent config '" + key + "' requested!";
		    errors.add(msg);
		    LOG.error(msg);
		}
		else if (logonException.getReason() == Reason.RES_ERROR_CONFIG_NOT_VALID) {
		    String msg = "value '" + val + "' for '" + key + "' couldn't be parsed as '" + type + "'.";
		    errors.add(msg);
		    LOG.error(msg);
		}
		else {
		    String msg = "error! msg: " + logonException.getMessage() + " reason: " + logonException.getReason();
		    errors.add(msg);
		    LOG.error(msg);
		}
		if (fail == true) {
		    hasFailed = true;
		}
		return hasFailed;
	}
