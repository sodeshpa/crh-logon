				StringTokenizer st = new StringTokenizer(printingPd4mlLanguages, ",");
				while (st.hasMoreTokens()) {
					String lang = st.nextToken().trim();
					if (StringUtils.notEmpty(lang)) {
						languages.add(lang.toLowerCase());
					}
				}
			}

			printingPd4mlLanguageSet = languages;
		}

		if (StringUtils.empty(value)) {
			return false;
		}

		return printingPd4mlLanguageSet.contains(value.trim().toLowerCase());
	}
	
