<!--
 Author            : AdNovum Informatik AG
 Version Number    : $Revision$
 Date of last edit : $Date$
-->

<!-- Set project name to project's cvs module name, as project name will
     be used for toolbox scope checks -->

<project name="logon" default="dist" basedir=".">
    <description>${ant.project.name} project build file</description>

    <!-- ================================================================= -->
    <!-- === externally defined                                        === -->
    <!-- ================================================================= -->
    <import file="properties.xml"/>
    <import file="../common.xml"/>
    <import file="${AAL_HOME}/aal/aal-maven.xml"/>
    <import file="./build-deps.xml"/>    
    <path id="eclipse.lib.classpath">
        <path refid="logon-mavendeps.test.classpath"/> <!-- maven libs -->
    </path>


    <!-- ================================================================ -->
    <!--  define target specific classpaths (build, runtime, test)        -->
    <!-- ================================================================ -->
    <path id="compile.classpath">
	<path refid="logon-mavendeps.compile.classpath"/>
    	<pathelement location="${jcan-log.jar}"/>
    	<pathelement location="${log4j.jar}"/>
    	<pathelement location="${commons-beanutils.jar}"/>
        <pathelement location="${commons-lang.jar}"/>
        <pathelement location="${axis2-kernel.jar}"/>
        <pathelement location="${axiom-api.jar}"/>
        <pathelement location="${jaxen.jar}"/>
	<pathelement location="${commons-codec.jar}"/>
        
    	<pathelement location="${picketbox.jar}"/>
    	<pathelement location="${jboss-client.jar}" />
    </path>

    <!-- ================================================================ -->
    <!--  initialization, cleanup and default targets                     -->
    <!-- ================================================================ -->
    <target name="all" depends="dist"
            description="build and test everything"/>
    <target name="toolbox-checkUptodate">
        <uptodate property="toolbox-isUptodate" targetfile=".classpath">
            <srcfiles refid="toolbox-sourcefiles"/>
        </uptodate>
    </target>
    <target name="toolbox" depends="toolbox-checkUptodate" unless="toolbox-isUptodate">
        <taskdef resource="adnant-taskdefs.xml"/> <!-- See documentation in adnant project's README -->
        <updatedotclasspath>
                <!-- See documentation of 'updatedotclasspath' in adnant project's README -->
            <con path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
            <var pathref="eclipse.lib.classpath" />
            <output path=".bin"/>
            <src path="${java.src.dir.name}"/>
            <src path="${java.test.src.dir.name}/unit"/>
            <src path="${build.dir.name}/${generated.dir.name}/gdi/xml2beans_in/src"/>
        	<src path="${build.dir.name}/${generated.dir.name}/gdi/xml2beans_out/src"/>
            <src path="${build.dir.name}/${generated.dir.name}/gdi/configcsv2java/src"/>
            <!-- Fix "MissingResourceException: Can't find bundle for base name LitDict, locale de" when running  UpAndRunningTest from within Eclipse -->
            <src path="${build.dir.name}/${generated.dir.name}/litdict"/>
            <lib path="${adntrace2-templates.jar}" sourcepath="${masterbuild.dir}/etc/adntrace2"/>
        </updatedotclasspath>
    </target>
    <target name="init" depends="toolbox"
            description="initialization project structure and environment">
        <tstamp/>
        <echo message="--------- ${ant.project.name}-${build.version} building on ${os.name} ---------"/>
        <echo message=" "/>
        <echo message="building file ${ant.file} with ${ant.version}"/>
        <echo message=""/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${lib.dir}"/>
        <mkdir dir="${generated.dir}"/>
        <mkdir dir="${test.build.dir}"/>
        <mkdir dir="${test.log.dir}"/>
        <mkdir dir="${test.lib.dir}"/>

    	<taskdef resource="net/sf/antcontrib/antcontrib.properties"/>
	    <if>
		    <equals arg1="${environment}" arg2="dev" />
		    <then>
			    <property name="build.date" value="January 1 1970"/>
			    <property name="build.stamp" value="197001010000"/>
		    </then>
		    <else>
			    <property name="build.date" value="${TODAY}"/>
			    <property name="build.stamp" value="${DSTAMP}${TSTAMP}"/>
		    </else>
		</if>
    </target>
    <target name="clean" depends="clean-test"
            description="cleans all generated files and directories" >
        <delete dir="${build.dir}"/>
    </target>

    <!-- ================================================================ -->
    <!--  compile targets                                                 -->
    <!-- ================================================================ -->
    <target name="build" depends="jars"
            description="build target"/>
    <target name="compile" depends="compile-src, compile-test"/>
    <target name="compile-src" depends="init, configcsv2java, xml2beans_in, xml2beans_out">
        <echo message="${java.src.dir}"/>
        <javac
            source="${compile.source}"
            target="${compile.target}"
            destdir="${classes.dir}"
            debug="${compile.debug}"
            optimize="${compile.optimize}"
            deprecation="${compile.deprecation}"
            encoding="${compile.encoding}"
            includeantruntime="no">
            <src path="${java.src.dir}"/>
            <src path="${generated.dir}/gdi/xml2beans_in/src"/>
        	<src path="${generated.dir}/gdi/xml2beans_out/src"/>
            <src path="${generated.dir}/gdi/configcsv2java/src"/>
            <include name="**/*.java"/>
            <bootclasspath refid="compile.bootclasspath"/>
            <classpath refid="compile.classpath"/>
        </javac>
    </target>

    <!-- ================================================================= -->
    <!-- === generator                                                 === -->
    <!-- ================================================================= -->
	<target name="xml2beans_in">
		<mkdir dir="${generated.dir}/xjc/xml2beans_in/src"/>
		<taskdef name="xjc" classname="com.sun.tools.xjc.XJCTask">
		  <classpath>
		    <pathelement path="${jaxb-xjc.jar}"/>
		  </classpath>
		</taskdef>
		<xjc destdir="${generated.dir}/xjc/xml2beans_in/src" extension="true">
	    	<arg value="-Xifins" />
			<schema dir="${etc.dir}/gdi/xml2beans_in/input">
				<include name="*.xsd"/>
			</schema>
			<binding dir="${etc.dir}/gdi/xml2beans_in/input">
				<include name="*.xjb"/>
			</binding>
			<classpath>
			   <pathelement path="${xjc-if-ins.jar}"/>
			</classpath>
			<depends dir="${etc.dir}/gdi/xml2beans_in/input"/>
			<produces dir="${generated.dir}/xjc/xml2beans_in/src"/>
		</xjc>
		<gditask classpathref="gdi.classpath"
			cartridgePath="${etc.dir}/gdi/xml2beans_in/cartridge"
		    outputPath="${generated.dir}/gdi/xml2beans_in">
			<input>
				<fileset dir="${generated.dir}/xjc/xml2beans_in/src"/>
		    </input>
			<systemproperty name="filetype" value="java"/>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
		</gditask>
		<copy todir="${generated.dir}/gdi/xml2beans_in/src">
            <fileset dir="${generated.dir}/xjc/xml2beans_in/src"/>
        </copy>
	</target>
	<target name="xml2beans_out">
		<gditask classpathref="gdi.classpath"
			cartridgePath="${etc.dir}/gdi/xml2beans_out/cartridge"
		    outputPath="${generated.dir}/gdi/xml2beans_out">
			<input>
				<fileset dir="${etc.dir}/gdi/xml2beans_out/input"/>
		    </input>
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
		</gditask>
		<copy todir="${dist.dir}/src/webservices-client">
            <fileset dir="${generated.dir}/gdi/xml2beans_out/src">
                <include name="**/LogonEventOutBeanToWebservice.java"/> <!-- this will be compiled in webservices-client -->
            </fileset>
        </copy>
        <delete>
            <fileset dir="${generated.dir}/gdi/xml2beans_out/src">
                <include name="**/LogonEventOutBeanToWebservice.java"/> <!-- this will be compiled in webservices-client -->
            </fileset>
        </delete>
	</target>
    <!-- note, this depends on a file that is maintained in logon-persistence, which is a
         component that is build after logon-common.
         this is quite unfortunate but those csv files are best located in logon-persistence
    -->
	<target name="configcsv2java">
        <gditask classpathref="gdi.classpath"
             cartridgePath="${etc.dir}/gdi/configcsv2java"
             outputPath="${generated.dir}/gdi/configcsv2java">
        	<input>
				<fileset dir="${subcomponent.persistence}/etc/csv/refdata"/>
		    </input>
	     	<systemproperty name="csv_separator" value=";"/>
	     	<systemproperty name="csv_quote_character" value='"'/>
	     	<systemproperty name="csv_skip_lines" value="1"/>
	     	<systemproperty name="ConfigBean" value="generate"/> <!-- only generate ConfigBean here -->
			<systemproperty name="gdiencoding" value="${gdi.encoding}"/>
        </gditask>
	</target>
	<target name="configcsv2javaTD">
		<java classname="ch.nevis.gdi.main.TemplateDesigner"
            fork="true" failonerror="true" newenvironment="true">
            <jvmarg value="-Dcsv_separator=;"/>
            <jvmarg value='-Dcsv_quote_character="'/>
            <jvmarg value="-Dcsv_skip_lines=1"/>
            <jvmarg value="-DConfigBean=generate"/>
            <jvmarg value="-DConfigInitializer=generate"/>
			<classpath refid="gdi.classpath"/>
			<arg line="etc/gdi/configcsv2java ${subcomponent.persistence}/etc/csv/refdata  ${generated.dir}/gdi/td/configcsv2java"/>
		</java>
	</target>

    <!-- ================================================================ -->
    <!--  generate LitDict.properties files for each language, plus 1 CSV -->
    <!-- ================================================================ -->
	<target name="litdict-checkUptodate">
		<uptodate property="litdict-isUptodate"
			srcfile="${etc.dir}/litdict/LitDict.global"
			targetfile="${generated.dir}/litdict/LitDict.txt" />
        <echo>litdict-isUptodate: ${litdict-isUptodate}</echo>
    </target>
	<target name="generatelitdict" depends="litdict-checkUptodate" unless="litdict-isUptodate" description="Generates both the language-specific properties files, as well as the TXT (tab-seperated) file for translation by customer.">
		<taskdef name="groovy" classname="org.codehaus.groovy.ant.Groovy" classpath="${groovy.jar}"/>

		<groovy src="${etc.dir}/litdict/LitDictExport.groovy" classpath="${etc.dir}/litdict">
			<!-- Name of the 'master' LitDict file -->
			<arg line="${etc.dir}/litdict/LitDict.global"/>
			<!-- File name base pattern for the generated files (e.g. LitDict_en.properties for 'en', LitDict.txt for the CSV) -->
			<arg line="${generated.dir}/litdict/LitDict"/>
		</groovy>
	</target>

    <!-- ================================================================ -->
    <!--  migrates classic LitDict.properties files into merged format    -->
    <!-- ================================================================ -->
	<target name="migratelitdict">
		<taskdef name="groovy" classname="org.codehaus.groovy.ant.Groovy" classpath="${groovy.jar}"/>
		<groovy src="${etc.dir}/litdict/LitDictMigrate.groovy" classpath="${etc.dir}/litdict">
			<!-- Location of the input LitDict property files -->
			<arg line="${etc.dir}/litdict/"/>
			<!-- Output file -->
			<arg line="${generated.dir}/litdict/LitDictMigrated.global"/>
		</groovy>
	</target>

  <!-- ================================================================= -->
  <!--  imports incoming tab-delimited TXT (from customer) to our format -->
  <!-- ================================================================= -->
  <target name="importlitdict" description="Import (merge) the translated litdic received from customer, from location etc/litdict/LitDict.replace_with_latest_to_be_imported.txt. See README in that directory.">
    <!-- Try to find a single csv file within ${etc.dir}/litdict/ and import that one if found -->
    <pathconvert property="filelist" pathsep="${line.separator}">
      <flattenmapper/>
      <fileset dir="${etc.dir}/litdict/">
        <include name="*.csv"/>
      </fileset>
    </pathconvert>
    <loadresource property="filename">
      <string value="${filelist}"/>
      <filterchain>
        <headfilter lines="1"/>
      </filterchain>
    </loadresource>
    <!-- Otherwise default to "LitDict.replace_with_latest_to_be_imported.txt" -->
    <property name="filename" value="LitDict.replace_with_latest_to_be_imported.txt"/>
    <echo message="New LitDict file to import: '${filename}'"/>
    <taskdef name="groovy" classname="org.codehaus.groovy.ant.Groovy" classpath="${groovy.jar}"/>
    <groovy src="${etc.dir}/litdict/LitDictImport.groovy" classpath="${etc.dir}/litdict">
      <arg line="'${etc.dir}/litdict/${filename}'"/>
      <arg line="${etc.dir}/litdict/LitDict.global"/>
      <arg line="${generated.dir}/litdict/LitDictImported_"/>
    </groovy>
  </target>

    <!-- ================================================================ -->
    <!--  java archives (JARs)                                            -->
    <!-- ================================================================ -->
	<target name="jars-checkUptodate">
        <uptodate property="jars-isUptodate"
			targetfile="${project-common.jar.loc}">
	        <srcfiles dir="${classes.dir}"/>
	        <srcfiles dir="${generated.dir}/litdict">
	        	<include name="**/*.properties"/>
            </srcfiles>
        </uptodate>
        <echo>jars-isUptodate: ${jars-isUptodate}</echo>
    </target>
    <target name="jars" depends="compile, generatelitdict, jars-checkUptodate" unless="jars-isUptodate">
        <tstamp/>
        <!-- class files for application -->
        <jar jarfile="${project-common.jar.loc}"
             basedir="${classes.dir}">
            <manifest>
                <attribute name="Manifest-Version" value="1.0"/>
                <attribute name="Implementation-Title" value="${ant.project.name}"/>
                <attribute name="Implementation-Vendor" value="${vendor}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Build-Date" value="${build.date}"/>
                <attribute name="Build-Stamp" value="${build.stamp}"/>
                <attribute name="Build-Environment" value="Java ${java.version}, ${java.vendor}"/>
                <attribute name="Build-System" value="${os.name} ${os.version}, ${os.arch}"/>
            </manifest>
            <include name="**/*.class"/>
            <fileset dir="${generated.dir}/litdict">
        		<include name="**/*.properties"/>
            </fileset>
            <fileset file="${buildtime.properties}"/>
        </jar>
     </target>

    <!-- ================================================================= -->
    <!-- === distribution targets                                      === -->
    <!-- ================================================================= -->
    <target name="dist" description="build the distribution" unless="omit.subcomponent.common">
        <antcall target="realdist" inheritall="true"/>
    </target>
    <target name="realdist" depends="jars">
        <copy todir="${dist.lib.dir}" file="${project-common.jar.loc}"/>
        <copy todir="${dist.dep.dir}" file="${jcan-log.jar}"/>
    	<copy todir="${dist.dep.dir}" file="${commons-beanutils.jar}"/>
		<copy todir="${dist.dep.dir}" file="${commons-collections.jar}"/>
        <copy todir="${dist.dep.dir}" file="${commons-lang.jar}"/>
        <copy todir="${dist.dep.dir}" file="${commons-codec.jar}"/>
    	<!-- copy joda time from maven deps -->
    	<copy todir="${dist.dep.dir}" flatten="true">
			<restrict>
				<name name="**/*joda-time*.jar"/> 
		    	<path refid="logon-mavendeps.compile.classpath" />
			</restrict>
		</copy>
    </target>

    <!-- NOTE: what we build here is only used for development (enables faster dev-cycles) -->
    <target name="deploy" depends="dist" description="deploy this sub-project only">
        <echo>nothing to deploy here!</echo>
    </target>

    <!-- ================================================================ -->
    <!-- source code tracing instrumentation targets                      -->
    <!-- ================================================================ -->
    <target name="adntrace2-instrument">
        <taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
        <adntrace2 operation="instrument"/>
    </target>
    <target name="adntrace2-refresh">
        <taskdef resource="adntrace2-taskdefs.xml" classpathref="adntrace2.classpath"/>
        <adntrace2 operation="refresh"/>
    </target>

    <!-- ================================================================ -->
    <!--  externally defined tasks/targets                                -->
    <!-- ================================================================ -->
    <import file="./build-test.xml"/>
		
</project>
